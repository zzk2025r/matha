# Matha 源码 - 动力学公式集
# 程序员直接编写，系统自动提取所有元数据
# 格式：公式 名字(参数) = 表达式
#       域: 领域
#       分类: area/volume/perimeter/general
#       单位: 物理单位
#       说明: 中文描述

# ============================================================
# 一、牛顿运动定律
# ============================================================

公式 牛顿第二定律(F, m, a) = F = m * a
  域: 动力学
  分类: general
  单位: N
  说明: 牛顿第二定律 F = ma

公式 力_加速度(F, m) = a = F / m
  域: 动力学
  分类: general
  单位: m/s²
  说明: 已知力和质量，求加速度 a = F/m

公式 力_质量(F, a) = m = F / a
  域: 动力学
  分类: general
  单位: kg
  说明: 已知力和加速度，求质量 m = F/a

公式 重力(F, m, g) = F = m * g
  域: 动力学
  分类: general
  单位: N
  说明: 重力 F = mg

# ============================================================
# 二、动量与冲量
# ============================================================

公式 动量(p, m, v) = p = m * v
  域: 动力学
  分类: general
  单位: kg·m/s
  说明: 动量 p = mv

公式 冲量(I, F, t) = I = F * t
  域: 动力学
  分类: general
  单位: N·s
  说明: 冲量 I = Ft

公式 末动量(p2, p1, F, t) = p2 = p1 + F * t
  域: 动力学
  分类: general
  单位: kg·m/s
  说明: 动量定理：末动量 = 初动量 + 冲量

# ============================================================
# 三、功与能
# ============================================================

公式 功(W, F, s, theta) = W = F * s * cos(theta)
  域: 动力学
  分类: general
  单位: J
  说明: 功 W = Fs cosθ

公式 功率(P, W, t) = P = W / t
  域: 动力学
  分类: general
  单位: W
  说明: 功率 P = W/t

公式 动能(Ek, m, v) = Ek = 0.5 * m * v * v
  域: 动力学
  分类: general
  单位: J
  说明: 动能 Ek = ½mv²

公式 重力势能(Ep, m, g, h) = Ep = m * g * h
  域: 动力学
  分类: general
  单位: J
  说明: 重力势能 Ep = mgh

公式 弹性势能(Es, k, x) = Es = 0.5 * k * x * x
  域: 动力学
  分类: general
  单位: J
  说明: 弹性势能 Es = ½kx²

公式 动能定理(W, m, v1, v2) = W = 0.5 * m * v2 * v2 - 0.5 * m * v1 * v1
  域: 动力学
  分类: general
  单位: J
  说明: 动能定理：合外力做功 = 动能变化

# ============================================================
# 四、转动动力学
# ============================================================

公式 力矩(M, r, F, theta) = M = r * F * sin(theta)
  域: 动力学
  分类: general
  单位: N·m
  说明: 力矩 M = rF sinθ

公式 角加速度(alpha, M, I) = alpha = M / I
  域: 动力学
  分类: general
  单位: rad/s²
  说明: 角加速度 α = M/I

公式 转动惯量_质点(I, m, r) = I = m * r * r
  域: 动力学
  分类: general
  单位: kg·m²
  说明: 质点转动惯量 I = mr²

公式 角动量(L, I, omega) = L = I * omega
  域: 动力学
  分类: general
  单位: kg·m²/s
  说明: 角动量 L = Iω

公式 转动动能(Erot, I, omega) = Erot = 0.5 * I * omega * omega
  域: 动力学
  分类: general
  单位: J
  说明: 转动动能 E_rot = ½Iω²

公式 角动量守恒(omega2, I1, omega1, I2) = omega2 = I1 * omega1 / I2
  域: 动力学
  分类: general
  单位: rad/s
  说明: 角动量守恒：I₁ω₁ = I₂ω₂

# ============================================================
# 五、机械振动
# ============================================================

公式 弹簧振子周期(T, m, k) = T = 2 * pi * sqrt(m / k)
  域: 动力学
  分类: general
  单位: s
  说明: 弹簧振子周期 T = 2π√(m/k)

公式 振动频率(f, T) = f = 1 / T
  域: 动力学
  分类: general
  单位: Hz
  说明: 频率 f = 1/T

公式 角频率(omega, T) = omega = 2 * pi / T
  域: 动力学
  分类: general
  单位: rad/s
  说明: 角频率 ω = 2π/T

公式 单摆周期(T, L, g) = T = 2 * pi * sqrt(L / g)
  域: 动力学
  分类: general
  单位: s
  说明: 单摆周期 T = 2π√(L/g)

公式 总能量(E, k, A) = E = 0.5 * k * A * A
  域: 动力学
  分类: general
  单位: J
  说明: 简谐振动总能量 E = ½kA²

# ============================================================
# 六、几何公式（从平面几何到立体几何）
# ============================================================

公式 长方形面积(S, a, b) = S = a * b
  域: 几何
  分类: area
  单位: m²
  说明: 长方形面积 = 长 × 宽

公式 三角形面积(S, a, h) = S = a * h / 2
  域: 几何
  分类: area
  单位: m²
  说明: 三角形面积 = 底 × 高 / 2

公式 梯形面积(S, a, b, h) = S = (a + b) * h / 2
  域: 几何
  分类: area
  单位: m²
  说明: 梯形面积 = (上底 + 下底) × 高 / 2

公式 圆面积(S, r) = S = pi * r * r
  域: 几何
  分类: area
  单位: m²
  说明: 圆面积 = πr²

公式 圆周长(C, r) = C = 2 * pi * r
  域: 几何
  分类: perimeter
  单位: m
  说明: 圆周长 = 2πr

公式 球体积(V, r) = V = 4 / 3 * pi * r * r * r
  域: 几何
  分类: volume
  单位: m³
  说明: 球体积 = 4/3 πr³

公式 球表面积(S, r) = S = 4 * pi * r * r
  域: 几何
  分类: area
  单位: m²
  说明: 球表面积 = 4πr²

公式 圆柱体积(V, r, h) = V = pi * r * r * h
  域: 几何
  分类: volume
  单位: m³
  说明: 圆柱体积 = πr²h

公式 圆锥体积(V, r, h) = V = pi * r * r * h / 3
  域: 几何
  分类: volume
  单位: m³
  说明: 圆锥体积 = ⅓πr²h

公式 圆柱侧面积(S, r, h) = S = 2 * pi * r * h
  域: 几何
  分类: area
  单位: m²
  说明: 圆柱侧面积 = 2πrh

# ============================================================
# 七、勾股定理与三角
# ============================================================

公式 勾股定理(c, a, b) = c = sqrt(a * a + b * b)
  域: 几何
  分类: general
  单位: m
  说明: 勾股定理 c² = a² + b²

公式 正弦定理(a, A, R) = a = 2 * R * sin(A)
  域: 几何
  分类: general
  单位: m
  说明: 正弦定理 a = 2R sinA

公式 余弦定理(c, a, b, C) = c = sqrt(a * a + b * b - 2 * a * b * cos(C))
  域: 几何
  分类: general
  单位: m
  说明: 余弦定理 c² = a² + b² - 2ab cosC

公式 海伦公式(S, a, b, c) = p = (a + b + c) / 2; S = sqrt(p * (p - a) * (p - b) * (p - c))
  域: 几何
  分类: area
  单位: m²
  说明: 海伦公式：已知三边求面积

# ============================================================
# 八、电磁学
# ============================================================

公式 库仑力(F, k, q1, q2, r) = F = k * q1 * q2 / (r * r)
  域: 电磁学
  分类: general
  单位: N
  说明: 库仑定律 F = kq₁q₂/r²

公式 电场强度(E, F, q) = E = F / q
  域: 电磁学
  分类: general
  单位: N/C
  说明: 电场强度 E = F/q

公式 电势(V, W, q) = V = W / q
  域: 电磁学
  分类: general
  单位: V
  说明: 电势 V = W/q

公式 欧姆定律(I, V, R) = I = V / R
  域: 电磁学
  分类: general
  单位: A
  说明: 欧姆定律 I = V/R

公式 电功率(P, V, I) = P = V * I
  域: 电磁学
  分类: general
  单位: W
  说明: 电功率 P = VI

公式 焦耳热(Q, I, R, t) = Q = I * I * R * t
  域: 电磁学
  分类: general
  单位: J
  说明: 焦耳热 Q = I²Rt

# ============================================================
# 九、流体力学
# ============================================================

公式 压强(P, F, A) = P = F / A
  域: 流体力学
  分类: general
  单位: Pa
  说明: 压强 P = F/A

公式 液体压强(P, rho, g, h) = P = rho * g * h
  域: 流体力学
  分类: general
  单位: Pa
  说明: 液体压强 P = ρgh

公式 浮力(Fb, rho, g, V) = Fb = rho * g * V
  域: 流体力学
  分类: general
  单位: N
  说明: 阿基米德浮力 Fb = ρgV

公式 连续性方程(v1, A1, v2, A2) = v1 * A1 = v2 * A2
  域: 流体力学
  分类: general
  单位: m/s
  说明: 连续性方程：流量守恒

公式 伯努利方程(P1, rho, v1, h1, P2, v2, h2) = P1 + 0.5 * rho * v1 * v1 + rho * g * h1 = P2 + 0.5 * rho * v2 * v2 + rho * g * h2
  域: 流体力学
  分类: general
  单位: Pa
  说明: 伯努利方程：能量守恒

# ============================================================
# 十、热力学
# ============================================================

公式 理想气体状态方程(P, V, n, T) = P * V = n * R * T
  域: 热力学
  分类: general
  单位: Pa·m³
  说明: 理想气体状态方程 PV = nRT

公式 热量(Q, m, c, delta_T) = Q = m * c * delta_T
  域: 热力学
  分类: general
  单位: J
  说明: 热量 Q = mcΔT

公式 热功率(P, Q, t) = P = Q / t
  域: 热力学
  分类: general
  单位: W
  说明: 热功率 P = Q/t

公式 热效率(eta, W, Q) = eta = W / Q
  域: 热力学
  分类: general
  单位: —
  说明: 热效率 η = W/Q
