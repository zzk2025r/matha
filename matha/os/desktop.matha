module 桌面 {
(* ============================================================
   Matha 桌面（阶段 27e）——纯 Matha TUI 桌面（共生体的桌面软件面）
   ------------------------------------------------------------
   桌面 = 纯 Matha 模块，运行在内核（matha/os/kernel.matha）之上：
     单元列表渲染 + 焦点选择 + 生命周期动作（启动/停止/卸载）+
     进程启动 + 协作调度步进。零宿主内建依赖——仅 use 标准库
     （len / str）与 use 内核，与自举链同源（Matha 编译器可编译、
     Matha VM 可解释）。

   数据模型：
     桌面 = [内核, 焦点, 消息, 退出]
       焦点  = 记录表下标（渲染面 1 起显示）
       消息  = 最近一次按键的结果行（帧固定下标 1）
       退出  = true/false——q 键置位，主循环收口
     帧    = [行, ...]（纯文本行序列；头两行固定：标题 + 消息）

   按键集（单字符键名，终端命令 桌面 [键们...] 逐键应用）：
     j / k  焦点下移 / 上移（环绕：末尾→开头、开头→末尾）
     s      启动焦点单元（内核 启动 协商）
     t      停止焦点单元（内核 停止 协商）
     u      卸载焦点单元（内核 卸载 协商，非强制）
     p      焦点单元启动主入口进程（内核 启动进程 协商）
     d      调度一轮（内核 调度(内核, 1)）
     q      退出桌面
     其余   未知键如实入消息

   演示单元（演示桌面 预装载，终端 桌面 命令与测试共用）：
     时钟  服务 v1  步计数器（3 步退出），提供服务「钟」
     回声  app  v1  一次性步（问候即退出）
     便签  包   v1  无入口（进程启动协商拒绝面演示）

   写法约束：与内核同源已证形态全集——curried 块体 / if 链 /
   let...in 嵌套 / 尾随冒号三元链；字典值位列表先 let 变量再入
   字典（裸列表字面量是已登记解析缺陷面）；负数写 0 - 1。
   ============================================================ *)

  use 标准库 { len | str }
  use 内核

  (* ===== 桌面构造 ===== *)

  func 桌面_新(内核) -> List = (内核) => {
    let 桌 = [内核, 0, "就绪", false]
    桌
  }

  (* ===== 焦点辅助（环绕 / 越界钳制） ===== *)

  func _夹焦(焦, n) -> Int =
    if n = 0 then 0
    else if 焦 < 0 then n - 1
    else if 焦 >= n then 0
    else 焦

  func _焦点名(桌) -> Value = (桌) => {
    let 记表 = 桌[0][1]
    let n = len(记表)
    let 焦 = _夹焦(桌[1], n)
    let 收 = n = 0 ? "" : 记表[焦][0]["名"]
    收
  }

  func _焦点步(桌, 增量) -> Value = (桌, 增量) => {
    let n = len(桌[0][1])
    let 下 = _夹焦(桌[1] + 增量, n)
    let 消 = "焦点 " + str(下 + 1) + "/" + str(n)
    let 收 = [桌[0], 下, 消, 桌[3]]
    收
  }

  (* ===== 渲染（消息行固定下标 1） ===== *)

  func _单元行们(记表, 焦, i) -> List =
    if i >= len(记表) then []
    else
      let 记 = 记表[i] in
      let 描 = 记[0] in
      let 标 = i = 焦 ? "> " : "  " in
      let 行 = 标 + "[" + str(i + 1) + "] " + 描["名"] + " " + 描["形态"] + " v" + str(描["版本"]) + " " + 记[1] in
      [行] + _单元行们(记表, 焦, i + 1)

  func _进程行们(行表, i) -> List =
    if i >= len(行表) then []
    else
      let 行 = "  pid " + str(行表[i][0]) + " " + 行表[i][1] + "/" + 行表[i][2] + " " + 行表[i][3] + " 步数 " + str(行表[i][4]) in
      [行] + _进程行们(行表, i + 1)

  func _服务行们(服务表, i) -> List =
    if i >= len(服务表) then []
    else
      let 行 = "  " + 服务表[i][0] + " <- " + 服务表[i][1] in
      [行] + _服务行们(服务表, i + 1)

  func 渲染帧(桌) -> List = (桌) => {
    let k = 桌[0]
    let 头 = ["== Matha 桌面共生体 ==", "消息: " + 桌[2]]
    let 中 = _单元行们(k[1], 桌[1], 0) + _进程行们(进程列表(k), 0) + _服务行们(k[3], 0)
    let 尾 = ["--", "键位: j/k 焦点  s 启动  t 停止  u 卸载  p 进程  d 步进  q 退出", "=="]
    头 + 中 + 尾
  }

  (* ===== 生命周期动作（内核协商面，消息如实回传） ===== *)

  func _结果消息(动作, r) -> String =
    if r["结果"] = "拒绝" then 动作 + "拒绝: " + r["原因"]
    else 动作 + "成功: " + r["结果"]

  func _动作(桌, 动) -> Value = (桌, 动) => {
    let 名 = _焦点名(桌)
    let r =
      动 = "启动" ? 启动(桌[0], 名) :
      动 = "停止" ? 停止(桌[0], 名) :
      卸载(桌[0], 名, false)
    let 新焦 = _夹焦(桌[1], len(桌[0][1]))
    let 消 = _结果消息(动, r)
    let 收 = [桌[0], 新焦, 消, 桌[3]]
    收
  }

  func _进程键(桌) -> Value = (桌) => {
    let 名 = _焦点名(桌)
    let r = 启动进程(桌[0], 名, "主")
    let 消 = _结果消息("进程", r)
    let 收 = [桌[0], 桌[1], 消, 桌[3]]
    收
  }

  func _步进键(桌) -> Value = (桌) => {
    let r = 调度(桌[0], 1)
    let 消 = "步进 " + str(r["步数"]) + " 步 事件 " + str(len(r["事件"]))
    let 收 = [桌[0], 桌[1], 消, 桌[3]]
    收
  }

  func _退出键(桌) -> Value = (桌) => {
    let 收 = [桌[0], 桌[1], "桌面退出", true]
    收
  }

  func _未知键(桌, 键) -> Value = (桌, 键) => {
    let 收 = [桌[0], 桌[1], "未知键 " + 键, 桌[3]]
    收
  }

  func 按键(桌, 键) -> Value =
    if 键 = "j" then _焦点步(桌, 1)
    else if 键 = "k" then _焦点步(桌, 0 - 1)
    else if 键 = "s" then _动作(桌, "启动")
    else if 键 = "t" then _动作(桌, "停止")
    else if 键 = "u" then _动作(桌, "卸载")
    else if 键 = "p" then _进程键(桌)
    else if 键 = "d" then _步进键(桌)
    else if 键 = "q" then _退出键(桌)
    else _未知键(桌, 键)

  (* ===== 主循环（键序列折叠；q 置位即收口） ===== *)

  func _主循环(桌, 键们, 帧史) -> List =
    if len(键们) = 0 then [桌, 帧史]
    else
      let 桌2 = 按键(桌, 键们[0]) in
      let 帧 = 渲染帧(桌2) in
      let 史2 = 帧史 + [帧] in
      桌2[3] ? [桌2, 史2] : _主循环(桌2, 键们[1:], 史2)

  func 主循环(桌, 键们) -> List = (桌, 键们) => _主循环(桌, 键们, [])

  (* ===== 演示单元（终端 桌面 命令与测试共用） ===== *)

  func 时钟步(上限) -> Value = (上限) => {
    let 步 = (状态) => {
      let n = 状态 = null ? 0 : 状态
      let 下 = n + 1
      let 产 = [下]
      let 报 = {"状态": 下, "继续": 下 < 上限, "产出": 产}
      报
    }
    步
  }

  func 回声步(状态) -> Value = (状态) => {
    let 话 = ["回声进程问候"]
    let 报 = {"状态": 1, "继续": false, "产出": 话}
    报
  }

  func 演示桌面() -> List = () => {
    let 无依赖 = []
    let 时钟入口 = [["主", 时钟步(3)]]
    let 时钟服务 = ["钟"]
    let 时钟描 = {"名": "时钟", "形态": "服务", "版本": 1, "requires": 无依赖, "入口": 时钟入口, "服务": 时钟服务}
    let 回声入口 = [["主", 回声步]]
    let 回声服务 = []
    let 回声描 = {"名": "回声", "形态": "app", "版本": 1, "requires": 无依赖, "入口": 回声入口, "服务": 回声服务}
    let 便签入口 = []
    let 便签服务 = []
    let 便签描 = {"名": "便签", "形态": "包", "版本": 1, "requires": 无依赖, "入口": 便签入口, "服务": 便签服务}
    let k = 内核_新()
    let 忽略1 = 装载(k, 时钟描)
    let 忽略2 = 装载(k, 回声描)
    let 忽略3 = 装载(k, 便签描)
    let 桌 = [k, 0, "演示就绪 3 单元", false]
    桌
  }
}
