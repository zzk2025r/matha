module 内核 {
(* ============================================================
   Matha OS 内核（阶段 27c）——纯 Matha 实现的操作系统内核核心
   ------------------------------------------------------------
   共生体内核：Matha 自身既是桌面/移动软件又是操作系统。本模块是
   OS 面的内核态：单元生命周期状态机、进程表与协作调度、服务注册表、
   requires 兼容协商（26c 插件语义的 Matha 镜像）。零宿主内建依赖
   ——仅 use 标准库（len / 原地设置 / matha_type_of），与自举链
   同源（Matha 编译器可编译、Matha VM 可解释）。

   数据模型（全部列表 + 原地设置，双面已证形态）：
     内核 = [名表, 记录表, 进程表, 服务表, 下一pid, 日志]
       名表   = [单元名, ...]（装载序）
       记录表 = [[描述, 状态, 版本史], ...]（与名表平行）
       进程表 = [[pid, 单元名, 入口名, 状态, 步函数, 进程状态, 步数], ...]
       服务表 = [[服务名, 提供单元名], ...]
       日志   = [[事件, 单元名, 细节], ...]
     描述（单元描述符，调用方以字典字面量构造；列表值须先 let 变量
       再入字典——字典字面量值位的裸列表是已登记解析缺陷面）：
       {"名": ..., "形态": ..., "版本": ..., "requires": [...],
        "入口": [[入口名, 步函数], ...], "服务": [服务名, ...]}
       可选两键（阶段 43d 常驻监督；缺键即 null，非真恒不激活）：
         "常驻": 真 → 启动即自动派生「主」进程（无须显式 启动进程）
         "重启预算": N → 主进程自然退出后内核至多重启 N 次
       形态 ∈ app | 包 | 域插件 | 终端命令 | 服务 | 外部
         （五形态 + 外部——宿主桥 27d：外部可执行单元经进程步闭包统一接入调度）
   状态机：已装载 → (启动) → 运行中 → (停止) → 已停止 → (启动/卸载)；
     运行中不可卸载/升级/回滚（须先停止）——诚实拒绝不静默。

   常驻监督（阶段 43d，策略全在本内核，宿主只提供进程载体）：
     · 启动 常驻 单元 → 单元状态改 运行中 的同一步内派生「主」进程；
       无 主 入口的 常驻 描述符 启动 诚实拒绝（不静默造一个空转进程）。
     · 调度 每轮尾做重启判定：单元仍 运行中 且 常驻 且「主」入口无就绪
       进程 且 有已退出进程 且 已退出次数 ≤ 重启预算 → 重启（派生新主进程，
       事件流补 ["重启", 单元名, pid]）。
     · 停止/已停止 的单元不重启（运行中 是重启的前置条件）；人工 停止进程
       落「已停止」态亦不重启——只有自然退出才触发监督重启。
     · 重启不增「步数」（步数只计实际步进，既有调度面读数口径零扰动）。

   requires 兼容协商（26c 语义镜像）：
     · 装载：requires 须已装载（注册序前置——装载先查后加，天然强制）；
       缺失诚实拒绝并记录（对齐 PluginResolver.register 缺依赖拒注册）。
     · 启动：requires 须运行中（OS 语义，比 26c 注册面更严一层）。
     · 卸载：存在依赖方默认拒绝；强制卸载后依赖方 requires 悬空，
       体检如实报告「依赖缺失」（对齐宿主 report() 不自动注销口径）。
     · 服务冲突：装载时单元声明的服务名已被占 → 装载诚实拒绝
       （先到先得；服务随卸载自动注销）。

   进程协作调度：步函数为 Matha 闭包值（描述符入口表携带），每步
     步函数(进程状态) → {"状态": 新状态, "继续": 真/假, "产出": [事件...]}
     产出 null 按 [] 处理；继续=假 → 进程「已退出」。调度按装载序
     轮转，每轮每个就绪进程恰一步。

   写法约束（vm.matha / stdlib / 24h 库模块实测已证形态全集）：
     · 函数体 `func f(p...) -> T = (p...) => { 体 }` curried 块形式，
       或表达式体（if 链 / 递归调用尾）；
     · 块内只允许：let 语句绑定、无条件 原地设置(...) 调用、裸变量收尾；
       块尾禁止裸列表字面量（语句位 [ 是输出语句面，阶段 18d）；
     · 递归遍历走 if 链 + `let ... in` 嵌套（else 分支内多行 let 语句
       不可达——表达式语境）；
     · 多路分派走 `let 结果 = if ... else if ... else ...`（stdlib 已证）
       或尾随冒号三元链（vm.matha 操作码名 式）；
     · 递归深度 = 表长（内核面表长即单元/服务/进程数，与 25c 字符递归
       RecursionError 同源约束，测试面规模远小于限）。
   ============================================================ *)

  use 标准库 { len | 原地设置 | matha_type_of }

  (* ===== 内核构造 ===== *)

  func 内核_新() -> List = [[], [], [], [], 1, []]

  (* ===== 内部辅助（日志 / 拒绝面） ===== *)

  func _记(内核, 事件, 名, 细节) -> List = (内核, 事件, 名, 细节) => {
    原地设置(内核, 5, 内核[5] + [[事件, 名, 细节]])
    内核
  }

  func _拒(原因, 名) -> Dict = (原因, 名) => {"结果": "拒绝", "原因": 原因, "名": 名}

  func _拒细(原因, 名, 细目) -> Dict = (原因, 名, 细目) => {"结果": "拒绝", "原因": 原因, "名": 名, "细目": 细目}

  (* ===== 名表 / 进程表 / 服务表 / 入口表查找（递归已证式） ===== *)

  func 名索引(名表, 名) -> Int =
    if 名表 = [] then 0 - 1
    else if 名表[0] = 名 then 0
    else
      let r = 名索引(名表[1:], 名) in
      r < 0 ? 0 - 1 : r + 1

  func _找记录(内核, 名) -> List = (内核, 名) => {
    let i = 名索引(内核[0], 名)
    let 收 = i < 0 ? [] : 内核[1][i]
    收
  }

  func _找进程表(进程表, pid) -> List =
    if 进程表 = [] then []
    else if 进程表[0][0] = pid then 进程表[0]
    else _找进程表(进程表[1:], pid)

  func _找进程(内核, pid) -> List = (内核, pid) => _找进程表(内核[2], pid)

  (* ===== 依赖协商（requires 镜像 26c） ===== *)

  (* 求缺失：requires 中不在在场名表的名字（排除自己——升级面） *)
  func _缺依赖(内核, 名, requires) -> List =
    if requires = [] then []
    else
      let 头 = requires[0] in
      let 尾 = _缺依赖(内核, 名, requires[1:]) in
      let 缺 = 头 != 名 and 名索引(内核[0], 头) < 0 in
      缺 ? [头] + 尾 : 尾

  (* 求未运行：requires 中已装载但状态非「运行中」的名字 *)
  func _未运行依赖(内核, requires) -> List =
    if requires = [] then []
    else
      let 头 = requires[0] in
      let 记 = _找记录(内核, 头) in
      let 尾 = _未运行依赖(内核, requires[1:]) in
      let 停 = len(记) > 0 and 记[1] != "运行中" in
      停 ? [头] + 尾 : 尾

  (* 依赖方名单：所有 requires 含 名 的已装载单元（除自己） *)
  func _依赖方表(内核, i, 名) -> List =
    if i >= len(内核[0]) then []
    else
      let 方 = 内核[0][i] in
      let 有 = 方 != 名 and 名索引(内核[1][i][0]["requires"], 名) >= 0 in
      let 尾 = _依赖方表(内核, i + 1, 名) in
      有 ? [方] + 尾 : 尾

  func _依赖方(内核, 名) -> List = (内核, 名) => _依赖方表(内核, 0, 名)

  (* ===== 形态 / 版本校验（五形态） ===== *)

  func _是形态(形态) -> Value = (形态) =>
    形态 = "app" or 形态 = "包" or 形态 = "域插件" or 形态 = "终端命令" or 形态 = "服务" or 形态 = "外部"

  func _形态好(名, 形态) -> Value =
    if matha_type_of(名) != "String" then false
    else if 名 = "" then false
    else _是形态(形态)

  func _版本好(版本) -> Value =
    if matha_type_of(版本) != "Int" then false
    else 版本 >= 1

  func _版本递增(新版本, 旧版本) -> Value =
    if matha_type_of(新版本) != "Int" then false
    else 新版本 > 旧版本

  func _有历史(记) -> Value =
    if len(记) = 0 then false
    else len(记[2]) > 0

  (* ===== 服务占用协商 ===== *)

  (* 服务占用扫描：服务表条目为 [服务名, 提供者] 对，须按下标 0 比对 *)
  func _占用名(服务表, 名) -> Value =
    if 服务表 = [] then false
    else if 服务表[0][0] = 名 then true
    else _占用名(服务表[1:], 名)

  func _占用表(服务表, 声明, si) -> List =
    if si >= len(声明) then []
    else
      let 名 = 声明[si] in
      let 尾 = _占用表(服务表, 声明, si + 1) in
      _占用名(服务表, 名) ? [名] + 尾 : 尾

  func _服务占用(内核, 声明) -> List = (内核, 声明) => _占用表(内核[3], 声明, 0)

  (* ===== 装载（requires 兼容协商 + 服务占用协商） ===== *)

  func 装载(内核, 描述) -> Dict = (内核, 描述) => {
    let 名 = 描述["名"]
    let 已有 = len(_找记录(内核, 名))
    let 形态好 = _形态好(名, 描述["形态"])
    let 版本好 = _版本好(描述["版本"])
    let 缺表 = _缺依赖(内核, 名, 描述["requires"])
    let 占用 = _服务占用(内核, 描述["服务"])
    let 结果 =
      not 形态好 ? _拒("描述符不合法", 名) :
      not 版本好 ? _拒("版本须为正整数", 名) :
      已有 > 0 ? _拒("已装载", 名) :
      len(缺表) > 0 ? _拒细("缺少依赖", 名, 缺表) :
      len(占用) > 0 ? _拒细("服务已被占用", 名, 占用) :
      _装载落地(内核, 描述, 名)
    结果
  }

  func _注册服务(内核, 声明, 名) -> List =
    if 声明 = [] then 内核
    else
      let 忽略 = 原地设置(内核, 3, 内核[3] + [[声明[0], 名]]) in
      _注册服务(内核, 声明[1:], 名)

  func _装载落地(内核, 描述, 名) -> Dict = (内核, 描述, 名) => {
    原地设置(内核, 0, 内核[0] + [名])
    原地设置(内核, 1, 内核[1] + [[描述, "已装载", []]])
    let 忽略 = _注册服务(内核, 描述["服务"], 名)
    let 忽略2 = _记(内核, "装载", 名, 描述["形态"])
    let 收 = {"结果": "已装载", "名": 名, "版本": 描述["版本"]}
    收
  }

  (* ===== 启动 / 停止 ===== *)

  func 启动(内核, 名) -> Dict = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let requires = len(记) > 0 ? 记[0]["requires"] : []
    let 未运行 = _未运行依赖(内核, requires)
    let 常驻 = len(记) > 0 ? _是常驻(记[0]) : false
    let 无主 = len(记) > 0 ? _找入口(记[0]["入口"], "主") = null : true
    let 结果 =
      len(记) = 0 ? _拒("未装载", 名) :
      记[1] = "运行中" ? _拒("已运行", 名) :
      len(未运行) > 0 ? _拒细("依赖未运行", 名, 未运行) :
      常驻 and 无主 ? _拒("常驻单元须有主入口", 名) :
      _启动落地(内核, 名, 记, 常驻)
    结果
  }

  func _启动落地(内核, 名, 记, 常驻) -> Dict = (内核, 名, 记, 常驻) => {
    原地设置(记, 1, "运行中")
    let 忽略 = _记(内核, "启动", 名, "")
    let 旧 = 常驻 ? _收旧进程(内核[2], 名, 0, []) : []
    let 忽略2 = 常驻 and len(旧) > 0 ? _记(内核, "收旧进程", 名, 旧) : 内核
    let 忽略3 = 常驻 ? _派主进程(内核, 名, 记) : 内核
    let 收 = {"结果": "运行中", "名": 名}
    收
  }

  (* 常驻 单元 启动 前收口遗留就绪进程：监督语义下一个常驻单元至多一个就绪
     主进程——宿主桥的进程句柄按单元名索引，两个就绪进程会互相覆写。 *)
  func _收旧进程(进程表, 单元名, i, 收) -> List =
    if i >= len(进程表) then 收
    else
      let 头 = 进程表[i] in
      let 旧 = 头[1] = 单元名 and 头[3] = "就绪" in
      let 忽略 = 旧 ? 原地设置(头, 3, "已停止") : 头 in
      let 尾 = 旧 ? 收 + [头[0]] : 收 in
      _收旧进程(进程表, 单元名, i + 1, 尾)

  func 停止(内核, 名) -> Dict = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let 结果 =
      len(记) = 0 ? _拒("未装载", 名) :
      记[1] != "运行中" ? _拒("未运行", 名) :
      _停止落地(内核, 名, 记)
    结果
  }

  func _停止落地(内核, 名, 记) -> Dict = (内核, 名, 记) => {
    原地设置(记, 1, "已停止")
    let 忽略 = _记(内核, "停止", 名, "")
    let 收 = {"结果": "已停止", "名": 名}
    收
  }

  (* ===== 卸载（依赖方协商 + 服务自动注销） ===== *)

  func 卸载(内核, 名, 强制) -> Dict = (内核, 名, 强制) => {
    let 记 = _找记录(内核, 名)
    let 方表 = _依赖方(内核, 名)
    let 结果 =
      if len(记) = 0 then _拒("未装载", 名)
      else if 记[1] = "运行中" then _拒("须先停止", 名)
      else if len(方表) > 0 and not 强制 then _拒细("存在依赖方", 名, 方表)
      else _卸载落地(内核, 名, 方表)
    结果
  }

  func _滤记(记录表, 名) -> List =
    if 记录表 = [] then []
    else
      let 头 = 记录表[0] in
      let 尾 = _滤记(记录表[1:], 名) in
      头[0]["名"] != 名 ? [头] + 尾 : 尾

  func _滤服务(服务表, 名) -> List =
    if 服务表 = [] then []
    else
      let 头 = 服务表[0] in
      let 尾 = _滤服务(服务表[1:], 名) in
      头[1] != 名 ? [头] + 尾 : 尾

  func _取名(记录表, i) -> List =
    if i >= len(记录表) then []
    else
      let 名 = 记录表[i][0]["名"] in
      let 尾 = _取名(记录表, i + 1) in
      [名] + 尾

  func _卸载落地(内核, 名, 方表) -> Dict = (内核, 名, 方表) => {
    let 新记录表 = _滤记(内核[1], 名)
    let 新名表 = _取名(新记录表, 0)
    let 新服务表 = _滤服务(内核[3], 名)
    原地设置(内核, 0, 新名表)
    原地设置(内核, 1, 新记录表)
    原地设置(内核, 3, 新服务表)
    let 忽略 = _记(内核, "卸载", 名, "")
    let 收 = {"结果": "已卸载", "名": 名, "依赖方": 方表}
    收
  }

  (* ===== 升级 / 回滚（版本史栈） ===== *)

  func 升级(内核, 名, 新描述) -> Dict = (内核, 名, 新描述) => {
    let 记 = _找记录(内核, 名)
    let 旧版本 = len(记) > 0 ? 记[0]["版本"] : 0
    let 缺表 = _缺依赖(内核, 名, 新描述["requires"])
    let 递增 = _版本递增(新描述["版本"], 旧版本)
    let 结果 =
      len(记) = 0 ? _拒("未装载", 名) :
      新描述["名"] != 名 ? _拒("名称不符", 名) :
      not 递增 ? _拒细("版本须递增", 名, [旧版本]) :
      记[1] = "运行中" ? _拒("须先停止", 名) :
      len(缺表) > 0 ? _拒细("缺少依赖", 名, 缺表) :
      _升级落地(内核, 名, 记, 新描述)
    结果
  }

  func _升级落地(内核, 名, 记, 新描述) -> Dict = (内核, 名, 记, 新描述) => {
    原地设置(记, 2, 记[2] + [记[0]])
    原地设置(记, 0, 新描述)
    原地设置(记, 1, "已装载")
    let 忽略 = _记(内核, "升级", 名, 新描述["形态"])
    let 收 = {"结果": "已升级", "名": 名, "版本": 新描述["版本"]}
    收
  }

  func 回滚(内核, 名) -> Dict = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let 历史 = _有历史(记)
    let 尾描述 = 历史 ? 记[2][len(记[2]) - 1] : null
    let 结果 =
      len(记) = 0 ? _拒("未装载", 名) :
      记[1] = "运行中" ? _拒("须先停止", 名) :
      not 历史 ? _拒("无历史版本", 名) :
      _回滚落地(内核, 名, 记, 尾描述)
    结果
  }

  func _回滚落地(内核, 名, 记, 尾描述) -> Dict = (内核, 名, 记, 尾描述) => {
    原地设置(记, 2, 记[2][:len(记[2]) - 1])
    原地设置(记, 0, 尾描述)
    原地设置(记, 1, "已装载")
    let 忽略 = _记(内核, "回滚", 名, 尾描述["形态"])
    let 收 = {"结果": "已回滚", "名": 名, "版本": 尾描述["版本"]}
    收
  }

  (* ===== 服务表（解析只读面） ===== *)

  func _解析表(服务表, 服务名) -> Value =
    if 服务表 = [] then null
    else if 服务表[0][0] = 服务名 then 服务表[0][1]
    else _解析表(服务表[1:], 服务名)

  func 服务_解析(内核, 服务名) -> Value = (内核, 服务名) => _解析表(内核[3], 服务名)

  func 服务列表(内核) -> List = (内核) => 内核[3]

  (* ===== 进程 / 协作调度 ===== *)

  func _找入口(入口表, 入口名) -> Value =
    if 入口表 = [] then null
    else if 入口表[0][0] = 入口名 then 入口表[0][1]
    else _找入口(入口表[1:], 入口名)

  func 启动进程(内核, 单元名, 入口名) -> Dict = (内核, 单元名, 入口名) => {
    let 记 = _找记录(内核, 单元名)
    let 入口表 = len(记) > 0 ? 记[0]["入口"] : []
    let 步函数 = _找入口(入口表, 入口名)
    let pid = 内核[4]
    let 结果 =
      len(记) = 0 ? _拒("未装载", 单元名) :
      记[1] != "运行中" ? _拒("单元未运行", 单元名) :
      步函数 = null ? _拒细("入口未定义", 单元名, [入口名]) :
      _进程落地(内核, pid, 单元名, 入口名, 步函数)
    结果
  }

  func _进程落地(内核, pid, 单元名, 入口名, 步函数) -> Dict = (内核, pid, 单元名, 入口名, 步函数) => {
    原地设置(内核, 4, pid + 1)
    原地设置(内核, 2, 内核[2] + [[pid, 单元名, 入口名, "就绪", 步函数, null, 0]])
    let 忽略 = _记(内核, "进程", 单元名, 入口名)
    let 收 = {"结果": "已启动", "pid": pid, "单元": 单元名, "入口": 入口名}
    收
  }

  func 停止进程(内核, pid) -> Dict = (内核, pid) => {
    let 进 = _找进程(内核, pid)
    let 结果 =
      len(进) = 0 ? _拒细("进程不存在", "", [pid]) :
      进[3] != "就绪" ? _拒细("进程已结束", "", [pid]) :
      _停止进程落地(内核, pid, 进)
    结果
  }

  func _停止进程落地(内核, pid, 进) -> Dict = (内核, pid, 进) => {
    原地设置(进, 3, "已停止")
    let 忽略 = _记(内核, "停止进程", 进[1], 进[2])
    let 收 = {"结果": "已停止", "pid": pid}
    收
  }

  (* ===== 常驻监督（阶段 43d）：策略全在本内核，宿主只提供进程载体 ===== *)

  func _是常驻(描述) -> Value = (描述) => 描述["常驻"] = true

  func _预算(描述) -> Value = (描述) =>
    描述["重启预算"] = null ? 0 : 描述["重启预算"]

  (* 派生主进程：取入口 主 的步函数入进程表——启动 与 重启 共用一派生位。 *)
  func _派主进程(内核, 名, 记) -> Dict = (内核, 名, 记) =>
    _进程落地(内核, 内核[4], 名, "主", _找入口(记[0]["入口"], "主"))

  (* 同 (单元, 入口) 的进程态计数，累计 [就绪数, 已退出数] *)
  func _态计数(进程表, 单元名, 入口名, 就绪数, 退出数) -> List =
    if 进程表 = [] then [就绪数, 退出数]
    else
      let 头 = 进程表[0] in
      let 同 = 头[1] = 单元名 and 头[2] = 入口名 in
      let r = 同 and 头[3] = "就绪" ? 就绪数 + 1 : 就绪数 in
      let x = 同 and 头[3] = "已退出" ? 退出数 + 1 : 退出数 in
      _态计数(进程表[1:], 单元名, 入口名, r, x)

  (* 重启判定前置条件全为已求值布尔/整数——and 链不触下标，无短路依赖 *)
  func _可重启(内核, 名) -> Value = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let 运行 = len(记) > 0 ? 记[1] = "运行中" : false
    let 常驻 = len(记) > 0 ? _是常驻(记[0]) : false
    let 预算 = len(记) > 0 ? _预算(记[0]) : 0
    let 计数 = _态计数(内核[2], 名, "主", 0, 0)
    let 可启 = 运行 and 常驻 and 计数[0] = 0 and 计数[1] > 0 and 计数[1] <= 预算
    可启
  }

  func _重启落地(内核, 名, 事件) -> List = (内核, 名, 事件) => {
    let 记 = _找记录(内核, 名)
    let 派 = _派主进程(内核, 名, 记)
    let 忽略 = _记(内核, "重启", 名, 派["pid"])
    let 收 = 事件 + [["重启", 名, 派["pid"]]]
    收
  }

  (* 监督轮：按装载序逐个单元做重启判定，返回新事件流（不动步数口径） *)
  func _监督轮(内核, i, 事件) -> List =
    if i >= len(内核[0]) then 事件
    else
      let 名 = 内核[0][i] in
      let 可启 = _可重启(内核, 名) in
      let 事件2 = 可启 ? _重启落地(内核, 名, 事件) : 事件 in
      _监督轮(内核, i + 1, 事件2)

  (* 单步：调步函数、落状态、收产出；继续=假 → 已退出 + 退出事件。
     返回 [新事件, 步数增量]，进程记录原地更新。 *)
  func _步进(进, 事件) -> List = (进, 事件) => {
    let 步 = 进[4]
    let 结果 = 步(进[5])
    let 产出 = 结果["产出"]
    let 继续 = 结果["继续"]
    let 收 = 产出 = null ? 事件 : 事件 + 产出
    let 收尾 = 继续 ? 收 : 收 + [["退出", 进[0]]]
    let 新态 = 继续 ? "就绪" : "已退出"
    原地设置(进, 5, 结果["状态"])
    原地设置(进, 6, 进[6] + 1)
    原地设置(进, 3, 新态)
    let 对 = [收尾, 1]
    对
  }

  (* 一轮：按装载序每个就绪进程恰一步 *)
  func _轮步表(进程表, i, 事件, 实际) -> List =
    if i >= len(进程表) then [事件, 实际]
    else
      let 进 = 进程表[i] in
      let 就绪 = 进[3] = "就绪" in
      let 收 = 就绪 ? _步进(进, 事件) : [事件, 0] in
      _轮步表(进程表, i + 1, 收[0], 实际 + 收[1])

  func _调度轮(内核, 剩, 事件, 实际) -> List =
    if 剩 <= 0 then [事件, 实际]
    else
      let 收 = _轮步表(内核[2], 0, 事件, 实际) in
      let 补 = _监督轮(内核, 0, 收[0]) in
      _调度轮(内核, 剩 - 1, 补, 收[1])

  func 调度(内核, 轮数) -> Dict = (内核, 轮数) => {
    let 收 = _调度轮(内核, 轮数, [], 0)
    let 报 = {"步数": 收[1], "事件": 收[0]}
    报
  }

  func _进程行(进程表) -> List =
    if 进程表 = [] then []
    else
      let 头 = 进程表[0] in
      let 行 = [头[0], 头[1], 头[2], 头[3], 头[6]] in
      let 尾 = _进程行(进程表[1:]) in
      [行] + 尾

  func 进程列表(内核) -> List = (内核) => _进程行(内核[2])

  (* ===== 查询 / 体检（报告面） ===== *)

  func 单元列表(内核) -> List = (内核) => 内核[0]

  func _单元信息(描述, 记) -> Dict = (描述, 记) => {
    let 信 = {"名": 描述["名"], "形态": 描述["形态"], "版本": 描述["版本"],
              "状态": 记[1], "requires": 描述["requires"], "历史版本数": len(记[2])}
    信
  }

  func 查询单元(内核, 名) -> Value = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let 描述 = len(记) > 0 ? 记[0] : null
    let 收 = 描述 = null ? null : _单元信息(描述, 记)
    收
  }

  (* 监督读数（43d）：常驻/预算 取自描述符，计数取自进程表——只读不改动 *)
  func _监督信息(内核, 记, 名) -> Dict = (内核, 记, 名) => {
    let 计数 = _态计数(内核[2], 名, "主", 0, 0)
    let 收 = {"常驻": _是常驻(记[0]), "重启预算": _预算(记[0]),
              "就绪主进程数": 计数[0], "已退出次数": 计数[1]}
    收
  }

  func 监督状态(内核, 名) -> Value = (内核, 名) => {
    let 记 = _找记录(内核, 名)
    let 收 = len(记) > 0 ? _监督信息(内核, 记, 名) : null
    收
  }

  (* 体检单元遍历：累计 [运行中, 已停止, 缺失对, 未运行对] *)
  func _体单元(内核, 记录表, 运行中, 已停止, 缺失对, 未运行对) -> List =
    if 记录表 = [] then [运行中, 已停止, 缺失对, 未运行对]
    else
      let 记 = 记录表[0] in
      let 描述 = 记[0] in
      let 运 = 记[1] = "运行中" ? 运行中 + 1 : 运行中 in
      let 停 = 记[1] = "已停止" ? 已停止 + 1 : 已停止 in
      let 缺表 = _缺依赖(内核, 描述["名"], 描述["requires"]) in
      let 缺对 = len(缺表) > 0 ? 缺失对 + [[描述["名"], 缺表]] : 缺失对 in
      let 未表 = 记[1] = "运行中" ? _未运行依赖(内核, 描述["requires"]) : [] in
      let 未对 = len(未表) > 0 ? 未运行对 + [[描述["名"], 未表]] : 未运行对 in
      _体单元(内核, 记录表[1:], 运, 停, 缺对, 未对)

  func _数就绪(进程表) -> Int =
    if 进程表 = [] then 0
    else
      let 尾 = _数就绪(进程表[1:]) in
      进程表[0][3] = "就绪" ? 尾 + 1 : 尾

  func 体检(内核) -> Dict = (内核) => {
    let 收 = _体单元(内核, 内核[1], 0, 0, [], [])
    let 就绪 = _数就绪(内核[2])
    let 报 = {"单元数": len(内核[0]), "运行中": 收[0], "已停止": 收[1],
              "进程数": len(内核[2]), "就绪进程": 就绪, "服务数": len(内核[3]),
              "依赖缺失": 收[2], "依赖未运行": 收[3], "日志条数": len(内核[5])}
    报
  }
}
