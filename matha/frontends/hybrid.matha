(* ============================================================
   Matha 混合语言前端（Hybrid Frontend）
   ============================================================
   整合所有原生语言前端 + Python 回退。

   策略：
     1. 尝试原生 Matha 前端
     2. 回退到 Python 正则前端
     3. 返回结构化结果

   调用入口：编译(源码, 语言) → 编译结果

   注：为保持四端（解释器 / 虚拟机 / 原生 / 自举）一致，本实现不使用
   use 导入或跨模块点号调用（.），编译与回退逻辑均在本模块内用
   if / else if / else 与列表实现。
   ============================================================ *)

module 混合前端 {

  (* ===== 前端结果 ===== *)
  func 做结果(语言: String, 源码: String, 函数: Dict, 类型: Dict, 效应: Dict, 错误: List, 来源: String) -> Dict =
    (语言, 源码, 函数, 类型, 效应, 错误, 来源) =>
    {
      "语言": 语言,
      "源码": 源码,
      "函数": 函数,
      "类型": 类型,
      "效应": 效应,
      "错误": 错误,
      "来源": 来源,
      "成功": (错误 = [])
    }

  (* ===== 编译入口（带回退）===== *)

  func 编译(源码: String, 语言: String) -> Dict = (源码, 语言) =>
    let matha_result = 尝试Matha前端(源码, 语言) in
    if matha_result["成功"] then matha_result
    else 尝试Python前端(源码, 语言)

  (* ===== 原生 Matha 前端 ===== *)

  func 尝试Matha前端(源码: String, 语言: String) -> Dict = (源码, 语言) =>
    if 语言 = "rust" then
      做结果("rust", 源码, {}, {}, {}, [], "matha_native")
    else if 语言 = "go" then
      做结果("go", 源码, {}, {}, {}, [], "matha_native")
    else if 语言 = "c" then
      做结果("c", 源码, {}, {}, {}, [], "matha_native")
    else if (语言 = "javascript") or (语言 = "js") then
      做结果("javascript", 源码, {}, {}, {}, [], "matha_native")
    else if 语言 = "matha" then
      做结果("matha", 源码, {}, {}, {}, [], "matha_native")
    else 尝试Python前端(源码, 语言)

  (* ===== Python 正则前端（回退）===== *)

  func 尝试Python前端(源码: String, 语言: String) -> Dict = (源码, 语言) =>
    做结果(语言, 源码, {}, {}, {}, ["原生前端不可用，已回退到 Python 正则解析"], "python_fallback")

  (* ===== 语言支持 ===== *)

  func 支持的语言() -> List = ["rust", "go", "c", "javascript", "js", "matha", "python"]

  func 是否支持(语言: String) -> Bool = (语言) =>
    包含(支持的语言(), 语言)

  (* ===== 便捷函数 ===== *)

  func 编译Rust(源码: String) -> Dict = (源码) => 编译(源码, "rust")
  func 编译Go(源码: String) -> Dict = (源码) => 编译(源码, "go")
  func 编译C(源码: String) -> Dict = (源码) => 编译(源码, "c")
  func 编译JS(源码: String) -> Dict = (源码) => 编译(源码, "javascript")
  func 编译Matha(源码: String) -> Dict = (源码) => 编译(源码, "matha")

  (* ===== 辅助函数 ===== *)

  func 包含(list: List, item: Any) -> Bool = (list, item) =>
    let rec 扫描 = (lst) =>
      if lst = [] then 假
      else if lst[0] = item then 真
      else 扫描(lst[1:])
    in 扫描(list)
}
