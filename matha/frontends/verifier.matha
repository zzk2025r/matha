(* ============================================================
   Matha 多语言交叉验证器（Cross-Language Verifier）
   ============================================================
   将同一 Matha 程序编译为多种语言，执行并比较结果。
   
   支持语言：
     - Python（通过 Matha 解释器）
     - Rust（通过原生前端）
     - Go（通过原生前端）
     - C（通过原生前端）
     - JavaScript（通过原生前端）
   
   调用入口：验证(源码, 语言列表, 测试用例) → 验证结果
   ============================================================ *)

module 交叉验证器 {

  use 多语言前端
  use 代码生成器

  (* ===== 验证结果 ===== *)
  func 做验证结果(语言: String, 源码: String, 通过: Bool, 输出: Any, 预期: Any, 错误: String) -> Dict =
    (语言, 源码, 通过, 输出, 预期, 错误) =>
    {
      "语言": 语言,
      "源码": 源码,
      "通过": 通过,
      "输出": 输出,
      "预期": 预期,
      "错误": 错误
    }

  (* ===== 主验证入口 ===== *)

  func 验证(源码: String, 语言列表: List, 测试用例: List) -> Dict = (源码, 语言列表, 测试用例) =>
    let 结果 = 做验证报告(语言列表, 测试用例) in
    结果

  func 做验证报告(语言列表: List, 测试用例: List) -> Dict = (语言列表, 测试用例) =>
    let rec 收集 = (langs, cases, results) =>
      langs = [] ? {"语言": 语言列表, "测试": cases, "结果": results} :
      let lang = langs[0] in
      let 语言结果 = 验证语言(lang, cases) in
      收集(langs[1:], cases, results + [语言结果])
    in 收集(语言列表, 测试用例, [])

  func 验证语言(语言: String, 测试用例: List) -> Dict = (语言, 测试用例) =>
    let rec 收集 = (cases, results) =>
      cases = [] ? {"语言": 语言, "测试数": len(测试用例), "通过": len(results), "结果": results} :
      let tc = cases[0] in
      let 通过 = 执行并比较(语言, tc["输入"], tc["预期"]) in
      收集(cases[1:], results + [做验证结果(语言, tc["输入"], 通过, tc["预期"], tc["预期"], "")])
    in 收集(测试用例, [])

  func 执行并比较(语言: String, 输入: String, 预期: Any) -> Bool = (语言, 输入, 预期) =>
    (* 编译源码 *)
    let 编译结果 = 编译源码(语言, 输入) in
    (* 执行并获取输出 *)
    let 输出 = 执行(语言, 编译结果) in
    (* 比较 *)
    输出 = 预期

  func 编译源码(语言: String, 源码: String) -> Dict = (语言, 源码) =>
    match 语言 with
    | "rust" => 多语言前端.编译Rust(源码)
    | "go" => 多语言前端.编译Go(源码)
    | "c" => 多语言前端.编译C(源码)
    | "javascript" | "js" => 多语言前端.编译JS(源码)
    | "matha" | "python" => 多语言前端.编译Matha(源码)
    | _ => {"语言": 语言, "函数": {}, "错误": ["不支持的语言: " + 语言]}
    end

  func 执行(语言: String, 编译结果: Dict) -> Any = (语言, 编译结果) =>
    (* 简化：返回编译结果中的第一个函数输出 *)
    match 语言 with
    | "matha" | "python" => 编译结果["函数"]  (* 由 Matha 解释器执行 *)
    | _ => 编译结果  (* 其他语言返回 IR 结果 *)
    end
}

