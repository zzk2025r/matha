(* ============================================================
   Matha 原生前端（Matha → Matha IR）
   ============================================================
   用 Matha 自身语言实现编译器前端。
   包含：词法分析、语法分析、IR 生成

   调用入口：编译(源码) → 前端结果

   注：为保持四端（解释器 / 虚拟机 / 原生 / 自举）一致，本实现只使用
   可移植构造：if / else if / else 替代 match，列表替代字典键枚举
   （.keys() 不可用），真 / 假 替代 true / false，含子串扫描替代
   字典成员判断；结果中的函数信息以列表 {"名": .., "返回类型": ..} 返回。
   ============================================================ *)

module 前端 {

  (* ===== 前端结果 ===== *)
  func 做前端结果(语言: String, 函数: List, 类型: List, 效应: List) -> Dict =
    (语言, 函数, 类型, 效应) =>
    {"类型": "前端结果", "语言": 语言, "函数": 函数, "类型": 类型, "效应": 效应}

  (* ===== 编译入口 ===== *)
  func 编译(源码: String) -> Dict = (源码) =>
    let toks = 扫描(源码) in
    let funcs = 提取函数(toks) in
    let types = 提取类型(funcs) in
    let effects = 提取效应(funcs) in
    做前端结果("matha", funcs, types, effects)

  (* ===== 词法分析 ===== *)

  func 扫描(source: String) -> List = (source) =>
    let rec 走 = (src, pos, toks) =>
      if pos >= len(src) then toks
      else if 空白(src[pos]) then 走(src, pos+1, toks)
      else if 数字(src[pos]) then
        let r = 读数字(src, pos) in
        走(src, r["位置"], toks + [做Token("literal", r["值"])])
      else if (字母(src[pos])) or (src[pos] = "_") then
        let r = 读标识符(src, pos) in
        走(src, r["位置"], toks + [做Token("ident", r["值"])])
      else if src[pos] = chr(34) then
        let r = 读字符串(src, pos) in
        走(src, r["位置"], toks + [做Token("string", r["值"])])
      else if (pos+1 < len(src)) and (src[pos] = "-") and (src[pos+1] = ">") then
        走(src, pos+2, toks + [做Token("箭头", "->")])
      else 走(src, pos+1, toks + [做Token("符号", src[pos])])
    in 走(source, 0, [])

  func 做Token(类型: String, 文本: String) -> Dict = (类型, 文本) =>
    {"类型": 类型, "文本": 文本}

  func 空白(c: String) -> Bool = (c) => (c = " ") or (c = "\t") or (c = "\r") or (c = "\n")
  func 数字(c: String) -> Bool = (c) => ((c >= "0") and (c <= "9")) or (c = ".")
  func 字母(c: String) -> Bool = (c) => ((c >= "a") and (c <= "z")) or ((c >= "A") and (c <= "Z"))

  func 读数字(src: String, pos: Int) -> Dict = (src, pos) =>
    let rec 走 = (p, num) =>
      if p >= len(src) then {"值": num, "位置": p}
      else if 数字(src[p]) then 走(p+1, num + src[p])
      else {"值": num, "位置": p}
    in 走(pos+1, src[pos])

  func 读标识符(src: String, pos: Int) -> Dict = (src, pos) =>
    let rec 走 = (p, ident) =>
      if p >= len(src) then {"值": ident, "位置": p}
      else if (字母(src[p])) or (src[p] = "_") or ((数字(src[p])) and (len(ident) > 0)) then
        走(p+1, ident + src[p])
      else {"值": ident, "位置": p}
    in 走(pos+1, src[pos])

  func 读字符串(src: String, pos: Int) -> Dict = (src, pos) =>
    let rec 走 = (p, s) =>
      if p >= len(src) then {"值": s, "位置": p}
      else if src[p] = chr(34) then {"值": s, "位置": p+1}
      else 走(p+1, s + src[p])
    in 走(pos+1, "")

  (* ===== 提取函数定义（列表） ===== *)

  func 提取函数(toks: List) -> List = (toks) =>
    let rec 走 = (ts, pos, acc) =>
      if pos >= len(ts) then acc
      else if (toks[pos]["类型"] = "ident") and (toks[pos]["文本"] = "func") then
        let nm = 读名(toks, pos+1) in
        let rt = 读返回类型(toks, nm["位置"]) in
        走(toks, rt["位置"], acc + [{"名": nm["值"], "返回类型": rt["值"]}])
      else 走(toks, pos+1, acc)
    in 走(toks, 0, [])

  func 读名(toks: List, pos: Int) -> Dict = (toks, pos) =>
    if (pos < len(toks)) and (toks[pos]["类型"] = "ident") then {"值": toks[pos]["文本"], "位置": pos+1}
    else {"值": "", "位置": pos}

  func 读返回类型(toks: List, pos: Int) -> Dict = (toks, pos) =>
    if (pos < len(toks)) and (toks[pos]["文本"] = "->") then
      let nm = 读名(toks, pos+1) in
      {"值": nm["值"], "位置": nm["位置"]}
    else {"值": "Any", "位置": pos}

  (* ===== 提取类型注解 ===== *)

  func 提取类型(funcs: List) -> List = (funcs) =>
    let rec 收集 = (fs, acc) =>
      if fs = [] then acc
      else
        let f = fs[0] in
        收集(fs[1:], acc + [{"名": f["名"], "返回类型": f["返回类型"]}])
    in 收集(funcs, [])

  (* ===== 效应分析 ===== *)

  func 提取效应(funcs: List) -> List = (funcs) =>
    let rec 收集 = (fs, acc) =>
      if fs = [] then acc
      else
        let f = fs[0] in
        收集(fs[1:], acc + [{"名": f["名"], "效应": "Pure"}])
    in 收集(funcs, [])
}
