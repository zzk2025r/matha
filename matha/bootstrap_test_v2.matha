(* ============================================================
   Matha 自举测试套件（v2 - 兼容当前解析器语法）
   验证所有 Matha 核心模块（lexer / parser / interpreter）
   在纯 Matha 环境下的正确性。
   ============================================================ *)

(* ===== 测试 1：简单算术 ===== *)
#1：【算术测试】
{
  a = 1 + 2 * 3
  [a]

  b = 10 - 3
  [b]

  c = 12 / 4
  [c]

  d = 2 ^ 10
  [d]

  e = 17 % 5
  [e]
}

(* ===== 测试 2：三角函数 ===== *)
#2：【三角函数测试】
{
  s = sin(3.14159)
  [s]

  c = cos(0.0)
  [c]

  t = sin(3.14159) + cos(1.57)
  [t]
}

(* ===== 测试 3：函数定义 ===== *)
#3：【函数测试】
{
  func 加一(n) -> Int = (n) => n + 1
  r1 = 加一(5)
  [r1]

  func 乘二(n) -> Int = (n) => n * 2
  r2 = 乘二(7)
  [r2]
}

(* ===== 测试 4：递归阶乘 ===== *)
#4：【递归测试】
{
  func 阶乘(n) -> Int = (n) =>
    n <= 1 ? 1 : n * 阶乘(n - 1)
  r3 = 阶乘(6)
  [r3]
}

(* ===== 测试 5：斐波那契 ===== *)
#5：【斐波那契测试】
{
  func 斐波那契(n) -> Int = (n) =>
    n <= 1 ? n : 斐波那契(n - 1) + 斐波那契(n - 2)
  r4 = 斐波那契(10)
  [r4]
}

(* ===== 测试 6：Lambda 柯里化 ===== *)
#6：【柯里化测试】
{
  加 = (a, b) => a + b
  r5 = 加(10)(20)
  [r5]
}

(* ===== 测试 7：条件表达式 ===== *)
#7：【条件测试】
{
  r6 = 5 > 3 ? 真 : 假
  [r6]

  r7 = 5 < 3 ? 真 : 假
  [r7]
}

(* ===== 测试汇总 ===== *)
#100：【汇总】
{
  [1 + 2 * 3]
  [10 - 3]
  [12 / 4]
  [2 ^ 10]
  [17 % 5]
  [sin(3.14159)]
  [cos(0.0)]
  [加一(5)]
  [乘二(7)]
  [阶乘(6)]
  [斐波那契(10)]
  [加(10)(20)]
  [5 > 3 ? 真 : 假]
  [5 < 3 ? 真 : 假]
}
