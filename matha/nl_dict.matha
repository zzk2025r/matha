(* ============================================================
   Matha 用户词典（阶段 8d：网络用语/代码词 → 控制子集词 显式映射）
   ------------------------------------------------------------
   词典是用户自有数据：向 默认词典 增补条目即扩展词典（编辑本文件，
   形如 词典 + 对列表 或直接改写 dict_from_pairs 实参）。
   约定：
     - 键为分词后的单词（英语词已小写化；中文词原样）；
     - 值必须是**控制子集词**（如 三/加/苹果 或 four/plus）；
     - 替换为**单层**映射（值不再进词典二次查找），
       值若仍是未知词则由词法器显式拒绝——永不静默回退。
   两语言词法器均先经 替换词表 再分类；默认词典为空 = 行为与 8b/8c 一致。
   ============================================================ *)

module 用户词典 {
  use 标准库 { dict_from_pairs }

  (* 默认用户词典：空（用户可编辑本函数实参增补映射）。 *)
  func 默认词典() -> Dict = dict_from_pairs([])

  (* 单词替换：词典命中取映射值，未命中原样返回（单层，不递归）。 *)
  func 词典替换(词典: Dict, 词: String) -> String =
    let 映射 = 安全索引(词典)(词) in
    if 映射 = null then 词 else 映射

  (* 词表整体替换：分词后、分类前对每个词做单层词典替换。 *)
  func 替换词表(词表: List, 词典: Dict) -> List =
    let rec _go(i: Int, acc: List) -> List =
      if i >= len(词表) then acc
      else _go(i + 1, acc + [词典替换(词典, 词表[i])])
    in _go(0, [])
}