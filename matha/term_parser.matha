module 终端句法器 {
  use 终端词法器 { 终端词法分析 }
  use 标准库 { len | dict_from_pairs }

  (* ============================================================
     终端句法器 —— 纯 Matha 实现（阶段 12a）
     ============================================================
     token 列表 → 命令帧（Dict）：
       {
         "命令": 命令名,
         "参数": [参数文本, ...],
         "管道链": [{"命令", "参数"}, ...],   (* 管道 | 之后的段，每段同构 *)
         "重定向": "" 或 ">" 或 ">>",
         "重定向目标": "" 或 文件名
       }
     文法（CMD 子集 v1）：
       命令行 := 段 (管道 段)* [重定向符 目标]
       段     := 词 参数*
     显式拒绝（错误，永不静默择一）：
       - 空 token 列表
       - 段缺命令名（管道/重定向符打头，或双管道）
       - 管道后缺命令
       - 重定向缺目标 / 重定向符重复 / 重定向不在末尾（后随管道）
     管道与重定向的**真执行**属终端执行器（12c）职责；本层只忠实成帧，
     未实现特性由执行器显式拒绝。 *)

  (* 便捷入口：命令行文本 → 命令帧（词法+句法一步到位） *)
  func 终端解析(行: String) -> Dict =
    终端帧分析(终端词法分析(行))

  (* token 列表 → 命令帧主入口 *)
  func 终端帧分析(tokens: List) -> Dict =
    if len(tokens) = 0 then
      错误("命令为空")
    else
      let (首段, i) = _段(tokens, 0) in
      _尾(tokens, i, 首段, [], "", "")

  (* 解析一个命令段：首个 token 为命令名，其后词 token 全为参数；
     遇 管道/重定向 token 或结尾停止。返回 (段帧, 下一索引)。 *)
  func _段(tokens: List, i: Int) -> (Dict, Int) =
    if i >= len(tokens) then
      错误("命令段为空")
    else
      let 首 = tokens[i] in
      if 首[0] != "词" then
        错误("缺少命令名: " + 首[1])
      else
        _段参数(tokens, i + 1, 首[1], [])

  func _段参数(tokens: List, i: Int, 命令: String, 参数: List) -> (Dict, Int) =
    if i >= len(tokens) then
      (段帧(命令, 参数), i)
    else
      let tok = tokens[i] in
      if tok[0] = "词" then
        _段参数(tokens, i + 1, 命令, 参数 + [tok[1]])
      else
        (段帧(命令, 参数), i)

  (* 尾部状态机：主段 + 管道链累积 + 重定向（必须末尾且唯一） *)
  func _尾(tokens: List, i: Int, 主段: Dict, 链: List, 重定向: String, 目标: String) -> Dict =
    if i >= len(tokens) then
      建帧(主段, 链, 重定向, 目标)
    else
      let tok = tokens[i] in
      if tok[0] = "管道" then
        if 重定向 != "" then
          错误("重定向必须位于命令行末尾")
        else
          let (次段, j) = _段(tokens, i + 1) in
          _尾(tokens, j, 主段, 链 + [次段], 重定向, 目标)
      else if 重定向 != "" then
        错误("重定向符重复: " + tok[1])
      else if i + 1 >= len(tokens) then
        错误("重定向缺少目标文件")
      else
        let 目标token = tokens[i + 1] in
        if 目标token[0] != "词" then
          错误("重定向目标必须是文件名")
        else
          let 符号 = if tok[0] = "追加重定向" then ">>" else ">" in
          _尾(tokens, i + 2, 主段, 链, 符号, 目标token[1])

  (* 单段帧（无管道/重定向字段——管道链中的段同构） *)
  func 段帧(命令: String, 参数: List) -> Dict =
    dict_from_pairs([["命令", 命令], ["参数", 参数]])

  (* 完整命令帧 *)
  func 建帧(主段: Dict, 链: List, 重定向: String, 目标: String) -> Dict =
    dict_from_pairs([
      ["命令", 主段["命令"]],
      ["参数", 主段["参数"]],
      ["管道链", 链],
      ["重定向", 重定向],
      ["重定向目标", 目标]
    ])
}
