(* ============================================================
   matha/stdlib_symbols.matha — Matha 全符号资源库（Phase ③）
   ============================================================
   分类登记 Matha 可用 / 可识别的符号：码位、中英文名、别名、类别、语义；
   运算符类另带 优先级 / 结合性，可生成 @define_op 声明文本。

   类别（主类别，共 7 类）：
     中文标点 / 全角 / ASCII / 运算符 / 数学 / 希腊 / 学科
   一个符号只登记一次；跨类别归属用 `标签` 表达（如 π 主类=数学、标签=[希腊,常量]）。

   数据单一来源：宿主 src/symbol_registry.py 编译并运行本文件，读取全局
   `符号表` 获得同一份数据；本文件内的查询函数供 Matha 程序使用。
   ============================================================ *)

(* 码位：字符串各字符的 Unicode 码点列表（如 "**" → [42, 42]） *)
func 码位(s: String) -> List =
  let rec _go(i: Int, acc: List) -> List =
    if i >= len(s) then acc
    else _go(i + 1, append(acc)(ord(s[i])))
  in _go(0, [])

(* 构造一个普通符号条目（非运算符，优先级 0） *)
func 符号(符: String, 中文名: String, 英文名: String,
          别名: List, 类别: String, 标签: List, 语义: String) -> Dict =
  {"符号": 符, "码位": 码位(符), "中文名": 中文名, "英文名": 英文名,
   "别名": 别名, "类别": 类别, "标签": 标签, "语义": 语义,
   "优先级": 0, "结合性": ""}

(* 构造一个运算符条目（主类别固定为「运算符」，带优先级 / 结合性） *)
func 运算符号(符: String, 中文名: String, 英文名: String, 别名: List,
              标签: List, 语义: String, 优先级: Int, 结合性: String) -> Dict =
  {"符号": 符, "码位": 码位(符), "中文名": 中文名, "英文名": 英文名,
   "别名": 别名, "类别": "运算符", "标签": 标签, "语义": 语义,
   "优先级": 优先级, "结合性": 结合性}

