(* ===================== 查询函数（供 Matha 程序使用） ===================== *)

func 类别列表() -> List =
  ["中文标点", "全角", "ASCII", "运算符", "数学", "希腊", "学科"]

func 全部符号() -> List = 符号表

func 符号数目() -> Int = len(符号表)

func _含(xs: List, x: String) -> Bool =
  let rec _go(i: Int) -> Bool =
    if i >= len(xs) then 假
    else if xs[i] = x then 真
    else _go(i + 1)
  in _go(0)

(* 按主类别或标签匹配（如 π 主类=数学、标签含 希腊 → 二者都可命中） *)
func 按类别(类别: String) -> List =
  let rec _go(i: Int, acc: List) -> List =
    if i >= len(符号表) then acc
    else
      let e = 符号表[i] in
      if e["类别"] = 类别 or _含(e["标签"], 类别) then
        _go(i + 1, append(acc)(e))
      else _go(i + 1, acc)
  in _go(0, [])

(* 按码位查首个条目（多字符符号取其首字符码位） *)
func 按码位(码: Int) -> Value =
  let rec _go(i: Int) -> Value =
    if i >= len(符号表) then null
    else
      let e = 符号表[i] in
      if _含(e["码位"], 码) then e else _go(i + 1)
  in _go(0)

(* 按符号字面量精确查 *)
func 按符号(符: String) -> Value =
  let rec _go(i: Int) -> Value =
    if i >= len(符号表) then null
    else if 符号表[i]["符号"] = 符 then 符号表[i]
    else _go(i + 1)
  in _go(0)

(* 按名查：匹配 中文名 / 英文名 / 别名 / 符号本身（不区分大小写地匹配英文名） *)
func 按名(名: String) -> Value =
  let rec _go(i: Int) -> Value =
    if i >= len(符号表) then null
    else
      let e = 符号表[i] in
      if e["中文名"] = 名 or e["英文名"] = 名 or e["符号"] = 名 or _含(e["别名"], 名) then e
      else _go(i + 1)
  in _go(0)

func 取语义(符: String) -> String =
  let e = 按符号(符) in
  if e = null then "" else e["语义"]

(* 生成 @define_op 声明文本（仅对带优先级/结合性的符号有意义） *)
func 运算符声明(符: String) -> String =
  let e = 按符号(符) in
  if e = null then ""
  else if e["优先级"] <= 0 then ""
  else "@define_op: " + 符 + " = " + str(e["优先级"]) + " | " + e["结合性"]

(* 列出所有可作为 @define_op 的符号（优先级 > 0） *)
func 可定义运算符() -> List =
  let rec _go(i: Int, acc: List) -> List =
    if i >= len(符号表) then acc
    else
      let e = 符号表[i] in
      if e["优先级"] > 0 then _go(i + 1, append(acc)(e["符号"]))
      else _go(i + 1, acc)
  in _go(0, [])
