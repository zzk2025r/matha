module 终端执行器 {
  use 终端句法器 { 终端解析 }
  use 标准库 { len | str | split | to_lower | list_slice | dict_from_pairs | dict_has | dict_get | dict_to_list | matha_type_of | read_file | write_file | append_file | find }

  (* ============================================================
     终端执行器 —— 纯 Matha 实现（阶段 12c）
     ============================================================
     命令帧 → 执行结果帧：
       { "输出": [输出行, ...], "退出": Bool }
     设计（经用户审批的三项决策）：
       ① 未知命令 = CMD 式透传：整行交系统 shell 真执行（内建 执行命令），
          失败如实追加 "命令退出码: N" 行——不伪装成功、不静默吞错。
       ② 管道(|)与重定向(> >>) 为 12a 解析预留特性。管道已真化（阶段 13a，
          CMD 式 stdin 注入——左段显示行 → 右段 输入行()/透传 stdin）；
          重定向已真化（阶段 13b：末段显示行落盘，> 截断 / >> 追加，CMD 式
          静默不回显；退出标志跳过落盘，段内错误不落盘）。
       ③ 命令注册表为纯 Matha 字典（闭包注册），CMD 模板命令集：
            目录/换目录/显示文件/复制/删除/建目录/改名/回显/清屏/帮助/退出
          英文别名同表（大小写不敏感），Matha 代码命令：
            运行/加载/编写/调试
          调试 经内建 调试Matha（仅宿主后端；VM 显式拒绝如实穿透）。
       ④（12e）扩展命令：注册命令/注销命令 持久化当前目录 matha_term_registry.txt
          （行格式 `名字 路径`，单空格，名字/路径含空格注册时显式拒绝）；派发顺序
          内建 → 注册表 → 透传（注册名不可覆盖内建，注册时显式拒绝冲突名）；调用
          扩展 = 处理器源码 + 拼接 处理([参数们]) 经 执行Matha 进程内执行，参数含
          引号/反斜杠/换行 显式拒绝（防代码注入）。处理器契约：导出 处理(参数们)
          并自行 输出 结果行。
       ⑤（12e）升级：内建 检查包更新()（pkg_manager_v2 真本地检查——从当前目录
          .matha_packages/*/manifest.json 还原已安装集合再本地比对，无网络）+
          纯 Matha 渲染；`升级 解释器` 显式拒绝（自举核心不可终端自升级）；
          无参升级只检查不安装；带名升级真安装（13c：os 域 升级包 真盘重写
          .matha_packages/<包>/manifest.json + 盘上版本复核；本地目录升级
          不联网下载）。
     文件 I/O 走 stdlib read_file/write_file（委托 _read_file/_write_file
     原语，两端同名可用）。OS 级能力（进程/文件系统）由 12b 胶水内建提供，
     本模块的全部命令逻辑为纯 Matha。 *)

  (* ---- ① 显示渲染：任意 Matha 值 → 人类可读文本 ---- *)

  func 显示值(v) -> String =
    if v = null then "null"
    else if matha_type_of(v) = "String" then v
    else if matha_type_of(v) = "Int" or matha_type_of(v) = "Float" or matha_type_of(v) = "Bool" then str(v)
    else if matha_type_of(v) = "List" then "[" + _列表文本(v, 0) + "]"
    else if matha_type_of(v) = "Dict" then "{" + _键值文本(dict_to_list(v), 0) + "}"
    else "<值:" + matha_type_of(v) + ">"

  func _列表文本(lst: List, i: Int) -> String =
    if i = len(lst) then ""
    else (if i = 0 then "" else ", ") + 显示值(lst[i]) + _列表文本(lst, i + 1)

  func _键值文本(pairs: List, i: Int) -> String =
    if i = len(pairs) then ""
    else (if i = 0 then "" else ", ") + 显示值(pairs[i][0]) + ": " + 显示值(pairs[i][1]) + _键值文本(pairs, i + 1)

  (* ---- ② 行处理小件 ---- *)

  (* split 产生的尾部空行（内容以 \n 结尾）不属终端可见行，去除 *)
  func _去尾空行(行们: List) -> List =
    if 行们 = [] then []
    else if 行们[len(行们) - 1] = "" then _去尾空行(list_slice(行们, 0, len(行们) - 1))
    else 行们

  func _拼接(参数们: List) -> String = _拼到(参数们, 0, "")

  func _拼到(参数们: List, i: Int, acc: String) -> String =
    if i = len(参数们) then acc
    else if acc = "" then _拼到(参数们, i + 1, 参数们[i])
    else _拼到(参数们, i + 1, acc + " " + 参数们[i])

  (* ---- ③ 结果帧构造 ---- *)

  func _结果(行们: List, 退出: Bool) -> Dict =
    dict_from_pairs([["输出", 行们], ["退出", 退出]])

  (* ---- ④ CMD 模板命令集 ---- *)

  func _目录(参数们: List) -> Dict =
    if len(参数们) > 1 then
      错误("目录: 至多 1 个参数, 实得 " + str(len(参数们)))
    else
      let 条目 = 列目录(if 参数们 = [] then "." else 参数们[0]) in
      _结果(_条目行(条目, 0), 假)

  func _条目行(条目: List, i: Int) -> List =
    if i = len(条目) then []
    else
      let 行 = 条目[i][0] + (if 条目[i][1] then "\t<目录>" else "\t" + str(条目[i][2])) in
      [行] + _条目行(条目, i + 1)

  func _换目录(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("换目录: 需要 1 个参数, 实得 " + str(len(参数们)))
    else
      let 已换 = 换目录(参数们[0]) in
      _结果([], 假)

  func _显示文件(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("显示文件: 需要 1 个参数, 实得 " + str(len(参数们)))
    else
      let 内容 = read_file(参数们[0]) in
      _结果(_去尾空行(split(内容, "\n")), 假)

  func _复制(参数们: List) -> Dict =
    if len(参数们) != 2 then
      错误("复制: 需要 2 个参数, 实得 " + str(len(参数们)))
    else
      let 已复制 = 复制文件(参数们[0])(参数们[1]) in
      _结果(["已复制 1 个文件。"], 假)

  func _删除(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("删除: 需要 1 个参数, 实得 " + str(len(参数们)))
    else
      let 已删 = 删除路径(参数们[0]) in
      _结果([], 假)

  func _建目录(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("建目录: 需要 1 个参数, 实得 " + str(len(参数们)))
    else
      let 已建 = 建目录(参数们[0]) in
      _结果([], 假)

  func _改名(参数们: List) -> Dict =
    if len(参数们) != 2 then
      错误("改名: 需要 2 个参数, 实得 " + str(len(参数们)))
    else
      let 已改名 = 改名(参数们[0])(参数们[1]) in
      _结果([], 假)

  func _回显(参数们: List) -> Dict =
    _结果([_拼接(参数们)], 假)

  func _清屏(参数们: List) -> Dict =
    if len(参数们) != 0 then
      错误("清屏: 不需要参数, 实得 " + str(len(参数们)))
    else
      _结果(["\x1b[2J\x1b[H"], 假)

  func _帮助(参数们: List) -> Dict =
    _结果([
      "Matha 终端（CMD 模板子集）命令：",
      "  目录 [路径]          列出目录内容（别名 dir/ls）",
      "  换目录 路径          切换当前目录（别名 cd）",
      "  显示文件 路径        显示文件内容（别名 type/cat）",
      "  复制 源 目标         复制文件（别名 copy）",
      "  删除 路径            删除文件或空目录（别名 del/rm；递归删除永不支持）",
      "  建目录 路径          创建目录（别名 mkdir/md）",
      "  改名 旧 新           重命名（别名 ren/rename）",
      "  回显 内容...         显示文本（别名 echo）",
      "  清屏                 清屏（别名 cls；ANSI 序列）",
      "  运行 \"源码\"          执行 Matha 源码字符串（别名 run）",
      "  加载 路径            执行 .matha 源文件（别名 load）",
      "  编写 路径 \"源码\"     将手写代码块写入文件（别名 write）",
      "  调试 \"源码\"          逐节点轨迹+变量快照（别名 debug；仅宿主后端）",
      "  注册命令 名字 路径    注册扩展命令（处理器导出 处理(参数们) 并自行 输出；别名 regcmd）",
      "  注销命令 名字         注销扩展命令（别名 unregcmd；注册表 matha_term_registry.txt）",
      "  升级 [包名]           无参=本地检查；带名=真安装（盘上 manifest 重写+复核；升级 解释器 显式拒绝，别名 upgrade）",
      "  扩展命令              注册名派发优先于透传、不可覆盖内建",
      "  启动自动加载          REPL 启动时自动执行当前目录 matha_term_extensions.msh（其中 退出 不结束会话）",
      "  帮助                 本帮助（别名 help）",
      "  退出                 退出终端（别名 exit/quit）",
      "  其他输入             CMD 式透传系统执行（失败显示退出码）",
      "  查找 子串             管道消费者：过滤含子串的行（别名 findstr/find；stdin 读至 EOF，空行终止）",
      "  排序                 管道消费者：码点序稳定排序 stdin 行（别名 sort；纯 Matha 插入排序）",
      "  管道 段1 | 段2        左段输出行 → 右段 stdin（阶段 13a 真化；透传段经 执行命令输入）",
      "  重定向 > / >>         末段显示行落盘（> 截断 / >> 追加；CMD 式静默，阶段 13b 真化）",
    ], 假)

  func _退出(参数们: List) -> Dict =
    _结果([], 真)

  (* ---- ⑤ Matha 代码命令 ---- *)

  func _运行(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("运行: 需要 1 个参数（引号包裹的 Matha 源码）, 实得 " + str(len(参数们)))
    else
      let 出 = 执行Matha(参数们[0]) in
      _结果(_渲染(出, 0), 假)

  func _加载(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("加载: 需要 1 个参数, 实得 " + str(len(参数们)))
    else
      let 出 = 执行Matha(read_file(参数们[0])) in
      _结果(_渲染(出, 0), 假)

  func _编写(参数们: List) -> Dict =
    if len(参数们) != 2 then
      错误("编写: 需要 2 个参数（路径 源码）, 实得 " + str(len(参数们)))
    else
      let 已写 = write_file(参数们[0], 参数们[1]) in
      _结果(["已编写 " + 参数们[0]], 假)

  func _调试(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("调试: 需要 1 个参数（引号包裹的 Matha 源码）, 实得 " + str(len(参数们)))
    else
      let 快照 = 调试Matha(参数们[0]) in
      let 轨迹段 = ["== 轨迹 =="] + 快照["轨迹"] in
      let 输出段 = ["== 输出 =="] + _渲染(快照["输出"], 0) in
      let 变量段 = ["== 变量 =="] + _变量行(快照["变量"], 0) in
      let 错误段 = if 快照["错误"] != "" then ["== 错误: " + 快照["错误"]] else [] in
      _结果(轨迹段 + 输出段 + 变量段 + 错误段, 假)

  func _渲染(出: List, i: Int) -> List =
    if i = len(出) then []
    else [显示值(出[i])] + _渲染(出, i + 1)

  func _变量行(变量们: List, i: Int) -> List =
    if i = len(变量们) then []
    else [变量们[i][0] + " = " + 变量们[i][1]] + _变量行(变量们, i + 1)

  (* ---- ⑥ CMD 式透传（未知命令） ----

     管入文本 = "" 走 执行命令（无输入）；非空走 执行命令输入（CMD 管道右段，
     os 域内建，stdin 注入）。管道段命令行按段帧重建（12a 词法已剥引号，引号
     分组不保留——如实边界）；首段透传仍优先原行保真。 *)

  func _重建行(帧: Dict) -> String =
    if 帧["参数"] = [] then 帧["命令"]
    else 帧["命令"] + " " + _拼接(帧["参数"])

  func _透传(原行: String, 帧: Dict, 管入文本: String) -> Dict =
    let 行 = if 原行 != "" then 原行 else _重建行(帧) in
    let 结果 = if 管入文本 = "" then 执行命令(行) else 执行命令输入(行)(管入文本) in
    let 出 = if 结果["stdout"] = "" then [] else _去尾空行(split(结果["stdout"], "\n")) in
    let 误 = if 结果["stderr"] = "" then [] else _去尾空行(split(结果["stderr"], "\n")) in
    let 尾 = if 结果["returncode"] = 0 then [] else ["命令退出码: " + str(结果["returncode"])] in
    _结果(出 + 误 + 尾, 假)

  (* ---- ⑦ 命令注册表（纯 Matha 字典 + 闭包） ---- *)

  func 命令表() -> Dict =
    dict_from_pairs([
      ["目录", (a) => _目录(a)],
      ["dir", (a) => _目录(a)],
      ["ls", (a) => _目录(a)],
      ["换目录", (a) => _换目录(a)],
      ["cd", (a) => _换目录(a)],
      ["显示文件", (a) => _显示文件(a)],
      ["type", (a) => _显示文件(a)],
      ["cat", (a) => _显示文件(a)],
      ["复制", (a) => _复制(a)],
      ["copy", (a) => _复制(a)],
      ["删除", (a) => _删除(a)],
      ["del", (a) => _删除(a)],
      ["rm", (a) => _删除(a)],
      ["建目录", (a) => _建目录(a)],
      ["mkdir", (a) => _建目录(a)],
      ["md", (a) => _建目录(a)],
      ["改名", (a) => _改名(a)],
      ["ren", (a) => _改名(a)],
      ["rename", (a) => _改名(a)],
      ["回显", (a) => _回显(a)],
      ["echo", (a) => _回显(a)],
      ["清屏", (a) => _清屏(a)],
      ["cls", (a) => _清屏(a)],
      ["运行", (a) => _运行(a)],
      ["run", (a) => _运行(a)],
      ["加载", (a) => _加载(a)],
      ["load", (a) => _加载(a)],
      ["编写", (a) => _编写(a)],
      ["write", (a) => _编写(a)],
      ["调试", (a) => _调试(a)],
      ["debug", (a) => _调试(a)],
      ["帮助", (a) => _帮助(a)],
      ["help", (a) => _帮助(a)],
      ["退出", (a) => _退出(a)],
      ["exit", (a) => _退出(a)],
      ["quit", (a) => _退出(a)],
      ["注册命令", (a) => _注册命令(a)],
      ["regcmd", (a) => _注册命令(a)],
      ["注销命令", (a) => _注销命令(a)],
      ["unregcmd", (a) => _注销命令(a)],
      ["升级", (a) => _升级(a)],
      ["upgrade", (a) => _升级(a)],
      ["查找", (a) => _管道查找(a)],
      ["findstr", (a) => _管道查找(a)],
      ["find", (a) => _管道查找(a)],
      ["排序", (a) => _管道排序(a)],
      ["sort", (a) => _管道排序(a)],
    ])

  (* ---- ⑦b 扩展命令注册表（阶段 12e） ---- *)

  func _注册表文本() -> String =
    if 路径存在("matha_term_registry.txt") then read_file("matha_term_registry.txt") else ""

  func _注册表对(行们: List, i: Int, 对们: List) -> List =
    if i = len(行们) then 对们
    else
      let 们 = split(行们[i], " ") in
      if len(们) != 2 then
        错误("终端注册表存在坏行（须为『名字 路径』单空格行）: " + 行们[i])
      else _注册表对(行们, i + 1, 对们 + [[们[0], 们[1]]])

  func 读注册表() -> Dict =
    let 行们 = _去尾空行(split(_注册表文本(), "\n")) in
    dict_from_pairs(_注册表对(行们, 0, []))

  func _留异名行(行们: List, i: Int, 名: String, 留们: List) -> List =
    if i = len(行们) then 留们
    else
      let 们 = split(行们[i], " ") in
      if len(们) = 2 and 们[0] = 名 then _留异名行(行们, i + 1, 名, 留们)
      else _留异名行(行们, i + 1, 名, 留们 + [行们[i]])

  func _拼换行(行们: List, i: Int) -> String =
    if i = len(行们) then ""
    else if i + 1 = len(行们) then 行们[i]
    else 行们[i] + "\n" + _拼换行(行们, i + 1)

  func _有空格(s: String) -> Bool = find(" ", s) != -1

  func _注册命令(参数们: List) -> Dict =
    if len(参数们) != 2 then
      错误("注册命令: 需要 2 个参数（名字 处理器路径）, 实得 " + str(len(参数们)))
    else if dict_has(命令表(), to_lower(参数们[0])) then
      错误("注册命令: 名字与内建命令冲突: " + 参数们[0])
    else if _有空格(参数们[0]) then
      错误("注册命令: 名字不能含空格（注册表行格式限制）: " + 参数们[0])
    else if _有空格(参数们[1]) or find("\n", 参数们[1]) != -1 then
      错误("注册命令: 路径不能含空格/换行（注册表行格式限制）: " + 参数们[1])
    else if 路径存在(参数们[1]) = 假 then
      错误("注册命令: 处理器文件不存在: " + 参数们[1])
    else
      let 名 = to_lower(参数们[0]) in
      let 行们 = _去尾空行(split(_注册表文本(), "\n")) in
      let 留们 = _留异名行(行们, 0, 名, []) in
      let 已写 = write_file("matha_term_registry.txt", _拼换行(留们 + [名 + " " + 参数们[1]], 0)) in
      _结果(["已注册扩展命令 " + 名 + " → " + 参数们[1]], 假)

  func _注销命令(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("注销命令: 需要 1 个参数（名字）, 实得 " + str(len(参数们)))
    else
      let 名 = to_lower(参数们[0]) in
      let 行们 = _去尾空行(split(_注册表文本(), "\n")) in
      let 留们 = _留异名行(行们, 0, 名, []) in
      if len(留们) = len(行们) then
        错误("注销命令: 未注册: " + 名)
      else
        let 已写 = write_file("matha_term_registry.txt", _拼换行(留们, 0)) in
        _结果(["已注销扩展命令 " + 名], 假)

  (* 调用扩展：处理器源码 + `处理(["参数", ...])` 拼接 → 执行Matha 进程内执行。
     参数安全嵌入限制：含引号/反斜杠/换行一律显式拒绝（防拼接改写为任意代码）。 *)
  func _安全参(参数们: List, i: Int) -> Bool =
    if i = len(参数们) then 真
    else if find("\"", 参数们[i]) != -1 or find("\\", 参数们[i]) != -1 or find("\n", 参数们[i]) != -1 then 假
    else _安全参(参数们, i + 1)

  func _拼引(参数们: List, i: Int) -> String =
    if i = len(参数们) then ""
    else if i + 1 = len(参数们) then "\"" + 参数们[i] + "\""
    else "\"" + 参数们[i] + "\", " + _拼引(参数们, i + 1)

  func _调用扩展(名: String, 参数们: List) -> Dict =
    let 路径 = dict_get(读注册表(), 名, "") in
    if 路径存在(路径) = 假 then
      错误("扩展命令: 处理器文件不存在: " + 路径)
    else if _安全参(参数们, 0) = 假 then
      错误("扩展命令: 参数不能含引号或反斜杠（安全嵌入限制，显式拒绝）")
    else
      let 调用源 = read_file(路径) + "\n处理([" + _拼引(参数们, 0) + "])" in
      let 出 = 执行Matha(调用源) in
      _结果(_渲染(出, 0), 假)

  (* ---- ⑦c 升级（pkg_manager_v2 真本地检查；阶段 12e） ---- *)

  func _升级行(更新们: List, i: Int) -> List =
    if i = len(更新们) then []
    else
      let u = 更新们[i] in
      [u[0] + ": " + u[1] + " -> " + u[2] + " (" + u[3] + ")"] + _升级行(更新们, i + 1)

  func _过滤包(更新们: List, i: Int, 名: String, 命中们: List) -> List =
    if i = len(更新们) then 命中们
    else if to_lower(更新们[i][0]) = 名 then _过滤包(更新们, i + 1, 名, 命中们 + [更新们[i]])
    else _过滤包(更新们, i + 1, 名, 命中们)

  func _升级(参数们: List) -> Dict =
    if len(参数们) > 1 then
      错误("升级: 至多 1 个参数（包名）, 实得 " + str(len(参数们)))
    else if len(参数们) = 1 and (参数们[0] = "解释器" or to_lower(参数们[0]) = "matha" or to_lower(参数们[0]) = "interpreter") then
      错误("升级 解释器: 显式拒绝——Matha 解释器自举核心不可由终端自我升级（自升级须走宿主安装渠道）")
    else
      let 更新们 = 检查包更新() in
      if len(参数们) = 1 then
        let 命中们 = _过滤包(更新们, 0, to_lower(参数们[0]), []) in
        if 命中们 = [] then
          _结果(["无该包可用更新: " + 参数们[0] + "（本地检查，不下载不安装）"], 假)
        else
          let 已升 = 升级包(命中们[0][0]) in
          _结果([已升[0] + ": " + 已升[1] + " -> " + 已升[2] + " (已真安装)"], 假)
      else if 更新们 = [] then
        _结果(["无可用更新（本地检查，不下载不安装）"], 假)
      else
        _结果(["可用更新（本地检查，不下载不安装）"] + _升级行(更新们, 0), 假)

  (* ---- ⑦d 管道编排（阶段 13a：CMD 式 stdin 注入） ----

     管道载荷 = 左段输出行（显示行语义：左段终端所见即右段所得；透传段输出帧
     合并 stdout/stderr/退出码行——与 CMD 仅管道 stdout 有差异，如实登记）。
     右段消费：内建/扩展/Matha 代码经 输入行()（管道模式耗尽即 EOF，不回落
     交互 stdin）；透传段经 执行命令输入 stdin 注入。段前注入段后清除；段内
     出错时清除步不执行、管道态泄漏至下一条 终端执行——入口每次先清除兜底。
     查找 逐行读 stdin 至 EOF 空串（管道行中的空行与 EOF 不可区分，同 CMD
     stdin 语义，空行终止读取）。 *)

  func _派发段(段: Dict, 原行: String, 管入文本: String) -> Dict =
    let 命令 = to_lower(段["命令"]) in
    let 表 = 命令表() in
    if dict_has(表, 命令) then
      let 处理 = dict_get(表, 命令, null) in
      处理(段["参数"])
    else
      let 注册表 = 读注册表() in
      if dict_has(注册表, 命令) then
        _调用扩展(命令, 段["参数"])
      else
        _透传(原行, 段, 管入文本)

  (* 管入 = null（首段，无管道输入）或 List（管道段：注入行列表缓存，
     透传段另拼接文本作 stdin） *)
  func _执行段(段: Dict, 原行: String, 管入) -> Dict =
    if 管入 = null then _派发段(段, 原行, "")
    else
      let 已注 = 管道输入(管入) in
      let r = _派发段(段, "", _拼换行(管入, 0)) in
      let 已清 = 管道结束() in
      r

  func _执行链(段们: List, i: Int, 行们: List, 退出: Bool, 原行: String) -> (List, Bool) =
    if 退出 or i = len(段们) then (行们, 退出)
    else
      let 管入 = if i = 0 then null else 行们 in
      let r = _执行段(段们[i], 原行, 管入) in
      _执行链(段们, i + 1, r["输出"], r["退出"], 原行)

  func _读管道行(acc: List) -> List =
    let 行 = 输入行() in
    if 行 = "" then acc else _读管道行(acc + [行])

  func _含行(子串: String, i: Int, 行们: List, 命中们: List) -> List =
    if i = len(行们) then 命中们
    else if find(子串, 行们[i]) != -1 then _含行(子串, i + 1, 行们, 命中们 + [行们[i]])
    else _含行(子串, i + 1, 行们, 命中们)

  func _管道查找(参数们: List) -> Dict =
    if len(参数们) != 1 then
      错误("查找: 需要 1 个参数（子串）, 实得 " + str(len(参数们)))
    else
      _结果(_含行(参数们[0], 0, _读管道行([]), []), 假)

  (* 排序：码点序（宿主与 VM 字符串比较语义一致），稳定插入排序 *)
  func _插一行(行: String, 已排: List, i: Int) -> List =
    if i = len(已排) then 已排 + [行]
    else if 已排[i] > 行 then
      list_slice(已排, 0, i) + [行] + list_slice(已排, i, len(已排))
    else _插一行(行, 已排, i + 1)

  func _插排(行们: List, i: Int, 已排: List) -> List =
    if i = len(行们) then 已排
    else _插排(行们, i + 1, _插一行(行们[i], 已排, 0))

  func _管道排序(参数们: List) -> Dict =
    if len(参数们) != 0 then
      错误("排序: 不需要参数, 实得 " + str(len(参数们)))
    else
      _结果(_插排(_读管道行([]), 0, []), 假)

  (* ---- ⑧ 主入口：命令帧 → 执行 ---- *)

  (* ---- ⑧ 重定向落盘（阶段 13b 真化）----
     末段显示行 → 文件：> 截断（write_file 覆盖）/ >> 追加（已有内容读出拼接）。
     每行以 \n 结尾（CMD echo x>f 文件末行带换行语义）；空输出写空文件。
     CMD 式静默：落盘不回显（输出 []）。
     边界（与 CMD 差异，登记）：接管的是末段**显示行**——透传段的 stderr/
     退出码行同样落盘（同管道载荷口径）；退出标志跳过落盘；段内错误不落盘
     （执行链先于写盘求值）。 *)
  func _重定向写(目标: String, 行们: List, 追加: Bool) -> Bool =
    let 正文 = if len(行们) = 0 then "" else _拼换行(行们, 0) + "\n" in
    if 追加 then
      let 已写 = append_file(目标, 正文) in
      真
    else
      let 已写 = write_file(目标, 正文) in
      真

  func 终端执行(帧: Dict, 原行: String) -> Dict =
    let 已清 = 管道结束() in
    let 段们 = [帧] + 帧["管道链"] in
    let (行们, 退出) = _执行链(段们, 0, [], 假, 原行) in
    if 退出 then
      _结果([], 真)
    else if 帧["重定向"] != "" then
      let 已写 = _重定向写(帧["重定向目标"], 行们, 帧["重定向"] = ">>") in
      _结果([], 假)
    else
      _结果(行们, 退出)

  (* 便捷入口：命令行文本 → 词法 → 句法 → 执行 一步到位 *)
  func 终端运行一行(行: String) -> Dict =
    终端执行(终端解析(行), 行)
}
