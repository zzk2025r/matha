(* 资源库：安全与密码学数学
   覆盖：哈希、加密、认证、风险评估、安全协议
   ============================================================ *)

module 安全密码 {

  (* ===== 哈希函数 ===== *)
  func 哈希长度(算法: String) -> Int =
    (算法) =>
    match 算法 {
      | "MD5" => 128
      | "SHA1" => 160
      | "SHA256" => 256
      | "SHA512" => 512
      | _ => 256
    }

  func 哈希熵(哈希长度: Int) -> Float =
    (哈希长度) => 浮点(哈希长度) * log(2)

  func 碰撞攻击复杂度(哈希长度: Int) -> Float =
    (* 生日攻击: 2^(n/2) *)
    (哈希长度) => pow(2.0, 浮点(哈希长度) / 2.0)

  func 暴力破解复杂度(密钥长度: Int) -> Float =
    (* 2^key_length *)
    (密钥长度) => pow(2.0, 浮点(密钥长度))

  (* ===== 对称加密 ===== *)
  func AES密钥长度() -> Int =
    () => 128

  func AES轮数(密钥长度: Int) -> Int =
    (密钥长度) =>
    match 密钥长度 {
      | 128 => 10
      | 192 => 12
      | 256 => 14
      | _ => 10
    }

  func 对称加密安全强度(密钥长度: Int) -> Int =
    (密钥长度) => 密钥长度 / 2  (* 有效安全强度 *)

  (* ===== 非对称加密 ===== *)
  func RSA密钥生成(素数p: Int, 素数q: Int) -> (Int, Int) =
    (* 返回n和φ(n) *)
    (p, q) => (p * q, (p - 1) * (q - 1))

  func RSA加密(明文: Int, e: Int, n: Int) -> Int =
    (明文, e, n) =>
    (明文 >= n) ? -1 : 模幂(明文, e, n)  (* 明文 >= n 视为错误 *)

  func RSA解密(密文: Int, d: Int, n: Int) -> Int =
    (密文, d, n) => 模幂(密文, d, n)

  func 模幂(base: Int, exp: Int, mod_val: Int) -> Int =
    (base, exp, mod_val) => {
    let rec power(b: Int, e: Int, m: Int, result: Int) -> Int =
      (b, e, m, result) =>
        (e == 0) ? result :
        (e % 2 == 0) ? power((b * b) % m, e / 2, m, result) :
        power(b, e - 1, m, (result * b) % m)
    power(base % mod_val, exp, mod_val, 1)
    }

  func RSA安全性(密钥长度: Int) -> String =
    (密钥长度) =>
    match 密钥长度 {
      | 1024 => "不安全"
      | 2048 => "安全"
      | 3072 => "强安全"
      | _ => "未知"
    }

  (* ===== 认证与授权 ===== *)
  (* 键混合摘要：两轮 131 进制滚动散列（mod 1e9+7 / 1e9+9），密钥同时进入内外两轮。
     口径：结构上是「密钥 + 盐 + 消息 → 内摘要 → 外摘要」，可判定密钥与消息的任一
     改动；因 Matha 无位运算原语，未采用 RFC 2104 的 ipad/opad 块填充，散列原语也非
     SHA 族，故不背书 HMAC 互操作性与密码学强度。 *)
  func HMAC哈希(密钥: String, 消息: String) -> String =
    (密钥, 消息) => {
      let 内 = 摘要(密钥 + "[inner]" + 消息 + 密钥, 1000000007)
      str(摘要(密钥 + "[outer]" + str(内), 1000000009))
    }

  func OAuth令牌有效期(创建时间: Int, 过期时间: Int, 当前时间: Int) -> Bool =
    (创建时间, 过期时间, 当前时间) =>
    当前时间 >= 创建时间 and 当前时间 <= 过期时间

  func 多因素认证强度(因素数: Int) -> Int =
    (* 每增加一个因素，安全性指数增长 *)
    (因素数) => 2 ^ 因素数

  (* ===== 安全风险评估 ===== *)
  func 风险值(威胁概率: Float, 影响程度: Float, 脆弱性: Float) -> Float =
    (威胁概率, 影响程度, 脆弱性) =>
    威胁概率 * 影响程度 * 脆弱性

  func 风险矩阵(概率: Int, 影响: Int) -> String =
    (概率, 影响) =>
    match str(概率) + ":" + str(影响) {
      | "1:1" => "低"
      | "1:2" => "中"
      | "2:1" => "中"
      | "2:2" => "高"
      | "2:3" => "高"
      | "3:2" => "高"
      | _ => "严重"
    }

  func 资产估值(重置成本: Float, 贬值率: Float, 年限: Int) -> Float =
    (重置成本, 贬值率, 年限) =>
    重置成本 * (1 - 贬值率) ^ 年限

  func 年损失预期(单次损失: Float, 年发生率: Float) -> Float =
    (单次损失, 年发生率) => 单次损失 * 年发生率

  (* ===== 网络安全 ===== *)
  func DDOS检测(每秒请求数: Int, 正常阈值: Int) -> Bool =
    (每秒请求数, 正常阈值) => 每秒请求数 > 正常阈值 * 3

  func 端口扫描检测(开放端口数: Int, 正常数: Int) -> Bool =
    (开放端口数, 正常数) => 开放端口数 > 正常数 + 5

  func SSL证书有效期(创建时间: Int, 过期时间: Int, 当前时间: Int) -> Bool =
    (创建时间, 过期时间, 当前时间) =>
    当前时间 >= 创建时间 and 当前时间 <= 过期时间

  (* ===== 密码强度 ===== *)
  (* 字符扫描原语：按 ASCII 码区间判定字符类（ord + 单字符切片，三面同源） *)
  func 码在区间(text: String, 低: Int, 高: Int) -> Bool =
    (text, 低, 高) => {
    let rec 走(i: Int) -> Bool =
      (i) => if i >= len(text) then 假 else {
        let c = ord(text[i:i+1])
        if c >= 低 and c <= 高 then 真 else 走(i + 1)
      }
    走(0)
  }

  (* 存在既非字母数字也非空格的字符（特殊字符类 = 可打印杂类） *)
  func 有杂类字符(text: String) -> Bool =
    (text) => {
    let rec 走(i: Int) -> Bool =
      (i) => if i >= len(text) then 假 else {
        let c = ord(text[i:i+1])
        let 是字母数字 = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        if 是字母数字 or c = 32 then 走(i + 1) else 真
      }
    走(0)
  }

  (* 滚动散列：acc = (acc * 131 + ord(c)) mod 模数，种子 7；纯整数路径，三面同值 *)
  func 摘要(串: String, 模数: Int) -> Int =
    (串, 模数) => {
    let rec 走(i: Int, acc: Int) -> Int =
      (i, acc) => if i >= len(串) then acc
      else 走(i + 1, (acc * 131 + ord(串[i:i+1])) % 模数)
    走(0, 7)
  }

  func 密码强度评分(密码: String) -> Int =
    (* 基于长度、字符种类 *)
    (密码) => {
      let 长度 = len(密码)
      let hasUpper = 密码包含大写字母(密码)
      let hasLower = 密码包含小写字母(密码)
      let hasDigit = 密码包含数字(密码)
      let hasSpecial = 密码包含特殊字符(密码)
      长度 * 4 + (hasUpper ? 2 : 0) + (hasLower ? 2 : 0) + (hasDigit ? 2 : 0) + (hasSpecial ? 3 : 0)
    }

  func 密码包含大写字母(text: String) -> Bool =
    (text) => 码在区间(text, 65, 90)

  func 密码包含小写字母(text: String) -> Bool =
    (text) => 码在区间(text, 97, 122)

  func 密码包含数字(text: String) -> Bool =
    (text) => 码在区间(text, 48, 57)

  func 密码包含特殊字符(text: String) -> Bool =
    (text) => 有杂类字符(text)

  func 浮点(n: Int) -> Float = (n) => n * 1.0
}
