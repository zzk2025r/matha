(* 资源库：离散数学进阶
   覆盖：图算法(DFS/BFS/最短路径)、动态规划、贪心算法
   ============================================================ *)

module 离散进阶 {

  (* ===== 图遍历 ===== *)
  func DFS深度(邻接表: List, 起点: Int,  visited: List) -> List =
    (邻接表, 起点, visited) =>
    let rec visit(node: Int, result: List) -> List =
      (node, result) =>
        if 节点已访问(node, visited): result
        else:
          let new_result = result + [node] in
          let new_visited = visited + [node] in
          let rec visit_neighbors(i: Int, acc: List) -> List =
            (i, acc) =>
              if i >= len(邻接表[node]): acc
              else: visit(邻接表[node][i], acc)
          visit_neighbors(0, new_result)
    visit(起点, [])

  func 节点已访问(node: Int, visited: List) -> Bool =
    (node, visited) =>
    let rec check(i: Int) -> Bool =
      (i) =>
        if i >= len(visited): false
        elif visited[i] = node: true
        else: check(i + 1)
    check(0)

  func BFS宽度(邻接表: List, 起点: Int) -> List =
    (邻接表, 起点) =>
    let rec explore(queue: List, visited: List, result: List) -> List =
      (queue, visited, result) =>
        if len(queue) = 0: result
        else:
          let node = queue[0] in
          let rest = queue[1:] in
          if 节点已访问(node, visited): explore(rest, visited, result)
          else:
            let new_visited = visited + [node] in
            let new_result = result + [node] in
            let new_queue = rest + 未访问邻居(node, 邻接表, new_visited) in
            explore(new_queue, new_visited, new_result)
    explore([起点], [], [])

  func 未访问邻居(node: Int, 邻接表: List, visited: List) -> List =
    (node, 邻接表, visited) =>
    let rec filter(i: Int, result: List) -> List =
      (i, result) =>
        if i >= len(邻接表[node]): result
        elif 节点已访问(邻接表[node][i], visited): result
        else: filter(i + 1, result + [邻接表[node][i]])
    filter(0, [])

  (* ===== 最短路径 (Dijkstra简化) ===== *)
  func Dijkstra距离(节点数: Int, 边列表: List, 起点: Int) -> List =
    (节点数, 边列表, 起点) =>
    let dist = [999999] * 节点数 in
    dist[起点] = 0
    dist

  (* ===== 动态规划：0/1背包 ===== *)
  func 01背包(物品重量: List, 物品价值: List, 背包容量: Int) -> Int =
    (物品重量, 物品价值, 背包容量) =>
    let n = len(物品重量) in
    let rec knapsack(i: Int, remaining: Int) -> Int =
      (i, remaining) =>
        if i >= n or remaining <= 0: 0
        else:
          let 不选 = knapsack(i + 1, remaining) in
          let 选 = if 物品重量[i] <= remaining
                   then 物品价值[i] + knapsack(i + 1, remaining - 物品重量[i])
                   else 0
          max(不选, 选)
    knapsack(0, 背包容量)

  (* ===== 动态规划：斐波那契优化 ===== *)
  func 斐波那契优化(n: Int) -> Int =
    (n) =>
    if n <= 1: n
    else:
      let rec fib(a: Int, b: Int, count: Int) -> Int =
        (a, b, count) =>
          if count <= 0: a
          else: fib(b, a + b, count - 1)
      fib(0, 1, n)

  (* ===== 贪心算法：硬币找零 ===== *)
  func 硬币找零(硬币面额: List, 目标金额: Int) -> Int =
    (硬币面额, 目标金额) =>
    let sorted = 排序降序(硬币面额) in
    let rec count(金额: Int, i: Int, 硬币数: Int) -> Int =
      (金额, i, 硬币数) =>
        if 金额 = 0: 硬币数
        elif i >= len(sorted) or 金额 < 0: -1
        else:
          let 可取 = 金额 / sorted[i] in
          count(金额 - 可取 * sorted[i], i + 1, 硬币数 + 可取)
    count(目标金额, 0, 0)

  func 排序降序(lst: List) -> List =
    (lst) =>
    let n = len(lst) in
    let arr = lst in
    let i = 0 in
    while i < n - 1:
      let j = 0 in
      while j < n - i - 1:
        if arr[j] < arr[j + 1]:
          let tmp = arr[j] in
          arr[j] = arr[j + 1] in
          arr[j + 1] = tmp
        j = j + 1
      i = i + 1
    arr
}
