(* 资源库：遗传学
   覆盖：孟德尔遗传、基因型概率、连锁与交换
   ============================================================ *)

module 遗传学 {

  func 显性表现型概率() -> Float = () => 0.75
  func 隐性表现型概率() -> Float = () => 0.25
  func F2分离比() -> String = () => "3:1"
  func F1杂合子概率() -> Float = () => 1.0

  func 独立分配概率(p1: Float, p2: Float) -> Float =
    (p1, p2) => p1 * p2

  func 连锁交换率(重组型数: Int, 总数: Int) -> Float =
    (重组型数, 总数) =>
    (总数 = 0) ? 0 : 重组型数 / 总数

  func 图距(交换率: Float) -> Float =
    (交换率) => 交换率 * 100

  func 哈迪温伯格频率(p: Float) -> Float =
    (p) => p * p

  func 人类染色体数() -> Int = () => 46
  func 人类配子染色体数() -> Int = () => 23
  func DNA碱基数() -> Int = () => 3000000000
}
