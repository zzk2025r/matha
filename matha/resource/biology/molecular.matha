(* 资源库：分子生物学
   覆盖：DNA/RNA、蛋白质合成、PCR、酶动力学
   ============================================================ *)

module 分子生物 {

  func DNA双螺旋长度(碱基数: Int) -> Float =
    (碱基数) => 碱基数 * 0.34  (* 纳米 *)

  func 碱基数从长度(长度纳米: Float) -> Int =
    (长度纳米) => int(长度纳米 / 0.34)

  func 碱基互补(碱基: String) -> String =
    (碱基) =>
    case 碱基 of
      "A" -> "T"
      "T" -> "A"
      "G" -> "C"
      "C" -> "G"
      "U" -> "A"
      _ -> "N"

  func 蛋白质质量道尔顿(氨基酸数: Int) -> Float =
    (氨基酸数) => 氨基酸数 * 110.0

  func 氨基酸数量(蛋白质质量道尔顿: Float) -> Int =
    (蛋白质质量道尔顿) => int(蛋白质质量道尔顿 / 110)

  func PCR产物数量(初始数: Int, 循环数: Int) -> Int =
    (初始数, 循环数) => 初始数 * 2 ^ 循环数

  func 酶反应速率(Vmax: Float, S: Float, Km: Float) -> Float =
    (Vmax, S, Km) =>
    (Km = 0) ? Vmax : Vmax * S / (Km + S)
}
