(* 资源库：电磁学
   覆盖：库仑定律、电路、磁场、电磁感应、交流电路
   ============================================================ *)

module 电磁学 {

  func 库仑力(q1: Float, q2: Float, r: Float) -> Float =
    (q1, q2, r) => 8.988e9 * q1 * q2 / (r * r)

  func 电场强度(Q: Float, r: Float) -> Float =
    (Q, r) => 8.988e9 * Q / (r * r)

  func 欧姆定律(V: Float, R: Float) -> Float = (V, R) => V / R
  func 电功率(V: Float, I: Float) -> Float = (V, I) => V * I
  func 电功(W: Float, V: Float, I: Float, t: Float) -> Float =
    (W, V, I, t) => V * I * t

  func 串联电阻(R1: Float, R2: Float) -> Float = (R1, R2) => R1 + R2
  func 并联电阻(R1: Float, R2: Float) -> Float =
    (R1, R2) => R1 * R2 / (R1 + R2)

  func 电容串联(C1: Float, C2: Float) -> Float =
    (C1, C2) => C1 * C2 / (C1 + C2)
  func 电容并联(C1: Float, C2: Float) -> Float = (C1, C2) => C1 + C2

  func 感抗(ω: Float, L: Float) -> Float = (ω, L) => ω * L
  func 容抗(ω: Float, C: Float) -> Float = (ω, C) => 1 / (ω * C)
  func 阻抗(R: Float, XL: Float, XC: Float) -> Float =
    (R, XL, XC) => 开方(R*R + (XL - XC)*(XL - XC))

  func 洛伦兹力(q: Float, v: Float, B: Float) -> Float =
    (q, v, B) => q * v * B

  func 法拉第定律(dPhi: Float, dt: Float, N: Int) -> Float =
    (dPhi, dt, N) => N * dPhi / dt

  func 自感电动势(L: Float, dI: Float, dt: Float) -> Float =
    (L, dI, dt) => L * dI / dt

  func 谐振频率(L: Float, C: Float) -> Float =
    (L, C) => 1 / (2 * 3.14159 * 开方(L * C))
}
