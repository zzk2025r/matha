(* 资源库：量子力学
   覆盖：波粒二象性、不确定性原理、势阱、氢原子
   ============================================================ *)

module 量子 {

  func 德布罗意波长(p: Float) -> Float = (p) => 6.626e-34 / p
  func 海森堡不确定度(dx: Float) -> Float =
    (dx) => 1.055e-34 / (2 * dx)

  func 玻尔能级(n: Int) -> Float = (n) => -13.6 / (n * n)
  func 玻尔半径() -> Float = () => 5.292e-11

  func 光电效应遏止电压(ν: Float, W: Float) -> Float =
    (ν, W) => (6.626e-34 * ν - W) / 1.602e-19

  func 康普顿散射波长偏移(λ_c: Float, θ: Float) -> Float =
    (λ_c, θ) => λ_c * (1 - cos(θ))

  func 薛定谔势阱能级(n: Int, m: Float, L: Float) -> Float =
    (n, m, L) => n * n * 6.626e-34 * 6.626e-34 / (8 * m * L * L)

  func 氢原子光谱波长(n1: Int, n2: Int) -> Float =
    (n1, n2) =>
    1 / (1.097e7 * (1/(n1*n1) - 1/(n2*n2)))
}
