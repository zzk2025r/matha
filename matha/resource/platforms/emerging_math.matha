(* 资源库：新兴平台数学
   覆盖：区块链基础、物联网、云计算、边缘计算
   ============================================================
   口径（阶段 41 真化批）：
   1. 分母为 0 / 入参无物理意义 → None，不再伪造 999 / 999.0 哨兵值或 0 读数
      （旧体 物联网延迟、设备电池寿命、自动伸缩响应时间、故障恢复时间 用 999(.0)，
       覆盖率/利用率/节省率 用 0——0 与「真实算出 0%」不可区分）。
   2. 近似模型必须写明所建模量与不做的事：共识机制效率 三项读数不是同一量纲，
       旧注释只有「简化」二字。
   ============================================================ *)

module 新兴平台 {

  (* ===== 区块链基础 ===== *)
  (* 区块高度差：绝对差值。旧体用 绝对值——该名为标准库函数，本模块无
     use 标准库，故 hi/VM/链面 皆「未定义变量」，函数从不可调用；改 abs（三面同名内建）。 *)
  func 区块高度差(高1: Int, 高2: Int) -> Int =
    (高1, 高2) => abs(高1 - 高2)

  (* 哈希前导零数：从首字符起连续 '0' 的个数（十六进制哈希的难度度量）。 *)
  func 哈希前导零数(哈希: String) -> Int =
    (哈希) => {
    let rec 走(i: Int) -> Int =
      (i) => if i >= len(哈希) then i else {
      if ord(哈希[i:i+1]) = 48 then 走(i + 1) else i
    }
    走(0)
    }

  (* 定长串数值序：等长十六进制串的数值序 ≡ 逐字符码点字典序。 *)
  func 定长串不超过(实际: String, 目标: String) -> Bool =
    (实际, 目标) => {
    let rec 走(i: Int) -> Bool =
      (i) => if i >= len(实际) then 真 else {
      let a = ord(实际[i:i+1])
      let b = ord(目标[i:i+1])
      if a < b then 真 else if a > b then 假 else 走(i + 1)
    }
    走(0)
    }

  (* 工作量证明难度：PoW 合法判据 = 实际哈希数值 <= 目标阈值。
     口径：两串为等长十六进制哈希，数值序即字典序；长度不等按「阈值位数不同，不可比」
     如实拒绝。旧桩只比字符串长度（len(实际) >= len(目标)），任意等长哈希恒返真，故退役。 *)
  func 工作量证明难度(目标哈希: String, 实际哈希: String) -> Bool =
    (目标哈希, 实际哈希) =>
    if len(实际哈希) = len(目标哈希) then 定长串不超过(实际哈希, 目标哈希) else 假

  func 区块链不可篡改性(区块数: Int, 哈希链长度: Int) -> Bool =
    (* 口径注：结构完整性判据——哈希链长度须覆盖区块数（链短于链上区块即缺环）；
       这不是密码学不可篡改性证明（那需逐块重算哈希并比对难度）。 *)
    (区块数, 哈希链长度) => 区块数 <= 哈希链长度

  (* 共识机制效率（口径注：三项读数不是同一量纲，各自含义如下）
     - PoW：1/N，「单节点出块权重」近似——随节点数增多，单节点命中率下降；
     - PoS：0.9，固定近似常数——本模型不随节点数变化（ Stake 分布未知）；
     - PBFT：(N−1)/N，「通信轮次参与比」近似——N=1 时为 0；
     - 其它算法：0.5 中性值。
     节点数 ≤ 0 无意义 → None（旧体在 节点数 = 0 时对 PoW/PBFT 抛除零）。 *)
  func 共识机制效率(节点数: Int, 共识算法: String) -> Float =
    (节点数, 共识算法) =>
    if 节点数 <= 0 then None else 效率按算法(节点数, 共识算法)

  func 效率按算法(节点数: Int, 共识算法: String) -> Float =
    (节点数, 共识算法) =>
    match 共识算法 {
      | "PoW" => 1.0 / 节点数
      | "PoS" => 0.9
      | "PBFT" => (节点数 - 1) / 节点数
      | _ => 0.5

    }
  func 智能合约Gas费用(计算步骤: Int, 单位Gas: Float) -> Float =
    (计算步骤, 单位Gas) => 计算步骤 * 单位Gas

  (* ===== 物联网 ===== *)
  func 传感器网络覆盖率(传感器数: Int, 监测面积: Float, 单传感器覆盖: Float) -> Float =
    (* 口径注：面积覆盖比（上限 1.0，重叠区域不计）；监测面积 ≤ 0 时无定义 → None。 *)
    (传感器数, 监测面积, 单传感器覆盖) =>
    if 监测面积 <= 0 then None else min([1.0, 传感器数 * 单传感器覆盖 / 监测面积])

  func 物联网延迟(设备数: Int, 网关容量: Int, 数据包大小: Int) -> Float =
    (* 口径注：串行化排队近似 设备数·包大小 / 网关容量；容量 ≤ 0 时无定义 → None
       （旧体返回 999.0 哨兵值）。 *)
    (设备数, 网关容量, 数据包大小) =>
    if 网关容量 <= 0 then None else 设备数 * 数据包大小 / 网关容量

  func 边缘计算节省(云端延迟: Float, 边缘延迟: Float) -> Float =
    (* 口径注：节省比 = 1 − 边缘/云端；云端延迟 ≤ 0 时无定义 → None。 *)
    (云端延迟, 边缘延迟) =>
    if 云端延迟 <= 0 then None else 1 - 边缘延迟 / 云端延迟

  func 设备电池寿命(功耗: Float, 电池容量: Float, 工作时间: Float) -> Float =
    (* 口径注：寿命 = 容量 / 功耗；功耗 ≤ 0 时无定义 → None（旧体返回 999.0）。
       工作时间 参数不参与计算（旧体即如此，保留入参仅为协议兼容）。 *)
    (功耗, 电池容量, 工作时间) =>
    if 功耗 <= 0 then None else 电池容量 / 功耗

  (* ===== 云计算 ===== *)
  func 云成本估算(实例数: Int, 单价: Float, 小时数: Int) -> Float =
    (实例数, 单价, 小时数) => 实例数 * 单价 * 小时数

  func 云资源利用率(已用资源: Int, 总资源: Int) -> Float =
    (* 口径注：总资源为 0 时无定义 → None（旧体返回 0，与「完全空闲」的真实读数 0 混淆）。 *)
    (已用资源, 总资源) =>
    if 总资源 = 0 then None else 已用资源 / 总资源

  func 自动伸缩响应时间(请求增加量: Int, 扩容速率: Int) -> Int =
    (* 口径注：向上取整除法 ⌈增加量/速率⌉（单位=扩容周期数）；
       速率 ≤ 0 时无定义 → None（旧体返回 999 哨兵值）。 *)
    (请求增加量, 扩容速率) =>
    if 扩容速率 <= 0 then None else (请求增加量 + 扩容速率 - 1) / 扩容速率

  func SLA可用性(年停机时间: Int) -> Float =
    (* 口径注：年停机时间单位为分钟，按 365×24×60 = 525600 分钟定长年折算，
       不计闰年；返回百分比（如 1 分钟停机 → 99.9998…%）。 *)
    (年停机时间) =>
    (1 - 年停机时间 / (365 * 24 * 60)) * 100

  func 云存储成本(数据量: Float, 存储类型: String, 时间: Int) -> Float =
    (数据量, 存储类型, 时间) =>
    match 存储类型 {
      | "标准" => 数据量 * 0.12 * 时间
      | "低频" => 数据量 * 0.0125 * 时间
      | "归档" => 数据量 * 0.00099 * 时间
      | _ => 数据量 * 0.023 * 时间

    }
  (* ===== 边缘计算 ===== *)
  func 边缘节点覆盖(节点位置: List, 区域中心: Float, 覆盖半径: Float) -> Bool =
    (* 一维覆盖判定：存在节点使 |位置 - 区域中心| <= 覆盖半径。
       口径：abs 而非 开方(x^2)（后者对边界浮点有舍入抖动，且 绝对值/开方 皆标准库名
       本模块不可达）；空列表如实返 假。
       旧体首臂写作 `if if i >= len(...) then 假 else None`——外层恒落下一分支，
       遍历到末尾后读 节点位置[i] 越界报错，故一并修正。 *)
    (节点位置, 区域中心, 覆盖半径) => {
    let rec check(i: Int) -> Bool =
    (i) =>
        if i >= len(节点位置) then 假
        else if abs(节点位置[i] - 区域中心) <= 覆盖半径 then 真
        else check(i + 1)
    check(0)
    }

  func 边缘缓存命中率(缓存大小: Int, 请求数: Int, 命中率: Float) -> Float =
    (* 口径注：透传投影——命中率 由外部统计得到，缓存大小/请求数 不参与推算
       （本函数不建缓存置换模型）。需按容量估算请自行实现 LRU 命中曲线。 *)
    (缓存大小, 请求数, 命中率) => 命中率

  (* ===== 分布式系统 ===== *)
  func CAP定理权衡(一致性: Bool, 可用性: Bool, 分区容忍: Bool) -> String =
    (一致性, 可用性, 分区容忍) =>
    if 分区容忍 then
      if 一致性 then "CP"
      else "AP"
    else "CA"

  func 分布式一致性强度(副本数: Int, 同步率: Float) -> Float =
    (副本数, 同步率) => 同步率 ^ 副本数

  func 故障恢复时间(备份间隔: Int, 恢复速度: Float) -> Float =
    (* 口径注：恢复时间 = 备份间隔 / 恢复速度；速度 ≤ 0 时无定义 → None
       （旧体返回 999.0 哨兵值）。 *)
    (备份间隔, 恢复速度) =>
    if 恢复速度 <= 0 then None else 备份间隔 / 恢复速度
}
