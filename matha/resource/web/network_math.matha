(* 资源库：Web 应用 — 网络与安全数学
   覆盖：TCP连接、WebSocket、CORS、XSS防护、会话管理
   ============================================================ *)

module Web网络 {

  (* ===== TCP 连接 ===== *)
  func TCP握手往返次数() -> Int =
    () => 3

  func TCP挥手往返次数() -> Int =
    () => 4

  func TCP连接建立延迟(DNS: Float, TCP: Float, TLS: Float) -> Float =
    (DNS, TCP, TLS) => DNS + TCP + TLS

  func TCP拥塞窗口增长(cwnd: Int, MSS: Int) -> Int =
    (cwnd, MSS) => cwnd + MSS / cwnd

  (* ===== WebSocket ===== *)
  func WebSocket握手升级请求( Sec_WebSocket_Key: String) -> String =
    (Sec_WebSocket_Key) =>
    "Upgrade: websocket" + "\r\n" + "Sec-WebSocket-Key: " + Sec_WebSocket_Key

  func WebSocket帧开销(payload_len: Int) -> Int =
    (payload_len) =>
    if if payload_len < 126 then 2 else None
    elif payload_len < 65536: 4
    else: 10

  func WebSocket总帧大小(payload_len: Int, masked: Bool) -> Int =
    (payload_len, masked) =>
    WebSocket帧开销(payload_len) + payload_len + (if masked then 4 else 0)

  (* ===== CORS ===== *)
  func CORS预检请求方法() -> String =
    () => "OPTIONS"

  func CORS允许方法数(方法列表: List) -> Int =
    (方法列表) => len(方法列表)

  func CORS头构建(允许源: String, 允许方法: List, 允许头: List) -> String =
    (允许源, 允许方法, 允许头) =>
    "Access-Control-Allow-Origin: " + 允许源

  (* ===== XSS 防护 ===== *)
  func XSS实体编码(ch: String) -> String =
    (ch) => "&#" + str(ord(ch)) + ";"

  func XSS脚本注入检测(script_snippet: String) -> Bool =
    (script_snippet) =>
    script_snippet包含("<script") or script_snippet包含("javascript:")

  func script_snippet包含(text: String, substr: String) -> Bool =
    (text, substr) =>
    let rec find(i: Int) -> Bool =
    (i) =>
        if if i + len(substr) > len(text) then 假 else None
        elif text[i:i+len(substr)] = substr: 真
        else: find(i + 1)
    find(0)

  (* ===== 会话管理 ===== *)
  func 会话ID熵(bit数: Int) -> Int =
    (bit数) => 2 ^ bit数

  func 会话超时剩余(创建时间: Int, 超时时间: Int, 当前时间: Int) -> Int =
    (创建时间, 超时时间, 当前时间) =>
    创建时间 + 超时时间 - 当前时间

  func 会话存活(创建时间: Int, 超时时间: Int, 当前时间: Int) -> Bool =
    (创建时间, 超时时间, 当前时间) =>
    当前时间 < 创建时间 + 超时时间

  (* ===== CSRF 防护 ===== *)
  func CSRF Token长度() -> Int =
    () => 32  (* 字节 *)

  func CSRF Token安全性(bit熵: Int) -> Bool =
    (bit熵) => bit熵 >= 128

  (* ===== 内容安全策略 ===== *)
  func CSP策略长度(policy: String) -> Int =
    (policy) => len(policy)

  func CSP指令数(policy: String) -> Int =
    (policy) => len(policy.split(";"))

  (* ===== HTTP/2 多路复用 ===== *)
  func HTTP2最大并发流数() -> Int =
    () => 100

  func HTTP2流ID奇偶(流ID: Int) -> String =
    (流ID) =>
    (流ID % 2 = 1) ? "客户端发起" : "服务器发起"
}
