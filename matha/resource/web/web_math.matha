(* 资源库：Web 应用数学
   覆盖：HTTP状态码、URI编码、分页、速率限制、JWT验证
   ============================================================ *)

module Web数学 {

  (* ===== HTTP 状态码 ===== *)
  func HTTP状态名称(代码: Int) -> String =
    (代码) =>
    match 代码 {
      | 200 => "OK"
      | 201 => "Created"
      | 204 => "No Content"
      | 301 => "Moved Permanently"
      | 302 => "Found"
      | 304 => "Not Modified"
      | 400 => "Bad Request"
      | 401 => "Unauthorized"
      | 403 => "Forbidden"
      | 404 => "Not Found"
      | 405 => "Method Not Allowed"
      | 429 => "Too Many Requests"
      | 500 => "Internal Server Error"
      | 502 => "Bad Gateway"
      | 503 => "Service Unavailable"
      | _ => "Unknown"

    }
  func HTTP是成功(代码: Int) -> Bool =
    (代码) => 代码 >= 200 and 代码 < 300

  func HTTP是重定向(代码: Int) -> Bool =
    (代码) => 代码 >= 300 and 代码 < 400

  func HTTP是客户端错误(代码: Int) -> Bool =
    (代码) => 代码 >= 400 and 代码 < 500

  func HTTP是服务器错误(代码: Int) -> Bool =
    (代码) => 代码 >= 500 and 代码 < 600

  (* ===== URI 编码 ===== *)
  func URI编码长度(text: String) -> Int =
    (text) => len(text) * 3

  func URI解码后长度(encoded: String) -> Int =
    (encoded) => len(encoded) / 3

  (* URI 单字符百分号转义（RFC 3986 §2.1 + UTF-8 编码）：Matha 面无位运算，
     移位/掩码以整除、取模等价实现——
       码点 < 128        → 1 字节 cp
       码点 < 2048       → 192 + cp/64, 128 + cp%64
       码点 < 65536      → 224 + cp/4096, 128 + (cp/64)%64, 128 + cp%64
       其余（<= 0x10FFFF）→ 240 + cp/262144, 128 + (cp/4096)%64, 128 + (cp/64)%64, 128 + cp%64
     旧体 "%" + hex(ord(ch[0])) 恒单字节输出（非 ASCII 即非法），且 hex 用真除法
     得浮点下标（chars[2.0]）——任意输入皆崩，故两处同修。
     注：跨面无一致的抛错原语（错误/assert 三面不不齐），故本函数取全定义形态。 *)
  func URI编码字符(ch: String) -> String =
    (ch) => {
    let 码 = ord(ch[0])
    if 码 < 128 then "%" + hex(码)
    else if 码 < 2048 then "%" + hex(192 + 码 // 64) + "%" + hex(128 + 码 % 64)
    else if 码 < 65536 then "%" + hex(224 + 码 // 4096) + "%" + hex(128 + (码 // 64) % 64) + "%" + hex(128 + 码 % 64)
    else "%" + hex(240 + 码 // 262144) + "%" + hex(128 + (码 // 4096) % 64) + "%" + hex(128 + (码 // 64) % 64) + "%" + hex(128 + 码 % 64)
    }

  (* 双十六进制位：整除取高位、取模取低位（旧体 "/" 真除法产浮点下标）。 *)
  func hex(n: Int) -> String =
    (n) =>
    let chars = "0123456789ABCDEF" in
    str(chars[n // 16]) + str(chars[n % 16])

  (* ord 走宿主/VM/自举链同名内建（真码点值）——旧本地桩恒返 0 会把
     URI编码字符 静默降级为 "%00"，故桩退役、不再自定义同名函数。 *)

  (* ===== 分页计算 ===== *)
  func 总页数(总数: Int, 每页: Int) -> Int =
    (总数, 每页) => (总数 + 每页 - 1) / 每页

  func 页内起始索引(页码: Int, 每页: Int) -> Int =
    (页码, 每页) => (页码 - 1) * 每页

  func 页内结束索引(页码: Int, 每页: Int, 总数: Int) -> Int =
    (页码, 每页, 总数) =>
    min([页码 * 每页, 总数])

  (* 分页窗口：当前页 ±2，左右各截断到 [1, 总页数]，返回 [start..end]。
     旧形 `if if i > end_ then result else None` 外层测的是内层 if 表达式的「值」而非条件——
     总页数 = 0 时 result 恒为空列表（假值），守卫永不命中、递归无终止；
     `let … in` 链紧跟语句形 let rec 在链面丢 rec 名——两处一并改为语句形 let + then 形守卫。 *)
  func 分页导航页码(当前页: Int, 总页数: Int) -> List =
    (当前页, 总页数) => {
    let start = max([1, 当前页 - 2])
    let end_ = min([总页数, 当前页 + 2])
    let rec pages(i: Int, result: List) -> List =
    (i, result) =>
        if i > end_ then result
        else pages(i + 1, result + [i])
    pages(start, [])
    }

  (* ===== 速率限制 ===== *)
  (* 令牌桶剩余 = 容量 − 已用 + 期间回填，双向截断到 [0, 容量]。
     旧式 `min(容量, 已用 − 新增)` 把回填量当成消耗（符号反了），且以「已用」为基数
     随时间递减，桶会在空闲期归零——与令牌桶语义相反，故真化。 *)
  func 令牌桶剩余(容量: Int, 填充速率: Float, 已用: Int, 上次时间: Float, 当前时间: Float) -> Int =
    (容量, 填充速率, 已用, 上次时间, 当前时间) => {
    let elapsed = 当前时间 - 上次时间
    let 新增 = floor(填充速率 * elapsed)
    max([0, min([容量, 容量 - 已用 + 新增])])
    }

  (* 窗口内请求计数：统计 当前时间 − 时间戳 ≤ 窗口大小 的条目。
     旧形 `if if i >= len then acc else None` 外层测值不测条件——acc = 0（假值）时
     守卫永不命中，递归越过末尾读 请求时间戳[len] 而非返回 0。 *)
  func 滑动窗口计数(请求时间戳: List, 窗口大小: Float, 当前时间: Float) -> Int =
    (请求时间戳, 窗口大小, 当前时间) => {
    let rec count(i: Int, acc: Int) -> Int =
    (i, acc) =>
        if i >= len(请求时间戳) then acc
        else if 当前时间 - 请求时间戳[i] <= 窗口大小 then count(i + 1, acc + 1)
        else count(i + 1, acc)
    count(0, 0)
    }

  (* ===== JWT 相关 ===== *)
  func JWT头部长度(header_json: String) -> Int =
    (header_json) => len(header_json)

  func JWT载荷长度(payload_json: String) -> Int =
    (payload_json) => len(payload_json)

  func JWT总长度(header: String, payload: String, signature: String) -> Int =
    (header, payload, signature) =>
    len(header) + len(payload) + len(signature) + 2  (* 两个点号 *)

  func JWT过期检查(exp: Int, now: Int) -> Bool =
    (exp, now) => exp > now

  (* ===== CORS ===== *)
  (* 允许列表逐位比对，命中或通配 "*" 为真，扫尽为假。
     旧形 `if if i >= len then 假 else None` 外层测值：假 恒为假值，
     越界守卫永不命中 → 递归越过末尾读 允许列表[i]。 *)
  func CORS允许源(请求源: String, 允许列表: List) -> Bool =
    (请求源, 允许列表) => {
    let rec check(i: Int) -> Bool =
    (i) =>
        if i >= len(允许列表) then 假
        else if 允许列表[i] = 请求源 or 允许列表[i] = "*" then 真
        else check(i + 1)
    check(0)
    }

  (* ===== 缓存 ===== *)
  func 缓存有效(最后修改时间: Int, 缓存时间: Int, 当前时间: Int) -> Bool =
    (最后修改时间, 缓存时间, 当前时间) =>
    当前时间 - 最后修改时间 < 缓存时间

  (* 旧体引用未定义的英文 `method`（三面皆「未定义变量」），改为形参 方法。 *)
  func 缓存键(方法: String, URL: String) -> String =
    (方法, URL) => 方法 + ":" + URL

  (* ===== 文件大小估算 ===== *)
  func HTML文件大小(元素数: Int, 平均标签长度: Int) -> Int =
    (元素数, 平均标签长度) => 元素数 * (平均标签长度 + 10)  (* 标签+属性+空格 *)

  func CSS文件大小(规则数: Int, 平均规则长度: Int) -> Int =
    (规则数, 平均规则长度) => 规则数 * (平均规则长度 + 5)

  func JS文件大小(函数数: Int, 平均函数长度: Int) -> Int =
    (函数数, 平均函数长度) => 函数数 * (平均函数长度 + 20)
}
