(* 资源库：工业与嵌入式系统数学
   覆盖：自动控制、传感器、电机控制、通信协议、PLC逻辑
   ============================================================
   口径（阶段 41 真化批）：
   - 无定义比值（分母为 0）一律诚实返回 None，不再伪造 0 读数
   - 自举链注册内建无 atan2/asin/exp，角度一律走 反正切（tan 二分求根）
   - 整除口径（波特率、时钟、内存对齐）用 //，与 -> Int 注解一致
   - CRC8 = 逐位移异或（init 0x00、不反射、无异或输出），位运算用 // % 算术模拟
   ============================================================ *)

module 工业嵌入式 {

  (* ===== 自动控制 ===== *)
  (* 传递函数极点 = 分母多项式的实根；系数按降幂排列（[1, 3, 2] → s² + 3s + 2）。
     分子系数不参与极点计算（其根为零点，另有口径）。
     限制：仅一阶/二阶系统给出实极点——判别式 < 0（共轭复极点）返回 []，
     三阶及以上不实算，诚实返回 None。 *)
  func 传递函数极点(分子系数: List, 分母系数: List) -> List =
    (分子系数, 分母系数) => {
    let 系数 = 去前零(分母系数)
    let 阶 = len(系数) - 1
    let 极点 = if 阶 < 1 then []
               else if 阶 = 1 then [(0 - 系数[1]) / 系数[0]]
               else if 阶 = 2 then 二阶极点(系数[0], 系数[1], 系数[2])
               else None
    极点
    }

  func 二阶极点(a, b, c) -> List =
    (a, b, c) => {
    let 判别 = b * b - 4 * a * c
    let 根 = (0 - b) / (2 * a)
    let 极点 = if 判别 < 0 then []
               else if 判别 = 0 then [根]
               else 实根对(根, 判别, a)
    极点
    }

  func 实根对(根, 判别, a) -> List =
    (根, 判别, a) => {
    let 偏 = sqrt(判别) / (2 * a)
    let 对 = [根 - 偏, 根 + 偏]
    对
    }

  func 去前零(系数: List) -> List =
    (系数) => 去零查(系数, 0)

  func 去零查(系数: List, i: Int) -> List =
    (系数, i) =>
      if i >= len(系数) then [] else 去零步(系数, i)

  func 去零步(系数: List, i: Int) -> List =
    (系数, i) => 系数[i] = 0 ? 去零查(系数, i + 1) : 尾部(系数, i)

  func 尾部(系数: List, i: Int) -> List =
    (系数, i) => if i >= len(系数) then [] else [系数[i]] + 尾部(系数, i + 1)

  func PID输出(Kp: Float, Ki: Float, Kd: Float, 误差: Float, 积分: Float, 微分: Float) -> Float =
    (* 位置式 PID：误差/积分/微分 由调用方按采样周期累计后传入，本函数只做加权和。 *)
    (Kp, Ki, Kd, 误差, 积分, 微分) =>
    Kp * 误差 + Ki * 积分 + Kd * 微分

  func 阶跃响应上升时间(带宽: Float) -> Float =
    (* tr ≈ 0.35 / BW（一阶系统经验式）；带宽 ≤ 0 无带宽口径 → None。 *)
    (带宽) =>
    if 带宽 <= 0 then None else 0.35 / 带宽

  func 稳态误差(开环增益: Float, 系统类型: Int) -> Float =
    (* 单位反馈、单位阶跃输入口径：0 型系统 ess = 1/(1+Kp)，I 型及以上对阶跃无静差。
       开环增益 = -1 使分母为 0，由除零守卫诚实报错。 *)
    (开环增益, 系统类型) =>
    if 系统类型 >= 1 then 0
    else 1 / (1 + 开环增益)

  func 相位裕度(增益穿越频率: Float, 相位: Float) -> Float =
    (* PM = 180° + φ(ω_gc)；相位 须为 增益穿越频率 处的开环相角（角度制，负值滞后）。
       增益穿越频率 仅作调用侧标注，本式不参与计算。 *)
    (增益穿越频率, 相位) => 180 + 相位

  func 增益裕度(相位穿越频率: Float, 增益: Float) -> Float =
    (* GM = 1/|G(jω_pc)|（线性幅值，非 dB）；幅值为 0 时 GM 无界 → None。
       分贝口径由调用方换算 20·log10(GM)。 *)
    (相位穿越频率, 增益) =>
    if 增益 = 0 then None else 1 / 增益

  (* ===== 传感器 ===== *)
  func 热电偶温度(电动势: Float, 灵敏度: Float) -> Float =
    (* 灵敏度 = 0 无标定口径 → None（不伪造 0 度读数）。 *)
    (电动势, 灵敏度) =>
    if 灵敏度 = 0 then None else 电动势 / 灵敏度

  func 应变片应变量(电阻变化: Float, 原始电阻: Float, 灵敏系数: Float) -> Float =
    (电阻变化, 原始电阻, 灵敏系数) =>
    if 原始电阻 * 灵敏系数 = 0 then None else 电阻变化 / (原始电阻 * 灵敏系数)

  (* 加速度计姿态角（弧度制）：俯仰 = atan2(ay, az)，横滚 = atan(-ax / √(ay²+az²))，
     偏航 无磁力计参考恒 0。水平模 = 0（ax 轴向垂直）时横滚无定义 → 记 0.0。 *)
  func 加速度计角度(ax: Float, ay: Float, az: Float) -> (Float, Float, Float) =
    (ax, ay, az) =>
    let 俯仰 = 象限角(ay, az) in
    let 水平模 = sqrt(ay * ay + az * az) in
    let 姿态 = if 水平模 = 0 then (俯仰, 0.0, 0.0) else 横滚对(ax, 水平模, 俯仰) in
    姿态

  func 横滚对(ax, 水平模, 俯仰) -> (Float, Float, Float) =
    (ax, 水平模, 俯仰) =>
    let 横滚 = 反正切((0 - ax) / 水平模) in
    (俯仰, 横滚, 0.0)

  (* 四象限反正切：x > 0 直接取 atan(y/x)；x < 0 按 y 符号加减 π；
     x = 0 时 y ≠ 0 取 ±π/2，y 亦为 0 时角度无定义 → 0.0。 *)
  func 象限角(y, x) -> Float =
    (y, x) =>
    if x > 0 then 反正切(y / x)
    else if x < 0 then 负x侧(y, x)
    else if y > 0 then 1.5707963267948966
    else if y < 0 then -1.5707963267948966
    else 0.0

  func 负x侧(y, x) -> Float =
    (y, x) =>
    if y >= 0 then 反正切(y / x) + 3.141592653589793
    else 反正切(y / x) - 3.141592653589793

  (* 反正切：tan 在 (-π/2, π/2) 单调递增，对 50 轮二分把区间压到 ~3e-15；
     链面注册内建无 atan/asin/atan2，故用三面同判的 tan + 算术二分实现。 *)
  func 反正切(r) -> Float =
    (r) => if r = 0 then 0.0 else 正切二分(-1.5707963267948966, 1.5707963267948966, r, 0)

  func 正切二分(lo, hi, r, k: Int) -> Float =
    (lo, hi, r, k) => {
    let 中 = (lo + hi) / 2.0
    let 角 = if k >= 50 then 中 else 正切半区(lo, hi, 中, r, k)
    角
    }

  func 正切半区(lo, hi, 中, r, k: Int) -> Float =
    (lo, hi, 中, r, k) =>
    let 值 = tan(中) in
    let 半区 = 值 < r ? [中, hi] : [lo, 中] in
    let 角 = 正切二分(半区[0], 半区[1], r, k + 1) in
    角

  func 陀螺仪角度(角速度: Float, 采样时间: Float) -> Float =
    (角速度, 采样时间) => 角速度 * 采样时间

  func 传感器融合(加速度角度: Float, 陀螺仪角度: Float, α: Float) -> Float =
    (* 互补滤波器 *)
    (加速度角度, 陀螺仪角度, α) =>
    α * 加速度角度 + (1 - α) * 陀螺仪角度

  (* ===== 电机控制 ===== *)
  func 步进电机步数(角度: Float, 步距角: Float) -> Int =
    (* 整步计数（向下取整）；步距角 ≤ 0 无步距口径 → None。 *)
    (角度, 步距角) =>
    if 步距角 <= 0 then None else floor(角度 / 步距角)

  func 直流电机转速(电压: Float, 电机常数: Float) -> Float =
    (电压, 电机常数) =>
    if 电机常数 = 0 then None else 电压 / 电机常数

  func 电机扭矩(电流: Float, 扭矩常数: Float) -> Float =
    (电流, 扭矩常数) => 电流 * 扭矩常数

  func 编码器脉冲(圈数: Float, 分辨率: Int) -> Int =
    (圈数, 分辨率) => floor(圈数 * 分辨率)

  (* ===== 通信协议 ===== *)
  (* CRC-8（init 0x00、不反射、无异或输出）：逐字节先异或入 acc，再移 8 次，
     每次看最高位（acc // 128）决定左移后是否再异或多项式；结果恒在 0..255。
     数据 元素须为 0..255 的字节值，越界元素按未定义输入对待。
     校验值：字节 49..57（"123456789"）、多项式 7 → 244（0xF4）。 *)
  func CRC8校验(数据: List, 多项式: Int) -> Int =
    (数据, 多项式) => CRC轮(0, 数据, 0, 多项式)

  func CRC轮(crc: Int, 数据: List, i: Int, 多项式: Int) -> Int =
    (crc, 数据, i, 多项式) =>
    if i >= len(数据) then crc else CRC步(crc, 数据, i, 多项式)

  func CRC步(crc: Int, 数据: List, i: Int, 多项式: Int) -> Int =
    (crc, 数据, i, 多项式) =>
    let 混入 = 异或数(crc, 数据[i]) in
    let 定值 = 位移轮(混入, 0, 多项式) in
    let 结果 = CRC轮(定值, 数据, i + 1, 多项式) in
    结果

  func 位移轮(crc: Int, k: Int, 多项式: Int) -> Int =
    (crc, k, 多项式) => if k >= 8 then crc else 位移步(crc, k, 多项式)

  func 位移步(crc: Int, k: Int, 多项式: Int) -> Int =
    (crc, k, 多项式) =>
    let 高位 = crc // 128 in
    let 左移 = (crc * 2) % 256 in
    let 新值 = if 高位 = 0 then 左移 else 异或数(左移, 多项式) in
    let 结果 = 位移轮(新值, k + 1, 多项式) in
    结果

  (* 按位异或（无位运算符，用 // % 逐比特分解重建）：仅限非负整数。 *)
  func 异或数(a: Int, b: Int) -> Int =
    (a, b) => 异或步(a, b, 1, 0)

  func 异或步(a: Int, b: Int, 位: Int, 累: Int) -> Int =
    (a, b, 位, 累) => if 位 > a and 位 > b then 累 else 异或步2(a, b, 位, 累)

  func 异或步2(a: Int, b: Int, 位: Int, 累: Int) -> Int =
    (a, b, 位, 累) =>
    let 甲位 = (a // 位) % 2 in
    let 乙位 = (b // 位) % 2 in
    let 相异 = 甲位 - 乙位 in
    let 新增 = 相异 = 0 ? 0 : 位 in
    let 结果 = 异或步(a, b, 位 * 2, 累 + 新增) in
    结果

  (* USART：波特率 = 时钟频率 / (16 × 分频系数)（16 倍过采样，分频系数即 BRR）。
     分频系数 ≤ 0 无分频口径 → None。 *)
  func UART波特率(时钟频率: Int, 分频系数: Int) -> Int =
    (时钟频率, 分频系数) =>
    if 分频系数 <= 0 then None else 时钟频率 // (16 * 分频系数)

  (* I2C：SCL = 时钟频率 / 分频系数，并按模式上限截断——标准模式 100 kHz、
     快速模式 400 kHz（更高模式需另立口径，此处不外推）。分频系数 ≤ 0 → None。 *)
  func I2C总线速度(时钟频率: Int, 分频系数: Int) -> Int =
    (时钟频率, 分频系数) =>
    if 分频系数 <= 0 then None else min([400000, 时钟频率 // 分频系数])

  (* SPI：SCK = 主时钟 / 分频（2 的幂分频由硬件保证，此处只做除法）。 *)
  func SPI时钟频率(分频: Int, 主时钟: Int) -> Int =
    (分频, 主时钟) =>
    if 分频 <= 0 then None else 主时钟 // 分频

  (* ===== PLC逻辑 ===== *)
  func 梯形图与门(a: Bool, b: Bool) -> Bool =
    (a, b) => a and b

  func 梯形图或门(a: Bool, b: Bool) -> Bool =
    (a, b) => a or b

  func 梯形图非门(a: Bool) -> Bool =
    (a) => not a

  (* 通电延时定时器：输入为真 且 已计时达到预设时间 → 输出真（计时未到不输出）。 *)
  func 定时器TON(输入: Bool, 预设时间: Float, 当前时间: Float) -> Bool =
    (输入, 预设时间, 当前时间) =>
    输入 and (当前时间 >= 预设时间)

  func 计数器CTU(脉冲: Bool, 预设值: Int, 当前计数: Int) -> (Int, Bool) =
    (脉冲, 预设值, 当前计数) =>
    if 脉冲 then
      (if 当前计数 + 1 >= 预设值 then 预设值 else 当前计数 + 1,
       当前计数 + 1 >= 预设值)
    else
      (当前计数, 假)

  (* ===== 嵌入式系统 ===== *)
  (* 向上对齐到对齐值的倍数（整型除法即向下取整）；对齐值 ≤ 0 无对齐口径 → None。 *)
  func 内存对齐(大小: Int, 对齐值: Int) -> Int =
    (大小, 对齐值) =>
    if 对齐值 <= 0 then None else ((大小 + 对齐值 - 1) // 对齐值) * 对齐值

  (* 使用率 = 已使用 / 总大小（可 > 1 表示溢出）；总大小 ≤ 0 无分母口径 → None。 *)
  func 堆栈使用率(已使用: Int, 总大小: Int) -> Float =
    (已使用, 总大小) =>
    if 总大小 <= 0 then None else 已使用 / 总大小

  func 中断延迟(指令周期: Int, 中断向量数: Int) -> Int =
    (指令周期, 中断向量数) =>
    指令周期 * 中断向量数
}
