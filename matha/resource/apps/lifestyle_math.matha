(* 资源库：生活服务等应用数学
   覆盖：导航定位、外卖配送、健康管理、生活服务计费
   ============================================================
   口径（阶段 41 真化批）：
   1. 比值/速率类函数分母为 0（或入参无物理意义）时返回 None，不再伪造
      999.0 哨兵值或 0 读数——0 与「真实算出 0%」不可区分，999.0 会污染下游统计。
   2. 链面（boot 编译器 + 解释器）注册内建不含 atan2/asin/acos/exp：旧体
      大圆距离、方位角 在链面恒「未定义变量」，函数从不可调用（三面皆假失败）。
      按 industrial_math 已验证的 tan 二分求根实现 反正切/象限角 本地 helper，
      三面皆可调用；球面距离改用 atan2 同值的 2·象限角(√a, √(1−a)) 形式。
   3. 角度制换算一律用全精度 π = 3.141592653589793——二分求根本身精确到
      ~3e-15，再用截断 π 折算度数会把有效位丢回 5 位。
   4. 函数名承诺的量纲必须兑现：导航路径长度 旧体返回航点个数（无量纲计数），
      现改为相邻航点标量距离累加。
   ============================================================ *)

module 生活服务 {

  (* ===== 导航定位 ===== *)
  (* 球面大圆距离（Haversine）：d = 2R·asin(√a) ≡ 2R·atan2(√a, √(1−a))。
     a 因浮点舍入可能溢出 [0,1]（同点时 1−a 可为微小负数），先钳单位再开方；
     经纬度按弧度传入（度数请先用 度转弧度 换算）。 *)
  func 大圆距离(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float =
    (lat1, lon1, lat2, lon2) =>
    let R = 6371.0 in
    let dlat = lat2 - lat1 in
    let dlon = lon2 - lon1 in
    let a = sin(dlat/2)^2 + cos(lat1) * cos(lat2) * sin(dlon/2)^2 in
    let 钳 = 钳单位(a) in
    R * 2 * 象限角(sqrt(钳), sqrt(1 - 钳))

  (* 初始方位角：atan2(x, y) 折算角度制，正北 0、顺时针为正，值域 (-180, 180]；
     需要 [0, 360) 时自行对负值加 360。经纬度按弧度传入。 *)
  func 方位角(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float =
    (lat1, lon1, lat2, lon2) =>
    let dlon = lon2 - lon1 in
    let x = sin(dlon) * cos(lat2) in
    let y = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dlon) in
    象限角(x, y) * 180 / 3.141592653589793

  func 钳单位(x: Float) -> Float =
    (x) => if x > 1 then 1.0 else if x < 0 then 0.0 else x

  (* 四象限反正切：x > 0 直接取 atan(y/x)；x < 0 按 y 符号加减 π；
     x = 0 时 y ≠ 0 取 ±π/2，y 亦为 0 时角度无定义 → 0.0。 *)
  func 象限角(y, x) -> Float =
    (y, x) =>
    if x > 0 then 反正切(y / x)
    else if x < 0 then 负x侧(y, x)
    else if y > 0 then 1.5707963267948966
    else if y < 0 then 0 - 1.5707963267948966
    else 0.0

  func 负x侧(y, x) -> Float =
    (y, x) =>
    if y >= 0 then 反正切(y / x) + 3.141592653589793
    else 反正切(y / x) - 3.141592653589793

  (* 反正切：tan 在 (-π/2, π/2) 单调递增，50 轮二分把区间压到 ~3e-15；
     链面注册内建无 atan/atan2，故用三面同判的 tan + 算术二分实现。 *)
  func 反正切(r) -> Float =
    (r) => if r = 0 then 0.0 else 正切二分(-1.5707963267948966, 1.5707963267948966, r, 0)

  func 正切二分(lo, hi, r, k: Int) -> Float =
    (lo, hi, r, k) => {
    let 中 = (lo + hi) / 2.0
    let 角 = if k >= 50 then 中 else 正切半区(lo, hi, 中, r, k)
    角
    }

  func 正切半区(lo, hi, 中, r, k: Int) -> Float =
    (lo, hi, 中, r, k) =>
    let 值 = tan(中) in
    let 半区 = 值 < r ? [中, hi] : [lo, 中] in
    let 角 = 正切二分(半区[0], 半区[1], r, k + 1) in
    角

  func 预估到达时间(距离: Float, 速度: Float) -> Float =
    (* 口径注：速度 ≤ 0 时无定义 → None（旧体返回 999.0 哨兵值）。 *)
    (距离, 速度) =>
    if 速度 <= 0 then None else 距离 / 速度

  func 导航路径长度(航点列表: List) -> Float =
    (* 口径注：旧体返回 len(航点列表)——航点个数（无量纲计数），与函数名承诺的
       「路径长度」量纲不符，属危险假读数。真化为相邻航点的标量距离累加
       Σ|p[i+1] − p[i]|：航点须为一维标量序列（里程桩/桩号）；
       不足 2 点 → 0.0；经纬度航点对需按 大圆距离 逐段累加，本函数不做球面换算。 *)
    (航点列表) => {
    let n = len(航点列表)
    let rec 累加(i: Int, acc: Float) -> Float =
    (i, acc) =>
      if i >= n - 1 then acc
      else 累加(i + 1, acc + abs(航点列表[i + 1] - 航点列表[i]))
    累加(0, 0.0)
    }

  (* ===== 外卖配送 ===== *)
  func 配送费用(距离: Float, 基础费: Float, 每公里费: Float) -> Float =
    (距离, 基础费, 每公里费) => 基础费 + 距离 * 每公里费

  func 预计配送时间(距离: Float, 速度: Float) -> Float =
    (* 口径注：速度 ≤ 0 时无定义 → None（旧体返回 999.0 哨兵值）；结果单位分钟。 *)
    (距离, 速度) =>
    if 速度 <= 0 then None else 距离 / 速度 * 60

  func 骑手容量利用率(已载单数: Int, 最大容量: Int) -> Float =
    (* 口径注：最大容量为 0 时无定义 → None（旧体返回 0，与「空车」的真实读数 0 混淆）。 *)
    (已载单数, 最大容量) =>
    if 最大容量 = 0 then None else 已载单数 / 最大容量

  func 订单合并评分(订单1距离: Float, 订单2距离: Float, 骑手位置: Float) -> Float =
    (* 口径注：评分取最近订单距离——骑手位置 参数在当前模型下不影响读数
       （保留入参仅为协议兼容）；需按骑手实际位置计价请改为
       min([abs(订单1距离 - 骑手位置), abs(订单2距离 - 骑手位置)])。 *)
    (订单1距离, 订单2距离, 骑手位置) =>
    min([订单1距离, 订单2距离])

  (* ===== 健康管理 ===== *)
  func BMI(体重: Float, 身高: Float) -> Float =
    (* 口径注：身高 ≤ 0 时无物理意义 → None（旧体直接抛除零/给负 BMI）。 *)
    (体重, 身高) =>
    if 身高 <= 0 then None else 体重 / (身高 * 身高)

  func BMI分类(bmi: Float) -> String =
    (bmi) =>
    match bmi {
      | _ if bmi < 18.5 => "偏瘦"
      | _ if bmi < 24 => "正常"
      | _ if bmi < 28 => "偏胖"
      | _ => "肥胖"

    }
  func 每日热量需求(基础代谢: Float, 活动系数: Float) -> Float =
    (基础代谢, 活动系数) => 基础代谢 * 活动系数

  func BMR_male(体重: Float, 身高: Float, 年龄: Int) -> Float =
    (体重, 身高, 年龄) =>
    66.5 + 13.75 * 体重 + 5.003 * 身高 - 6.755 * 年龄

  func BMR_female(体重: Float, 身高: Float, 年龄: Int) -> Float =
    (体重, 身高, 年龄) =>
    655.1 + 9.563 * 体重 + 1.850 * 身高 - 4.676 * 年龄

  func 目标心率(最大心率: Float, 强度: Float) -> Float =
    (最大心率, 强度) => 最大心率 * 强度

  func 最大心率(年龄: Int) -> Int =
    (年龄) => 220 - 年龄

  (* ===== 生活服务计费 ===== *)
  func 水电费(用量: Float, 单价: Float, 阶梯阈值: Float, 阶梯单价: Float) -> Float =
    (用量, 单价, 阶梯阈值, 阶梯单价) =>
    if 用量 <= 阶梯阈值 then 用量 * 单价
    else 阶梯阈值 * 单价 + (用量 - 阶梯阈值) * 阶梯单价

  func 出租车费(里程: Float, 起步价: Float, 里程单价: Float, 起步里程: Float) -> Float =
    (里程, 起步价, 里程单价, 起步里程) =>
    if 里程 <= 起步里程 then 起步价
    else 起步价 + (里程 - 起步里程) * 里程单价

  func 话费计算(通话分钟: Int, 单价: Float, 套餐分钟: Int, 套餐费: Float) -> Float =
    (通话分钟, 单价, 套餐分钟, 套餐费) =>
    if 通话分钟 <= 套餐分钟 then 套餐费
    else 套餐费 + (通话分钟 - 套餐分钟) * 单价

  func 停车费(小时数: Float, 首小时: Float, 续小时单价: Float) -> Float =
    (小时数, 首小时, 续小时单价) =>
    首小时 + max([0, 小时数 - 1]) * 续小时单价

  (* ===== 社交娱乐 ===== *)
  (* 口径注：以下四项均为「比率/强度」类读数——分母为 0 表示无样本，
     结果无定义 → None；旧体返回 0 与「真实算出 0%」不可区分。 *)
  func 直播间人气热度(观看人数: Int, 互动数: Int, 时长: Int) -> Float =
    (观看人数, 互动数, 时长) =>
    if 时长 <= 0 then None else (观看人数 * 0.6 + 互动数 * 0.4) / 时长

  func 短视频完播率(完播数: Int, 播放数: Int) -> Float =
    (完播数, 播放数) =>
    if 播放数 = 0 then None else 完播数 / 播放数

  func 用户留存率(次日留存: Int, 当日新增: Int) -> Float =
    (次日留存, 当日新增) =>
    if 当日新增 = 0 then None else 次日留存 / 当日新增

  func 内容互动率(互动数: Int, 曝光数: Int) -> Float =
    (互动数, 曝光数) =>
    if 曝光数 = 0 then None else 互动数 / 曝光数
}
