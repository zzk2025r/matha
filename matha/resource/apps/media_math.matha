(* 资源库：影音与媒体应用数学
   覆盖：音频处理、视频编码、图像处理、滤镜算法
   ============================================================ *)

module 影音媒体 {

  (* ===== 音频处理 ===== *)
  func 采样率转换(原采样率: Int, 目标采样率: Int, 样本数: Int) -> Int =
    (原采样率, 目标采样率, 样本数) =>
    int(样本数 * 目标采样率 / 原采样率)

  func 音频音量(db: Float) -> Float =
    (* dB to linear: 10^(dB/20) *)
    (db) => pow(10.0, db / 20.0)

  func 音频dB计算(振幅: Float) -> Float =
    (* 20 * log10(amp) *)
    (振幅) =>
    if 振幅 <= 0 then -999.0
    else 20.0 * log10(振幅)

  func 音频均衡器(频率: Float, 增益: Float) -> Float =
    (* 简化：返回增益 *)
    (频率, 增益) => 增益

  func 音频混响时间(房间体积: Float, 表面积: Float, 吸声系数: Float) -> Float =
    (* Sabine公式: T60 = 0.161 * V / (S * α) *)
    (房间体积, 表面积, 吸声系数) =>
    0.161 * 房间体积 / (表面积 * 吸声系数)

  func 音频比特率(采样率: Int, 位深: Int, 声道数: Int) -> Int =
    (采样率, 位深, 声道数) => 采样率 * 位深 * 声道数

  (* ===== 视频编码 ===== *)
  func 视频码率估算(分辨率: Int, 帧率: Int, 质量因子: Float) -> Int =
    (* 简化：分辨率*帧率*质量因子 *)
    (分辨率, 帧率, 质量因子) => int(分辨率 * 帧率 * 质量因子 / 1000)

  func 视频文件大小(码率: Int, 时长: Float) -> Float =
    (码率, 时长) => 码率 * 时长 / 8 / 1024 / 1024  (* MB *)

  func 压缩比(原始大小: Int, 压缩后大小: Int) -> Float =
    (原始大小, 压缩后大小) =>
    (原始大小 = 0) ? 0 : 原始大小 / 压缩后大小

  func 视频编码效率(比特率: Int, 分辨率宽: Int, 分辨率高: Int) -> Float =
    (比特率, 分辨率宽, 分辨率高) =>
    比特率 / (分辨率宽 * 分辨率高)

  (* ===== 图像处理 ===== *)
  func 图像尺寸(宽: Int, 高: Int) -> Int =
    (宽, 高) => 宽 * 高

  func 图像像素总量(宽: Int, 高: Int, 位深: Int) -> Int =
    (宽, 高, 位深) => 宽 * 高 * 位深 / 8

  func 图像压缩比(原始: Int, 压缩: Int) -> Float =
    (原始, 压缩) =>
    (原始 = 0) ? 0 : 原始 / 压缩

  func 高斯模糊核大小(σ: Float) -> Int =
    (* 核大小 = 6σ + 1 *)
    (σ) => int(6.0 * σ + 1.0)

  func 边缘检测灵敏度(图像梯度: Float, 阈值: Float) -> Bool =
    (图像梯度, 阈值) => 图像梯度 > 阈值

  func 直方图均衡化映射(原值: Int, 总像素: Int, 灰度级: Int) -> Int =
    (* 简化：返回原值 *)
    (原值, 总像素, 灰度级) => 原值

  (* ===== 滤镜算法 ===== *)
  func 灰度化(r: Float, g: Float, b: Float) -> Float =
    (r, g, b) => 0.299 * r + 0.587 * g + 0.114 * b

  func  sepia滤镜(r: Float, g: Float, b: Float) -> (Float, Float, Float) =
    (r, g, b) =>
    (min(1.0, r * 0.393 + g * 0.769 + b * 0.189),
     min(1.0, r * 0.349 + g * 0.686 + b * 0.168),
     min(1.0, r * 0.272 + g * 0.534 + b * 0.131))

  func 亮度调整(pixel: Float, 调整量: Float) -> Float =
    (pixel, 调整量) =>
    max(0, min(1, pixel + 调整量))

  func 对比度调整(pixel: Float, 对比度: Float) -> Float =
    (pixel, 对比度) =>
    ((pixel - 0.5) * 对比度 + 0.5)

  func 饱和度调整(r: Float, g: Float, b: Float, 饱和度: Float) -> (Float, Float, Float) =
    (r, g, b, 饱和度) =>
    let gray = 0.299*r + 0.587*g + 0.114*b in
    (max(0, min(1, gray + 饱和度 * (r - gray))),
     max(0, min(1, gray + 饱和度 * (g - gray))),
     max(0, min(1, gray + 饱和度 * (b - gray))))

  (* ===== 流媒体 ===== *)
  func 缓冲时间(文件大小: Float, 带宽: Float) -> Float =
    (文件大小, 带宽) =>
    (带宽 = 0) ? 999.0 : 文件大小 * 8 / 带宽

  func 码率自适应(当前带宽: Float, 目标码率: List) -> Int =
    (* 简化：返回第一个不超过带宽的码率索引 *)
    (当前带宽, 目标码率) =>
    let rec find(i: Int) -> Int =
      (i) =>
        if i >= len(目标码率): len(目标码率) - 1
        elif 目标码率[i] <= 当前带宽: i
        else: find(i + 1)
    find(0)
}
