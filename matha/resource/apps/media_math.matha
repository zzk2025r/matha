(* 资源库：影音与媒体应用数学
   覆盖：音频处理、视频编码、图像处理、滤镜算法
   ============================================================
   口径（阶段 41 真化批）：
   - 指数一律走 pow / 2.718281828459045 ^ x，常用对数写 log(x)/log(10.0)
     （自举链注册内建无 exp/log10）
   - 分母为 0、参数越界等无定义口径一律诚实返回 None，不再伪造哨兵值
     （旧 缓冲时间 用 999.0、旧 码率自适应 用恒 None 的坏分支假装工作）
   - 标注为经验式的函数（视频码率估算、Sabine 混响）保留启发口径，
     只把单位、适用条件与不做的事写清，不改数值
   ============================================================ *)

module 影音媒体 {

  (* ===== 音频处理 ===== *)
  (* 样本数换算：目标采样率 / 原采样率 的比值缩放下取整；原采样率 ≤ 0 无换算口径 → None。 *)
  func 采样率转换(原采样率: Int, 目标采样率: Int, 样本数: Int) -> Int =
    (原采样率, 目标采样率, 样本数) =>
    if 原采样率 <= 0 then None else floor(样本数 * 目标采样率 / 原采样率)

  func 音频音量(db: Float) -> Float =
    (* 线性增益 = 10^(dB/20)；dB = 0 → 1.0（原样通过）。 *)
    (db) => pow(10.0, db / 20.0)

  func 音频dB计算(振幅: Float) -> Float =
    (* 20·log10(振幅)；log10 用 log(x)/log(10) 表达（链面只注册自然对数 log）。
       振幅 ≤ 0 时 dB 无定义 → None（旧式以 -999.0 哨兵冒充静音，会混入真实计算）。 *)
    (振幅) =>
    if 振幅 <= 0 then None else 20.0 * (log(振幅) / log(10.0))

  (* 参量均衡（peaking EQ）幅度响应：RBJ 双二阶 cookbook 系数在频率 f 处的 |H(e^jw)|。
     入参：频率 f（Hz）、中心频率 f0（Hz）、带宽因数 Q、峰值增益（dB）、采样率（Hz）。
     有效域：采样率 > 0、0 < f0 < 采样率/2（奈奎斯特）、Q > 0；越界 → None。
     返回该频率处的线性幅度倍率（增益 dB = 0 时恒 1.0）。 *)
  func 音频均衡器(频率: Float, 中心频率: Float, Q: Float, 增益dB: Float, 采样率: Int) -> Float =
    (频率, 中心频率, Q, 增益dB, 采样率) =>
    let 有效 = if 采样率 <= 0 then 假
               else if 中心频率 <= 0 then 假
               else if 中心频率 >= 采样率 / 2 then 假
               else if Q <= 0 then 假
               else 真 in
    let 倍率 = if not 有效 then None else EQ幅度(频率, 中心频率, Q, 增益dB, 采样率) in
    倍率

  func EQ幅度(频率, 中心频率, Q, 增益dB, 采样率) -> Float =
    (频率, 中心频率, Q, 增益dB, 采样率) =>
    let π = 3.141592653589793 in
    let w0 = 2 * π * 中心频率 / 采样率 in
    let w = 2 * π * 频率 / 采样率 in
    let A = pow(10.0, 增益dB / 40.0) in
    let α = sin(w0) / (2 * Q) in
    let 余 = cos(w0) in
    let 甲 = 分子幅(1 + α * A, 0 - 2 * 余, 1 - α * A, w) in
    let 乙 = 分子幅(1 + α / A, 0 - 2 * 余, 1 - α / A, w) in
    let 倍率 = sqrt(甲 / 乙) in
    倍率

  (* 二阶多项式 B0 + B1·e^-jw + B2·e^-2jw 的模平方（虚部符号不影响模，故省去负号）。 *)
  func 分子幅(b0, b1, b2, w) -> Float =
    (b0, b1, b2, w) =>
    let 实 = b0 + b1 * cos(w) + b2 * cos(2 * w) in
    let 虚 = b1 * sin(w) + b2 * sin(2 * w) in
    let 方 = 实 * 实 + 虚 * 虚 in
    方

  (* Sabine 混响时间 T60 = 0.161·V / (S·α)（V 房间体积 m³、S 表面积 m²、α 平均吸声系数）。
     经验式，适用于 α 较小、声场扩散的房间；吸收项 S·α ≤ 0 无混响口径 → None。 *)
  func 音频混响时间(房间体积: Float, 表面积: Float, 吸声系数: Float) -> Float =
    (房间体积, 表面积, 吸声系数) =>
    if 表面积 * 吸声系数 <= 0 then None else 0.161 * 房间体积 / (表面积 * 吸声系数)

  (* 未压缩 PCM 比特率（bps）= 采样率 × 位深 × 声道数。 *)
  func 音频比特率(采样率: Int, 位深: Int, 声道数: Int) -> Int =
    (采样率, 位深, 声道数) => 采样率 * 位深 * 声道数

  (* ===== 视频编码 ===== *)
  (* 启发式码率估算（kbps）= 像素数 × 帧率 × 质量因子 / 1000。
     质量因子 是每像素每帧的比特预算系数（经验取值 0.05 ~ 0.3），
     不是编码器实测——真实码率取决于内容复杂度与编码预设。 *)
  func 视频码率估算(分辨率: Int, 帧率: Int, 质量因子: Float) -> Int =
    (分辨率, 帧率, 质量因子) => floor(分辨率 * 帧率 * 质量因子 / 1000)

  (* 文件大小（MB）：码率 取 bps（与 音频比特率 同口径），时长 取秒。 *)
  func 视频文件大小(码率: Int, 时长: Float) -> Float =
    (码率, 时长) => 码率 * 时长 / 8 / 1024 / 1024  (* MB *)

  (* 压缩比 = 原始 / 压缩后（>1 表示变小）。压缩后大小 ≤ 0 无压缩口径 → None
     （旧式守卫写错了操作数：判 原始大小 而除 压缩后大小）。 *)
  func 压缩比(原始大小: Int, 压缩后大小: Int) -> Float =
    (原始大小, 压缩后大小) =>
    if 压缩后大小 <= 0 then None else 原始大小 / 压缩后大小

  (* 码率密度 = 比特率 / (宽 × 高)，单位 bps/像素（未折算帧率，帧率维度由调用侧另计）。
     像素总量 ≤ 0 无归一化口径 → None。 *)
  func 视频编码效率(比特率: Int, 分辨率宽: Int, 分辨率高: Int) -> Float =
    (比特率, 分辨率宽, 分辨率高) =>
    if 分辨率宽 * 分辨率高 <= 0 then None else 比特率 / (分辨率宽 * 分辨率高)

  (* ===== 图像处理 ===== *)
  func 图像尺寸(宽: Int, 高: Int) -> Int =
    (宽, 高) => 宽 * 高

  (* 未压缩位图占用（字节）= 宽 × 高 × 位深 / 8，整除向下取整（与 -> Int 注解一致）。 *)
  func 图像像素总量(宽: Int, 高: Int, 位深: Int) -> Int =
    (宽, 高, 位深) => 宽 * 高 * 位深 // 8

  (* 压缩比 = 原始 / 压缩后；压缩后 ≤ 0 无压缩口径 → None（旧式守卫判错操作数）。 *)
  func 图像压缩比(原始: Int, 压缩: Int) -> Float =
    (原始, 压缩) =>
    if 压缩 <= 0 then None else 原始 / 压缩

  (* 高斯核边长 = 2⌈3σ⌉ + 1（±3σ 截断，恒为奇数以保证核对称）；σ < 0 无核口径 → None。 *)
  func 高斯模糊核大小(σ: Float) -> Int =
    (σ) =>
    if σ < 0 then None else 2 * ceil(3.0 * σ) + 1

  func 边缘检测灵敏度(图像梯度: Float, 阈值: Float) -> Bool =
    (图像梯度, 阈值) => 图像梯度 > 阈值

  (* 直方图均衡化映射：真算 CDF 映射，而非把原值原样返回。
     直方图 为 灰度级 长度的计数表（bin i = 灰度值 i 的像素数），
     均衡值 = round(累计计数 / 总像素 × (灰度级 − 1))。
     无定义口径诚实返回 None：灰度级 ≤ 0、总像素 ≤ 0、直方图短于 灰度级、原值越出 [0, 灰度级)。 *)
  func 直方图均衡化映射(原值: Int, 直方图: List, 灰度级: Int) -> Int =
    (原值, 直方图, 灰度级) => {
    let 总像素 = 表求和(直方图, 0)
    let 有效 = if 灰度级 <= 0 then 假
               else if 总像素 <= 0 then 假
               else if len(直方图) < 灰度级 then 假
               else if 原值 < 0 then 假
               else if 原值 >= 灰度级 then 假
               else 真
    let 值 = if not 有效 then None else 均衡值(累计和(直方图, 原值, 0), 总像素, 灰度级)
    值
    }

  func 表求和(直方图: List, i: Int) -> Int =
    (直方图, i) => if i >= len(直方图) then 0 else 直方图[i] + 表求和(直方图, i + 1)

  (* 累计计数 Σ hist[0..上界]（含 上界）。 *)
  func 累计和(直方图: List, 上界: Int, i: Int) -> Int =
    (直方图, 上界, i) => if i > 上界 then 0 else 直方图[i] + 累计和(直方图, 上界, i + 1)

  (* floor(x + 0.5) 形式的四舍五入（避免各面 round 的半整数口径差）。 *)
  func 均衡值(cdf: Int, 总像素: Int, 灰度级: Int) -> Int =
    (cdf, 总像素, 灰度级) => floor(cdf * (灰度级 - 1) / 总像素 + 0.5)

  (* ===== 滤镜算法 ===== *)
  func 灰度化(r: Float, g: Float, b: Float) -> Float =
    (r, g, b) => 0.299 * r + 0.587 * g + 0.114 * b

  func sepia滤镜(r: Float, g: Float, b: Float) -> (Float, Float, Float) =
    (* 经典 sepia 矩阵；各通道只钳上界 1.0（输入约定 ∈ [0, 1]，负输入按线性值透传）。 *)
    (r, g, b) =>
    (min([1.0, r * 0.393 + g * 0.769 + b * 0.189]),
     min([1.0, r * 0.349 + g * 0.686 + b * 0.168]),
     min([1.0, r * 0.272 + g * 0.534 + b * 0.131]))

  func 亮度调整(pixel: Float, 调整量: Float) -> Float =
    (pixel, 调整量) =>
    max([0, min([1, pixel + 调整量])])

  func 对比度调整(pixel: Float, 对比度: Float) -> Float =
    (* 绕中灰 0.5 的线性拉伸：(p − 0.5)·k + 0.5。
       与 亮度调整 不同，此处故意不截断——超范围像素由调用侧统一钳位后再量化。 *)
    (pixel, 对比度) =>
    ((pixel - 0.5) * 对比度 + 0.5)

  func 饱和度调整(r: Float, g: Float, b: Float, 饱和度: Float) -> (Float, Float, Float) =
    (r, g, b, 饱和度) =>
    let gray = 0.299*r + 0.587*g + 0.114*b in
    (max([0, min([1, gray + 饱和度 * (r - gray)])]),
     max([0, min([1, gray + 饱和度 * (g - gray)])]),
     max([0, min([1, gray + 饱和度 * (b - gray)])]))

  (* ===== 流媒体 ===== *)
  (* 缓冲时间（秒）= 文件大小（字节）× 8 / 带宽（bps）。
     带宽 ≤ 0 无传输口径 → None（旧式回 999.0 哨兵，会与真实缓冲时长混在一起）。 *)
  func 缓冲时间(文件大小: Float, 带宽: Float) -> Float =
    (文件大小, 带宽) =>
    if 带宽 <= 0 then None else 文件大小 * 8 / 带宽

  (* 码率自适应（ABR 上调档）：目标码率 为升序档位表，
     返回 不超过 当前带宽 的最高档索引；一档都放不下 或 空表 → -1（无可选档）。
     旧式写坏成 `if if … elif …:` 恒落 None（且只取首个可行档），故真化。 *)
  func 码率自适应(当前带宽: Float, 目标码率: List) -> Int =
    (当前带宽, 目标码率) => 自适应查(0, -1, 当前带宽, 目标码率)

  func 自适应查(i: Int, 最佳: Int, 当前带宽: Float, 目标码率: List) -> Int =
    (i, 最佳, 当前带宽, 目标码率) =>
    if i >= len(目标码率) then 最佳 else 自适应步(i, 最佳, 当前带宽, 目标码率)

  func 自适应步(i: Int, 最佳: Int, 当前带宽: Float, 目标码率: List) -> Int =
    (i, 最佳, 当前带宽, 目标码率) =>
    let 档 = 目标码率[i] in
    let 新最佳 = 档 <= 当前带宽 ? i : 最佳 in
    let 结果 = 自适应查(i + 1, 新最佳, 当前带宽, 目标码率) in
    结果
}
