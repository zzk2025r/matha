(* 资源库：社交与电商应用数学
   覆盖：消息队列、用户关系、推荐算法、购物车、支付计算
   ============================================================ *)

module 社交电商 {

  (* ===== 消息系统 ===== *)
  func 消息队列长度(入队次数: Int, 出队次数: Int) -> Int =
    (入队次数, 出队次数) => max([0, 入队次数 - 出队次数])

  (* 消息优先级排序：消息表形态 [[优先级, 内容], ...]，按 优先级 降序重建新表
     （数值大者先出队，同优先级保持原序——插入排序稳定）。
     旧桩原样返回入参，任意优先级序列皆被判"已排序"，故真化。
     空表 → []；元素须为二元表，否则由下标守卫诚实报错。 *)
  func 消息优先级排序(消息列表: List) -> List =
    (消息列表) => {
    let rec 插入(新: List, 已排: List) -> List =
      (新, 已排) => len(已排) == 0 ? [新] + 已排 :
        ((优先值(已排[0]) >= 优先值(新)) ? [已排[0]] + 插入(新, 已排[1:]) : [新] + 已排)
    let rec 排(剩余: List, 已排: List) -> List =
      (剩余, 已排) => len(剩余) == 0 ? 已排 : 排(剩余[1:], 插入(剩余[0], 已排))
    排(消息列表, [])
    }

  func 优先值(消息: List) -> Float =
    (消息) => 消息[0]

  func 消息送达率(发送数: Int, 送达数: Int) -> Float =
    (发送数, 送达数) =>
    (发送数 = 0) ? 0 : 送达数 / 发送数

  func 消息延迟均值(延迟列表: List) -> Float =
    (延迟列表) => {
    let rec sum(i: Int, acc: Float) -> Float =
    (i, acc) => if i >= len(延迟列表): acc else sum(i+1, acc + 延迟列表[i])
    sum(0, 0) / len(延迟列表)
    }

  (* ===== 用户关系 ===== *)
  func 关注互关率(互关数: Int, 总关注数: Int) -> Float =
    (互关数, 总关注数) =>
    (总关注数 = 0) ? 0 : 互关数 / 总关注数

  func 活跃用户比率(日活: Int, 总用户: Int) -> Float =
    (日活, 总用户) =>
    (总用户 = 0) ? 0 : 日活 / 总用户

  func 用户留存率(初始用户: Int, 次日留存: Int) -> Float =
    (初始用户, 次日留存) =>
    (初始用户 = 0) ? 0 : 次日留存 / 初始用户

  func 社交网络密度(用户数: Int, 关系数: Int) -> Float =
    (用户数, 关系数) =>
    let max_edges = 用户数 * (用户数 - 1) / 2 in
    (max_edges = 0) ? 0 : 关系数 / max_edges

  func 平均好友数(用户列表: List) -> Float =
    (用户列表) => {
    let rec sum(i: Int, acc: Int) -> Int =
    (i, acc) => if i >= len(用户列表): acc else sum(i+1, acc + 用户列表[i])
    sum(0, 0) / len(用户列表)
    }

  (* ===== 推荐算法 ===== *)
  (* 协同过滤相似度：余弦相似度 cosθ = Σaᵢbᵢ / (‖a‖·‖b‖)，两表按序配对，
     长度取较短者（超出部分无配对，不计入）。零向量（任一模长为 0）无方向可比 → 0.0。
     旧式把 `let … in` 链写成块内语句——块值模型下绑定尾不回传值，函数恒返 None，故真化。 *)
  func 协同过滤相似度(user1Prefs: List, user2Prefs: List) -> Float =
    (user1Prefs, user2Prefs) => {
    let n = min([len(user1Prefs), len(user2Prefs)])
    let rec 点积(i: Int) -> Float =
    (i) => if i >= n then 0.0 else user1Prefs[i] * user2Prefs[i] + 点积(i + 1)
    let rec 平方和甲(i: Int) -> Float =
    (i) => if i >= n then 0.0 else user1Prefs[i] ^ 2 + 平方和甲(i + 1)
    let rec 平方和乙(i: Int) -> Float =
    (i) => if i >= n then 0.0 else user2Prefs[i] ^ 2 + 平方和乙(i + 1)
    let 甲模 = sqrt(平方和甲(0))
    let 乙模 = sqrt(平方和乙(0))
    let 分母 = 甲模 * 乙模
    let 相似度 = if 分母 = 0 then 0.0 else 点积(0) / 分母
    相似度
    }

  func 内容推荐评分(内容质量: Float, 用户兴趣: Float, 时效性: Float) -> Float =
    (内容质量, 用户兴趣, 时效性) =>
    内容质量 * 0.4 + 用户兴趣 * 0.4 + 时效性 * 0.2

  func 热度计算(点赞数: Int, 评论数: Int, 分享数: Int, 天数: Int) -> Float =
    (点赞数, 评论数, 分享数, 天数) =>
    (点赞数 * 1 + 评论数 * 3 + 分享数 * 5) / max([1, 天数])

  (* ===== 购物车 ===== *)
  (* 购物车总价：Σ 价格[i] × 数量[i]，两表按序配对，长度取较短者（多余项无配对不计入）。
     商品列表 仅作调用侧上下文，不参与计价（保留形参以维持调用约定）。
     旧式块内 `let … in` 链不回传块值 + `if if … else:` 恒落 None，故真化。 *)
  func 购物车总价(商品列表: List, 价格列表: List, 数量列表: List) -> Float =
    (商品列表, 价格列表, 数量列表) => {
    let n = min([len(价格列表), len(数量列表)])
    let rec 累(i: Int, acc: Float) -> Float =
    (i, acc) => if i >= n then acc else 累(i + 1, acc + 价格列表[i] * 数量列表[i])
    let 总价 = 累(0, 0)
    总价
    }

  func 购物车折扣价(原价: Float, 折扣率: Float) -> Float =
    (原价, 折扣率) => 原价 * (1 - 折扣率)

  func 满减计算(总价: Float, 门槛: Float, 减免: Float) -> Float =
    (总价, 门槛, 减免) =>
    if 总价 >= 门槛 then min([减免, 总价 * 0.2]) else 0

  func 运费计算(重量: Float, 基础运费: Float, 续重单价: Float) -> Float =
    (重量, 基础运费, 续重单价) =>
    基础运费 + max([0, 重量 - 1]) * 续重单价

  (* ===== 支付计算 ===== *)
  func 分期月供(总额: Float, 期数: Int, 月利率: Float) -> Float =
    (总额, 期数, 月利率) =>
    if 月利率 = 0 then 总额 / 期数
    else 总额 * 月利率 * (1 + 月利率)^期数 / ((1 + 月利率)^期数 - 1)

  func 手续费计算(金额: Float, 费率: Float) -> Float =
    (金额, 费率) => 金额 * 费率

  func 汇率换算(金额: Float, 汇率: Float) -> Float =
    (金额, 汇率) => 金额 * 汇率

  func 积分换算(消费金额: Float, 积分比例: Int) -> Int =
    (消费金额, 积分比例) => floor(消费金额) * 积分比例

  func 积分抵扣(可用积分: Int, 抵扣比例: Float, 总价: Float) -> Float =
    (可用积分, 抵扣比例, 总价) =>
    min([可用积分 * 抵扣比例, 总价 * 0.5])
}
