(* 资源库：算法基础
   覆盖：排序、搜索、分治
   ============================================================ *)

module 算法 {

  func 冒泡排序(arr: List) -> List = (arr) => {
    let n = len(arr)
    let result = arr
    let i = 0
    while i < n - 1 {
      let j = 0
      while j < n - i - 1 {
        if result[j] > result[j + 1] {
          let tmp = result[j]
          result[j] = result[j + 1]
          result[j + 1] = tmp
        }
        j = j + 1
      }
      i = i + 1
    }
    result
  }

  func 插入排序(arr: List) -> List = (arr) => {
    let result = arr
    let i = 1
    while i < len(result) {
      let key = result[i]
      let j = i - 1
      while j >= 0 and result[j] > key {
        result[j + 1] = result[j]
        j = j - 1
      }
      result[j + 1] = key
      i = i + 1
    }
    result
  }

  func 线性搜索(arr: List, target: Int) -> Int = (arr, target) => {
    let rec search(i: Int) -> Int = (i) =>
      i >= len(arr) ? -1 : arr[i] == target ? i : search(i + 1)
    search(0)
  }

  func 二分搜索(arr: List, target: Int) -> Int = (arr, target) => {
    let lo = 0
    let hi = len(arr) - 1
    let found = -1
    while lo <= hi {
      let mid = (lo + hi) / 2
      if arr[mid] == target {
        found = mid
        lo = hi + 1
      } else {
        if arr[mid] < target {
          lo = mid + 1
        } else {
          hi = mid - 1
        }
      }
    }
    found
  }

  func 时间复杂度_冒泡() -> String = () => "O(n^2)"
  func 时间复杂度_插入() -> String = () => "O(n^2)"
  func 时间复杂度_二分搜索() -> String = () => "O(log n)"
  func 时间复杂度_线性搜索() -> String = () => "O(n)"
}
