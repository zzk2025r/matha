(* 资源库：通用工具数学
   覆盖：日期时间、单位换算、图像处理、数据压缩
   ============================================================
   口径（阶段 41 真化批）：
   1. 无定义读数返回 None，不再伪造 999.0 / 0 / 恒等值——
      旧体在分母为 0 时给出 0（与真实比值不可区分），噪声功率为 0 时
      给出 999.0（哨兵值会污染下游统计）。
   2. 守卫必须作用在真正的除数上：JPEG压缩率 旧体守卫 原始大小 = 0
      而除数是 压缩大小，属假守卫（压缩大小为 0 时仍抛除零）。
   3. 换算函数只覆盖表内配对；表外配对返回 None 而非恒等回显——
      恒等回显把「未换算」伪装成「已换算且数值相同」。
   4. 链面（boot 编译器 + 解释器）注册内建不含 log10 / log2：旧体在链面
      恒「未定义变量」，函数从不可调用。按换底公式改写为
      log(x)/log(10.0)、log(x)/log(2.0)，hi / vm / 链面三面可调用。
   ============================================================ *)

module 工具数学 {

  (* ===== 日期时间 ===== *)
  func 闰年判断(年: Int) -> Bool =
    (年) => (年 % 4 = 0) and ((年 % 100 != 0) or (年 % 400 = 0))

  func 月份天数(月: Int, 年: Int) -> Int =
    (月, 年) =>
    match 月 {
      | 2 => if 闰年判断(年) then 29 else 28
      | 4 => 30
      | 6 => 30
      | 9 => 30
      | 11 => 30
      | _ => 31

    }
  func 年内天数(年: Int) -> Int =
    (年) => if 闰年判断(年) then 366 else 365

  func 日期差(年1: Int, 月1: Int, 日1: Int, 年2: Int, 月2: Int, 日2: Int) -> Int =
    (* 口径注：近似算法——固定 365 天年 / 30 天月，不计闰年与大小月，
       仅供量级估算；精确日历差需按 月份天数 逐月累加，本文件不提供。 *)
    (年1, 月1, 日1, 年2, 月2, 日2) =>
    (年2 - 年1) * 365 + (月2 - 月1) * 30 + (日2 - 日1)

  func 时间戳转日期(时间戳: Int) -> Int =
    (* 口径注：返回「距今整年数 + 1970」的粗估年份——按 365 天定长年折算，
       不含闰日修正；误差随时间戳增大（约每 4 年偏 1 天），不用于精确日期。
       本 Matha 的 `/` 恒浮除，旧式 `时间戳 / 31536000` 落小数年（2023.906…）与
       `-> Int` 声明和上述「整年数」口径相悖，故走整除 `//`。 *)
    (时间戳) => 1970 + 时间戳 // (365 * 24 * 3600)

  func 周几计算(年: Int, 月: Int, 日: Int) -> Int =
    (* 口径注：完整 Zeller 同族取模式（非简化），格里高利历，月/日须在合法区间。
       本式相位与标准 Zeller（h=0 为周六）固定错 4 位，按实测校准为
       0=周二、1=周三、2=周四、3=周五、4=周六、5=周日、6=周一
       （2026-11-24 周二返 0，2000-01-01 周六返 4，2024-02-10 周六返 4，
        1969-07-20 周日返 5）——只作星期序号使用，不自带日历语义。 *)
    (年, 月, 日) =>
    let y = if 月 <= 2 then 年 - 1 else 年 in
    let m = if 月 <= 2 then 月 + 12 else 月 in
    (日 + floor(2.6 * m - 0.2) + y + floor(y/4) - floor(y/100) + floor(y/400)) % 7

  (* ===== 单位换算 ===== *)
  (* 口径注：以下换算仅覆盖表内配对；表外配对（含 从 == 到）返回 None，
     旧体恒等回显 值 会把「未换算」伪装成「换算成功」。 *)
  func 长度换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    (从 == "米" and 到 == "厘米") ? 值 * 100 :
    (从 == "米" and 到 == "毫米") ? 值 * 1000 :
    (从 == "千米" and 到 == "米") ? 值 * 1000 :
    (从 == "英寸" and 到 == "厘米") ? 值 * 2.54 :
    (从 == "英尺" and 到 == "米") ? 值 * 0.3048 :
    None
  func 重量换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    (从 == "千克" and 到 == "克") ? 值 * 1000 :
    (从 == "磅" and 到 == "千克") ? 值 * 0.453592 :
    (从 == "吨" and 到 == "千克") ? 值 * 1000 :
    None
  func 温度换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    (从 == "摄氏" and 到 == "开尔文") ? 值 + 273.15 :
    (从 == "开尔文" and 到 == "摄氏") ? 值 - 273.15 :
    (从 == "摄氏" and 到 == "华氏") ? 值 * 9/5 + 32 :
    (从 == "华氏" and 到 == "摄氏") ? (值 - 32) * 5/9 :
    None
  func 面积换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    (从 == "平方米" and 到 == "平方英尺") ? 值 * 10.7639 :
    (从 == "公顷" and 到 == "平方米") ? 值 * 10000 :
    (从 == "亩" and 到 == "平方米") ? 值 * 666.67 :
    None
  func 体积换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    (从 == "升" and 到 == "毫升") ? 值 * 1000 :
    (从 == "加仑" and 到 == "升") ? 值 * 3.78541 :
    (从 == "立方米" and 到 == "升") ? 值 * 1000 :
    None
  (* ===== 数据处理 ===== *)
  func 数据压缩比(原始: Int, 压缩: Int) -> Float =
    (* 口径注：压缩比 = 原始 / 压缩；压缩大小为 0 时无定义 → None。
       旧体返回 0，与「压缩后大小远大于原始」的真实读数无法区分。 *)
    (原始, 压缩) =>
    if 压缩 = 0 then None else 原始 / 压缩

  func 数据压缩率(原始: Int, 压缩: Int) -> Float =
    (* 口径注：压缩率 = 1 - 压缩 / 原始；原始大小为 0 时无定义 → None。 *)
    (原始, 压缩) =>
    if 原始 = 0 then None else 1.0 - 压缩 / 原始

  func 信噪比(信号功率: Float, 噪声功率: Float) -> Float =
    (* 口径注：SNR(dB) = 10·log10(信号 / 噪声)，两功率须严格大于 0；
       否则无定义 → None（旧体噪声为 0 时伪造 999.0 哨兵值）。
       链面注册内建不含 log10，按换底公式 log(x)/log(10.0) 改写。 *)
    (信号功率, 噪声功率) =>
    if 噪声功率 <= 0 then None
    else if 信号功率 <= 0 then None
    else 10.0 * (log(信号功率 / 噪声功率) / log(10.0))

  func 数据熵(符号列表: List, 概率列表: List) -> Float =
    (* 口径注：Shannon 熵 -Σ p·log2(p)，取 min(符号数, 概率数) 项；
       概率 ≤ 0 的项按 0·log0 = 0 跳过；概率未归一化时为「非归一化熵」。
       链面注册内建不含 log2，按换底公式 log(x)/log(2.0) 改写。 *)
    (符号列表, 概率列表) => {
    let n = min([len(符号列表), len(概率列表)])
    let rec 累加(i: Int, acc: Float) -> Float =
    (i, acc) =>
      if i >= n then acc
      else if 概率列表[i] <= 0 then 累加(i + 1, acc)
      else 累加(i + 1, acc - 概率列表[i] * (log(概率列表[i]) / log(2.0)))
    累加(0, 0.0)
    }

  func 香农编码长度(概率: Float) -> Float =
    (* 口径注：码长 = -log2(p)，定义域 p ∈ (0, 1]；p ≤ 0 或 p > 1 时无定义 → None
       （旧体 p ≤ 0 时伪造 999.0）。链面不支持 log2，按换底公式改写。 *)
    (概率) =>
    if 概率 <= 0 then None
    else if 概率 > 1 then None
    else 0 - (log(概率) / log(2.0))

  (* ===== 图像处理工具 ===== *)
  func 图像分辨率(宽: Int, 高: Int) -> Int =
    (宽, 高) => 宽 * 高

  func 图像宽高比(宽: Int, 高: Int) -> Float =
    (* 口径注：高为 0 时无定义 → None（旧体返回 0，与「宽为 0」的真实读数 0 混淆）。 *)
    (宽, 高) =>
    if 高 = 0 then None else 宽 / 高

  func 图像像素密度(ppi: Int, 尺寸英寸: Float) -> Int =
    (* 口径注：投影恒等——像素密度由 ppi 与物理尺寸共同决定，本函数仅回显入参 ppi，
       不做换算；需要由 宽/高 与对角线英寸求 ppi 时请用 sqrt(宽²+高²)/尺寸英寸。 *)
    (ppi, 尺寸英寸) => ppi

  func 色彩深度位数(颜色数: Int) -> Int =
    (* 口径注：位宽 = ⌊log2(颜色数)⌋（2 的整次幂色数取精确 n）；颜色数 ≤ 1 时无定义 → None。
       旧体用冒号 `if n <= 1: acc` 代替 then，与本文件其余控制流的 then/else 写法不一致，
       此处统一；局部名 位宽 避免与链面缺失的 log2 内建同名混淆。 *)
    (颜色数) => {
    let rec 位宽(n: Int, acc: Int) -> Int =
    (n, acc) => if n <= 1 then acc else 位宽(n / 2, acc + 1)
    let 结果 = if 颜色数 <= 1 then None else 位宽(颜色数, 0)
    结果
    }

  (* ===== 文件格式 ===== *)
  func JPEG压缩率(原始大小: Int, 压缩大小: Int) -> Float =
    (* 口径注：JPEG 压缩比 = 原始 / 压缩。旧体守卫的是 原始大小 = 0，
       而真正的除数是 压缩大小——属假守卫：压缩大小为 0 时仍抛除零、
       原始为 0 时返回的 0 与真实读数（原始 ≪ 压缩）不可区分。改为守卫除数。 *)
    (原始大小, 压缩大小) =>
    if 压缩大小 = 0 then None else 原始大小 / 压缩大小

  func PNG无损压缩率(原始: Int, 压缩: Int) -> Float =
    (* 口径注：压缩大小为 0 时无定义 → None。 *)
    (原始, 压缩) =>
    if 压缩 = 0 then None else 原始 / 压缩

  func MP4码率(文件大小: Float, 时长: Float) -> Float =
    (* 口径注：码率 = 文件大小 × 8 / 时长（单位为 kbps 需文件大小按 KB、时长按 s）；
       时长为 0 时无定义 → None。 *)
    (文件大小, 时长) =>
    if 时长 = 0 then None else 文件大小 * 8 / 时长
}
