(* 资源库：地理信息
   覆盖：距离计算、时区、海拔气压、地图投影
   ============================================================
   口径（阶段 41 真化批）：
   - 指数写成 2.718281828459045 ^ x，反三角走 sin 二分求根——链面注册内建
     不含 exp / atan2 / asin，旧体在链面恒「未定义变量」，函数从不可调用
   - Haversine 中间量 a 先钳进 [0, 1]（浮点误差能把 a 顶出 asin 定义域）
   - 二分 50 轮把角度压到 ~1.4e-15，与宿主 atan2 的差在末位，非同一算法
   ============================================================ *)

module 地理信息 {

  (* 球面大圆距离（Haversine）：d = 2R·asin(√a)，
     a = sin²(Δφ/2) + cosφ1·cosφ2·sin²(Δλ/2)；经纬度按弧度传入。
     atan2(√a, √(1−a)) 与 asin(√a) 在 a ∈ [0,1] 同值，故取后者（只需一元反函数）。 *)
  func 大圆距离(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float =
    (lat1, lon1, lat2, lon2) =>
    let R = 6371.0 in
    let dlat = lat2 - lat1 in
    let dlon = lon2 - lon1 in
    let a = sin(dlat/2)^2 + cos(lat1) * cos(lat2) * sin(dlon/2)^2 in
    半中心角(钳单位(a))

  func 半中心角(a: Float) -> Float =
    (a) => 2 * 反正弦(sqrt(a))

  func 钳单位(a: Float) -> Float =
    (a) => if a > 1 then 1.0 else if a < 0 then 0.0 else a

  (* 反正弦：sin 在 [0, π/2] 单调递增，50 轮二分取根（x 须 ∈ [-1,1]，
     由调用侧钳位保证；越界时二分恒推向端点，取到 ±π/2）。 *)
  func 反正弦(x: Float) -> Float =
    (x) => 正弦二分(0.0, 1.5707963267948966, x, 0)

  func 正弦二分(lo, hi, x, k: Int) -> Float =
    (lo, hi, x, k) => {
    let 中 = (lo + hi) / 2.0
    let 角 = if k >= 50 then 中 else 正弦半区(lo, hi, 中, x, k)
    角
    }

  func 正弦半区(lo, hi, 中, x, k: Int) -> Float =
    (lo, hi, 中, x, k) =>
    let 值 = sin(中) in
    let 半区 = 值 < x ? [中, hi] : [lo, 中] in
    let 角 = 正弦二分(半区[0], 半区[1], x, k + 1) in
    角

  (* 时区差：经度差 / 15（每 15° 一时区），取绝对值——不表方向，不含夏令时。 *)
  func 时区差(经度1: Float, 经度2: Float) -> Float =
    (经度1, 经度2) => abs(经度1 - 经度2) / 15

  (* 海拔气压：国际标准大气低层近似 P = 101.325·e^(−0.00012·h)（h 为米），
     仅在 0 ~ 约 11km 对流层内贴合，高层不建模。 *)
  func 海拔气压(海拔: Float) -> Float =
    (海拔) => 101.325 * (2.718281828459045 ^ (0 - 0.00012 * 海拔))

  (* 坡度百分数 = 高差 / 水平距离 × 100；水平距离 = 0 无坡度口径 → None。 *)
  func 坡度计算(高差: Float, 水平距离: Float) -> Float =
    (高差, 水平距离) =>
    if 水平距离 = 0 then None else 高差 / 水平距离 * 100

  func 比例尺换算(图上距离: Float, 比例: Int) -> Float =
    (图上距离, 比例) => 图上距离 * 比例
}
