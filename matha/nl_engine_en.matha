(* ============================================================
   Matha 自然语言英语执行器（阶段 8d：英语语义框架 → 自举求值）
   ------------------------------------------------------------
   复用 8c 执行链：句子 → 英语词法/句法（语义框架）→ 注册内建(空环境)
   → 自举 求值。歧义/超控制子集句子经 NL英语编译 显式 错误 拒绝，
   永不静默回退。宿主/VM 以独立命名内建 自然语言执行英语 委托本链，
   与中文链 自然语言执行 及既有混合接口零冲突。
   ============================================================ *)

module 自然语言英语执行器 {
  use 自然语言英语句法器 { NL英语编译 }
  use 解释器 { 求值 | 注册内建 | 空环境 }

  (* 句子 → 语义框架 → 自举求值 → 结果值。 *)
  func NL英语执行(句子: String) -> Value =
    let 框架 = NL英语编译(句子) in
    let env = 注册内建(空环境()) in
    求值(框架, env)
}