(* ============================================================
   Matha 自然语言英语词法器（阶段 8d：英语控制子集分词 + 词类标注）
   ------------------------------------------------------------
   控制子集（全部小写化后匹配）：
     - 前导：compute / calculate / what / is（跳过）
     - 运算：plus|add → +、minus|subtract → -、times → *、divided-by → /
     - 数词：数字串（"123"）、英文数词单词（zero..ninety/hundred/thousand）、
       连字复合数词（twenty-one=21、three-thousand-five-hundred=3500），
       复合序列不合法（如 twenty-hundred、five-twenty）显式拒绝
     - 其余词 → 经用户词典单层替换后仍未知 → 错误 拒绝（永不静默回退）
   空格分隔复合数词（"twenty five"）按 连续数词 由句法器显式拒绝（边界如实登记）。
   token 形态与中文词法器一致：关键词 ["词", 文本, 词类]、数词 ["数字", str, "数词"]。
   ============================================================ *)

module 自然语言英语词法器 {
  use 标准库 { len | find | 截取 | split | strip | to_lower | str | int }
  use 自然语言词法器 { 是数字码 }
  use 用户词典 { 默认词典 | 替换词表 }

  (* ===== 英文数词值：单词（无连字符）；非数词返回 -1 ===== *)
  func 英语数词值(w: String) -> Int =
    if w = "zero" then 0
    else if w = "one" then 1
    else if w = "two" then 2
    else if w = "three" then 3
    else if w = "four" then 4
    else if w = "five" then 5
    else if w = "six" then 6
    else if w = "seven" then 7
    else if w = "eight" then 8
    else if w = "nine" then 9
    else if w = "ten" then 10
    else if w = "eleven" then 11
    else if w = "twelve" then 12
    else if w = "thirteen" then 13
    else if w = "fourteen" then 14
    else if w = "fifteen" then 15
    else if w = "sixteen" then 16
    else if w = "seventeen" then 17
    else if w = "eighteen" then 18
    else if w = "nineteen" then 19
    else if w = "twenty" then 20
    else if w = "thirty" then 30
    else if w = "forty" then 40
    else if w = "fifty" then 50
    else if w = "sixty" then 60
    else if w = "seventy" then 70
    else if w = "eighty" then 80
    else if w = "ninety" then 90
    else if w = "hundred" then 100
    else if w = "thousand" then 1000
    else -1

  (* ===== 连字复合数词序列合法性（不抛错，供分类） ===== *)
  (* 状态机 last：无=起始 U=个位 T=十几 S=整十 H=百 K=千。 *)
  func _复合合法(parts: List, i: Int, last: String) -> Bool =
    if i >= len(parts) then 真
    else
      let p = parts[i] in
      let v = 英语数词值(p) in
      if v < 0 then 假
      else if p = "hundred" then
        (if last = "U" then _复合合法(parts, i + 1, "H") else 假)
      else if p = "thousand" then
        (if last = "U" then _复合合法(parts, i + 1, "K") else 假)
      else if v >= 20 then
        (if last = "无" or last = "K" then _复合合法(parts, i + 1, "S") else 假)
      else if v >= 10 then
        (if last = "无" then _复合合法(parts, i + 1, "T") else 假)
      else
        (if last = "无" or last = "S" or last = "H" or last = "K" then _复合合法(parts, i + 1, "U") else 假)

  func 是英语复合数词(w: String) -> Bool =
    let parts = split(w, "-") in
    if len(parts) < 2 then 假 else _复合合法(parts, 0, "无")

  (* ===== 连字复合数词值（仅对已通过 _复合合法 的序列调用） ===== *)
  func 英语复合数词值(w: String) -> Int =
    let parts = split(w, "-") in
    let rec _go(i: Int, total: Int, section: Int, num: Int, last: String) -> Int =
      if i >= len(parts) then total + section + num
      else
        let p = parts[i] in
        let v = 英语数词值(p) in
        if p = "hundred" then
          _go(i + 1, total, section + num * 100, 0, "H")
        else if p = "thousand" then
          _go(i + 1, total + (section + num) * 1000, 0, 0, "K")
        else if v >= 20 then
          _go(i + 1, total, section, v, "S")
        else if v >= 10 then
          _go(i + 1, total, section, v, "T")
        else if last = "S" then
          _go(i + 1, total, section, num + v, "U")
        else
          _go(i + 1, total, section, v, "U")
    in _go(0, 0, 0, 0, "无")

  (* ===== 纯数字串判定（至少一位、全为 0-9） ===== *)
  func 全数字(w: String) -> Bool =
    let rec _go(i: Int) -> Bool =
      if i >= len(w) then 真
      else if 是数字码(w[i]) then _go(i + 1)
      else 假
    in _go(0)

  (* ===== 数词文本 → Int（数字串 / 连字复合 / 单词） ===== *)
  func 英语数词文本值(w: String) -> Int =
    if 全数字(w) then int(w)
    else if find("-", w) >= 0 then 英语复合数词值(w)
    else 英语数词值(w)

  (* ===== 词类标注（输入已小写化并经词典替换） ===== *)
  func 词类标注英语(w: String) -> String =
    if w = "compute" or w = "calculate" or w = "what" or w = "is" then
      "前导"
    else if w = "plus" or w = "add" or w = "minus" or w = "subtract" or
            w = "times" or w = "divided-by" then
      "动词"
    else if 全数字(w) then
      "数词"
    else if find("-", w) >= 0 then
      (if 是英语复合数词(w) then "数词" else "未知")
    else if 英语数词值(w) >= 0 then
      "数词"
    else
      "未知"

  (* ===== 主入口：英语 NL 词法分析 ===== *)
  func NL英语词法分析(句子: String) -> List =
    NL英语词法分析带词典(句子, 默认词典())

  (* 显式词典入口：测试/下游可注入自定义词典。 *)
  func NL英语词法分析带词典(句子: String, 词典: Dict) -> List =
    let 分割后 = 替换词表(split(to_lower(strip(句子)), " "), 词典) in
    let rec _go(i: Int, acc: List) -> List =
      if i >= len(分割后) then
        (if len(acc) = 0 then 错误("句子为空或仅含空白") else acc)
      else
        let 词 = 分割后[i] in
        if 词 = "" then
          _go(i + 1, acc)
        else
          let 类 = 词类标注英语(词) in
          if 类 = "前导" or 类 = "动词" then
            _go(i + 1, acc + [["词", 词, 类]])
          else if 类 = "数词" then
            _go(i + 1, acc + [["数字", str(英语数词文本值(词)), "数词"]])
          else
            错误("超出控制子集的英语词: " + 词)
    in _go(0, [])
}