(* ============================================================
   Matha 自举语法分析器（完整版）
   ------------------------------------------------------------
   递归下降解析器，输入 Token 流，输出 AST。
   对应 src/parser.py 的完整功能。
   
   调用入口：parse(tokens) → AST
   ============================================================ *)

module 语法器 {

  use 词法器 { Token | 类型 | 扫描 | 做Token }

  (* ===== AST 数据模型 ===== *)

  (* 用 dict 表示 AST 节点（无 struct 时的替代）=====
     节点格式：{"类型": "...", ...}
     通过不同的 "类型" 字段区分节点种类 ===== *)

  (* ===== AST 节点构造子 ===== *)
  func 做Program(decls: List) -> Dict = {"类型": "程序", "声明": decls}
  func 做FuncDef(name: String, params: List, ret_type: String, body: Dict) -> Dict =
    {"类型": "函数定义", "名": name, "参数": params, "返回类型": ret_type, "体": body}
  func 做Binding(name: String, value: Dict) -> Dict = {"类型": "绑定", "名": name, "值": value}
  (* let 绑定表达式：let [rec] 名 = 值 [in 体]
     - 递归=真：值中的 lambda 可引用绑定名自身（经占位符+原地更新实现）
     - 有体=真：体 为绑定作用域内的续体表达式，求值结果取体 *)
  func 做Let绑定(名: String, 值: Dict, 递归: Bool, 有体: Bool, 体: Dict) -> Dict =
    {"类型": "let绑定", "名": 名, "值": 值, "递归": 递归, "有体": 有体, "体": 体}
  (* let 元组解构：let (a, b, ...) = expr [in body] —— 多变量绑定 *)
  func 做Let元组绑定(名字: List, 值: Dict, 有体: Bool, 体: Dict) -> Dict =
    {"类型": "let元组绑定", "名字": 名字, "值": 值, "有体": 有体, "体": 体}
  func 做Output(expr: Dict) -> Dict = {"类型": "输出", "expr": expr}
  (* ===== 机械单元 #N：… =====
     与宿主 MechUnit → GenStmt → OutputTrail → Output 透传链一一对应：
       #：{ … }      → 机械单元 + 代码块（自测块）
       #N：【命令】   → 生成语句 + 命令字面量
       #N：？expr     → 生成语句 + 表达式
       #N：[输出]     → 生成语句 + 输出追踪 + 输出
     输出单元在语句位置编译为 `求值; OP_OUTPUT`（不 DUP；表达式位置的
     输出(...) 才 DUP 以留值）。 *)
  func 做机械单元(body: Dict) -> Dict = {"类型": "机械单元", "body": body}
  func 做生成语句(content: Dict) -> Dict = {"类型": "生成语句", "content": content}
  func 做输出追踪(expr: Dict) -> Dict =
    {"类型": "输出追踪", "输出": 做Output(expr)}
  (* []：空输出。用独立节点类型标记，使编译器可识别为「不发射任何指令」，
     避免与真实表达式节点混淆。 *)
  func 做空输出() -> Dict = {"类型": "空输出"}
  (* raise <expr>：抛出异常（作为表达式，与宿主 RaiseExpr 对齐） *)
  func 做抛出(值: Dict) -> Dict = {"类型": "抛出", "值": 值}
  (* { } 集合构造：枚举形式 {1, 2} / 理解形式 {输出 | 生成子句 | 条件}。
     form 为 "enumeration" 或 "comprehension"；未使用的槽位传 null，
     与宿主 SetConstruct(form, variables, conditions, literals, output) 对齐：
     理解形式 variables 为生成子句列表（每项 {"名": 名, "集合": 可迭代表达式}），
     conditions 为过滤条件列表，output 为输出表达式；枚举形式只用 literals。 *)
  func 做集合构造(form: String, variables, conditions, literals, output) -> Dict =
    {"类型": "集合构造", "form": form, "variables": variables,
     "conditions": conditions, "literals": literals, "output": output}
  (* a ∈ b：成员判定（对应宿主 ast.Belongs） *)
  func 做属于(left: Dict, right: Dict) -> Dict =
    {"类型": "属于", "左": left, "右": right}
  (* typeof <expr>：返回类型名称（对应宿主 ast.TypeOfExpr） *)
  func 做typeof(operand: Dict) -> Dict =
    {"类型": "typeof", "操作数": operand}
  (* a is b：同一性判断（对应宿主 ast.IsExpr，编译为 BINOP "is"） *)
  func 做同一性(左: Dict, 右: Dict) -> Dict =
    {"类型": "同一性", "左": 左, "右": 右}
  (* try { 块 } catch [(e)] { 块 } [finally { 块 }]：
     捕获变量为 "" 表示无变量 catch；finally体 为空 Program 表示无 finally *)
  func 做Try(try体: Dict, 捕获变量: String, 捕获体: Dict, finally体: Dict) -> Dict =
    {"类型": "try", "try体": try体, "捕获变量": 捕获变量, "捕获体": 捕获体, "finally体": finally体}
  func 做If(cond: Dict, then_branch: Dict, else_branch: Dict) -> Dict =
    {"类型": "if", "条件": cond, "真分支": then_branch, "假分支": else_branch}
  (* 自然语言块【…】：对应宿主 ast.NLBlock。宿主把它列入 _NOOP_STMTS
     （编译期不产任何字节码），故这里只承载文本、发射阶段为空操作。
     标注体形如 【*/自主成长：从源码学习/*】，词法上是 乘/除 夹一串 token。 *)
  func 做自然语言块(标注: String, 正文: String) -> Dict =
    {"类型": "自然语言块", "标注": 标注, "正文": 正文}
  (* @define_op : <符号> = <优先级> | <结合性> [ => <处理函数> ] —— 对应宿主
     ast.DefineOp，编译期 NOOP（_NOOP_STMTS）。绑定信息累积进解析器状态 自定义表，
     使自定义运算符可在表达式中使用（二元节点携带「实现」函数名）。 *)
  func 做定义运算符() -> Dict = {"类型": "定义运算符"}
  (* 通道构造 chan T → 降级为 {"缓冲": [], "容量": n, "关闭": False}
     （对应宿主 ast.ChanExpr；容量宿主固定 None → 编译为 0）。
     发送 ch <- v → ast.SendExpr。 *)
  func 做通道(元素类型: String) -> Dict =
    {"类型": "通道", "元素类型": 元素类型}
  func 做发送(通道: Dict, 值: Dict) -> Dict =
    {"类型": "发送", "通道": 通道, "值": 值}
  func 做While(cond: Dict, body: Dict) -> Dict = {"类型": "while", "条件": cond, "体": body}
  func 做For(var_name: String, iterable: Dict, body: Dict) -> Dict =
    {"类型": "for", "变量": var_name, "迭代": iterable, "体": body}
  func 做Match(scrutinee: Dict, branches: List) -> Dict = {"类型": "match", "scrutinee": scrutinee, "分支": branches}
  (* switch 节点：与宿主 ast_nodes.SwitchStmt 对应（值 / 分支[[case_val,body]] / 默认）。
     默认分支无则传 null。 *)
  func 做Switch(value: Dict, branches: List, 默认: Dict) -> Dict =
    {"类型": "switch", "值": value, "分支": branches, "默认": 默认}
  (* 构造子模式 Some(x) / None()：宿主 pattern 用字典 {"Some": 值} 匹配，
     字段为子模式列表（按位置对应）。 *)
  func 做构造子模式(name: String, fields: List) -> Dict =
    {"类型": "构造子模式", "名": name, "字段": fields}
  func 做Lambda(params: List, body: Dict) -> Dict = {"类型": "lambda", "参数": params, "体": body}
  func 做BinaryOp(op: String, left: Dict, right: Dict) -> Dict = {"类型": "二元运算", "运算符": op, "左": left, "右": right}
  (* 自定义运算符二元节点：@define_op 绑定具名函数时使用独立节点类型，
     携带「实现」函数名供解释器 / 编译器调用（普通二元运算无此节点）。 *)
  func 做自定义二元(op: String, left: Dict, right: Dict, 实现: String) -> Dict =
    {"类型": "自定义二元", "运算符": op, "左": left, "右": right, "实现": 实现}
  func 做UnaryOp(op: String, operand: Dict) -> Dict = {"类型": "一元运算", "运算符": op, "操作数": operand}
  func 做FuncApp(func: Dict, arg: Dict) -> Dict = {"类型": "函数应用", "函数": func, "参数": arg}
  func 做IntLit(n: Int) -> Dict = {"类型": "整数", "值": n}
  func 做FloatLit(n: Float) -> Dict = {"类型": "浮点", "值": n}
  func 做StringLit(s: String) -> Dict = {"类型": "字符串", "值": s}
  func 做BoolLit(b: Bool) -> Dict = {"类型": "布尔", "值": b}
  func 做Variable(name: String) -> Dict = {"类型": "变量", "名": name}
  func 做StructDef(name: String, fields: List) -> Dict = {"类型": "结构体", "名": name, "字段": fields}
  func 做EnumDef(name: String, ctors: List) -> Dict = {"类型": "枚举", "名": name, "构造子": ctors}
  (* 属性访问 a.b —— obj 为对象表达式（通常是变量节点），name 为属性名 *)
  func 做Attr(obj: Dict, name: String) -> Dict =
    {"类型": "属性", "对象": obj, "名": name}
  (* 列表字面量 [a, b, c] —— 元素为表达式节点列表 *)
  func 做ListLit(元素: List) -> Dict = {"类型": "列表", "元素": 元素}
  (* 元组字面量 (a, b, c) —— 与宿主 TupleExpr 一致，编译为 BUILD_LIST *)
  func 做元组(元素: List) -> Dict = {"类型": "元组", "元素": 元素}
  (* 下标访问 a[i] —— 容器为表达式节点，索引为表达式节点 *)
  func 做Subscript(容器: Dict, 索引: Dict) -> Dict =
    {"类型": "下标", "容器": 容器, "索引": 索引}
  (* 可选链 a?.b / a?.[i]：为空则整体为空。
     is_index 为 true 时 右 是索引表达式节点，否则是属性名文本。 *)
  func 做安全路径(左: Dict, is_index: Bool, 右) -> Dict =
    {"类型": "安全路径", "左": 左, "是下标": is_index, "右": 右}
  (* 角度包装 ⟨expr⟩：单值包装，编译期直接取内层值 *)
  func 做尖括号(内: Dict) -> Dict = {"类型": "尖括号", "内": 内}
  (* 切片 a[start:end] —— 开始/结束为表达式节点或 None（做IntLit(-1) 标记 None） *)
  func 做切片(容器: Dict, 开始: Dict, 结束: Dict) -> Dict =
    {"类型": "切片", "容器": 容器, "开始": 开始, "结束": 结束}
  (* 字典字面量 {k1: v1, k2: v2, ...} —— 键和值均为表达式节点列表 *)
  func 做DictLit(键: List, 值: List) -> Dict =
    {"类型": "字典", "键": 键, "值": 值}
  (* 模块声明：module 名 { 声明... } —— 展平为带前缀的声明列表 *)
  func 做模块(名: String, 声明: List) -> Dict =
    {"类型": "模块", "名": 名, "声明": 声明}
  (* use 导入：use 名 { 导入名 | ... } —— 解析后由编译器忽略（函数已在全局） *)
  func 做导入(模块名: String, 名字: List) -> Dict =
    {"类型": "导入", "模块名": 模块名, "名字": 名字}

  (* ===== 解析器状态 ===== *)
  struct 解析器 {
    tokens: List
    pos: Int
    line: Int
    col: Int
    (* 禁止并列：输出括号 [ … ] 内解析时置真，禁用并列应用（juxtaposition），
       以对齐宿主 parser（无并列应用语法）。缺省 / 假 表示允许并列。 *)
    禁止并列: Bool
    (* 自定义运算符表：@define_op 声明累积的 [信息] 列表，供表达式层优先级爬升
       与二元节点「实现」字段使用。每项为
       {"符号": ..., "优先级": ..., "结合性": ..., "处理函数": ...}。
       缺省为空表（宿主 src/custom_ops.REGISTRY 的自举对应物）。 *)
    自定义: List
    (* 在理解头：集合理解 `{ 输出 | 子句 | ... }` 的头部/子句解析期间置真，
       使 `|` 作为子句分隔符而非位或（对齐宿主 _in_comp_head / _parse_bit_expr）。
       缺省 假。 *)
    在理解头: Bool
  }

  (* ===== 解析器辅助 ===== *)
  (* 规范化：跳过 pos 处的换行 token（多行源码支持），
     使解析器状态的 pos 始终指向非换行 token。 *)
  func 规范(p: 解析器) -> 解析器 = (p) =>
    (p.pos < len(p.tokens) and p.tokens[p.pos].类型 = 类型.换行) ?
      规范({ tokens: p.tokens, pos: p.pos + 1, line: p.line + 1, col: 1, 禁止并列: p.禁止并列, 自定义: p.自定义, 在理解头: p.在理解头 }) : p

  (* 推进：消费当前 token，并规范化到下一个非换行 token *)
  func 推进(p: 解析器) -> 解析器 =
    规范({ tokens: p.tokens, pos: p.pos + 1, line: p.line, col: p.col, 禁止并列: p.禁止并列, 自定义: p.自定义, 在理解头: p.在理解头 })

  (* 推进原样：消费当前 token 但**不**跳过换行。
     自然语言块需区分「】后紧跟换行」（正文为空）与「】后同行还有正文」，
     而 推进 会吞掉换行，故单列一个原样版本。 *)
  func 推进原样(p: 解析器) -> 解析器 =
    { tokens: p.tokens, pos: p.pos + 1, line: p.line, col: p.col, 禁止并列: p.禁止并列, 自定义: p.自定义, 在理解头: p.在理解头 }

  func 当前(p: 解析器) -> Token = (p) =>
    (p.pos < len(p.tokens)) ? p.tokens[p.pos] : 做Token(类型.结束, "", p.line, p.col)

  func 匹配(p: 解析器, t: 类型) -> Bool =
    当前(p).类型 = t

  (* 匹配指定文本的关键字（and/or/in/rec 等以 关键字 类型呈现） *)
  func 匹配关键字文本(p: 解析器, 文本: String) -> Bool =
    当前(p).类型 = 类型.关键字 and 当前(p).文本 = 文本

  (* 期望指定文本的关键字：匹配则推进，否则报错 *)
  func 期望关键字文本(p: 解析器, 文本: String) -> 解析器 =
    匹配关键字文本(p, 文本) ? 推进(p) : 错误("期望 " + 文本)

  (* 当前关键字是否位于行首（token 流中前一元素为换行）。
     用途：行首 and 是互递归函数延续（and g(...) = ...）而非逻辑运算符——
     与宿主「表达式止于换行」语义一致。 *)
  func 是行首关键字(p: 解析器) -> Bool =
    p.pos > 0 and p.tokens[p.pos - 1].类型 = 类型.换行

  (* 期望当前 token 类型为 t：匹配则推进并返回【新解析器状态】，否则报错 *)
  func 期望(p: 解析器, t: 类型) -> 解析器 =
    if 匹配(p, t) then 推进(p)
    else 错误("期望 " + 类型名(t))

  (* ===== 关键字匹配辅助函数 ===== *)
  func 是结束(p: 解析器) -> Bool = 当前(p).类型 = 类型.结束
  func 匹配函数关键字(p: 解析器) -> Bool =
    当前(p).类型 = 类型.关键字 and 当前(p).文本 = "func"
  func 匹配结构体关键字(p: 解析器) -> Bool =
    当前(p).类型 = 类型.关键字 and 当前(p).文本 = "struct"
  func 匹配枚举关键字(p: 解析器) -> Bool =
    当前(p).类型 = 类型.关键字 and 当前(p).文本 = "enum"

  (* 跳过分号语句分隔符（ASCII `;`，自举词法器降级为 符号）。宿主
     _skip_semicolon 在代码块/顶层语句循环里消费它，兼容 Python/C 风格；
     此处对齐，支持 `{ let x = 1; x + 1 }` 等写法。全角 `；` 已映射为
     全角冒号，由对应分支处理。 *)
  func 跳过分号(p: 解析器) -> 解析器 =
    if 当前(p).类型 = 类型.符号 and 当前(p).文本 = ";" then 跳过分号(推进(p)) else p

  (* ===== 类型名映射 ===== *)
  func 类型名(t: 类型) -> String =
    t = 类型.整数 ? "整数" :
    t = 类型.浮点 ? "浮点" :
    t = 类型.字符串 ? "字符串" :
    t = 类型.布尔 ? "布尔" :
    t = 类型.标识符 ? "标识符" :
    t = 类型.关键字 ? "关键字" :
    t = 类型.符号 ? "符号" :
    t = 类型.换行 ? "换行" :
    t = 类型.结束 ? "EOF" :
    t = 类型.加 ? "+" :
    t = 类型.减 ? "-" :
    t = 类型.乘 ? "*" :
    t = 类型.除 ? "/" :
    t = 类型.取模 ? "%" :
    t = 类型.整除 ? "//" :
    t = 类型.次方 ? "^" :
    t = 类型.等于 ? "=" :
    t = 类型.不等于 ? "!=" :
    t = 类型.大于 ? ">" :
    t = 类型.小于 ? "<" :
    t = 类型.大于等于 ? ">=" :
    t = 类型.小于等于 ? "<=" :
    t = 类型.箭头 ? "->" :
    t = 类型.胖箭头 ? "=>" :
    t = 类型.发送 ? "<-" :
    t = 类型.问号 ? "?" :
    t = 类型.冒号 ? ":" :
    t = 类型.管道 ? "|" :
    t = 类型.左括号 ? "(" :
    t = 类型.右括号 ? ")" :
    t = 类型.左括号方 ? "[" :
    t = 类型.右括号方 ? "]" :
    t = 类型.左括号花 ? "{" :
    t = 类型.右括号花 ? "}" :
    t = 类型.逗号 ? "," :
    t = 类型.点 ? "." :
    t = 类型.下划线 ? "_" :
    t = 类型.占位符 ? "？" :
    "未知"

  (* 错误：直接使用宿主/VM 提供的抛出式「错误」内建（msg -> 抛出异常），
     不在此重定义为 dict 构造子，否则错误值会沿状态线程传播而非中止解析。 *)

  (* ===== 优先级解析器（递归下降）===== *)

  (* 解析表达式（递归下降 + 算符优先级）=====
     表达式层次（由低到高）：
       三元：cond ? then : else
       逻辑或：a or b
       逻辑与：a and b
       等于：a = b
       比较：a < > <= >= <> !=
       加减：a + -
       乘除取模：a * / %
       一元：-x, ^x
       函数应用：f(x)
       括号：(expr)
       字面量/变量 *)

  func 解析表达式(p: 解析器) -> (Dict, 解析器) =
    解析三元(p)

  (* 三元条件：cond ? then : else 或 cond ? then else
     支持冒号 : 和 else 关键字作为分隔符。
     当 then 分支为 if-expr 时，else 可能属于内层 if 而非外层三元——
     此时 else 后跟 then/else/in 则视为内层，不消费。 *)
  func 解析三元(p: 解析器) -> (Dict, 解析器) =
    let (cond, p2) = 解析自定义(p) in
    if 匹配(p2, 类型.问号) then
      let p3 = 推进(p2) in
      let (then_expr, p4) = 解析三元(p3) in
      if 匹配(p4, 类型.冒号) then
        let p5 = 推进(p4) in
        let (else_expr, p6) = 解析三元(p5) in
        (做If(cond, then_expr, else_expr), p6)
      else if 匹配关键字文本(p4, "else") then
        (* else 后是否为 then/else/in（内层 if-expr 的 else） *)
        let nxt = 当前(推进(p4)) in
        if nxt.类型 = 类型.关键字 and (nxt.文本 = "then" or nxt.文本 = "else" or nxt.文本 = "in") then
          (* else 属于内层 if-expr，不消费 → 无外层 else *)
          (做If(cond, then_expr, null), p4)
        else
          let p5 = 推进(p4) in
          let (else_expr, p6) = 解析三元(p5) in
          (做If(cond, then_expr, else_expr), p6)
      else
        (做If(cond, then_expr, null), p4)
    else (cond, p2)

  (* ===== 用户自定义运算符（@define_op）=====
     查询：按符号在解析器状态 自定义表 中查找（未注册返回 null）。 *)
  func 查自定义(p: 解析器, 符: String) -> Dict =
    过滤自定义(p.自定义, 符, 0)

  func 过滤自定义(表: List, 符: String, i: Int) -> Dict =
    if i >= len(表) then null
    else if 表[i]["符号"] = 符 then 表[i]
    else 过滤自定义(表, 符, i + 1)

  (* 自定义运算符表达式层：先按常规 or 链解析左操作数，再优先级爬升接入
     @define_op 注册的运算符（对齐宿主 _parse_custom_op_expr/_rest）。 *)
  func 解析自定义(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析或(p) in
    解析自定义_续(left, p2, 0)

  func 解析自定义_续(left: Dict, p: 解析器, 最低: Int) -> (Dict, 解析器) =
    let t = 当前(p) in
    if t.类型 = 类型.符号 then
      let 信息 = 查自定义(p, t.文本) in
      if 信息 = null then (left, p)
      else if 信息["优先级"] < 最低 then (left, p)
      else
        let p1 = 推进(p) in
        let (right0, p2) = 解析或(p1) in
        let 次最低 = 信息["结合性"] = "right" ? 信息["优先级"] : 信息["优先级"] + 1 in
        let (right, p3) = 解析自定义_续(right0, p2, 次最低) in
        解析自定义_续(做自定义二元(信息["符号"], left, right, 信息["处理函数"]), p3, 最低)
    else (left, p)

  (* 逻辑或：a or b or c ...（左结合循环） *)
  func 解析或(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析与(p) in
    解析或_续(left, p2)

  func 解析或_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 匹配关键字文本(p, "or") then
      let p3 = 推进(p) in
      let (right, p4) = 解析与(p3) in
      解析或_续(做BinaryOp("or", left, right), p4)
    else (left, p)

  (* 逻辑与：a and b and c ...（左结合循环，绑定紧于 or）。
     行首 and 视为互递归函数延续边界，不作为逻辑运算符消费。 *)
  func 解析与(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析属于(p) in
    解析与_续(left, p2)

  func 解析与_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 匹配关键字文本(p, "and") and not 是行首关键字(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析属于(p3) in
      解析与_续(做BinaryOp("and", left, right), p4)
    else (left, p)

  (* 属于判断：a ∈ b（成员判定）。
     优先级：比比较运算符松（与宿主 _parse_set_expr 同层），
     故右侧仍按比较层解析——`1 ∈ a == b` 得到 Belongs(1, a == b)。
     运算符为符号 token，文本 "∈"（宿主 lexer 同样落 SYMBOL）。 *)
  func 是属于符(p: 解析器) -> Bool =
    let t = 当前(p) in
    t.类型 = 类型.符号 and t.文本 = "∈"

  func 解析属于(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析比较(p) in
    解析属于_续(left, p2)

  func 解析属于_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 是属于符(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析比较(p3) in
      解析属于_续(做属于(left, right), p4)
    else (left, p)

  (* 比较：= <> != < > <= >=（左结合循环） *)
  func 解析比较(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析集合(p) in
    解析比较_续(left, p2)

  func 解析比较_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    let (op_tok, p3) = 解析比较_op(p) in
    if op_tok = "" then (left, p)
    else
      let (right, p4) = 解析集合(p3) in
      if 是关系运算符(op_tok) then
        解析关系链_续(做BinaryOp(op_tok, left, right), null, right, p4)
      else
        解析比较_续(做BinaryOp(op_tok, left, right), p4)

  (* 关系运算符（可链式比较）判定：< > <= >=（对齐宿主 _parse_rel_expr 的链式分支） *)
  func 是关系运算符(op: String) -> Bool =
    op = "<" or op = ">" or op = "<=" or op = ">="

  (* 链式比较：`a <= b <= c` → `(a <= b) and (b <= c)`，中间项复用。
     对齐宿主 chain 累积：chain 为右嵌套 and，末置于 `and(first, chain)`。 *)
  func 解析关系链_续(first: Dict, chain, 前右: Dict, p: 解析器) -> (Dict, 解析器) =
    let (op_tok, p2) = 解析比较_op(p) in
    if 是关系运算符(op_tok) then
      let (right2, p3) = 解析集合(p2) in
      let cmp2 = 做BinaryOp(op_tok, 前右, right2) in
      let chain2 = chain = null ? cmp2 : 做BinaryOp("and", chain, cmp2) in
      解析关系链_续(first, chain2, right2, p3)
    else
      (chain = null ? first : 做BinaryOp("and", first, chain), p)

  func 解析比较_op(p: 解析器) -> (String, 解析器) =
    if 匹配(p, 类型.等于) then ("=", 推进(p))
    else if 匹配(p, 类型.不等于) then ("!=", 推进(p))
    else if 匹配(p, 类型.大于等于) then (">=", 推进(p))
    else if 匹配(p, 类型.小于等于) then ("<=", 推进(p))
    else if 匹配(p, 类型.大于) then (">", 推进(p))
    else if 匹配(p, 类型.小于) then ("<", 推进(p))
    else ("", p)

  (* 集合表达式：∪ ∩ ⊖ × ⊆ 与补 ～/〜/¬（左结合）。层级在比较之下、加减之上，
     对齐宿主 src/parser.py：rel → set → add（_parse_set_expr 夹在 _parse_rel_expr
     与 _parse_add_expr 之间）。运算符为「符号」token（自举词法器无专属类型），
     按文本判定。注意 ASCII `~` 不在此列——它是前缀位取反（见 是位取反）。 *)
  func 集合运算文本(s: String) -> String = (s) =>
    s = "∪" ? "∪" :
    s = "∩" ? "∩" :
    (s = "⊖" or s = "＼") ? "⊖" :
    (s = "×" or s = "＄") ? "×" :
    s = "⊆" ? "⊆" :
    (s = "～" or s = "〜" or s = "¬") ? "~" :
    ""

  func 是集合运算符(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 集合运算文本(当前(p).文本) != ""

  func 解析集合(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析加减(p) in
    解析集合_续(left, p2)

  func 解析集合_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 是集合运算符(p) then
      let op = 集合运算文本(当前(p).文本) in
      let p3 = 推进(p) in
      let (right, p4) = 解析加减(p3) in
      解析集合_续(做BinaryOp(op, left, right), p4)
    else (left, p)

  (* 加减：+ -（左结合循环） *)
  func 解析加减(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析移位(p) in
    解析加减_续(left, p2)

  func 解析加减_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    let (op_tok, p3) = 解析加减_op(p) in
    if op_tok != "" then
      let (right, p4) = 解析移位(p3) in
      解析加减_续(做BinaryOp(op_tok, left, right), p4)
    else (left, p)

  (* 位移：<< >>（左结合）。层级在加减之下、乘除之上，对齐宿主
     _parse_bit_expr（mul_expr → bit_expr → add_expr 的调用次序）。
     is 同一性判断同处此层（宿主 _parse_set_expr 内的 IsExpr 分支）。 *)
  func 解析移位(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析乘除(p) in
    解析移位_续(left, p2)

  func 解析移位_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.左移) then
      let p3 = 推进(p) in
      let (right, p4) = 解析乘除(p3) in
      解析移位_续(做BinaryOp("<<", left, right), p4)
    else if 匹配(p, 类型.右移) then
      let p3 = 推进(p) in
      let (right, p4) = 解析乘除(p3) in
      解析移位_续(做BinaryOp(">>", left, right), p4)
    else if 是位与(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析乘除(p3) in
      解析移位_续(做BinaryOp("&", left, right), p4)
    else if not p.在理解头 and 是位或(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析乘除(p3) in
      解析移位_续(做BinaryOp("|", left, right), p4)
    else if 是异或(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析乘除(p3) in
      解析移位_续(做BinaryOp("⊕", left, right), p4)
    else if 是中缀is(p) then
      let p3 = 推进(p) in
      let (right, p4) = 解析移位(p3) in
      解析移位_续(做同一性(left, right), p4)
    else (left, p)

  (* 位运算符判定（对齐宿主 _parse_bit_expr：&/＆→位与、|/｜→位或、⊕→异或）。
     `|` 另需在集合理解头部排除，见 解析集合构造 的 是理解头/有顶层理解管道 守卫。 *)
  func 是位与(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and (当前(p).文本 = "&" or 当前(p).文本 = "＆")

  func 是位或(p: 解析器) -> Bool =
    当前(p).类型 = 类型.管道 or
    (当前(p).类型 = 类型.符号 and (当前(p).文本 = "|" or 当前(p).文本 = "｜"))

  func 是异或(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "⊕"

  (* 中缀 is 判定：词法把 is 归为标识符（KEYWORDS 无此条，与宿主一致），
     故须比对标识符文本，并确认其后确为表达式起始——
     否则 `is = 5` / `f is` 中的 is 仍按变量处理。 *)
  func 是中缀is(p: 解析器) -> Bool =
    let t = 当前(p) in
    t.类型 = 类型.标识符 and t.文本 = "is" and 是表达式起点后(p, 1)

  (* 自当前 token 起偏移 offset 位的 token 是否为表达式起点。
     用于消解「既是标识符又可作运算符」的中缀 is。 *)
  func 是表达式起点后(p: 解析器, offset: Int) -> Bool =
    let idx = p.pos + offset in
    idx < len(p.tokens) ?
      let t = p.tokens[idx] in
      t.类型 = 类型.整数 or t.类型 = 类型.浮点 or t.类型 = 类型.字符串 or
      t.类型 = 类型.布尔 or t.类型 = 类型.标识符 or t.类型 = 类型.占位符 or
      t.类型 = 类型.左括号 or t.类型 = 类型.左括号方 or
      t.类型 = 类型.左括号花 or t.类型 = 类型.尖括号 or
      t.类型 = 类型.符号 or (t.类型 = 类型.关键字 and t.文本 = "if")
    : false

  func 解析加减_op(p: 解析器) -> (String, 解析器) =
    if 匹配(p, 类型.加) then ("+", 推进(p))
    else if 匹配(p, 类型.减) then ("-", 推进(p))
    else ("", p)

  (* 乘除取模：* / %（左结合循环） *)
  func 解析乘除(p: 解析器) -> (Dict, 解析器) =
    let (left, p2) = 解析幂(p) in
    解析乘除_续(left, p2)

  func 解析乘除_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    let (op_tok, p3) = 解析乘除_op(p) in
    if op_tok != "" then
      let (right, p4) = 解析幂(p3) in
      解析乘除_续(做BinaryOp(op_tok, left, right), p4)
    else (left, p)

  func 解析乘除_op(p: 解析器) -> (String, 解析器) =
    if 匹配(p, 类型.乘) then ("*", 推进(p))
    else if 匹配(p, 类型.除) then ("/", 推进(p))
    else if 匹配(p, 类型.取模) then ("%", 推进(p))
    else if 匹配(p, 类型.整除) then ("//", 推进(p))
    else ("", p)

  (* 幂：^（右结合）===== *)
  func 解析幂(p: 解析器) -> (Dict, 解析器) =
    let (base, p2) = 解析一元(p) in
    if 匹配(p2, 类型.次方) then
      let p3 = 推进(p2) in
      let (exp, p4) = 解析幂(p3) in  (* 右结合：递归解析幂 *)
      (做BinaryOp("^", base, exp), p4)
    else (base, p2)

  (* 一元：-x, ^x *)
  (* 前缀位取反 `~`：自举词法器把 ~ 归入 符号 类型（无专属类型），按文本判定。
     宿主 lexer 产出 OP_BIT_NOT，文本等价。 *)
  func 是位取反(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "~"

  (* 前缀符号一元：√ 平方根 / ∛ 立方根（自举词法器归入 符号 类型，按文本判定，
     对齐宿主 parser 的 SYMBOL "√"/"∛" 分支）。 *)
  func 是开方号(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "√"

  func 是立方根号(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "∛"

  (* 聚合前缀符号一元：∑ 列表求和 / ∏ 列表求积（自举词法器归入 符号 类型，
     按文本判定，对齐宿主 parser 的 SYMBOL "∑"/"∏" 分支）。 *)
  func 是求和号(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "∑"

  func 是求积号(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 当前(p).文本 = "∏"

  (* 一元运算符的操作数：允许再接一层同族前缀（<< - ~ ^ **），否则退回 解析应用。
     与宿主 src/parser.py:_parse_unary_operand 对齐：`-<<30` = -(<<30)，
     `<<-90` = <<(-90)。注意不能调 解析一元（上一级），否则无限递归。 *)
  func 解析一元操作数(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.左移) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("angle", operand), p3)
    else if 匹配(p, 类型.次方) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sqrt", operand), p3)
    else if 匹配(p, 类型.减) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("-", operand), p3)
    else if 是位取反(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("~", operand), p3)
    else if 是开方号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sqrt", operand), p3)
    else if 是立方根号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("cbrt", operand), p3)
    else if 是求和号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sum", operand), p3)
    else if 是求积号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("prod", operand), p3)
    else 解析应用(p)

  (* 前缀一元：<<（前缀角度）^/** （前缀开方）- ~ ++ -- not typeof。
     与宿主 src/parser.py:_parse_unary 对齐。^(OP_BIT_XOR) 与 **(OP_POWER)
     前缀均映射为开方；<< 前缀为角度（中缀 << 仍是位移，在 解析移位 层处理）。
     not/typeof 的操作数退回 解析应用（对应宿主 _parse_postfix）。 *)
  func 解析一元(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.左移) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("angle", operand), p3)
    else if 匹配(p, 类型.次方) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sqrt", operand), p3)
    else if 匹配(p, 类型.减) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("-", operand), p3)
    else if 是位取反(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("~", operand), p3)
    else if 是开方号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sqrt", operand), p3)
    else if 是立方根号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("cbrt", operand), p3)
    else if 是求和号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("sum", operand), p3)
    else if 是求积号(p) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("prod", operand), p3)
    else if 匹配(p, 类型.加加) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("++", operand), p3)
    else if 匹配(p, 类型.减减) then
      let p2 = 推进(p) in
      let (operand, p3) = 解析一元操作数(p2) in
      (做UnaryOp("--", operand), p3)
    else if 匹配关键字文本(p, "not") then
      let p2 = 推进(p) in
      let (operand, p3) = 解析应用(p2) in
      (做UnaryOp("not", operand), p3)
    else if 匹配关键字文本(p, "typeof") then
      (* typeof <expr>：编译为 LOAD_GLOBAL "typeof"; <operand>; CALL 1 *)
      let p2 = 推进(p) in
      let (operand, p3) = 解析应用(p2) in
      (做typeof(operand), p3)
    else 解析应用(p)

  (* 原子起点判定：当前 token 是否可作为并列应用（juxtaposition）的参数起点。
     仅限字面量/变量类 token，排除关键字（if/let/then 等）和运算符。 *)
  func 是原子起点(p: 解析器) -> Bool =
    匹配(p, 类型.整数) or 匹配(p, 类型.浮点) or 匹配(p, 类型.字符串) or
    匹配(p, 类型.布尔) or 匹配(p, 类型.占位符) or 匹配(p, 类型.标识符)

  (* 函数应用：f(a)、f(a, b)（多参构建嵌套 FuncApp，与宿主 parser 柯里化语义一致）、f(a)(b) 链式
     以及并列应用 f x（同一行内，token 前方非换行时视为 f(x)） *)
  func 解析应用(p: 解析器) -> (Dict, 解析器) =
    let (base, p2) = 解析主要(p) in
    解析应用链(base, p2)

  func 解析应用链(expr: Dict, p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.左括号) then
      let p2 = 推进(p) in
      let (args, p3) = 解析实参列表(p2) in
      let p4 = 期望(p3, 类型.右括号) in
      let result = len(args) = 0 ? 做FuncApp(expr, 做IntLit(0)) : 构建应用链(expr, args) in
      解析应用链(result, p4)
    else if 匹配(p, 类型.点) then
      let p2 = 推进(p) in
      let name_tok = 当前(p2) in
      let p3 = 推进(p2) in
      let result = 做Attr(expr, name_tok.文本) in
      解析应用链(result, p3)
    else if 匹配(p, 类型.可选链) then
      (* 可选链 a?.b / a?.[i]：空值安全属性 / 下标。
         须递归回 解析应用链 而非就地消费，以便 d?.a?.b 链式续接。 *)
      let p2 = 推进(p) in
      if 匹配(p2, 类型.左括号方) then
        let p3 = 推进(p2) in
        let (index, p4) = 解析表达式(p3) in
        let p5 = 期望(p4, 类型.右括号方) in
        解析应用链(做安全路径(expr, true, index), p5)
      else if 当前(p2).类型 = 类型.标识符 then
        let name_tok = 当前(p2) in
        let p3 = 推进(p2) in
        解析应用链(做安全路径(expr, false, name_tok.文本), p3)
      else 错误("?. 后需跟属性名或 [ 下标")
    else if 匹配(p, 类型.左括号方) and 下标可续接(p) then
      (* 下标 a[i] 或切片 a[start:end] / a[start:] / a[:end] / a[:] *)
      let p2 = 推进(p) in
      (* 切片检测：[: 或 start: *)
      if 匹配(p2, 类型.冒号) then
        (* a[:end] 或 a[:] *)
        let p3 = 推进(p2) in
        let (结束, p4) = 匹配(p3, 类型.右括号方) ? (null, p3) : 解析表达式(p3) in
        let p5 = 期望(p4, 类型.右括号方) in
        解析应用链(做切片(expr, null, 结束), p5)
      else
        let (index, p3) = 解析表达式(p2) in
        if 匹配(p3, 类型.冒号) then
          (* a[start:end] 或 a[start:] *)
          let p4 = 推进(p3) in
          let (结束, p5) = 匹配(p4, 类型.右括号方) ? (null, p4) : 解析表达式(p4) in
          let p6 = 期望(p5, 类型.右括号方) in
          解析应用链(做切片(expr, index, 结束), p6)
        else
          let p4 = 期望(p3, 类型.右括号方) in
          解析应用链(做Subscript(expr, index), p4)
    else if 匹配(p, 类型.发送) then
      (* 通道发送 ch <- v：宿主 _parse_postfix 的 OP_SEND 分支
         （SendExpr；右值走完整 解析表达式，故右结合）。 *)
      let p2 = 推进(p) in
      let (值, p3) = 解析表达式(p2) in
      解析应用链(做发送(expr, 值), p3)
    else if 是原子起点(p) and not 是行首关键字(p) and not 是中缀is(p) and not p.禁止并列 then
      (* 并列应用 f x / f(x) 假：同一行内，原子 token 紧跟表达式时视为应用。
         is 例外：它是中缀运算符而非实参，否则 `a is b` 会被并列应用吞成
         FuncApp(a, Variable("is"))，剩余的 b 再成一次应用。 *)
      let (arg, p2) = 解析主要(p) in
      解析应用链(做FuncApp(expr, arg), p2)
    else (expr, p)

  (* 实参列表：(a, b, c) → [a, b, c] *)
  func 解析实参列表(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号) then ([], p)
    else
      let (arg, p2) = 解析表达式(p) in
      解析实参列表_rest(p2, [arg])

  func 解析实参列表_rest(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.逗号) then
      let p2 = 推进(p) in
      let (arg, p3) = 解析表达式(p2) in
      解析实参列表_rest(p3, acc + [arg])
    else (acc, p)

  (* 列表元素列表：[] → 空列表；[a, b, c] → [a, b, c]（含可选尾逗号） *)
  func 解析列表元素(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号方) then ([], 推进(p))
    else
      let (elem, p2) = 解析表达式(p) in
      解析列表元素_rest(p2, [elem])

  func 解析列表元素_rest(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.逗号) then
      let p2 = 推进(p) in
      (* 尾逗号：[, ] → 接受并结束 *)
      if 匹配(p2, 类型.右括号方) then (acc, 推进(p2))
      else
        let (elem, p3) = 解析表达式(p2) in
        解析列表元素_rest(p3, acc + [elem])
    else if 匹配(p, 类型.右括号方) then (acc, 推进(p))
    else (acc, p)

  (* 花括号三义消解：代码块 vs 字典字面量 vs 集合构造
     前瞻 { 后第一个 token（推进已规范化跳过换行），与宿主
     _parse_brace_dispatch 逐条对齐：
      - } → 空集合 {}
      - , 或 | → 集合构造
      - 整数/浮点/布尔 → 集合枚举 {1, 2, 3}
      - 字符串/标识符 且 下一 token 为 : → 字典字面量 {k: v, ...}
      - 字符串 后为 , 或 |、标识符 后为 | → 集合构造
      - 其他 → 代码块 { stmts }（语句列表，返回 Program 节点） *)

  (* 逗号分隔符：半角 , 与全角 ， 等价，与宿主 _is_comma 对齐 *)
  func 是逗号类型(t: 类型) -> Bool =
    t = 类型.逗号 or t = 类型.中文逗号

  func 是逗号(p2: 解析器) -> Bool =
    是逗号类型(当前(p2).类型)

  (* 花括号种类：把 { 之后的首 token 归类为 "集合" / "字典" / "块"。
     判定顺序与宿主 _parse_brace_dispatch 的分支顺序逐条对齐：
       1) }                     → 集合（空集合）
       2) , 或 |                → 集合
       3) 整数/浮点/布尔         → 集合
       4) 字符串：后为 : → 字典；后为 , 或 | → 集合；否则块
       5) 标识符：后为 | → 集合；后为 : → 字典；否则块
       6) 其余                  → 块
     p 指向 { 之后。 *)
  func 花括号种类(p2: 解析器) -> String =
    let t = 当前(p2).类型 in
    if t = 类型.右括号花 then "集合"
    else if 是逗号类型(t) or t = 类型.管道 or t = 类型.整数 or
            t = 类型.浮点 or t = 类型.布尔 then "集合"
    else if t = 类型.字符串 then
      let t2 = 当前(推进(p2)).类型 in
      if t2 = 类型.冒号 then "字典"
      else if t2 = 类型.管道 or 是逗号类型(t2) then "集合"
      else "块"
    else if t = 类型.标识符 then
      let t2 = 当前(推进(p2)).类型 in
      if t2 = 类型.管道 then "集合"
      else if t2 = 类型.冒号 then "字典"
      else "块"
    else "块"

  (* 代码块分支：{ stmts }，消费闭 }，返回 Program 节点 *)
  func 解析花括号块(p2: 解析器) -> (Dict, 解析器) =
    let (body, p3) = 解析语句列表(p2) in
    (body, 期望(p3, 类型.右括号花))

  func 解析花括号消解(p: 解析器) -> (Dict, 解析器) =
    let p2 = 推进(p) in
    let kind = 花括号种类(p2) in
    kind = "集合" ? 解析集合构造(p2) :
    kind = "字典" ? 解析字典字面量(p2) :
    解析花括号块(p2)

  (* <set_construct> = { <literal_list> }，枚举形式 {1, 2, 3}（逗号分隔）。
     p 指向 { 之后；与宿主 _parse_set_construct 的枚举行为对齐。
     注意：宿主 _parse_set_construct 现已支持理解形式
     { 输出 | v >> S | 条件 }（form="comprehension"）与有界域推断 { x | 1 <= x <= 10 }，
     宿主解释器与字节码/原生后端（同源 MMB 字节码）均已支持；自举层只产出枚举形式，
     遇到理解形式不伪造宿主 VM 到不了的 AST（保持阶段一致性）。 *)
  (* 集合理解判定：对齐宿主 _is_comprehension_head / _has_top_level_comprehension_pipe。
     自举层不产出理解形式 AST，命中即报错（避免 `{x | cond}` 被静默误解析为位或枚举）。
     `{1 | 2}` 非理解头（首记号非标识符/元组且管道后无条件），仍按位或枚举解析，与宿主 [3] 一致。 *)
  func 是理解头(p: 解析器) -> Bool =
    let t = 窥视(p, 0) in
    if t.类型 = 类型.标识符 or t.类型 = 类型.占位符 then
      窥视(p, 1).类型 = 类型.管道
    else if t.类型 = 类型.左括号 then
      let j = 配对括号后续(p, 0) in
      j >= 0 and 窥视(p, j).类型 = 类型.管道
    else 假

  (* 从非换行索引 i（应为左括号）找到配对右括号之后的位置；越界返回 -1。 *)
  func 配对括号后续(p: 解析器, i: Int) -> Int = 配对括号走(p, i, 0)

  func 配对括号走(p: 解析器, i: Int, depth: Int) -> Int =
    let t = 窥视(p, i).类型 in
    t = 类型.结束 or t = 类型.右括号花 ? -1 :
    (t = 类型.左括号 or t = 类型.左括号方) ? 配对括号走(p, i + 1, depth + 1) :
    (t = 类型.右括号 or t = 类型.右括号方) ?
      (depth = 1 ? i + 1 : 配对括号走(p, i + 1, depth - 1)) :
    配对括号走(p, i + 1, depth)

  (* 顶层是否存在生成子句 `v >> S`，或首个管道之后的过滤条件。 *)
  func 有顶层理解管道(p: 解析器) -> Bool =
    let tops = 顶层记号(p, 0, 0, []) in
    存在生成子句(p, tops) or 首管道后有条件(tops)

  (* 收集深度为 0 的记号，元素为 [非换行索引, 类型, 文本]。 *)
  func 顶层记号(p: 解析器, i: Int, depth: Int, acc: List) -> List =
    let t = 窥视(p, i) in
    t.类型 = 类型.结束 ? acc :
    (t.类型 = 类型.左括号 or t.类型 = 类型.左括号方 or t.类型 = 类型.左括号花) ?
      顶层记号(p, i + 1, depth + 1, acc) :
    (t.类型 = 类型.右括号 or t.类型 = 类型.右括号方 or t.类型 = 类型.右括号花) ?
      (depth = 0 ? acc : 顶层记号(p, i + 1, depth - 1, acc)) :
    (depth = 0 ?
       顶层记号(p, i + 1, depth, acc + [[i, t.类型, t.文本]]) :
       顶层记号(p, i + 1, depth, acc))

  func 存在生成子句(p: 解析器, tops: List) -> Bool =
    tops = [] ? 假 :
    (tops[0][1] = 类型.管道 and len(tops) >= 2 and
     (tops[1][1] = 类型.标识符 or tops[1][1] = 类型.占位符) and
     窥视(p, tops[1][0] + 1).类型 = 类型.右移) ? 真 :
    存在生成子句(p, tops[1:])

  func 首管道后有条件(tops: List) -> Bool =
    let fp = 首个管道(tops) in
    fp < 0 ? 假 : 区间有条件(tops[fp + 1:])

  func 首个管道(tops: List) -> Int =
    tops = [] ? -1 :
    tops[0][1] = 类型.管道 ? 0 : 首个管道(tops[1:])

  func 区间有条件(tops: List) -> Bool =
    tops = [] ? 假 :
    (是条件运算符(tops[0][1]) or
     (tops[0][1] = 类型.关键字 and (tops[0][2] = "and" or tops[0][2] = "or"))) ? 真 :
    区间有条件(tops[1:])

  func 是条件运算符(t: 类型) -> Bool =
    t = 类型.小于 or t = 类型.大于 or t = 类型.小于等于 or t = 类型.大于等于 or
    t = 类型.不等于 or t = 类型.等于

  func 解析集合构造(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.右括号花) then
      (做集合构造("enumeration", null, null, [], null), 推进(p))
    else if 是理解头(p) or 有顶层理解管道(p) then
      解析集合理解(p)
    else
      let (first, p2) = 解析表达式(p) in
      解析集合元素_rest(p2, [first])

  func 解析集合元素_rest(p: 解析器, literals: List) -> (Dict, 解析器) =
    if 是逗号(p) then
      let (e, p2) = 解析表达式(推进(p)) in
      解析集合元素_rest(p2, literals + [e])
    else
      (做集合构造("enumeration", null, null, literals, null),
       期望(p, 类型.右括号花))

  (* ===== 集合理解 { 输出 | 子句 | 子句 ... }（`|` 分隔）=====
     对齐宿主 _parse_set_comprehension：先解析输出表达式，再按 `|` 解析生成子句
     `v >> S` 与过滤条件；末逗号后为输出映射（映射写法）。头部/子句解析期间把
     在理解头 置真，使 `|` 作为子句分隔符而非位或。 *)
  func 解析集合理解(p: 解析器) -> (Dict, 解析器) =
    let 原 = p.在理解头 in
    let p头 = 置在理解头(p, 真) in
    let (output, p2) = 解析表达式(p头) in
    let p3 = 期望(p2, 类型.管道) in
    let (gens, conds, out2, p4) = 解析理解子句循环(p3, [], [], output) in
    let p5 = 期望(p4, 类型.右括号花) in
    let 生成 = gens != [] ? gens : 必须推断(conds) in
    (做集合构造("comprehension", 生成, conds, null, out2), 置在理解头(p5, 原))

  (* 无生成子句时按条件推断有界整数域，失败即抛错（对齐宿主错误信息）。 *)
  func 必须推断(conds: List) -> List =
    let 推 = 推断理解生成(conds) in
    推 = null ? 错误("集合理解需带生成子句 `v >> 集合`，或可由条件推断有界整数域") : [推]

  func 解析理解子句循环(p: 解析器, gens: List, conds: List, output: Dict)
      -> (List, List, Dict, 解析器) =
    let (项, p2) = 解析理解子句(p) in
    let gens2 = 项[0] = "gen" ? gens + [项[1]] : gens in
    let conds2 = 项[0] = "cond" ? conds + [项[1]] : conds in
    if 是逗号(p2) then
      let (out2, p3) = 解析表达式(推进(p2)) in
      (gens2, conds2, out2, p3)
    else if 匹配(p2, 类型.管道) then
      解析理解子句循环(推进(p2), gens2, conds2, output)
    else
      (gens2, conds2, output, p2)

  (* 生成子句 `v >> S`（当前为标识符/占位符且后继 `>>`）→ ["gen", {"名","集合"}]；
     其余按过滤条件表达式 → ["cond", 表达式]。 *)
  func 解析理解子句(p: 解析器) -> (List, 解析器) =
    let t = 当前(p) in
    if (t.类型 = 类型.标识符 or t.类型 = 类型.占位符) and
       窥视(p, 1).类型 = 类型.右移 then
      let 名 = t.文本 in
      let p2 = 推进(推进(p)) in
      let (it, p3) = 解析表达式(p2) in
      (["gen", {"名": 名, "集合": it}], p3)
    else
      let (c, p2) = 解析表达式(p) in
      (["cond", c], p2)

  (* ===== 有界整数域推断（对齐宿主 _infer_comprehension_generator）=====
     从 `1 <= x <= 10`（展平为 and(1<=x, x<=10)）或分开的 `1 <= x` / `x <= 10`
     条件，为唯一自由变量推断整数域，返回 {"名","集合"}（集合为枚举列表字面量）
     或 null。仅接受整数常量边界，跨度上限 100000。 *)
  func 推断理解生成(conds: List) -> Dict =
    let 表 = _收集界(conds, []) in
    let cands = _候选界(表, []) in
    len(cands) = 1 ? _展开域(cands[0]) : null

  func _收集界(conds: List, 表: List) -> List =
    conds = [] ? 表 :
    _收集界(conds[1:], _收集条件界(conds[0], 表))

  func _收集条件界(c: Dict, 表: List) -> List =
    _收集合取(_合取子句(c), 表)

  func _收集合取(cs: List, 表: List) -> List =
    cs = [] ? 表 :
    let conj = cs[0] in
    let 表2 = (conj["类型"] = "二元运算" and _是比较(conj["运算符"])) ?
      _记录比较(表, conj) : 表 in
    _收集合取(cs[1:], 表2)

  (* 顶层 and 二叉树展平为合取子句列表。
     注意：宿主把函数体的 if/else 分支当语句解析，`else [c]` 会被当成输出单元；
     且函数体不能以 `(` 开头（被当 lambda 形参表），故用无括号三元表达式，
     使 `[c]` 处于表达式位置，两端解析一致。 *)
  func _合取子句(c: Dict) -> List =
    c["类型"] = "二元运算" and c["运算符"] = "and" ?
      _合取子句(c["左"]) + _合取子句(c["右"]) :
      [c]

  func _是比较(op: String) -> Bool =
    op = "<" or op = "<=" or op = ">" or op = ">="

  func _变量名(n) -> Any =
    n["类型"] = "变量" ? n["名"] : null

  func _常量整(n) -> Any =
    n["类型"] = "整数" ? n["值"] :
    (n["类型"] = "一元运算" and (n["运算符"] = "-" or n["运算符"] = "neg")) ?
      _取负(_常量整(n["操作数"])) :
    null

  func _取负(v) -> Any = v = null ? null : 0 - v

  func _镜像(op: String) -> String =
    op = "<" ? ">" : op = "<=" ? ">=" : op = ">" ? "<" : ">="

  (* 记录一条比较代入界表：变量在左/右均可（右为变量时镜像运算符）。 *)
  func _记录比较(表: List, conj: Dict) -> List =
    let lvar = _变量名(conj["左"]) in
    let rvar = _变量名(conj["右"]) in
    let rconst = _常量整(conj["右"]) in
    let lconst = _常量整(conj["左"]) in
    if lvar != null and rconst != null then
      _记界(表, lvar, conj["运算符"], rconst)
    else if rvar != null and lconst != null then
      _记界(表, rvar, _镜像(conj["运算符"]), lconst)
    else 表

  (* 界表：[[变量名, 下界项, 上界项]]，界项为 null 或 [值, 含端点]。 *)
  func _记界(表: List, var: String, op: String, 常数: Int) -> List =
    let 索引 = _界索引(表, var, 0) in
    索引 >= 0 ?
      _界更新(表, 索引, op, 常数) :
      _界更新(表 + [[var, null, null]], len(表), op, 常数)

  func _界索引(表: List, var: String, i: Int) -> Int =
    i >= len(表) ? -1 :
    表[i][0] = var ? i : _界索引(表, var, i + 1)

  func _界更新(表: List, i: Int, op: String, 常数: Int) -> List =
    let 项 = 表[i] in
    let 新项 = (op = "<" or op = "<=") ?
      [项[0], 项[1], _收上界(项[2], 常数, op = "<=")] :
      [项[0], _收下界(项[1], 常数, op = ">="), 项[2]] in
    _替换(表, i, 新项)

  func _收上界(hi, 常数: Int, 含: Bool) -> List =
    hi = null ? [常数, 含] :
    (常数 < hi[0] or (常数 = hi[0] and not 含)) ? [常数, 含] : hi

  func _收下界(lo, 常数: Int, 含: Bool) -> List =
    lo = null ? [常数, 含] :
    (常数 > lo[0] or (常数 = lo[0] and not 含)) ? [常数, 含] : lo

  func _替换(表: List, i: Int, 值) -> List =
    i = 0 ? [值] + 表[1:] :
    [表[0]] + _替换(表[1:], i - 1, 值)

  func _候选界(表: List, acc: List) -> List =
    表 = [] ? acc :
    (表[0][1] != null and 表[0][2] != null) ?
      _候选界(表[1:], acc + [表[0]]) :
      _候选界(表[1:], acc)

  func _展开域(项: List) -> Dict =
    let lo项 = 项[1] in
    let hi项 = 项[2] in
    let lo = lo项[0] + (lo项[1] ? 0 : 1) in
    let hi = hi项[0] - (hi项[1] ? 0 : 1) in
    (hi - lo + 1) > 100000 ? null :
      {"名": 项[0], "集合": 做ListLit(_整数序列(lo, hi))}

  func _整数序列(lo: Int, hi: Int) -> List =
    lo > hi ? [] : [做IntLit(lo)] + _整数序列(lo + 1, hi)


  (* 字典字面量 {k: v, k: v, ...}：p 指向 { 之后。
     空 {} → 空字典；否则解析 key : value 对，逗号分隔，尾逗号可选。 *)
  func 解析字典字面量(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.右括号花) then
      (做DictLit([], []), 推进(p))
    else
      let (k, p2) = 解析表达式(p) in
      let p3 = 期望(p2, 类型.冒号) in
      let (v, p4) = 解析表达式(p3) in
      解析字典字面量_rest(p4, [k], [v])

  func 解析字典字面量_rest(p: 解析器, 键: List, 值: List) -> (Dict, 解析器) =
    if 匹配(p, 类型.逗号) then
      let p2 = 推进(p) in
      (* 尾逗号 {k: v,} → 接受并结束 *)
      if 匹配(p2, 类型.右括号花) then
        (做DictLit(键, 值), 推进(p2))
      else
        let (k, p3) = 解析表达式(p2) in
        let p4 = 期望(p3, 类型.冒号) in
        let (v, p5) = 解析表达式(p4) in
        解析字典字面量_rest(p5, 键 + [k], 值 + [v])
    else if 匹配(p, 类型.右括号花) then
      (做DictLit(键, 值), 推进(p))
    else (做DictLit(键, 值), p)

  (* 多参构建嵌套 FuncApp：f + [a, b, c] → f(a)(b)(c) *)
  func 构建应用链(f: Dict, args: List) -> Dict =
    len(args) = 0 ? f : 构建应用链(做FuncApp(f, args[0]), args[1:])

  (* 主要表达式：字面量/变量/括号/lamb a da *)
  func 解析主要(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.整数) then
      let tok = 当前(p) in
      (做IntLit(整数值(tok.文本)), 推进(p))
    else if 匹配(p, 类型.浮点) then
      let tok = 当前(p) in
      (做FloatLit(浮点值(tok.文本)), 推进(p))
    else if 匹配(p, 类型.字符串) then
      let tok = 当前(p) in
      (做StringLit(tok.文本), 推进(p))
    else if 匹配(p, 类型.布尔) then
      let tok = 当前(p) in
      (做BoolLit(tok.文本 = "真" or tok.文本 = "true"), 推进(p))
    else if 匹配(p, 类型.占位符) then
      let tok = 当前(p) in
      (做Variable(tok.文本), 推进(p))
      else if 匹配(p, 类型.尖括号) then
        (* 角度包装 ⟨expr⟩：消费 ⟨，解析内层，期望 ⟩ *)
        let p2 = 推进(p) in
        let (内, p3) = 解析表达式(p2) in
        let p4 = 期望(p3, 类型.尖括号) in
        (做尖括号(内), p4)
      else if 匹配(p, 类型.读取开) then
        (* 表达式位置的【…】：宿主 _parse_statement 的 MATHA_READ_OPEN 分支同样
           产读取块节点，函数体因此可能整体是一个文档块（宿主不把紧随其后的
           缩进行并入体，故此处亦只吃掉本块）。 *)
        解析自然语言块(p)
      else if 匹配关键字文本(p, "chan") then
        (* chan T：降级为通道 dict（宿主 _parse_primary 的 KW_CHAN 分支）*)
        let (类型名, p2) = 解析类型名(推进(p)) in
        (做通道(类型名), p2)
    else if 匹配(p, 类型.标识符) then
      let tok = 当前(p) in
      (做Variable(tok.文本), 推进(p))
    else if 匹配(p, 类型.符号) then
      let tok = 当前(p) in
      (* ∅：空集字面量（对齐宿主 parser 把 SYMBOL "∅" 解析为空列表）；
         其余符号（π τ φ ∞ √ ∛ 等）按变量名处理，与宿主「SYMBOL→Variable」一致。
         注意：√/∛ 已在 解析一元 层被消费，普通符号在此兜底成变量引用。 *)
      (tok.文本 = "∅" ? 做ListLit([]) : 做Variable(tok.文本), 推进(p))
    else if 匹配(p, 类型.左括号) then
      let p2 = 推进(p) in
      (* 试探 lambda：(params) => body *)
      解析括号消解(p2)
    else if 匹配(p, 类型.左括号方) then
      (* 列表字面量 [a, b, c]：消费 [，解析元素列表，期望 ] *)
      let p2 = 推进(p) in
      let (元素, p3) = 解析列表元素(p2) in
      (做ListLit(元素), p3)
    else if 匹配(p, 类型.左括号花) then
      (* { } 双义消解：代码块 vs 字典字面量 *)
      解析花括号消解(p)
    else if 匹配(p, 类型.关键字) and 当前(p).文本 = "if" then
      解析if表达式(p)
    else if 匹配(p, 类型.关键字) and 当前(p).文本 = "let" then
      解析let表达式(p)
    else if 匹配(p, 类型.关键字) and 当前(p).文本 = "raise" then
      let p1 = 推进(p) in
      let (值expr, p2) = 解析表达式(p1) in
      (做抛出(值expr), p2)
    else if 匹配(p, 类型.关键字) and 当前(p).文本 = "throw" then
      (* throw <expr>：宿主 _parse_unary 把 KW_THROW 与 KW_RAISE 合并为
         RaiseExpr，故此处不产出独立 ThrowStmt 节点（宿主 parser 也不产
         ThrowStmt——compiler 里那条 isinstance 分支目前无产生点）。 *)
      let p1 = 推进(p) in
      let (值expr, p2) = 解析表达式(p1) in
      (做抛出(值expr), p2)
    else if 匹配(p, 类型.关键字) then
      (* 关键字用作变量名（如 func 参数）：视为变量引用 *)
      let tok = 当前(p) in
      (做Variable(tok.文本), 推进(p))
    else
      (错误("期望表达式，实际 " + 类型名(当前(p).类型)), p)

  (* if 表达式：if cond then e1 else e2（纯表达式形态，无大括号）*)
  func 解析if表达式(p: 解析器) -> (Dict, 解析器) =
    let p2 = 推进(p) in  (* 消费 if *)
    let (cond, p3) = 解析表达式(p2) in
    let p4 = if 匹配(p3, 类型.关键字) and 当前(p3).文本 = "then" then 推进(p3)
             else 错误("期望 then") in
    let (then_e, p5) = 解析表达式(p4) in
    let p6 = if 匹配(p5, 类型.关键字) and 当前(p5).文本 = "else" then 推进(p5)
             else p5 in
    if 匹配(p5, 类型.关键字) and 当前(p5).文本 = "else" then
      let (else_e, p7) = 解析表达式(p6) in
      (做If(cond, then_e, else_e), p7)
    else
      (做If(cond, then_e, null), p6)

  (* 括号内消解：统一解析 lambda、元组 (a, b) 或普通分组 (expr)
     先解析内容为表达式列表（逗号分隔），消费 )，再根据 => 判断 lambda *)
  (* (x: Int) => body：判断 p2（已解析首个元素后）是否为带类型标注的 lambda 形参。
     需满足：当前为 `:`，且跳到匹配的 `)` 之后紧跟 `=>`。
     与宿主「_parse_primary 括号分支可带类型标注」对齐；
     宿主该形态仅在 `=>` 存在时合法，否则回退分组解析。 *)
  func 是带类型lambda(p2: 解析器) -> Bool =
    if 匹配(p2, 类型.冒号) then
      匹配(跳过类型至右括号(推进(p2)), 类型.胖箭头)
    else 假

  func 解析括号消解(p: 解析器) -> (Dict, 解析器) = (p) =>
    (* 空括号 () => body: lambda；() 无 =>: unit *)
    if 匹配(p, 类型.右括号) then
      let p2 = 推进(p) in
      if 匹配(p2, 类型.胖箭头) then
        let p3 = 推进(p2) in
        let (body, p4) = 解析表达式(p3) in
        (做Lambda([], body), p4)
      else (做IntLit(0), p2)
    else
      (* 解析第一个表达式 *)
      let (first, p2) = 解析表达式(p) in
      if 是带类型lambda(p2) then
        (* 带类型标注的形参：(x: Int) => body *)
        let pa = 跳过类型至右括号(推进(p2)) in
        let (body, pb) = 解析表达式(推进(pa)) in
        (做Lambda([first], body), pb)
      else
      (* 逗号 → 多元素（元组或 lambda 多参）；否则单元素 *)
      let (elems, p3) = 匹配(p2, 类型.逗号) ?
        let p3a = 推进(p2) in
        let (rest, p3b) = 解析实参列表(p3a) in
        ([first] + rest, p3b) :
        ([first], p2) in
      let p4 = 期望(p3, 类型.右括号) in
      (* => → lambda；否则单元素=分组，多元素=元组 *)
      if 匹配(p4, 类型.胖箭头) then
        let p5 = 推进(p4) in
        let (body, p6) = 解析表达式(p5) in
        (做Lambda(elems, body), p6)
      else
        len(elems) = 1 ? (elems[0], p4) : (做元组(elems), p4)

  (* 解析 ) 之后的 lambda 体：胖箭头 + 表达式 *)
  func 解析_lambda_体(params: List, p4: 解析器) -> (Dict, 解析器) =
    if 匹配(p4, 类型.胖箭头) then
      let p5 = 推进(p4) in
      let (body, p6) = 解析表达式(p5) in
      (做Lambda(params, body), p6)
    else 错误("期望 =>")

  func 解析_lambda_param(p: 解析器) -> (Dict, 解析器) =
    let tok = 当前(p) in
    let p2 = 推进(p) in
    (* 可选类型标注：name [: Type] —— 吃掉冒号与类型名 token *)
    let p3 = if 匹配(p2, 类型.冒号) then 推进(推进(p2)) else p2 in
    (做Variable(tok.文本), p3)

  func 解析_lambda_params_rest(acc: List, param: Dict, p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.逗号) then
      let p2 = 推进(p) in
      let (param2, p3) = 解析_lambda_param(p2) in
      解析_lambda_params_rest(acc + [param], param2, p3)
    else (acc + [param], p)

  (* 去单位：截去首个非 ASCII(ord>=128) 字符起的所有后续字符。
     单位（CJK 汉字 / ° ℃ ℉）仅作字符串标签，编译/运行期一律丢弃——对齐宿主
     parser 的 num/unit 拆分（unit 字段四端均不参与求值）。 *)
  func 去单位(s: String) -> String =
    if s = "" then ""
    else if ord(get(s)(0)) >= 128 then ""
    else get(s)(0) + 去单位(substr(s, 1))

  (* 整数值/浮点值转换 ===== *)
  func 整数值(s0: String) -> Int =
    let s = 去单位(s0) in
    let base = (len(s) > 2 and get(s)(0) = "0" and (get(s)(1) = "b" or get(s)(1) = "x")) ?
      if get(s)(1) = "b" then 2 else 16 else 10 in
    let base2 = (len(s) > 2 and get(s)(0) = "0" and get(s)(1) = "t") ? 3 : base in
    let digits = (len(s) > 2 and get(s)(0) = "0") ? substr(s, 2) : s in
    字符串转整数(digits, base2)

  func 浮点值(s: String) -> Float =
    字符串转浮点(去单位(s))

  func 字符串转整数(s: String, base: Int) -> Int =
    if s = "" then 0
    else 字符串转整数_helper(s, 0, base)

  func 字符串转整数_helper(s: String, acc: Int, base: Int) -> Int =
    if s = "" then acc
    else
      let c = ord(get(s)(0)) in
      let digit = (c >= 48 and c <= 57) ? c - 48 :
                  (c >= 65 and c <= 70) ? c - 55 :
                  (c >= 97 and c <= 102) ? c - 87 : 0 in
      字符串转整数_helper(substr(s, 1), acc * base + digit, base)

  (* 浮点字面量 → Float。直接委托宿主/自举 VM 的 float(String)，
     由底层数值解析保证与宿主 float() 逐位一致（含科学计数法 e/E）。 *)
  func 字符串转浮点(s: String) -> Float =
    if s = "" then 0.0 else float(s)

  (* 字符串工具 ===== *)
  func substr(s: String, start: Int) -> String =
    if start >= len(s) then ""
    else 子串_helper(s, start, len(s) - start, "")

  func 子串_helper(s: String, pos: Int, count: Int, acc: String) -> String =
    (s, pos, count, acc) =>
    (count <= 0 or pos >= len(s)) ? acc :
    子串_helper(s, pos + 1, count - 1, acc + get(s)(pos))

  func 分割(s: String, sep: String) -> List =
    分割_helper(s, sep, [])

  func 分割_helper(s: String, sep: String, acc: List) -> List =
    let idx = 查找(s, sep) in
    if idx < 0 then reverse(acc + [s])
    else
      let before = 子串(s, 0, idx) in
      let after = substr(s, idx + len(sep)) in
      分割_helper(after, sep, acc + [before])

  func 查找(s: String, sub: String) -> Int =
    查找_helper(s, sub, 0)

  func 查找_helper(s: String, sub: String, start: Int) -> Int =
    if start >= len(s) then -1
    else if 前缀匹配(s, sub, start) then start
    else 查找_helper(s, sub, start + 1)

  func 前缀匹配(s: String, sub: String, start: Int) -> Bool =
    if sub = "" then 真
    else if start + len(sub) > len(s) then 假
    else
      前缀匹配_helper(s, sub, start, 0)

  func 前缀匹配_helper(s: String, sub: String, s_pos: Int, sub_pos: Int) -> Bool =
    (s, sub, s_pos, sub_pos) =>
    (sub_pos >= len(sub)) ? 真 :
    (s_pos >= len(s)) ? 假 :
    (get(s)(s_pos) = get(sub)(sub_pos)) ?
      前缀匹配_helper(s, sub, s_pos + 1, sub_pos + 1) : 假

  func 子串(s: String, start: Int, end: Int) -> String =
    子串_helper2(s, start, end, 0, "")

  func 子串_helper2(s: String, start: Int, end: Int, pos: Int, acc: String) -> String =
    (s, start, end, pos, acc) =>
    (pos >= end) ? acc :
    (pos >= start) ? 子串_helper2(s, start, end, pos + 1, acc + get(s)(pos)) :
    子串_helper2(s, start, end, pos + 1, acc)

  func reverse(lst: List) -> List =
    reverse_helper(lst, [])

  func reverse_helper(lst: List, acc: List) -> List =
    lst = [] ? acc : reverse_helper(lst[1:], acc + [lst[0]])

  (* 跳过 #：{ ... } 自测块：p 指向 段号。
     消费 段号、可选全角冒号、{ ... } 块（计数嵌套大括号），返回块后状态 *)
  func 跳过自测块(p: 解析器) -> 解析器 =
    let p1 = 推进(p) in  (* 消费 段号 *)
    let p2 = 匹配(p1, 类型.全角冒号) ? 推进(p1) : p1 in
    let p3 = 匹配(p2, 类型.左括号花) ? 推进(p2) : p2 in
    跳过大括号块(p3, 1)

  (* @define_op : <符号> = <优先级> | <结合性>  [ => <处理函数> ]
     对齐宿主 _parse_define_op 的消费次序：@ → define_op → 冒号 → 符号 → =
     → 优先级 → | → 结合性；随后可选 `=> 函数名`（兼容 `->`）绑定实现函数。
     宿主登记进 GLOBAL_CUSTOM_OPS 并返回 NOOP 节点，编译期不产字节码；自举侧
     把绑定累积进解析器状态 自定义表，供表达式层优先级爬升与二元节点「实现」字段。 *)
  func 解析定义运算符(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进(p) in                            (* 消费 @ *)
    let p2 = 推进(p1) in                           (* 消费 define_op 标识符 *)
    let p3 = (匹配(p2, 类型.全角冒号) or 匹配(p2, 类型.冒号)) ? 推进(p2) : p2 in
    let 符号 = 当前(p3).文本 in
    let p4 = 推进(p3) in                           (* 运算符符号 *)
    let p5 = 推进(p4) in                           (* = *)
    let 优先级 = 整数值(当前(p5).文本) in
    let p6 = 推进(p5) in                           (* 优先级 *)
    let p7 = 推进(p6) in                           (* | *)
    let 结合性 = 当前(p7).文本 in
    let p8 = 推进(p7) in                           (* left / right *)
    let 有处理 = 匹配(p8, 类型.胖箭头) or 匹配(p8, 类型.箭头) in
    let 处理函数 = 有处理 ? 当前(推进(p8)).文本 : "" in
    let p9 = 有处理 ? 推进(推进(p8)) : p8 in
    let 信息 = {"符号": 符号, "优先级": 优先级, "结合性": 结合性, "处理函数": 处理函数} in
    let p10 = { tokens: p9.tokens, pos: p9.pos, line: p9.line, col: p9.col,
                禁止并列: p9.禁止并列, 自定义: p9.自定义 + [信息], 在理解头: p9.在理解头 } in
    (做定义运算符(), p10)

  (* ===== 自然语言块【…】=====
     对齐宿主 _parse_nl_block：消费 【 与 】；】后若紧跟换行/EOF 则正文为空
     （对齐宿主「不跳过换行」的判断——标注块常单独成行，后接 #N：{…} 代码块），
     否则把同行剩余 token 作为自然语言正文。宿主把 NLBlock 列入 _NOOP_STMTS，
     编译期不产字节码；stage3 同样只留文本，发射阶段空操作。 *)
  func 收集直到闭(p: 解析器, acc: String) -> (String, 解析器) = (p, acc) =>
    (匹配(p, 类型.结束) or 匹配(p, 类型.读取闭)) ? (acc, p) :
    收集直到闭(推进原样(p), acc + 当前(p).文本)

  func 收集到行尾(p: 解析器, acc: String) -> (String, 解析器) = (p, acc) =>
    (匹配(p, 类型.结束) or 匹配(p, 类型.换行)) ? (acc, p) :
    收集到行尾(推进原样(p), acc + 当前(p).文本)

  func 解析自然语言块(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进原样(p) in                      (* 消费 【 *)
    let (标注, p2) = 收集直到闭(p1, "") in
    let p3 = 匹配(p2, 类型.读取闭) ? 推进原样(p2) : p2 in
    (匹配(p3, 类型.换行) or 匹配(p3, 类型.结束)) ?
      (做自然语言块(标注, ""), 规范(p3)) :
      let (正文, p4) = 收集到行尾(p3, "") in
      (做自然语言块(标注, 正文), 规范(p4))

  (* ===== 机械单元（#N：…）=====
     与宿主 parser._parse_mech_unit 对齐：先消费 # 与可选全角冒号，
     再按首个 token 判定内容形态。 *)
  func 解析机械单元(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进(p) in                            (* 消费 段号 *)
    let p1b = 匹配(p1, 类型.整数) ? 推进(p1) : p1 in   (* 可选段号 #N：中的 N *)
    let p2 = 匹配(p1b, 类型.全角冒号) ? 推进(p1b) : p1b in
    if 匹配(p2, 类型.左括号花) then
      (* #：{ … } 代码块／自测块：块内绑定沿用外层作用域（顶层即全局） *)
      let (block, p3) = 解析语句列表(推进(p2)) in
      let p4 = 匹配(p3, 类型.右括号花) ? 推进(p3) : p3 in
      (做机械单元(block), p4)
    else if 匹配(p2, 类型.读取开) then
      (* #N：【命令】→ 生成语句 + 命令字面量 *)
      let (cmd, p3) = 解析命令文字(p2) in
      (做机械单元(做生成语句(cmd)), p3)
    else if 匹配(p2, 类型.左括号方) then
      (* #N：[输出] → 生成语句 + 输出追踪；内容可能是多值列表 *)
      let (expr, p3) = 解析括号内输出(推进(p2)) in
      let p4 = 匹配(p3, 类型.右括号方) ? 推进(p3) : p3 in
      (做机械单元(做生成语句(做输出追踪(expr))), p4)
    else if 匹配(p2, 类型.占位符) then
      (* #N：？expr → 生成语句 + 表达式 *)
      let (expr, p3) = 解析表达式(推进(p2)) in
      (做机械单元(做生成语句(expr)), p3)
    else
      let (expr, p3) = 解析表达式(p2) in
      (做机械单元(做生成语句(expr)), p3)

  (* ===== 后缀续接的换行敏感判定 =====
     解析器状态 pos 始终指向非换行 token（规范() 会跳过换行），故需回看
     原始 token 序列判断 [ 是否紧跟换行。若 [ 紧跟换行且换行前是「值结尾」
     token（标识符/字面量/右括号类），则 [ 开启新语句——语句位置恒为输出
     单元，不可当作下标续接；否则属表达式中途（如 1 +\n [x]），仍按下标解析。
     与宿主 parser._parse_primary 的前序 token 判定同构。 *)
  func 下标可续接(p: 解析器) -> Bool = (p) =>
    (p.pos < 1) ? 真 :
    (p.tokens[p.pos - 1].类型 = 类型.换行) ? 换行后非值结尾(p, p.pos - 2) : 真

  func 换行后非值结尾(p: 解析器, i: Int) -> Bool = (p, i) =>
    (i < 0) ? 真 :
    (p.tokens[i].类型 = 类型.换行) ? 换行后非值结尾(p, i - 1) :
    (not 值结尾token(p.tokens[i]))

  func 值结尾token(t: Token) -> Bool = (t) =>
    (t.类型 = 类型.标识符) or (t.类型 = 类型.整数) or (t.类型 = 类型.浮点) or
    (t.类型 = 类型.字符串) or (t.类型 = 类型.右括号) or
    (t.类型 = 类型.右括号方) or (t.类型 = 类型.右括号花)

  (* ===== 输出单元（语句位置的 [）=====
     <output> = "[" , [ <expr> ] , "]"
     与宿主 _parse_output 对齐：[] → 空输出（不发射任何指令）；
     内容形如 a, b（首个 token 之后紧跟逗号）→ 列表字面量；
     否则按表达式解析。 *)
  func 解析输出语句(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进(p) in                                  (* 消费 [ *)
    let (expr, p2) = 解析括号内输出(p1) in
    let p3 = 匹配(p2, 类型.右括号方) ? 推进(p2) : p2 in
    (做Output(expr), p3)

  (* [ … ] 内部解析，三种形态（对应宿主 _parse_output）：
       []        → 空输出（宿主 Output(expr=None)）
       [a, b]    → 列表字面量（列表前瞻成立；见 有列表前瞻）
       [expr]    → 单个表达式
     列表路径消费 ] 后另接集合运算符链（[a,b] ∪ [c,d] → BinaryOp，左结合），
     对齐宿主 _parse_output 列表分支。返回 (expr, 解析器)：列表路径已过 ]，
     表达式路径停在 ]（由调用方按既有宽松模式消费）。 *)
  func 解析括号内输出(p: 解析器) -> (Dict, 解析器) =
    匹配(p, 类型.右括号方) ? (做空输出(), p) :
    有列表前瞻(p) ?
      let (元素, p2) = 解析列表元素(p) in
      解析输出集合_续(做ListLit(元素), p2) :
      尝试输出表达式(p)

  (* 尝试将 [ … ] 内容解析为恰好填满至 ] 的单个表达式。
     成功（解析后正好停在 ]）→ 返回 (表达式, 解析器)；
     否则文本回退：拼接 ] 之前的原始记号文本为字符串字面量
     （对齐宿主 _parse_output 的 ParseError 回退，见 src/parser.py:2614）。
     解析在「禁并列」副本上进行：宿主 parser 无并列应用语法，
     故 [Hello world] 须回退为文本而非被吞成 FuncApp。） *)
  func 尝试输出表达式(p: 解析器) -> (Dict, 解析器) =
    let 捕获 = 调用捕获(() => 试解析输出(p))([]) in
    捕获[0] == "__正常__" ? 处理输出(捕获[1], p) : 做文本回退(p)

  (* 受保护尝试体：解析成功且正好停在 ] 时返回 [真, 表达式, 解析器]，
     否则返回 [假]。解析异常由 VM 内建 调用捕获 拦截（等价宿主 try/catch
     的 ParseError 回退，但避免在自举目录引入自举编译器尚不支持的 try 节点）。 *)
  func 试解析输出(p: 解析器) -> List =
    let (expr, p2) = 解析表达式(禁并列(p)) in
    匹配(p2, 类型.右括号方) ? [真, expr, p2] : [假]

  (* 处理 调用捕获 的受保护结果：正常且命中 → (表达式, 解析器)；否则文本回退。 *)
  func 处理输出(内层: List, p: 解析器) -> (Dict, 解析器) =
    内层[0] ? (内层[1], 内层[2]) : 做文本回退(p)

  (* 禁并列：构造禁用并列应用的解析器副本（供输出括号内解析使用）。 *)
  func 禁并列(p: 解析器) -> 解析器 =
    { tokens: p.tokens, pos: p.pos, line: p.line, col: p.col, 禁止并列: 真, 自定义: p.自定义, 在理解头: p.在理解头 }

  (* 置在理解头：构造（不）处于集合理解头部的解析器副本，控制 `|` 是否作位或。 *)
  func 置在理解头(p: 解析器, v: Bool) -> 解析器 =
    { tokens: p.tokens, pos: p.pos, line: p.line, col: p.col, 禁止并列: p.禁止并列, 自定义: p.自定义, 在理解头: v }

  (* 文本回退：拼接当前至 ] 之间的原始记号文本（含换行 "\n"，不跳过换行），
     与宿主回退的 _advance().value 逐 token 拼接一致。
     返回 (字符串字面量, 停在 ] 的解析器)，供调用方随后消费 ]。 *)
  func 做文本回退(p: 解析器) -> (Dict, 解析器) =
    let (文本, p2) = 收集原始文本(p, "") in
    (做StringLit(文本), p2)

  func 收集原始文本(p: 解析器, acc: String) -> (String, 解析器) =
    匹配(p, 类型.右括号方) or 匹配(p, 类型.结束) ? (acc, p) :
    收集原始文本(推进原样(p), acc + 当前(p).文本)

  (* 窥视：从当前位置起的下一个非换行 token *)
  func 窥视(p: 解析器, n: Int) -> Token =
    let (t, p2) = 窥视走(p, n, 0) in t

  func 窥视走(p: 解析器, n: Int, seen: Int) -> (Token, 解析器) =
    seen = n ? (当前(p), p) :
    (p.pos < len(p.tokens)) ?
      (p.tokens[p.pos].类型 = 类型.换行 ?
        窥视走({ tokens: p.tokens, pos: p.pos + 1, line: p.line + 1, col: 1 }, n, seen) :
        窥视走({ tokens: p.tokens, pos: p.pos + 1, line: p.line, col: p.col }, n, seen + 1)) :
      (当前(p), p)

  (* 列表前瞻：当前是表达式起始，且其后紧跟逗号 *)
  func 窥视逗号(p: 解析器) -> Bool =
    窥视(p, 1).类型 = 类型.逗号

  (* 表达式起始：当前 token 是否可作为 primary 开头
     （对齐宿主 _is_primary_start；null/none/undefined 在自举词法器为标识符，
     故一并列入关键字分支以保持等价）。 *)
  func 是表达式起始(p: 解析器) -> Bool =
    let t = 当前(p).类型 in t = 类型.整数 or t = 类型.浮点 or t = 类型.字符串 or
    t = 类型.布尔 or t = 类型.标识符 or t = 类型.占位符 or t = 类型.符号 or
    t = 类型.左括号 or t = 类型.左括号方 or t = 类型.左括号花 or
    t = 类型.尖括号 or t = 类型.读取开 or t = 类型.读取开2 or
    (t = 类型.关键字 and (当前(p).文本 = "if" or 当前(p).文本 = "null" or
      当前(p).文本 = "none" or 当前(p).文本 = "undefined"))

  (* 输出集合运算符文本：∪ ∩ ⊖ × ⊆（含别名 ＼/＄），排除补运算 ～/〜/¬
     （对齐宿主 _parse_output 列表分支只认 UNION/INTER/DIFF/PROD/SUBSET）。 *)
  func 是输出集合运算符文本(s: String) -> Bool =
    s = "∪" or s = "∩" or s = "⊖" or s = "＼" or s = "×" or s = "＄" or s = "⊆"

  func 是输出集合运算符(p: 解析器) -> Bool =
    当前(p).类型 = 类型.符号 and 是输出集合运算符文本(当前(p).文本)

  (* 集合运算符前瞻：紧跟的集合运算符（非补）且其后为 , 或 ]（对齐宿主
     _parse_output 的 is_list_lookahead 分支）。 *)
  func 输出集合运算符前瞻(p: 解析器) -> Bool =
    let t1 = 窥视(p, 1) in
    let t2 = 窥视(p, 2) in
    t1.类型 = 类型.符号 and 是输出集合运算符文本(t1.文本) and
      (t2.类型 = 类型.逗号 or t2.类型 = 类型.右括号方)

  (* 括号有逗号：从下标 i 起按 (),[],{} 配对扫描，配对 ] 前出现深度 1 的逗号则真
     （对齐宿主 _bracket_has_comma；调用时 i 指向 [ 之后、深度从 1 起）。 *)
  func 括号有逗号(p: 解析器, i: Int, 深度: Int) -> Bool =
    i >= len(p.tokens) ? 假 :
    let t = p.tokens[i].类型 in
    (t = 类型.左括号 or t = 类型.左括号方 or t = 类型.左括号花) ?
      括号有逗号(p, i + 1, 深度 + 1) :
    (t = 类型.右括号 or t = 类型.右括号方 or t = 类型.右括号花) ?
      (深度 - 1 <= 0 ? 假 : 括号有逗号(p, i + 1, 深度 - 1)) :
    (t = 类型.逗号 and 深度 = 1) ? 真 :
    (t = 类型.结束) ? 假 :
    括号有逗号(p, i + 1, 深度)

  (* 列表前瞻：表达式起始 且（紧跟逗号 或 集合运算符前瞻 或 括号内有顶层逗号）
     ——对齐宿主 _parse_output 的 is_list_lookahead。 *)
  func 有列表前瞻(p: 解析器) -> Bool =
    是表达式起始(p) and (窥视逗号(p) or 输出集合运算符前瞻(p) or 括号有逗号(p, p.pos, 1))

  (* 输出集合续接：[a, b] 后跟 ∪/∩/⊖/×/⊆ [c,…]（左结合；右操作数用 解析加减，
     避免经 解析集合 右结合——对齐宿主 _parse_output 列表分支）。 *)
  func 解析输出集合_续(left: Dict, p: 解析器) -> (Dict, 解析器) =
    if 是输出集合运算符(p) then
      let op = 集合运算文本(当前(p).文本) in
      let p3 = 推进(p) in
      let (right, p4) = 解析加减(p3) in
      解析输出集合_续(做BinaryOp(op, left, right), p4)
    else (left, p)

  func 跳过大括号块(p: 解析器, 深度: Int) -> 解析器 =
    深度 = 0 ? 规范(p) :
    匹配(p, 类型.结束) ? p :
    匹配(p, 类型.左括号花) ?
      跳过大括号块(推进(p), 深度 + 1) :
    匹配(p, 类型.右括号花) ?
      跳过大括号块(推进(p), 深度 - 1) :
      跳过大括号块(推进(p), 深度)

  (* ===== 解析顶层声明 ===== *)

  (* module Name { decls... }：消费 module，解析模块名，期望 {，
     递归解析内部声明直到 }。声明中的函数名会被编译器加模块前缀。 *)
  func 解析模块声明(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进(p) in  (* 消费 module *)
    let 模块名 = 当前(p1).文本 in
    let p2 = 推进(p1) in
    let p3 = 期望(p2, 类型.左括号花) in
    let (声明, p4) = 解析模块声明列表(规范(p3), []) in
    let p5 = 期望(p4, 类型.右括号花) in
    (做模块(模块名, 声明), 规范(p5))

  func 解析模块声明列表(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.右括号花) or 匹配(p, 类型.结束) then
      (reverse(acc), p)
    else
      let (decl, p2) = 解析声明(p) in
      解析模块声明列表(规范(p2), acc + [decl])

  (* use Name { a | b | c }：消费 use，解析模块名，期望 {，
     解析导入名列表（管道分隔），期望 }。导入名暂存，编译器忽略。 *)
  func 解析导入声明(p: 解析器) -> (Dict, 解析器) =
    let p1 = 推进(p) in  (* 消费 use *)
    let 模块名 = 当前(p1).文本 in
    let p2 = 推进(p1) in
    (* use Name { a | b } 形式 vs use Name（无大括号，全模块导入）*)
    if 匹配(p2, 类型.左括号花) then
      let (名字, p4) = 解析导入名列表(规范(p2), []) in
      let p5 = 期望(p4, 类型.右括号花) in
      (做导入(模块名, 名字), 规范(p5))
    else
      (做导入(模块名, []), p2)

  func 解析导入名列表(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.右括号花) then (acc, p)
    else if 匹配(p, 类型.管道) then
      解析导入名列表(推进(p), acc)
    else
      let 名 = 当前(p).文本 in
      解析导入名列表(推进(p), acc + [名])

  func 解析程序(tokens: List) -> Dict =
    let p = 规范({ tokens: tokens, pos: 0, line: 1, col: 1, 自定义: [], 在理解头: 假 }) in
    解析声明列表(p, [])

  func 解析声明列表(p: 解析器, acc: List) -> Dict =
    let p0 = 跳过分号(p) in
    if 匹配(p0, 类型.结束) then
      做Program(reverse(acc))
    else
      let (decl, p2) = 解析声明(p0) in
      解析声明列表(p2, acc + [decl])

  func 解析声明(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.段号) then
      解析机械单元(p)
    else if 匹配(p, 类型.读取开) then
      (* 自然语言标注块（宿主 _parse_statement 的 MATHA_READ_OPEN 分支）*)
      解析自然语言块(p)
    else if 匹配(p, 类型.设置符) then
      (* @define_op : … 自定义运算符声明（编译期 NOOP）*)
      解析定义运算符(p)
    else if 匹配(p, 类型.关键字) then
      let tok = 当前(p) in
      if tok.文本 = "func" then 解析函数定义(p)
      else if tok.文本 = "and" then
        (* and 互递归函数延续：and <名>(<参数>) -> <类型> = (<参数>) => <体>
           语义等价 func（省略 func 关键字），与宿主 _parse_and_func_def 对齐 *)
        解析函数定义(p)
      else if tok.文本 = "struct" then 解析结构体定义(p)
      else if tok.文本 = "enum" then 解析枚举定义(p)
      else if tok.文本 = "let" then 解析let表达式(p)
      else if tok.文本 = "if" then 解析if_stmt(p)
      else if tok.文本 = "while" then 解析while_stmt(p)
      else if tok.文本 = "for" then 解析for_stmt(p)
      else if tok.文本 = "match" then 解析match_stmt(p)
      else if tok.文本 = "switch" then 解析switch(p)
      else if tok.文本 = "try" then 解析try语句(p)
      else if tok.文本 = "module" then 解析模块声明(p)
      else if tok.文本 = "use" then 解析导入声明(p)
      else 解析表达式(p)
    else if 匹配(p, 类型.左括号方) then
      (* 语句位置的 [ 恒为输出单元（宿主 _parse_output 同构）*)
      解析输出语句(p)
    else if 匹配(p, 类型.标识符) then
      let tok = 当前(p) in
      let nxt = 当前(推进(p)) in
      if tok.文本 = "func" then 解析函数定义(推进(p))
      else if nxt.类型 = 类型.等于 then
        (* 顶层绑定 name = expr（绑定语义，与宿主 parser 一致；`==` 比较不在此列） *)
        let p1 = 推进(推进(p)) in
        let (val, p2) = 解析表达式(p1) in
        (做Binding(tok.文本, val), p2)
      else 解析表达式(p)
    else 解析表达式(p)

  (* 跳过返回类型：单 token（Int/Bool/...）或元组 (T1, T2) *)
  func 跳过返回类型(p: 解析器) -> (String, 解析器) =
    if 匹配(p, 类型.左括号) then
      let p2 = 推进(p) in
      let p3 = 跳过类型至右括号(p2) in
      ("元组", p3)
    else
      let tok = 当前(p) in
      (tok.文本, 推进(p))

  func 跳过类型至右括号(p: 解析器) -> 解析器 =
    if 匹配(p, 类型.右括号) then 推进(p)
    else 跳过类型至右括号(推进(p))

  (* 类型名（可带 [] 泛型实参），返回源码文本。对齐宿主 _parse_type_name：
     标识符（?占位符）后跟任意层 [...]。用于 chan T 的元素类型；该文本仅
     供语义分析读取，不参与字节码，故此处不强制类型存在。 *)
  func 解析类型名(p: 解析器) -> (String, 解析器) =
    let 首 = 当前(p).文本 in
    解析类型名泛型(推进(p), 首)

  func 解析类型名泛型(p: 解析器, acc: String) -> (String, 解析器) =
    匹配(p, 类型.左括号方) ?
      let (内, p2) = 收集方括号(推进(p), "[", 1) in
      解析类型名泛型(p2, acc + 内) :
    (acc, p)

  (* 从 depth=1（已消费首个 [）起收集到配平的 ]，含首尾括号文本。
     注意：同一表达式里不能既 推进(p) 又 当前(p)——两者都按传入的 p 求值，
     须先把 token 绑到局部再推进，否则会漏掉/重复一个 token。 *)
  func 收集方括号(p: 解析器, acc: String, depth: Int)
      -> (String, 解析器) =
    匹配(p, 类型.结束) ? (acc, p) :
    let t = 当前(p) in
    let p2 = 推进(p) in
    let acc2 = acc + t.文本 in
    let 是开 = t.类型 = 类型.左括号方 in
    let d2 = 是开 ? depth + 1 : depth in
    let d3 = t.类型 = 类型.右括号方 ? d2 - 1 : d2 in
    d3 <= 0 ? (acc2, p2) : 收集方括号(p2, acc2, d3)

  (* 函数定义：func name(params) -> RetType = (params) => body *)
  func 解析函数定义(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* func *)
    let name_tok = 当前(p2) in
    let p3 = 推进(p2) in
    let name = name_tok.文本 in
    let p4 = 期望(p3, 类型.左括号) in
    let (params, p5) = 解析参数列表(p4) in
    let p6 = 期望(p5, 类型.右括号) in
    let p7 = 期望(p6, 类型.箭头) in  (* -> *)
    (* 返回类型：单 token（如 Int）或元组 (T1, T2) ——跳过括号内容 *)
    let (ret_type, p8) = 跳过返回类型(p7) in
    let p9 = 期望(p8, 类型.等于) in  (* = *)
    if 匹配(p9, 类型.左括号) then
      (* 显式 lambda：(params) => body *)
      let p10 = 推进(p9) in
      let (lam_params, p11) = if 匹配(p10, 类型.右括号) then ([], p10)
        else
          let (lparam, p10b) = 解析_lambda_param(p10) in
          解析_lambda_params_rest([], lparam, p10b) in
      let p12 = 期望(p11, 类型.右括号) in
      let p13 = 期望(p12, 类型.胖箭头) in  (* => *)
      let (body, p14) = 解析表达式(p13) in
      (做FuncDef(name, lam_params, ret_type, body), p14)
    else
      (* 直接体：未写 `(params) =>`，参数直接入 FuncDef.参数，体为裸表达式。
         与显式路径（parser 消费掉外层 lambda 语法）及宿主行为一致。 *)
      let (body, p14) = 解析表达式(p9) in
      (做FuncDef(name, params, ret_type, body), p14)

  func 解析参数列表(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号) then ([], p)
    else
      let (param, p2) = 解析参数(p) in
      let (rest, p3) = 解析参数列表_rest(p2) in
      ([param] + rest, p3)

  func 解析参数列表_rest(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.逗号) then
      let p2 = 推进(p) in
      let (param, p3) = 解析参数(p2) in
      let (rest, p4) = 解析参数列表_rest(p3) in
      ([param] + rest, p4)
    else ([], p)

  (* 解析函数定义中的参数：name（必选）后跟「: 类型」标注（可选）。
     消费参数名，若存在冒号则额外跳过类型 token，返回 (参数名, 新状态)。 *)
  func 解析参数(p: 解析器) -> (String, 解析器) =
    let tok = 当前(p) in
    let p2 = 推进(p) in
    let p3 = if 匹配(p2, 类型.冒号) then 推进(推进(p2)) else p2 in
    (tok.文本, p3)

  (* let 表达式：let [rec] 名 [: 类型] = 值 [in 体]
     - rec：递归绑定（值中的 lambda 可引用绑定名自身）
     - in 体：绑定作用域内的续体；无 in 时求值结果为绑定值本身
     与宿主 parser 的 LetBinding 语义对齐（自举层无 in 二元运算歧义，
     无需 _in_let_value 状态线程）。 *)
  (* 元组参数列表：(a, b, c) → [a, b, c]（仅标识符，逗号分隔）*)
  func 解析元组参数列表(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号) then ([], p)
    else
      let tok = 当前(p) in
      let p2 = 推进(p) in
      let (rest, p3) = 解析元组参数列表_rest(p2) in
      ([tok.文本] + rest, p3)

  func 解析元组参数列表_rest(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.逗号) then
      let tok = 当前(推进(p)) in
      let (rest, p3) = 解析元组参数列表_rest(推进(推进(p))) in
      ([tok.文本] + rest, p3)
    else ([], p)

  func 解析let表达式(p: 解析器) -> (Dict, 解析器) =
    let p1 = 期望(p, 类型.关键字) in  (* let *)
    let (是递归, p2) = 匹配关键字文本(p1, "rec") ?
      (真, 推进(p1)) : (假, p1) in
    if 匹配(p2, 类型.左括号) then
      (* 元组解构：let (a, b, ...) = expr [in body] *)
      let p3 = 推进(p2) in
      let (名字, p4) = 解析元组参数列表(p3) in
      let p5 = 期望(p4, 类型.右括号) in
      let p6 = 期望(p5, 类型.等于) in
      let (值expr, p7) = 解析表达式(p6) in
      if 匹配关键字文本(p7, "in") then
        let p8 = 推进(p7) in
        let (体expr, p9) = 解析表达式(p8) in
        (做Let元组绑定(名字, 值expr, 真, 体expr), p9)
      else
        (做Let元组绑定(名字, 值expr, 假, 做IntLit(0)), p7)
    else
      let name_tok = 当前(p2) in
      let p3 = 推进(p2) in
      (* 函数式绑定：let name(params) -> RetType = body
         转换为 let name = (params) => body *)
      if 匹配(p3, 类型.左括号) then
        let p4 = 推进(p3) in
        let (params, p5) = 解析参数列表(p4) in
        let p6 = 期望(p5, 类型.右括号) in
        let p7 = 期望(p6, 类型.箭头) in
        let (忽略, p8) = 跳过返回类型(p7) in
        let p9 = 期望(p8, 类型.等于) in
        (* 与 解析函数定义 一致：若 `=` 后为显式 lambda `(params) => body`，
           则直接采用该 lambda（其参数即函数参数），不再用签名参数包一层，
           否则会形成双层 lambda（值变成返回函数的函数）。 *)
        let (lam, p10) = if 匹配(p9, 类型.左括号) then
          let q1 = 推进(p9) in
          let (lam_params, q2) = if 匹配(q1, 类型.右括号) then ([], q1)
            else
              let (lparam, q1b) = 解析_lambda_param(q1) in
              解析_lambda_params_rest([], lparam, q1b) in
          let q3 = 期望(q2, 类型.右括号) in
          let q4 = 期望(q3, 类型.胖箭头) in
          let (lbody, q5) = 解析表达式(q4) in
          (做Lambda(lam_params, lbody), q5)
        else
          let (dbody, q5) = 解析表达式(p9) in
          (做Lambda(params, dbody), q5) in
        if 匹配关键字文本(p10, "in") then
          let p11 = 推进(p10) in
          let (体expr, p12) = 解析表达式(p11) in
          (做Let绑定(name_tok.文本, lam, 是递归, 真, 体expr), p12)
        else
          (做Let绑定(name_tok.文本, lam, 是递归, 假, 做IntLit(0)), p10)
      else
        (* 简单绑定：let name [: Type] = expr [in body] *)
        let p3b = 匹配(p3, 类型.冒号) ? 推进(推进(p3)) : p3 in
        let p4 = 期望(p3b, 类型.等于) in
        let (值expr, p5) = 解析表达式(p4) in
        if 匹配关键字文本(p5, "in") then
          let p6 = 推进(p5) in
          let (体expr, p7) = 解析表达式(p6) in
          (做Let绑定(name_tok.文本, 值expr, 是递归, 真, 体expr), p7)
        else
          (做Let绑定(name_tok.文本, 值expr, 是递归, 假, 做IntLit(0)), p5)

  (* if 语句：if cond then expr else expr（表达式形式）
     或 if cond { 块 } [else { 块 }]（语句形式，else/否则 均可）*)
  func 解析if_stmt(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in
    let (cond, p3) = 解析表达式(p2) in
    if 匹配关键字文本(p3, "then") then
      let p4 = 推进(p3) in
      let (then_e, p5) = 解析表达式(p4) in
      if 匹配关键字文本(p5, "else") then
        let p6 = 推进(p5) in
        let (else_e, p7) = 解析表达式(p6) in
        (做If(cond, then_e, else_e), p7)
      else
        (做If(cond, then_e, null), p5)
    else
      let p4 = 期望(p3, 类型.左括号花) in
      let (then_body, p5) = 解析语句列表(p4) in
      let p6 = 期望(p5, 类型.右括号花) in
      if 匹配关键字文本(p6, "else") or 匹配关键字文本(p6, "否则") then
        let p7 = 推进(p6) in
        let p8 = 期望(p7, 类型.左括号花) in
        let (else_body, p9) = 解析语句列表(p8) in
        let p10 = 期望(p9, 类型.右括号花) in
        (做If(cond, then_body, else_body), p10)
      else
        (做If(cond, then_body, 做Program([])), p6)

  (* while 语句 *)
  func 解析while_stmt(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* while *)
    let (cond, p3) = 解析表达式(p2) in
    let p4 = 期望(p3, 类型.左括号花) in
    let (body, p5) = 解析语句列表(p4) in
    let p6 = 期望(p5, 类型.右括号花) in
    (做While(cond, body), p6)

  (* try 语句：try { 块 } [catch [(e)] { 块 }] [finally { 块 }]
     catch 变量可选（catch (e) {} 或 catch {}），catch/finally 均可选（宿主允许 try/finally 或 bare try） *)
  func 解析try语句(p: 解析器) -> (Dict, 解析器) =
    let p1 = 期望(p, 类型.关键字) in  (* try *)
    let p2 = 期望(p1, 类型.左括号花) in
    let (try体, p3) = 解析语句列表(p2) in
    let p4 = 期望(p3, 类型.右括号花) in
    let (捕获变量, 捕获体, p5) =
      if 匹配关键字文本(p4, "catch") then
        let p4a = 推进(p4) in
        let (捕获变量, p4b) =
          if 匹配(p4a, 类型.左括号) then
            let 变量tok = 当前(推进(p4a)) in
            let p4c = 期望(推进(p4a), 类型.标识符) in
            let p4d = 期望(p4c, 类型.右括号) in
            (变量tok.文本, p4d)
          else ("", p4a) in
        let p4e = 期望(p4b, 类型.左括号花) in
        let (捕获体, p4f) = 解析语句列表(p4e) in
        let p4g = 期望(p4f, 类型.右括号花) in
        (捕获变量, 捕获体, p4g)
      else
        ("", 做Program([]), p4) in
    if 匹配关键字文本(p5, "finally") then
      let p5a = 推进(p5) in
      let p5b = 期望(p5a, 类型.左括号花) in
      let (fin体, p5c) = 解析语句列表(p5b) in
      let p5d = 期望(p5c, 类型.右括号花) in
      (做Try(try体, 捕获变量, 捕获体, fin体), p5d)
    else
      (做Try(try体, 捕获变量, 捕获体, 做Program([])), p5)

  (* for 语句：for var in expr { body } *)
  func 解析for_stmt(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* for *)
    let var_tok = 当前(p2) in
    let p3 = 推进(p2) in
    let p4 = 期望(p3, 类型.关键字) in  (* in *)
    let (iterable, p5) = 解析表达式(p4) in
    let p6 = 期望(p5, 类型.左括号花) in
    let (body, p7) = 解析语句列表(p6) in
    let p8 = 期望(p7, 类型.右括号花) in
    (做For(var_tok.文本, iterable, body), p8)

  (* match 语句：match <expr> { | <pat> [if <guard>] => <body> ... }
     与宿主 _parse_match_stmt 对齐：分支以 | 前导；支持守卫；模式支持
     字面量 / 变量绑定 / 构造子 / 下划线通配。分支元组为 [模式, 守卫, 体]
     （守卫缺省为 null），与宿主 (pattern, guard, body) 一致。 *)
  func 解析match_stmt(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* match *)
    let (scrutinee, p3) = 解析表达式(p2) in
    let p4 = 期望(p3, 类型.左括号花) in
    let (acc, p5) = 解析match分支(p4, []) in
    let p6 = 期望(p5, 类型.右括号花) in
    (做Match(scrutinee, acc), p6)

  func 解析match分支(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.管道) then
      let p2 = 推进(p) in  (* 消费 | *)
      let (pattern, p3) = 解析match模式(p2) in
      let (guard, p4) =
        if 匹配关键字文本(p3, "if") then
          let (g, pg) = 解析表达式(推进(p3)) in (g, pg)
        else (null, p3) in
      let p5 = 期望(p4, 类型.胖箭头) in
      (* 体表达式置「在理解头」：复用该旗标抑制 `|` 作位或——宿主表达式止于
         换行，而本解析器的 推进 会跳过换行，否则下一行行首的 `|` 会被续接成
         位或运算，多分支 match 的分支分隔符随之丢失。 *)
      let 原 = p5.在理解头 in
      let (body, p6) = 解析表达式(置在理解头(p5, 真)) in
      解析match分支(置在理解头(p6, 原), acc + [[pattern, guard, body]])
    else
      (reverse(acc), p)

  func 解析match模式(p: 解析器) -> (Dict, 解析器) =
    if 匹配(p, 类型.下划线) or 匹配(p, 类型.占位符) then
      (做Variable("_"), 推进(p))
    else if 匹配(p, 类型.整数) then
      let tok = 当前(p) in
      (做IntLit(整数值(tok.文本)), 推进(p))
    else if 匹配(p, 类型.浮点) then
      let tok = 当前(p) in
      (做FloatLit(浮点值(tok.文本)), 推进(p))
    else if 匹配(p, 类型.字符串) then
      let tok = 当前(p) in
      (做StringLit(tok.文本), 推进(p))
    else if 匹配(p, 类型.布尔) then
      let tok = 当前(p) in
      (做BoolLit(tok.文本 = "真" or tok.文本 = "true"), 推进(p))
    else if 匹配(p, 类型.标识符) then
      let tok = 当前(p) in
      let p2 = 推进(p) in
      if 匹配(p2, 类型.左括号) then
        let (字段, p3) = 解析模式字段列表(推进(p2), []) in
        let p4 = 期望(p3, 类型.右括号) in
        (做构造子模式(tok.文本, 字段), p4)
      else
        (做Variable(tok.文本), p2)
    else (做Variable("_"), p)

  (* 构造子模式字段：(pat, pat, ...) —— 逗号分隔；空列表返回 []。
     与宿主 _parse_pattern 构造子分支一致，按位置对应字段。 *)
  func 解析模式字段列表(p: 解析器, acc: List) -> (List, 解析器) =
    if 匹配(p, 类型.右括号) then
      (reverse(acc), p)
    else
      let p1 = acc = [] ? p : 期望(p, 类型.逗号) in
      let (pat, p2) = 解析match模式(p1) in
      解析模式字段列表(p2, acc + [pat])

  (* switch 语句：switch <expr> { case <val>: <body> ... default: <body> }
     与宿主 _parse_switch_stmt 对齐。无 default 时 默认 为 null。 *)
  func 解析switch(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* switch *)
    let (value, p3) = 解析表达式(p2) in
    let p4 = 期望(p3, 类型.左括号花) in
    let (分支, 默认, p5) = 解析switch分支(p4, [], null) in
    let p6 = 期望(p5, 类型.右括号花) in
    (做Switch(value, 分支, 默认), p6)

  func 解析switch分支(p: 解析器, cases: List, 默认: Dict) -> (List, Dict, 解析器) =
    if 匹配(p, 类型.右括号花) or 匹配(p, 类型.结束) then
      (reverse(cases), 默认, p)
    else if 匹配关键字文本(p, "default") then
      let p2 = 期望(推进(p), 类型.冒号) in
      let (body, p3) = 解析表达式(p2) in
      解析switch分支(p3, cases, body)
    else if 匹配关键字文本(p, "case") then
      let p2 = 推进(p) in
      let (case_val, p3) = 解析表达式(p2) in
      let p4 = 期望(p3, 类型.冒号) in
      let (body, p5) = 解析表达式(p4) in
      解析switch分支(p5, cases + [[case_val, body]], 默认)
    else
      (reverse(cases), 默认, p)

  (* 语句列表 *)
  func 解析语句列表(p: 解析器) -> (Dict, 解析器) =
    解析语句列表_rest(p, [])

  func 解析语句列表_rest(p: 解析器, acc: List) -> (Dict, 解析器) =
    let p0 = 跳过分号(p) in
    if 匹配(p0, 类型.右括号花) or 匹配(p0, 类型.结束) then
      (做Program(reverse(acc)), p0)
    else
      let (stmt, p2) = 解析声明(p0) in
      解析语句列表_rest(p2, acc + [stmt])

  (* 结构体定义：struct Name { field1: Type1, field2: Type2 } *)
  func 解析结构体定义(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* struct *)
    let name_tok = 当前(p2) in
    let p3 = 推进(p2) in
    let p4 = 期望(p3, 类型.左括号花) in
    let (fields, p5) = 解析结构体字段列表(p4) in
    let p6 = 期望(p5, 类型.右括号花) in
    (做StructDef(name_tok.文本, fields), p6)

  func 解析结构体字段列表(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号花) then
      ([], p)
    else
      let name_tok = 当前(p) in
      let p2 = 推进(p) in
      let p3 = 期望(p2, 类型.冒号) in
      let type_tok = 当前(p3) in
      let p4 = 推进(p3) in
      (* 字段间逗号分隔（可选尾逗号）：x: Int, y: Int [,] *)
      let p4b = 匹配(p4, 类型.逗号) ? 推进(p4) : p4 in
      let (rest, p5) = 解析结构体字段列表(p4b) in
      ([{"名": name_tok.文本, "类型": type_tok.文本}] + rest, p5)

  (* 枚举定义：enum Name { Ctor1 | Ctor2 | Ctor3 }
     构造子分隔：| 或空格/换行均可（与宿主 parser 一致） *)
  func 解析枚举定义(p: 解析器) -> (Dict, 解析器) =
    let p2 = 期望(p, 类型.关键字) in  (* enum *)
    let name_tok = 当前(p2) in
    let p3 = 推进(p2) in
    let p4 = 期望(p3, 类型.左括号花) in
    let (ctors, p5) = 解析枚举构造子列表(p4) in
    let p6 = 期望(p5, 类型.右括号花) in
    (做EnumDef(name_tok.文本, ctors), p6)

  (* 构造子列表：标识符序列，分隔符为 | 或换行/空格（连续标识符即可） *)
  func 解析枚举构造子列表(p: 解析器) -> (List, 解析器) =
    if 匹配(p, 类型.右括号花) then
      ([], p)
    else
      let tok = 当前(p) in
      let p2 = 推进(p) in
      (* 跳过换行（多行枚举支持） *)
      let p2b = 匹配(p2, 类型.换行) ? 推进(p2) : p2 in
      let (rest, p3) = if 匹配(p2b, 类型.管道) then
        解析枚举构造子列表(推进(p2b))
      else if 匹配(p2b, 类型.右括号花) then
        ([], p2b)
      else
        (* 空格分隔的下一个构造子 *)
        解析枚举构造子列表(p2b) in
      ([tok.文本] + rest, p3)

  (* ===== 公共入口 ===== *)
  func parse(tokens: List) -> Dict = 解析程序(tokens)

  (* ===== 自测 ===== *)
  #：{
    (* 测试：基础输出 *)
    [1]
  }

}
