module 绘画辅助 {
(* ============================================================
   Matha 标准库·绘画辅助 绘画辅助
   ------------------------------------------------------------
   阶段 24b：画布域（src/domains/graphics_engine.py）真光栅之上的
   纯 Matha 组合层 —— 三角形描边、坐标轴、直方图。零新内建，全部
   由画布域柯里化符号（设置描边/画线/画矩形）与内核 len 组合。

   行为口径（Python 真相由 tests/test_graphics_canvas_phase24.py
   与本文件 use 对拍锁双端同值）：
     画三角形(cv, x1, y1, x2, y2, x3, y3, c)
                         三边描线（显式颜色规格），返回 cv
     画坐标轴(cv, w, h, c)
                         水平/垂直中轴两条线，返回 cv
     画直方图(cv, xs, x, y, w, h, c)
                         值列表 xs 归一化条形图（按峰值缩放；
                         全负值表峰值记 0 → 全部零高条），返回 cv

   写法约束（沿用 collections_core 实测口径）：
     · 函数体走 `func f(p...) = (p...) => { 体 }` curried 形式；
     · 循环用 while + 语句位裸赋值计数器（阶段 22c 绑定语义）；
     · 峰值经 let rec 折叠，不用排序。
   ============================================================ *)

func 画三角形(cv, x1, y1, x2, y2, x3, y3, c) -> Canvas = (cv, x1, y1, x2, y2, x3, y3, c) => {
  设置描边(cv, c, 1)
  画线(cv, x1, y1, x2, y2)
  画线(cv, x2, y2, x3, y3)
  画线(cv, x3, y3, x1, y1)
  cv
}

func 画坐标轴(cv, w, h, c) -> Canvas = (cv, w, h, c) => {
  设置描边(cv, c, 1)
  画线(cv, 0, h / 2, w, h / 2)
  画线(cv, w / 2, 0, w / 2, h)
  cv
}

func 画直方图(cv, xs, x, y, w, h, c) -> Canvas = (cv, xs, x, y, w, h, c) => {
  let n = len(xs)
  let rec 峰值折叠 = (i, acc) => (i >= n) ? acc : ((xs[i] > acc) ? 峰值折叠(i + 1, xs[i]) : 峰值折叠(i + 1, acc))
  let 峰值 = 峰值折叠(0, 0)
  let 条宽 = w / n
  let i = 0
  while i < n {
    let 条高 = (峰值 > 0) ? (h * xs[i] / 峰值) : 0
    画矩形(cv, x + i * 条宽, y + h - 条高, 条宽, 条高, c)
    i = i + 1
  }
  cv
}
}
