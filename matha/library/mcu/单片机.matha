module 单片机 {
(* ============================================================
   Matha 标准库·单片机
   ------------------------------------------------------------
   阶段 24f 单片机域（src/domains/mcu.py）之上的纯 Matha 组合层
   —— 常用固件模板与控制载荷封装。零新内建，全部由单片机域符号
   （单片机_编程 / 单片机_图纸 / 单片机_控制）组合；指令规格由
   本层程序化构造（呼吸灯的 模拟写 斜坡即资源库生成指令列表），
   「资源库当代码用」的单片机面。

   行为口径（Python 真相由 tests/test_library_capability_phase24.py
   与本文件 use 对拍锁双端同值）：
     闪灯程序(板, 引脚, 毫秒)
                         数字写 高/低 + 延时 blink 循环，返回 单片机_编程
                         结果字典（键：代码/板/mcu/字节数）
     闪灯图纸(板, 引脚)
                         LED 接线 SVG 示意图，返回 单片机_图纸 结果
                         字典（键：svg/宽/高/板/元件数）
     呼吸灯程序(板, 引脚)
                         模拟写 占空比 0→255→0 斜坡（步进 25，每步
                         延时 15ms）——引脚须为本板型 PWM 引脚（uno/
                         nano：3/5/6/9/10/11），非 PWM 引脚如实报错
     控制载荷(板, 指令)
                         指令序列归一化校验，返回 matha-mcu-ctl/1
                         协议载荷（串口实时收发仍显式拒绝）

   写法约束（沿用 绘画辅助 实测口径）：
     · 函数体走 `func f(p...) -> T = (p...) => { 体 }` curried 形式；
     · 指令操作名为文本字面量（["数字写", 引脚, "高"]）——裸标识符
       在列表字面量里是变量；
     · 读指令（模拟读）生成的 C 无条件补 Serial.begin(9600)（域面
       行为，本层不重排）。
   ============================================================ *)

func 闪灯程序(板, 引脚, 毫秒) -> Any = (板, 引脚, 毫秒) => {
  单片机_编程({"板": 板, "设置": [["数字模式", 引脚, "输出"]], "循环": [["数字写", 引脚, "高"], ["延时", 毫秒], ["数字写", 引脚, "低"], ["延时", 毫秒]]})
}

func 闪灯图纸(板, 引脚) -> Any = (板, 引脚) => {
  单片机_图纸({"板": 板, "元件": [["LED", 引脚]]})
}

func 呼吸灯程序(板, 引脚) -> Any = (板, 引脚) => {
  let 循环 = []
  let d = 0
  while d <= 255 {
    循环 = 循环 + [["模拟写", 引脚, d], ["延时", 15]]
    d = d + 25
  }
  d = 255
  while d >= 0 {
    循环 = 循环 + [["模拟写", 引脚, d], ["延时", 15]]
    d = d - 25
  }
  单片机_编程({"板": 板, "设置": [["数字模式", 引脚, "输出"]], "循环": 循环})
}

func 控制载荷(板, 指令) -> Any = (板, 指令) => {
  单片机_控制({"板": 板, "指令": 指令})
}
}
