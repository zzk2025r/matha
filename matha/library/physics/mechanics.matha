(* 资源库：物理 — 经典力学 *)
(* 保护隔离：速度、加速度、力、动能、势能 *)

func 速度(s: Float, t: Float) -> Float = (s, t) => s / t
func 加速度(v: Float, t: Float) -> Float = (v, t) => v / t
func 牛顿第二定律(m: Float, a: Float) -> Float = (m, a) => m * a
func 动能(m: Float, v: Float) -> Float = (m, v) => 0.5 * m * v ^ 2
func 重力势能(m: Float, g: Float, h: Float) -> Float = (m, g, h) => m * g * h
