module 端口协议 {
(* ============================================================
   Matha 资源库·OS 分支——统一五动作端口协议（阶段 28e）
   ------------------------------------------------------------
   工具链六层（词法语法 / 解释器宿主 / 解释器自举 / 编译器 /
   虚拟机 / 内核特性）的扩展插口统一协议层：五动作（注册 / 启停 /
   升级 / 回滚 / 依赖协商）以纯函数形态定义——端口状态进出，
   不触任何运行时；各层适配器（宿主 src/extension_port.py +
   自举 内建插口/解释器插口）据此对齐。

   端口状态形状：
     {"层": 层名,
      "条目": [[名, 版本, 启用, 实现, 历史行们, 依赖名们]],
      "审计": [String 行]}
   历史行们 = [[版本, 实现]]（升级压栈 / 回滚弹出，仅一层语义由
   调用方约定——协议层保留全部历史，回滚弹最近一版）。

   五动作统一返回三元组 (结果: Bool, 端口: Dict, 原因: String)：
   诚实拒绝不抛错——失败面由 结果=假 + 原因 表达，状态原样返回。

   行为口径（tests/test_port_protocol_phase28.py 锁）：
     新端口(层名)             空端口
     端口注册(P,名,版本,实现,依赖)  重名 → 假「已注册」；
         依赖名们须在场且启用（依赖协商内联）否则 假「依赖未满足: …」
     端口启停(P,名,开关)      未注册 → 假；启用时依赖复查；
         停用无条件（停用依赖方不级联——诚实边界：协商面可见）
     端口升级(P,名,新版本,新实现)  未注册 → 假；旧版压历史
     端口回滚(P,名)          无历史 → 假「无历史」；弹最近一版还原
     端口依赖协商(P,名,需求们)  只读核查 → 真/假 + 原因列缺失停用名
   ============================================================ *)

  use 标准库 { len | str | list_slice | 原地设置 }

  func 新端口(层名: String) -> Dict = (层名) => {
    let 条 = []
    let 空 = []
    {"层": 层名, "条目": 条, "审计": 空}
  }

  func 找条目(端口: Dict, 名: String) -> Int =
    let 条目们 = 端口["条目"] in
    端口_找(条目们, 名, 0)

  func 端口_找(条目们: List, 名: String, i: Int) -> Int =
    i >= len(条目们) ? -1 :
    (条目们[i][0] = 名 ? i : 端口_找(条目们, 名, i + 1))

  func 端口条目(端口: Dict, 名: String) -> Value =
    let i = 找条目(端口, 名) in
    i >= 0 ? 端口["条目"][i] : null

  func 端口名表(端口: Dict) -> List =
    let 条目们 = 端口["条目"] in
    端口_名们(条目们, 0, [])

  func 端口_名们(条目们: List, i: Int, 收: List) -> List =
    i >= len(条目们) ? 收 :
    端口_名们(条目们, i + 1, 收 + [条目们[i][0]])

  func 端口启用名表(端口: Dict) -> List =
    let 条目们 = 端口["条目"] in
    端口_启用名们(条目们, 0, [])

  func 端口_启用名们(条目们: List, i: Int, 收: List) -> List =
    i >= len(条目们) ? 收 :
    (条目们[i][2] ?
      端口_启用名们(条目们, i + 1, 收 + [条目们[i][0]]) :
      端口_启用名们(条目们, i + 1, 收))

  func 端口审计(端口: Dict) -> List = 端口["审计"]

  (* 依赖核查：需求名们全部在场且启用 → 真；否则把缺失/停用名列进原因 *)
  func 依赖核查(端口: Dict, 需求名们: List) -> (Bool, String) =
    let 条目们 = 端口["条目"] in
    let 缺 = 端口_缺失(条目们, 需求名们, 0, []) in
    let 停 = 端口_停用(条目们, 需求名们, 0, []) in
    (len(缺) + len(停) = 0) ?
      (真, "依赖满足") :
      (假, 依赖原因(缺, 停))

  func 端口_缺失(条目们: List, 需求名们: List, i: Int, 收: List) -> List =
    i >= len(需求名们) ? 收 :
    (端口_找(条目们, 需求名们[i], 0) < 0 ?
      端口_缺失(条目们, 需求名们, i + 1, 收 + [需求名们[i]]) :
      端口_缺失(条目们, 需求名们, i + 1, 收))

  func 端口_停用(条目们: List, 需求名们: List, i: Int, 收: List) -> List =
    i >= len(需求名们) ? 收 :
    (let j = 端口_找(条目们, 需求名们[i], 0) in
     (j >= 0 and not 条目们[j][2]) ?
       端口_停用(条目们, 需求名们, i + 1, 收 + [需求名们[i]]) :
       端口_停用(条目们, 需求名们, i + 1, 收))

  func 依赖原因(缺: List, 停: List) -> String =
    "依赖未满足" + (len(缺) > 0 ? " 缺失" + 列串(缺) : "") +
    (len(停) > 0 ? " 停用" + 列串(停) : "")

  func 列串(名们: List) -> String =
    "[" + _逗串们(名们, 0, "") + "]"

  func _逗串们(名们: List, i: Int, 收: String) -> String =
    i >= len(名们) ? 收 :
    (i = 0 ? 收 + 名们[i] : 收 + "," + 名们[i])

  func 审计加(端口: Dict, 行: String) -> Dict =
    let 审计 = 端口["审计"] + [行] in
    {"层": 端口["层"], "条目": 端口["条目"], "审计": 审计}

  (* ===== 动作一：注册（依赖协商内联）===== *)
  func 端口注册(端口: Dict, 名: String, 版本: Int, 实现, 依赖名们: List) -> (Bool, Dict, String) =
    找条目(端口, 名) >= 0 ?
      (假, 端口, "已注册") :
    (let 核 = 依赖核查(端口, 依赖名们) in
     核[0] ? 注册落(端口, 名, 版本, 实现, 依赖名们) : (假, 端口, 核[1]))

  func 注册落(端口: Dict, 名: String, 版本: Int, 实现, 依赖名们: List) -> (Bool, Dict, String) =
    let 新条目 = [名, 版本, 真, 实现, [], 依赖名们] in
    let 新条目们 = 端口["条目"] + [新条目] in
    let 新状态 = {"层": 端口["层"], "条目": 新条目们, "审计": 端口["审计"]} in
    let 落定 = 审计加(新状态, "注册 " + 端口["层"] + "/" + 名 + " v" + str(版本)) in
    (真, 落定, "注册完成")

  (* ===== 动作二：启停（启用复查依赖；停用不级联）===== *)
  func 端口启停(端口: Dict, 名: String, 开关: Bool) -> (Bool, Dict, String) =
    let i = 找条目(端口, 名) in
    i < 0 ? (假, 端口, "未注册") :
    (let 条目 = 端口["条目"][i] in
     (开关 and not 条目[2]) ?
       (let 核 = 依赖核查(端口, 条目[5]) in
        核[0] ? 启停落(端口, i, 开关) : (假, 端口, 核[1])) :
     (条目[2] = 开关) ? (真, 端口, "无变化") :
       启停落(端口, i, 开关))

  func 启停落(端口: Dict, i: Int, 开关: Bool) -> (Bool, Dict, String) =
    let 条目 = 端口["条目"][i] in
    let 新条目 = [条目[0], 条目[1], 开关, 条目[3], 条目[4], 条目[5]] in
    let 新条目们 = 原地设置(端口["条目"], i, 新条目) in
    let 新状态 = {"层": 端口["层"], "条目": 新条目们, "审计": 端口["审计"]} in
    let 落定 = 审计加(新状态, (开关 ? "启用 " : "停用 ") + 端口["层"] + "/" + 条目[0]) in
    (真, 落定, "启停完成")

  (* ===== 动作三：升级（旧版压历史）===== *)
  func 端口升级(端口: Dict, 名: String, 新版本: Int, 新实现) -> (Bool, Dict, String) =
    let i = 找条目(端口, 名) in
    i < 0 ? (假, 端口, "未注册") :
    (let 条目 = 端口["条目"][i] in
     let 历史 = 条目[4] + [[条目[1], 条目[3]]] in
     let 新条目 = [条目[0], 新版本, 条目[2], 新实现, 历史, 条目[5]] in
     let 新条目们 = 原地设置(端口["条目"], i, 新条目) in
     let 新状态 = {"层": 端口["层"], "条目": 新条目们, "审计": 端口["审计"]} in
     let 落定 = 审计加(新状态, "升级 " + 端口["层"] + "/" + 名 + " v" + str(条目[1]) + "->v" + str(新版本)) in
     (真, 落定, "升级完成"))

  (* ===== 动作四：回滚（弹最近一版还原）===== *)
  func 端口回滚(端口: Dict, 名: String) -> (Bool, Dict, String) =
    let i = 找条目(端口, 名) in
    i < 0 ? (假, 端口, "未注册") :
    (let 条目 = 端口["条目"][i] in
     len(条目[4]) = 0 ? (假, 端口, "无历史") :
     (let 最近 = 条目[4][len(条目[4]) - 1] in
      let 历史 = list_slice(条目[4], 0, len(条目[4]) - 1) in
      let 新条目 = [条目[0], 最近[0], 条目[2], 最近[1], 历史, 条目[5]] in
      let 新条目们 = 原地设置(端口["条目"], i, 新条目) in
      let 新状态 = {"层": 端口["层"], "条目": 新条目们, "审计": 端口["审计"]} in
      let 落定 = 审计加(新状态, "回滚 " + 端口["层"] + "/" + 名 + "->v" + str(最近[0])) in
      (真, 落定, "回滚完成")))

  (* ===== 动作五：依赖协商（只读）===== *)
  func 端口依赖协商(端口: Dict, 名: String, 需求名们: List) -> (Bool, Dict, String) =
    let 核 = 依赖核查(端口, 需求名们) in
    (核[0], 端口, 核[1])

  (* ===== 汇报面：三元组 → 可打印摘要字典（层名 + 条目/审计计数）=====
     单参收整个动作三元组（宿主驱动一行式：端口报告(动作(...))["结果"]）——
     若收三个散参，单实参调用会落成部分应用、后缀 ["结果"] 便索引到闭包上。 *)
  func 端口报告(三元: (Bool, Dict, String)) -> Dict =
    let 端口 = 三元[1] in
    {"结果": 三元[0], "层": 端口["层"], "原因": 三元[2], "条目数": len(端口["条目"]), "审计行数": len(端口["审计"])}

}
