module 进程管理 {
(* ============================================================
   Matha 资源库·OS 分支——进程管理（阶段 27f）
   ------------------------------------------------------------
   27c 内核（matha/os/kernel.matha）之上的纯 Matha 组合层：
   面向共生体调用者的进程面常用编排。零新内建，全部由内核符号
   （调度 / 进程列表 / 启动 / 停止）组合，「资源库当代码用」的
   OS 面。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     运行到退出(内核, pid, 上限轮)
                         逐轮调度直至 pid 进程退出或达上限轮；返回
                         {"轮数", "步数", "事件", "已退出"}
     批量启动(内核, 名们) 逐单元内核 启动 协商；返回
                         {"成功": [名...], "拒绝": [[名, 原因]...]}
     批量停止(内核, 名们) 同上（内核 停止 协商）
     进程快照(内核)       进程表可读行序列
                         （"pid N 单元/入口 状态 步数 M"）

   写法约束：与内核同源已证形态（curried 块体 / let...in 嵌套 /
   尾随三元链）；负轮界用 <= 0 收口。
   ============================================================ *)

  use 标准库 { len | str }
  use 内核

  func _找行(行表, pid) -> List =
    if 行表 = [] then []
    else if 行表[0][0] = pid then 行表[0]
    else _找行(行表[1:], pid)

  func _跑到退出(内核, pid, 剩, 轮数, 事件, 步数) -> List =
    if 剩 <= 0 then [轮数, 步数, 事件]
    else
      let r = 调度(内核, 1) in
      let 事件2 = 事件 + r["事件"] in
      let 步2 = 步数 + r["步数"] in
      let 行 = _找行(进程列表(内核), pid) in
      let 已退 = len(行) > 0 and 行[3] = "已退出" in
      已退 or 剩 - 1 <= 0 ? [轮数 + 1, 步2, 事件2] : _跑到退出(内核, pid, 剩 - 1, 轮数 + 1, 事件2, 步2)

  func 运行到退出(内核, pid, 上限轮) -> Dict = (内核, pid, 上限轮) => {
    let 收 = _跑到退出(内核, pid, 上限轮, 0, [], 0)
    let 行 = _找行(进程列表(内核), pid)
    let 已退 = len(行) > 0 and 行[3] = "已退出"
    let 报 = {"轮数": 收[0], "步数": 收[1], "事件": 收[2], "已退出": 已退}
    报
  }

  func _启一批(内核, 名们, 好们, 坏们) -> List =
    if 名们 = [] then [好们, 坏们]
    else
      let r = 启动(内核, 名们[0]) in
      let 好 = r["结果"] = "拒绝" ? 好们 : 好们 + [名们[0]] in
      let 坏 = r["结果"] = "拒绝" ? 坏们 + [[名们[0], r["原因"]]] : 坏们 in
      _启一批(内核, 名们[1:], 好, 坏)

  func 批量启动(内核, 名们) -> Dict = (内核, 名们) => {
    let 收 = _启一批(内核, 名们, [], [])
    let 报 = {"成功": 收[0], "拒绝": 收[1]}
    报
  }

  func _停一批(内核, 名们, 好们, 坏们) -> List =
    if 名们 = [] then [好们, 坏们]
    else
      let r = 停止(内核, 名们[0]) in
      let 好 = r["结果"] = "拒绝" ? 好们 : 好们 + [名们[0]] in
      let 坏 = r["结果"] = "拒绝" ? 坏们 + [[名们[0], r["原因"]]] : 坏们 in
      _停一批(内核, 名们[1:], 好, 坏)

  func 批量停止(内核, 名们) -> Dict = (内核, 名们) => {
    let 收 = _停一批(内核, 名们, [], [])
    let 报 = {"成功": 收[0], "拒绝": 收[1]}
    报
  }

  func 进程快照(内核) -> List = (内核) => _快照行(进程列表(内核), 0)

  func _快照行(行表, i) -> List =
    if i >= len(行表) then []
    else
      let 行 = "pid " + str(行表[i][0]) + " " + 行表[i][1] + "/" + 行表[i][2] + " " + 行表[i][3] + " 步数 " + str(行表[i][4]) in
      [行] + _快照行(行表, i + 1)
}
