module 单元清单 {
(* ============================================================
   Matha 资源库·OS 分支——单元清单（阶段 27f）
   ------------------------------------------------------------
   27c 内核（matha/os/kernel.matha）之上的纯 Matha 组合层：
   内核状态的可读清单面。零新内建，全部由内核符号
   （查询单元 / 单元列表 / 体检）组合——「资源库当代码用」的
   OS 清单面。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     清单行(内核, 名)     单行 "名 形态 v版本 状态 历史=N"
                         （未装载 → "未装载 名"）
     服务目录行(内核)     服务表逐行 "服务 X ← 提供者"
     依赖表(内核)         体检 依赖缺失 逐行 "名 缺: a, b"
                         （无缺失 → []）
     清单报告(内核)       头两行统计 + 单元行们 + 服务目录 + 依赖区
                         （无缺失 → ["依赖: 完整"]）

   写法约束：与内核同源已证形态（模块级 if-then-else / let...in
   嵌套 / 累加递归）；str 仅对数字取文（27e 实测口径）。
   ============================================================ *)

  use 标准库 { len | str }
  use 内核

  func _逗串(表) -> String =
    if len(表) = 0 then ""
    else if len(表) = 1 then 表[0]
    else 表[0] + ", " + _逗串(表[1:])

  func 清单行(内核, 名) -> String =
    if 查询单元(内核, 名) = null then "未装载 " + 名
    else
      let 信 = 查询单元(内核, 名) in
      信["名"] + " " + 信["形态"] + " v" + str(信["版本"]) + " " + 信["状态"] + " 历史=" + str(信["历史版本数"])

  func _清单行们(内核, 名们, i, 收) -> List =
    if i >= len(名们) then 收
    else _清单行们(内核, 名们, i + 1, 收 + [清单行(内核, 名们[i])])

  func _服务行(表, i, 收) -> List =
    if i >= len(表) then 收
    else _服务行(表, i + 1, 收 + ["服务 " + 表[i][0] + " ← " + 表[i][1]])

  func 服务目录行(内核) -> List = (内核) => _服务行(内核[3], 0, [])

  func _缺行们(对们, i, 收) -> List =
    if i >= len(对们) then 收
    else _缺行们(对们, i + 1, 收 + [对们[i][0] + " 缺: " + _逗串(对们[i][1])])

  func 依赖表(内核) -> List = (内核) => _缺行们(体检(内核)["依赖缺失"], 0, [])

  func _缺区(对们) -> List =
    if len(对们) = 0 then ["依赖: 完整"]
    else ["依赖缺失:"] + _缺行们(对们, 0, [])

  func 清单报告(内核) -> List = (内核) => {
    let 体 = 体检(内核)
    let 行们 = _清单行们(内核, 单元列表(内核), 0, [])
    let 头 = ["单元 " + str(体["单元数"]) + "  运行中 " + str(体["运行中"]) + "  已停止 " + str(体["已停止"])]
    let 进程 = ["进程 " + str(体["进程数"]) + "  就绪 " + str(体["就绪进程"])]
    let 服务 = 服务目录行(内核)
    let 缺 = _缺区(体["依赖缺失"])
    let 出 = 头 + 进程 + 行们 + 服务 + 缺
    出
  }
}
