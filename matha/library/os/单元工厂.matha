module 单元工厂 {
(* ============================================================
   Matha 资源库·OS 分支——单元工厂（阶段 27f）
   ------------------------------------------------------------
   27c 内核单元描述符的构造器组合层：五形态描述符一步成形，
   「资源库当代码用」的 OS 工厂面。本模块不 use 任何模块——
   只构造数据（描述符字典 + 一步闭包），内核协商由调用方驱动。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     应用描述(名, 入口名, 步)   形态 app，入口 [[入口名, 步]]
     服务描述(名, 服务名们)     形态 服务，入口 [["主", 一步]]，
                               服务 = 服务名们（一步 = 立即退出）
     包描述(名)                形态 包，入口 []（外部单元胶水由
                               27d 域面承接——诚实边界）
     插件描述(名, 符号名们)     形态 域插件，一步闭包一次性产出
                               符号名们（调用方给的符号清单——
                               解析器发现属宿主桥 27d 范围）
     带依赖(描述, 依赖名们)    换 requires 的副本（其余槽原样）
     带服务(描述, 服务名们)    换 服务 的副本

   写法约束：与 27c 驱动同源已证形态——列表值先 let 绑定再入
   字典；一步闭包 {"状态": null, "继续": false, "产出": 出}。
   ============================================================ *)

  func 应用描述(名, 入口名, 步) -> Dict = (名, 入口名, 步) => {
    let 入口 = [[入口名, 步]]
    let 空 = []
    let 描述 = {"名": 名, "形态": "app", "版本": 1, "requires": 空, "入口": 入口, "服务": 空}
    描述
  }

  func 服务描述(名, 服务名们) -> Dict = (名, 服务名们) => {
    let 步 = (状态) => {
      let 空 = []
      let 报 = {"状态": null, "继续": false, "产出": 空}
      报
    }
    let 入口 = [["主", 步]]
    let 空 = []
    let 描述 = {"名": 名, "形态": "服务", "版本": 1, "requires": 空, "入口": 入口, "服务": 服务名们}
    描述
  }

  func 包描述(名) -> Dict = (名) => {
    let 空 = []
    let 无入口 = []
    let 描述 = {"名": 名, "形态": "包", "版本": 1, "requires": 空, "入口": 无入口, "服务": 空}
    描述
  }

  func 插件描述(名, 符号名们) -> Dict = (名, 符号名们) => {
    let 步 = (状态) => {
      let 报 = {"状态": null, "继续": false, "产出": 符号名们}
      报
    }
    let 入口 = [["主", 步]]
    let 空 = []
    let 描述 = {"名": 名, "形态": "域插件", "版本": 1, "requires": 空, "入口": 入口, "服务": 空}
    描述
  }

  func 带依赖(描述, 依赖名们) -> Dict = (描述, 依赖名们) => {
    let 新 = {"名": 描述["名"], "形态": 描述["形态"], "版本": 描述["版本"], "requires": 依赖名们, "入口": 描述["入口"], "服务": 描述["服务"]}
    新
  }

  func 带服务(描述, 服务名们) -> Dict = (描述, 服务名们) => {
    let 新 = {"名": 描述["名"], "形态": 描述["形态"], "版本": 描述["版本"], "requires": 描述["requires"], "入口": 描述["入口"], "服务": 服务名们}
    新
  }
}
