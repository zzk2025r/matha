(* ============================================================
   Matha 标准库·代数化简（阶段 4）
   ------------------------------------------------------------
   建在 calculus_diff.matha 的规范形之上，提供面向调用的化简入口：
     化简文本(e)      规范形文本（合并同类项 / 幂合并 / 系数归一）
     展开文本(e)      先把乘式对加式做分配，再取规范形
     代入文本(e, v, 值) 变量替换后取规范形
   覆盖不到的结构一律 错误("不支持: …")，不静默给出近似结果。
   ============================================================ *)

(* 分配：把 mul 里嵌着的 add 乘开（仅对「系数 × 和式」「和式 × 和式」两种方向） *)
func 展开(e) -> Any = {
  let t = e[0]
  if t == "num" {
    return e
  }
  if t == "var" {
    return e
  }
  if t == "neg" {
    return ["neg", 展开(e[1])]
  }
  if t == "add" {
    return ["add", 展开(e[1]), 展开(e[2])]
  }
  if t == "sub" {
    return ["sub", 展开(e[1]), 展开(e[2])]
  }
  if t == "mul" {
    return 展乘对(展开(e[1]), 展开(e[2]))
  }
  if t == "div" {
    return ["div", 展开(e[1]), 展开(e[2])]
  }
  if t == "pow" {
    return 展幂(展开(e[1]), 展开(e[2]))
  }
  if t == "ln" {
    return ["ln", 展开(e[1])]
  }
  if t == "fn" {
    return ["fn", e[1], 展开(e[2])]
  }
  return 错误("不支持: 展开未知节点 " + t)
}

(* a * b：只要有一侧是加式就分配展开 *)
func 展乘对(a, b) -> Any = {
  if a[0] == "add" {
    return ["add", 展乘对(a[1], b), 展乘对(a[2], b)]
  }
  if b[0] == "add" {
    return ["add", 展乘对(a, b[1]), 展乘对(a, b[2])]
  }
  return ["mul", a, b]
}

(* 正整数幂的底数展开：(a+b)^n → 乘 n 次；其它情形原样留下（由规范形处理） *)
func 展幂(底, 指) -> Any = {
  if 指[0] == "num" {
    let n = 指[1]
    if 底[0] == "add" {
      if n > 0 {
        if n == int(n) {
          return 连乘(底, int(n))
        }
      }
    }
  }
  return ["pow", 底, 指]
}

func 连乘(底, n) -> Any = {
  if n == 1 {
    return 底
  }
  return ["mul", 底, 连乘(底, n - 1)]
}

(* ---------- 调用入口 ---------- *)

func 化简(e) -> Any = 规范(e)

func 化简文本(e) -> Str = 规范文本(规范(e))

func 展开文本(e) -> Str = 规范文本(规范(展开(e)))

func 代入(e, v, 值) -> Any = 规范(替(e, v, ["num", 值]))

func 代入文本(e, v, 值) -> Str = 规范文本(代入(e, v, 值))

(* 结构替换：不化简，只换变量 *)
func 替(e, v, 新) -> Any = {
  let t = e[0]
  if t == "var" {
    if e[1] == v {
      return 新
    }
    return e
  }
  if t == "num" {
    return e
  }
  if t == "neg" {
    return ["neg", 替(e[1], v, 新)]
  }
  if t == "ln" {
    return ["ln", 替(e[1], v, 新)]
  }
  if t == "fn" {
    return ["fn", e[1], 替(e[2], v, 新)]
  }
  return [t, 替(e[1], v, 新), 替(e[2], v, 新)]
}
