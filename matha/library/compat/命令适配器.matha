module 命令适配器 {
(* ============================================================
   Matha 资源库·兼容分支——命令适配器（阶段 27f）
   ------------------------------------------------------------
   12e 终端注册命令（matha_term_registry.txt『名字 路径』行式
   处理器）与 27c 内核单元之间的适配层：终端命令成为共生体
   内核单元——「终端命令/操作系统互调」的兼容面。零新内建，
   全部由 标准库（len/split/read_file）、胶水（路径存在/执行Matha）
   与内核 装载 组合。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     命令步(路径)      一步闭包：读处理器文件 + "\n处理([])" 拼源，
                      执行Matha 进程隔离真跑，产出 = 输出行列表
                      （处理器契约：文件须定义 处理(参数们)，
                      12e 扩展命令同源约定）
     命令描述符(名, 路径) 形态 终端命令 描述符适配结果
                      {"可装载": true, "描述": 好, "原因": ""}
                      / {"可装载": false, "描述": null,
                         "原因": "命令文件不存在: " + 路径}
     注册表描述符们(文本) 注册表文本逐行适配（『名字 路径』单
                      空格行）；坏行诚实落 {"可装载": false,
                      "原因": "坏行..."}，不中断整表

   一步语义：命令是「按需一步」单元——启动进程 + 调度 1 轮即
   真跑一次处理器并经事件取回输出；继续 = false 不留常驻进程。
   ============================================================ *)

  use 标准库 { len | split | read_file }
  use 内核

  func 命令步(路径) -> Value = (路径) => {
    let 步 = (状态) => {
      let 调用源 = read_file(路径) + "\n处理([])"
      let 出 = 执行Matha(调用源)
      let 报 = {"状态": null, "继续": false, "产出": 出}
      报
    }
    步
  }

  func 命令描述符(名, 路径) -> Dict = (名, 路径) => {
    let 有 = 路径存在(路径)
    let 入口 = [["主", 命令步(路径)]]
    let 空 = []
    let 描述 = {"名": 名, "形态": "终端命令", "版本": 1, "requires": 空, "入口": 入口, "服务": 空}
    let 成 = {"可装载": true, "描述": 描述, "原因": ""}
    let 坏 = {"可装载": false, "描述": null, "原因": "命令文件不存在: " + 路径}
    let 出 = 有 ? 成 : 坏
    出
  }

  func _一登记(行, 收) -> List =
    if len(split(行, " ")) = 2 then
      let 们 = split(行, " ") in
      收 + [命令描述符(们[0], 们[1])]
    else
      let 们 = split(行, " ") in
      收 + [{"名": 们[0], "可装载": false, "描述": null, "原因": "坏行（须为『名字 路径』单空格行）: " + 行}]

  func _留非空(行们, i, 收) -> List =
    if i >= len(行们) then 收
    else if 行们[i] = "" then _留非空(行们, i + 1, 收)
    else _留非空(行们, i + 1, 收 + [行们[i]])

  func _注册行(行们, i, 收) -> List =
    if i >= len(行们) then 收
    else _注册行(行们, i + 1, _一登记(行们[i], 收))

  func 注册表描述符们(文本) -> List = (文本) => {
    let 行们 = _留非空(split(文本, "\n"), 0, [])
    let 出 = _注册行(行们, 0, [])
    出
  }
}
