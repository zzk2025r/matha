module 包适配器 {
(* ============================================================
   Matha 资源库·兼容分支——包适配器（阶段 27f）
   ------------------------------------------------------------
   25c/25d 应用中心包清单（商店索引/安装 manifest）与 27c 内核
   单元描述符之间的适配层：「第三方软件融合进共生体」的兼容面。
   零新内建，全部由 标准库（split/int/ord_matha/dict_get）与内核
   装载 组合。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     包描述符(清单)  清单 → 内核描述符适配结果
                    {"已适配": true, "描述": 好, "原因": ""}
                    / {"已适配": false, "描述": null, "原因": 拒因}
                    清单契约：{"名": str, "版本": 语义版本串,
                    "入口": [入口名们]}；服务 可缺省（缺省 []）
     融合(内核, 清单) 适配成功即内核 装载（失败透传拒因，
                    形状对齐内核 {"结果": "拒绝", "原因", "名"}）

   版本协商：语义版本主段（"." 首段）须全数字且 >= 1——
   主段非数字 / 0.x 预发布包 / 其他非正整数一律诚实拒绝
   （内核版本栈只收正整数，27c 升级回滚语义以此为基）。

   入口语义：包入口以 [入口名, null] 落描述符——步函数由外部
   单元胶水承接（27d 边界，诚实 null 而非假步）。
   ============================================================ *)

  use 标准库 { len | split | int | ord_matha | dict_get }
  use 内核

  func _数字段(段) -> Bool =
    if len(段) = 0 then false
    else if len(段) = 1 then ord_matha(段[0]) >= 48 and ord_matha(段[0]) <= 57
    else (ord_matha(段[0]) >= 48 and ord_matha(段[0]) <= 57) and _数字段(段[1:])

  func _主段(版本) -> String = (版本) => {
    let 段们 = split(版本, ".")
    段们[0]
  }

  func _入口对们(入口名们, i, 收) -> List =
    if i >= len(入口名们) then 收
    else _入口对们(入口名们, i + 1, 收 + [[入口名们[i], null]])

  func _拒因(数, 主) -> String =
    if 数 = false then "版本主段非数字"
    else if 主 = 0 then "预发布包 0.x 不受内核版本栈支持"
    else "版本须为正整数"

  func 包描述符(清单) -> Dict = (清单) => {
    let 主段 = _主段(清单["版本"])
    let 数 = _数字段(主段)
    let 主 = 数 ? int(主段) : 0 - 1
    let 服务 = dict_get(清单, "服务", [])
    let 空 = []
    let 入口 = _入口对们(清单["入口"], 0, [])
    let 好 = {"名": 清单["名"], "形态": "包", "版本": 主, "requires": 空, "入口": 入口, "服务": 服务}
    let 成 = {"已适配": true, "描述": 好, "原因": ""}
    let 坏 = {"已适配": false, "描述": null, "原因": _拒因(数, 主)}
    let 出 = 主 >= 1 ? 成 : 坏
    出
  }

  func 融合(内核, 清单) -> Dict = (内核, 清单) => {
    let 适 = 包描述符(清单)
    let 拒 = {"结果": "拒绝", "原因": 适["原因"], "名": 清单["名"]}
    let 回 = 适["已适配"] ? 装载(内核, 适["描述"]) : 拒
    回
  }
}
