module 建模仿真 {
(* ============================================================
   Matha 标准库·建模仿真
   ------------------------------------------------------------
   阶段 24e 仿真域（src/domains/simulation.py）之上的纯 Matha 组合层
   —— 欧拉 / RK4 双法对拍与步长扫描。零新内建，全部由仿真域符号
   （仿真_欧拉 / 仿真_龙格库塔）组合；「资源库当代码用」的仿真面。

   行为口径（Python 真相由 tests/test_library_capability_phase24.py
   与本文件 use 对拍锁双端同值）：
     双法对比(导, 初值, 起点, 终点, 步数)
                         同步数跑欧拉与 RK4（标量状态专用——向量末态
                         不定义减法），返回 [欧拉末态, RK4末态, 误差]，
                         误差 = |欧拉末态 − RK4末态|（RK4 为高阶参考）
     步长扫描(导, 初值, 起点, 终点, 步数表)
                         每个步数各跑双法（向量状态亦可——行内保存
                         末态原样），返回 [[步数, 欧拉末态, RK4末态], ...]
     轨迹抽样(结果, 间隔)
                         等间隔抽取 仿真_欧拉/仿真_龙格库塔 结果的
                         轨迹条目（下标 0, 间隔, 2·间隔, ...），
                         返回 [t, y] 对列表

   写法约束（沿用 绘画辅助 实测口径）：
     · 函数体走 `func f(p...) -> T = (p...) => { 体 }` curried 形式；
     · 循环用 while + 语句位裸赋值计数器（阶段 22c 绑定语义）；
     · 步长 h = (终点 − 起点) / 步数，由仿真域负责，本层不重算；
     · 函数体块尾禁止裸列表字面量——语句位 `[` 是输出语句面（阶段 18d
       生成代码面，故意不动），须先 let 绑定再以裸变量名收尾。
   ============================================================ *)

func 双法对比(导, 初值, 起点, 终点, 步数) -> List = (导, 初值, 起点, 终点, 步数) => {
  let e = 仿真_欧拉({"导函数": 导, "初值": 初值, "起点": 起点, "终点": 终点, "步数": 步数})
  let r = 仿真_龙格库塔({"导函数": 导, "初值": 初值, "起点": 起点, "终点": 终点, "步数": 步数})
  let 差 = e["末态"] - r["末态"]
  let 结果 = [e["末态"], r["末态"], (差 > 0) ? 差 : 0 - 差]
  结果
}

func 步长扫描(导, 初值, 起点, 终点, 步数表) -> List = (导, 初值, 起点, 终点, 步数表) => {
  let n = len(步数表)
  let 行表 = []
  let i = 0
  while i < n {
    let 步数 = 步数表[i]
    let e = 仿真_欧拉({"导函数": 导, "初值": 初值, "起点": 起点, "终点": 终点, "步数": 步数})
    let r = 仿真_龙格库塔({"导函数": 导, "初值": 初值, "起点": 起点, "终点": 终点, "步数": 步数})
    行表 = 行表 + [[步数, e["末态"], r["末态"]]]
    i = i + 1
  }
  行表
}

func 轨迹抽样(结果, 间隔) -> List = (结果, 间隔) => {
  let 全轨 = 结果["轨迹"]
  let n = len(全轨)
  let 取样 = []
  let i = 0
  while i < n {
    取样 = 取样 + [全轨[i]]
    i = i + 间隔
  }
  取样
}
}
