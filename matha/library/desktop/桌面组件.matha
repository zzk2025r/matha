module 桌面组件 {
(* ============================================================
   Matha 资源库·桌面分支——桌面组件（阶段 27f）
   ------------------------------------------------------------
   27e 纯 Matha TUI 桌面（matha/os/desktop.matha）之上的纯
   Matha 组件层：帧内容的常用绘制件。「资源库当代码用」的
   桌面面。零新内建，全部字符串拼接 + 递归重复。

   行为口径（tests/test_library_os_phase27.py 双面对拍锁）：
     进度条(值, 上限, 宽)  "[######----] 6/10"（上限 <= 0 诚实
                          报错；值 > 上限 时负余量收口为空串）
     表格(标目们, 行表)    列宽取整列最长；行内左对齐 " | " 相接，
                          头与体之间 "-+-" 分隔行；单元格一律字符串
     消息框(标题, 行们)    "=" 边框（宽 = 最长行 + 4）+ 标题行 +
                          "-" 分隔 + 正文
     键位栏(对们)          [键, 说明] 对序列 → "j 焦点  d 步进"
                          （两空格相接）

   写法约束：与内核同源已证形态（模块级 if-then-else / let...in
   嵌套 / 累加递归）；str 仅对数字取文。
   ============================================================ *)

  use 标准库 { len | str | int }

  func _重复(文本, n) -> String =
    if n <= 0 then ""
    else 文本 + _重复(文本, n - 1)

  func 进度条(值, 上限, 宽) -> String =
    if 上限 <= 0 then 错误("进度条: 上限须为正, 实得 " + str(上限))
    else
      let 满 = int(值 * 宽 / 上限) in
      "[" + _重复("#", 满) + _重复("-", 宽 - 满) + "] " + str(值) + "/" + str(上限)

  func _垫(文, 宽) -> String = 文 + _重复(" ", 宽 - len(文))

  func _行串(格们, 宽们, i) -> String =
    if i >= len(格们) then ""
    else if i + 1 = len(格们) then _垫(格们[i], 宽们[i])
    else _垫(格们[i], 宽们[i]) + " | " + _行串(格们, 宽们, i + 1)

  func _分隔(宽们, i) -> String =
    if i >= len(宽们) then ""
    else if i + 1 = len(宽们) then _重复("-", 宽们[i])
    else _重复("-", 宽们[i]) + "-+-" + _分隔(宽们, i + 1)

  func _列宽(标目们, 行表, 列, i, 最) -> Int =
    if i = 0 then _列宽(标目们, 行表, 列, 1, len(标目们[列]))
    else if i > len(行表) then 最
    else
      let w = len(行表[i - 1][列]) in
      let 最2 = w > 最 ? w : 最 in
      _列宽(标目们, 行表, 列, i + 1, 最2)

  func _宽们(标目们, 行表, 列, 收) -> List =
    if 列 >= len(标目们) then 收
    else _宽们(标目们, 行表, 列 + 1, 收 + [_列宽(标目们, 行表, 列, 0, 0)])

  func _体行们(行表, 宽们, i, 收) -> List =
    if i >= len(行表) then 收
    else _体行们(行表, 宽们, i + 1, 收 + [_行串(行表[i], 宽们, 0)])

  func 表格(标目们, 行表) -> List = (标目们, 行表) => {
    let 宽们 = _宽们(标目们, 行表, 0, [])
    let 头 = _行串(标目们, 宽们, 0)
    let 隔 = _分隔(宽们, 0)
    let 体 = _体行们(行表, 宽们, 0, [])
    let 出 = [头, 隔] + 体
    出
  }

  func _最长(行们, i, 最) -> Int =
    if i >= len(行们) then 最
    else
      let w = len(行们[i]) in
      let 最2 = w > 最 ? w : 最 in
      _最长(行们, i + 1, 最2)

  func 消息框(标题, 行们) -> List = (标题, 行们) => {
    let 全 = [标题] + 行们
    let 宽 = _最长(全, 0, 0)
    let 边 = _重复("=", 宽 + 4)
    let 分 = _重复("-", 宽 + 4)
    let 出 = [边, "  " + 标题, 分] + 行们 + [边]
    出
  }

  func _键串(对们, i) -> String =
    if i >= len(对们) then ""
    else if i + 1 = len(对们) then 对们[i][0] + " " + 对们[i][1]
    else 对们[i][0] + " " + 对们[i][1] + "  " + _键串(对们, i + 1)

  func 键位栏(对们) -> String = (对们) => _键串(对们, 0)
}
