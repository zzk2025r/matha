(* ============================================================
   Matha 自然语言执行器（阶段 8c：语义转换 + 执行引擎）
   ------------------------------------------------------------
   把 8b 句法器产的语义框架（Matha 表达式 AST Dict）交给自举
   解释器 求值，完成「句子 → 词法 → 句法 → 语义转换 → 执行」
   全 Matha 闭环。歧义/超控制子集句子经 NL编译 显式 错误 拒绝，
   永不静默回退。宿主/VM 以独立命名内建 自然语言执行 委托本链，
   与既有 混合编译/混合执行 及 Python 侧 intent/nl_pipeline 零冲突。
   ============================================================ *)

module 自然语言执行器 {
  use 自然语言句法器 { NL编译 }
  use 解释器 { 求值 | 注册内建 | 空环境 }

  (* 句子 → 语义框架 → 自举求值 → 结果值。 *)
  func NL执行(句子: String) -> Value =
    let 框架 = NL编译(句子) in
    let env = 注册内建(空环境()) in
    求值(框架, env)
}