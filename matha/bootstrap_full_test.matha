(* ============================================================
   Matha 自举全链路测试（S5）
   ------------------------------------------------------------
   一站式验证自举四大模块的完整链路（零 Python 依赖）：
     1. 自举词法器 tokenize("1 + 2 * 3") → 6 tokens（5 + EOF）
     2. 自举语法器 parse(toks) → "程序" AST（顶层"二元运算"，乘法绑定更紧）
     3. 自举解释器 求值 → 7
     4. 自举编译器 编译(source) → M3V 字节码（魔数 M 3 V 1）

   运行：
     python -c "from src.matha_service import run_file; r=run_file('matha/bootstrap_full_test.matha'); print(r['output'], r['error'])"
   期望输出：[6, 整数, 加, 程序, 二元运算, 二元运算, +, 7, N, M, 3, V, 1] 且 error=None
   （N 为字节码总长度，随常量池编码而异，只要求 > 0）
   ============================================================ *)

module 自举全链路测试 {

  use 词法器 { tokenize }
  use 语法器 { parse }
  use 解释器 { 注册内建 | 求值 }
  use 编译器 { 编译 }
  use 标准库 { len }
}

(* ===== 自测：全链路断言输出 ===== *)
#：{
  (* ---- 1. 词法：token 流 ---- *)
  toks = tokenize("1 + 2 * 3")
  [len(toks)]                    (* 期望 6：5 个 token + 结束 *)
  [toks[0]["类型"]]               (* 期望 整数 *)
  [toks[0]["文本"]]               (* 期望 1 *)
  [toks[1]["类型"]]               (* 期望 加 *)
  [toks[3]["类型"]]               (* 期望 乘 *)
  [toks[5]["类型"]]               (* 期望 结束 *)

  (* ---- 2. 语法：AST 结构 ---- *)
  ast = parse(toks)
  [ast["类型"]]                   (* 期望 程序 *)
  d0 = ast["声明"][0]
  [d0["类型"]]                    (* 期望 二元运算 *)
  [d0["运算符"]]                  (* 期望 +（顶层是加法）*)
  [d0["右"]["类型"]]              (* 期望 二元运算（乘法绑定更紧）*)
  [d0["右"]["运算符"]]            (* 期望 * *)
  [d0["左"]["值"]]                (* 期望 1 *)

  (* ---- 3. 解释：求值 AST → 7 ---- *)
  env = 注册内建([])
  [求值(d0, env)]                 (* 期望 7 *)

  (* ---- 4. 编译：模块 dict（常量池 / 函数表 / 主码）---- *)
  bc = 编译("1 + 2 * 3")
  [bc["模块名"]]                   (* 期望 主程序 *)
  [len(bc["常量"])]                (* 期望 5：1, 2, 3, *, + *)
  [bc["常量"][0]]                  (* 期望 1 *)
  [bc["常量"][4]]                  (* 期望 + *)
  [len(bc["主码"])]                (* 期望 7：6 条指令 + HALT *)
  [bc["主码"][6][0]]               (* 期望 255（HALT）*)
  [bc["主码"][4][0]]               (* 期望 64（BINOP：先乘）*)
  [len(bc["函数"])]                (* 期望 0：无函数定义 *)
}
