(* ============================================================
   Matha 自举解释器（纯 Matha 实现，零 Python 依赖）
   ------------------------------------------------------------
   完整解释器，支持：
     - 字面量、变量、算术运算
     - 三元条件表达式
     - Lambda 闭包与柯里化
     - 函数调用
     - if/while/for/match 控制流
     - 标准库内建函数（来自 stdlib.matha）
     - 运行时引擎数学函数（来自 运行时引擎）
   
   调用入口：interpret(source) -> List
   ============================================================ *)

module 解释器 {

  use 词法器 { Token | 类型 | 扫描 | 做Token }
  use 语法器
  use 标准库
  use 运行时引擎

  (* ===== 环境：列表 [(name, value), ...] ===== *)

  func 空环境() -> List = () => []

  func 绑定环境(env: List, name: String, value) -> List = (env, name, value) =>
    let pair = [name, value] in
    [pair] + env

  func 查找环境(env: List, name: String) -> Value = (env, name) =>
    (* 39b：缺名臂类型化抛错——宿主/VM 面同源 未定义错误 内建，
       异常类 MathaUndefinedNameError（此前 错误 → MathaRuntimeError，
       与宿主 _eval_variable/_GlobalScope.__missing__ 分歧 31-⑧）。 *)
    env = [] ? 未定义错误("未定义变量 '" + name + "'") :
    env[0][0] = name ? env[0][1] : 查找环境(env[1:], name)

  func 查找环境链(envs: List, name: String) -> Value = (envs, name) =>
    envs = [] ? 未定义错误("未定义变量 '" + name + "'（词法作用域外）") :
    let env = envs[0] in
    let rec _lookup(e: List) -> Value =
      e = [] ? (envs = [] ? 未定义错误("未定义变量 '" + name + "'") : _lookup(envs[1:]))
      : e[0][0] = name ? e[0][1] : _lookup(e[1:])
    in _lookup(env)

  (* ===== 错误 ===== *)
  func 错误(msg: String) -> Value = (msg) =>
    raise MathaRuntimeError(msg)

  (* ===== 输出面（29d）=====
     模块级单槽容器 输出槽[0] = 输出值列表（宿主 Interpreter.outputs / VM
     vm.outputs 同构，28d/29c 单槽容器先例）。执行语句/执行生成语句的
     输出/输出追踪/match 支与 应用内建 输出/print 分支经 输出记录 归一登记
     （可调用值记 "<function>"，对齐宿主 _norm_output / VM _norm_output）；
     输出快照/输出清空 供 sweep 驱动每文件复位。求值 "输出"（[] 括号形，
     列表字面量遗留语义）不在记录面。 *)
  输出槽 = [[]]

  (* 可调用三形态：闭包列表 ["__closure__",...] / 内建元组 ("__builtin__",名) /
     内建字典 {"类型":"__builtin__"}。链式索引不可靠（and/or 急切求值），
     嵌套三元 + 安全索引（缺键 null）保证守卫安全。 *)
  func 输出规范化(v) -> Value = (v) =>
    type_of(v) = "List" ?
      (标准库.len(v) = 0 ? v : (v[0] = "__closure__" ? "<function>" : v)) :
    type_of(v) = "Tuple" ?
      (标准库.len(v) = 0 ? v :
        (v[0] = "__builtin__" ? "<function>" :
          (v[0] = "__closure__" ? "<function>" : v))) :
    type_of(v) = "Dict" ?
      (安全索引(v, "类型") = "__builtin__" ? "<function>" : v) :
    v

  func 输出记录(v) -> Value = (v) =>
    let 忽略 = 标准库.原地设置(输出槽, 0, 输出槽[0] + [输出规范化(v)]) in null

  func 输出快照() -> List = 输出槽[0]

  func 输出清空() -> Value = 标准库.原地设置(输出槽, 0, [])

  (* 输出节点载荷取值：null（宿主 Output.expr=None 同构）与 空输出节点 →
     null，其余求值。独立成函数：let-in 体贪婪吞并外层三元链承接位，
     内联即挂链错位（29c 先例）。 *)
  func 输出取值(node: Dict, env: List) -> Value = (node, env) =>
    node = null ? null :
    node["类型"] = "空输出" ? null : 求值(node, env)

  (* ===== 表达式求值 ===== *)

  (* 下标求值（29d 真化：求值 此前无 下标 分支——自举执行面任何含 a[i]/d["k"]
     语料诚实报错 未知表达式类型；宿主 IndexExpr 镜像：列表/元组/字符串按
     VM 下标原语，字典缺键 null（29b-④ 对齐面），其余形态诚实报错） *)
  func 求值下标(容器e: Dict, 索引e: Dict, env: List) -> Value = (容器e, 索引e, env) =>
    let c = 求值(容器e, env) in
    let i = 求值(索引e, env) in
    let ct = type_of(c) in
    ct = "Dict" ? c[i] :
    ct = "List" or ct = "Tuple" or ct = "String" ? c[i] :
    错误("索引操作不支持: " + _类型名(c) + "[" + 标准库.str(i) + "]")

  (* 切片求值（31f 真化：求值 此前无 切片 分支——自举执行面任何含 a[s:e] 语料
     诚实报错 未知表达式类型；30 收官登记④。宿主 SliceExpr 镜像
     （src/interp.py 切片支）：列表/元组/字符串 Python 切片语义——缺端 null→
     None、负下标回绕、越界钳制、起点超长→空；其余形态诚实报错同文案） *)
  func 求值切片(容器e: Dict, 开始e: Dict, 结束e: Dict, env: List) -> Value =
    let c = 求值(容器e, env) in
    let s0 = 开始e = null ? null : 求值(开始e, env) in
    let e0 = 结束e = null ? null : 求值(结束e, env) in
    let ct = type_of(c) in
    ct = "List" or ct = "Tuple" or ct = "String" ?
      _切片值(c, s0, e0, ct) :
      错误("切片操作不支持: " + _类型名(c) + "[" + 标准库.str(s0) + ":" + 标准库.str(e0) + "]")

  (* Python 切片下标归一：null→缺省（起点 0 / 终点 n）、负值回绕后钳 [0, n] *)
  func _切片起(i, n: Int) -> Int =
    i = null ? 0 :
    i < 0 ? ((i + n) < 0 ? 0 : i + n) :
    i > n ? n : i

  func _切片端(i, n: Int) -> Int =
    i = null ? n :
    i < 0 ? ((i + n) < 0 ? 0 : i + n) :
    i > n ? n : i

  func _切片值(c, s0, e0, ct: String) -> Value =
    let 元素们 = ct = "List" ? c : ct = "Tuple" ? _元组元素(c) : 字符串拆字符(c) in
    let n = 标准库.len(元素们) in
    let s = _切片起(s0, n) in
    let e = _切片端(e0, n) in
    let 们 = _切片收(元素们, s, e, []) in
    ct = "String" ? _切片串(们, "") : ct = "Tuple" ? _to_tuple(们) : 们

  func _切片收(元素们: List, s: Int, e: Int, acc: List) -> List = (元素们, s, e, acc) =>
    s >= e ? acc : _切片收(元素们, s + 1, e, acc + [元素们[s]])

  func _切片串(们: List, acc: String) -> String = (们, acc) =>
    们 = [] ? acc : _切片串(们[1:], acc + 们[0])

  func 求值(expr: Dict, env: List) -> Value = (expr, env) =>
    expr["类型"] = "整数" ? expr["值"] :
    expr["类型"] = "浮点" ? expr["值"] :
    expr["类型"] = "字符串" ? expr["值"] :
    expr["类型"] = "布尔" ? expr["值"] :
    expr["类型"] = "变量" ? 查找环境(env, expr["名"]) :
    expr["类型"] = "二元运算" ? 求值二元(expr["运算符"], expr["左"], expr["右"], env) :
    expr["类型"] = "自定义二元" ? 求值自定义二元(expr["实现"], expr["左"], expr["右"], env) :
    expr["类型"] = "一元运算" ? 求值一元(expr["运算符"], expr["操作数"], env) :
    expr["类型"] = "if" ? 求值if(expr["条件"], expr["真分支"], expr["假分支"], env) :
    expr["类型"] = "lambda" ? 求值lambda(expr["参数"], expr["体"], env) :
    expr["类型"] = "函数应用" ? 求值应用(expr["函数"], expr["参数"], env) :
    expr["类型"] = "列表" ? 求值列表(expr["元素"], env) :
    expr["类型"] = "列表推导" ? 求值列表推导(expr, env) :
    expr["类型"] = "元组" ? _to_tuple(求值列表(expr["元素"], env)) :
    expr["类型"] = "字典" ? 求值字典(expr["键"], expr["值"], env) :
    expr["类型"] = "输出" ? (求值(expr["expr"], env), env) :
    expr["类型"] = "绑定" ? 求值绑定(expr, env) :
    expr["类型"] = "let绑定" ? 求值let绑定(expr, env) :
    (* 35-①：let (a, b) = expr [in body] 表达式位（宿主 LetTupleBinding
       _eval 同位） *)
    expr["类型"] = "let元组绑定" ? 求值let元组(expr, env) :
    expr["类型"] = "match" ? 求值match(expr, env) :
    expr["类型"] = "下标" ? 求值下标(expr["容器"], expr["索引"], env) :
    expr["类型"] = "切片" ? 求值切片(expr["容器"], expr["开始"], expr["结束"], env) :
    (* 30a：属性访问 a.b（宿主 Attribute 镜像）——变量已绑定 → struct 实例/
       enum 命名空间/字典字段；未绑定 → 模块平铺回退（链模块内建已平铺）；
       其余对象表达式先求值再取字段。 *)
    expr["类型"] = "属性" ? 求值属性(expr["对象"], expr["名"], env) :
    expr["类型"] = "程序" ? 求值程序(expr, env) :
    expr["类型"] = "typeof" ? typeof归一(求值(expr["操作数"], env)) :
    错误("未知表达式类型: " + expr["类型"])

  (* 29d：程序（块体）表达式位（宿主块体函数体同位）——顺序执行声明取末
     值，空体 null；绑定仅在块内存活（返回值面，环境丢弃）。宿主块体
     lambda 体 _eval 逐语句同构。29b06 块体用例此前 boot 面落入未知
     表达式类型兜底报错（被 interpret 静默回退 Python 面掩盖）。
     36-②：块尾绑定族不回传值（宿主 _eval_block_value 同位）——映射仅
     此表达式位应用，程序位顶层（run_ast → 执行语句）保持尾表达式值。 *)
  func 求值程序(prog: Dict, env: List) -> Value = (prog, env) =>
    let ds = prog["声明"] in
    ds = [] ? null :
    let (v, 忽略) = 执行语句列表(prog, env) in
    _块尾值(_尾声明(ds), v)

  func _尾声明(ds: List) -> Dict = (ds) =>
    ds[1:] = [] ? ds[0] : _尾声明(ds[1:])

  (* 绑定表达式：let x = expr in body *)
  func 求值绑定(binding: Dict, env: List) -> (Value, List) = (binding, env) =>
    let v = 求值(binding["值"], env) in
    (v, 绑定环境(env, binding["名"], v))

  func 更新绑定值(env: List, name: String, value) -> List = (env, name, value) =>
    if env = [] then
      env
    else if env[0][0] = name then
      let 忽略 = 标准库.原地设置(env[0], 1, value) in
      env
    else
      let 忽略 = 更新绑定值(env[1:], name, value) in
      env

  (* env 中是否已含名为 name 的绑定（29d 自包含：此前经宿主面/合并链
     隐式可得，29d 链无 interp.matha 时 LOAD_GLOBAL 未定义潜伏崩溃） *)
  func 环境包含(env: List, name: String) -> Bool =
    env = [] ? 假 :
    env[0][0] = name ? 真 : 环境包含(env[1:], name)

  (* 37c：链式 let rec 互递归预绑（32-⑩ 真化，宿主 interp.py 链头收集
     镜像）——沿 体 链收集 rec 名逐个预绑占位对（非 rec 成员跳过但继续
     走链）；占位对经 更新绑定值 原地填充，链内闭包共享同一对。 *)
  func 预绑链占位(expr: Dict, env: List) -> List =
    let env1 = expr["递归"] ?
      绑定环境(env, expr["名"], "__递归占位__") : env in
    expr["有体"] ?
      (expr["体"]["类型"] = "let绑定" ?
        预绑链占位(expr["体"], env1) :
        env1) :
      env1

  func 求值let绑定(expr: Dict, env: List) -> Value = (expr, env) =>
    expr["递归"] ? 求值递归let(expr, env) : 求值非递归let(expr, env)

  func 求值递归let(expr: Dict, env: List) -> Value = (expr, env) =>
    (* 32e：已有占位对（预绑递归let 预绑）复用同一对，更新绑定值 原地
       改写共享对；37c：无占位时沿链预绑（预绑链占位）——链式 let rec
       互递归成员前向可见。环境包含 先判（查找环境缺名抛错），嵌套三元
       保双面短路。 *)
    let env1 = 环境包含(env, expr["名"]) ?
      (查找环境(env, expr["名"]) = "__递归占位__" ? env :
        预绑链占位(expr, env)) :
      预绑链占位(expr, env) in
    let v = 求值(expr["值"], env1) in
    let env2 = 更新绑定值(env1, expr["名"], v) in
    if expr["有体"] then 求值(expr["体"], env2) else v

  func 求值非递归let(expr: Dict, env: List) -> Value = (expr, env) =>
    let v = 求值(expr["值"], env) in
    let env1 = 绑定环境(env, expr["名"], v) in
    if expr["有体"] then 求值(expr["体"], env1) else v

  (* 语句/声明级 let 绑定：返回 (值, 新环境)，使顶层 let 绑定对后续语句可见
     （对齐 interp.matha 绑定求值let；表达式级 求值let绑定 仅返回值，
     顶层若走它会丢弃新 env → 「未定义变量」）。 *)
  func 绑定求值let(expr: Dict, env: List) -> (Value, List) = (expr, env) =>
    if expr["递归"] then
      (* 32e：已有占位对复用同一对原地填充共享；37c：无占位时沿链预绑；
         环境包含 先判（查找环境缺名抛错），嵌套三元保双面短路 *)
      let env1 = 环境包含(env, expr["名"]) ?
        (查找环境(env, expr["名"]) = "__递归占位__" ? env :
          预绑链占位(expr, env)) :
        预绑链占位(expr, env) in
      let v = 求值(expr["值"], env1) in
      let env2 = 更新绑定值(env1, expr["名"], v) in
      (* 36-②：块尾 let 无体 → null（宿主 _BLOCK_TAIL_STMT_NODES 面，
         Binding 尾不回传值；35-① 绑定求值let元组 同形） *)
      if expr["有体"] then (求值(expr["体"], env2), env2) else (null, env2)
    else
      let v = 求值(expr["值"], env) in
      let env1 = 绑定环境(env, expr["名"], v) in
      if expr["有体"] then (求值(expr["体"], env1), env1) else (null, env1)

  (* 35-①：let (a, b) = expr [in body] 表达式位求值（宿主 interp.py
     LetTupleBinding _eval 镜像）——解构经 _解构绑定元组（闭包标记 4 元组
     三名绑定跳标记位，与宿主 _eval start=1 同判），绑定沿 绑定环境 链
     天然不泄漏（宿主 POPS 同效）；有体取体值，无体取右值。 *)
  func 求值let元组(e: Dict, env: List) -> Value = (e, env) =>
    let v = 求值(e["值"], env) in
    let env2 = _解构绑定元组(env, e["名字"], v, 真) in
    e["有体"] ? 求值(e["体"], env2) : v

  (* 语句/声明级 let 元组绑定：解构不跳闭包标记（宿主 _exec_stmt 长度面
     同判——闭包 4 元组仅与名单同长时逐位绑定，错误文案仍归 function）；
     无体块值 null（宿主 _BLOCK_TAIL_STMT_NODES 面），有体走体值。 *)
  func 绑定求值let元组(e: Dict, env: List) -> (Value, List) = (e, env) =>
    let v = 求值(e["值"], env) in
    let env2 = _解构绑定元组(env, e["名字"], v, 假) in
    e["有体"] ? (求值(e["体"], env2), env2) : (null, env2)

  (* 解构核心（34e _解构绑定 同族 + 闭包标记 tname 归 function）：
     List/Tuple 且长度精确匹配逐位绑定；闭包标记 4 元组
     ["__closure__", …] 错误文案归 "function"（宿主 _eval/_exec_stmt
     错误路径同判）；嵌套三元保短路（null 臂不取 len）。 *)
  func _解构绑定元组(env: List, 名单: List, v, 跳闭包: Bool) -> List =
    let 是闭包 = if type_of(v) = "List" then
        (if 标准库.len(v) = 4 then v[0] = "__closure__" else 假)
      else 假 in
    let 期望 = 标准库.len(名单) in
    let 元素们 = 是闭包 and 跳闭包 and 期望 = 3 ? [v[1], v[2], v[3]] :
      type_of(v) = "Tuple" ? _元组元素(v) :
      type_of(v) = "List" ? v :
      null in
    元素们 = null ?
      错误("解构失败：期望 " + 标准库.str(期望) + " 个元素，实际 " +
        (是闭包 ? "function" : _类型名(v))) :
      标准库.len(元素们) = 期望 ?
        _解构绑定进(env, 名单, 元素们, 0) :
        错误("解构失败：期望 " + 标准库.str(期望) + " 个元素，实际 " +
          (是闭包 ? "function" : _类型名(v)))

  (* 二元运算求值 ===== *)
  (* 29d：and/or 短路值语义（宿主 _eval_binary &&/||/and/or 同构）——左
     真值取左、否则求右取右；此前双操作数先求值且结果强转 1.0/0.0——
     短路求值序与值面双偏差（golden 32 `0 or (2==2 ? 5 : 6)` 实证）。
     真值面复用 真值（match 守卫同辅助）。独立成函数：let-in 体贪婪
     吞并外层三元链承接位。 *)
  func 求值且(left: Dict, right: Dict, env: List) -> Value =
    (left, right, env) =>
    let l = 求值(left, env) in
    真值(l) ? 求值(right, env) : l

  func 求值或(left: Dict, right: Dict, env: List) -> Value =
    (left, right, env) =>
    let l = 求值(left, env) in
    真值(l) ? l : 求值(right, env)

  func 求值二元(op: String, left: Dict, right: Dict, env: List) -> Value =
    (op, left, right, env) =>
    op = "and" or op = "&&" ? 求值且(left, right, env) :
    op = "or" or op = "||" ? 求值或(left, right, env) :
    let l = 求值(left, env) in
    let r = 求值(right, env) in
    应用运算(op, l, r)

  (* 29d：typeof 类型名归一（宿主 builtin_typeof 同表）——boot type_of
     VM 内部名映射宿主中文类型名（golden 15 实证 Int→整数 等）；元组
     宿主无对应支（非 list/str/dict）同落 函数。 *)
  func typeof归一(v: Value) -> String = (v) =>
    type_of(v) = "Bool" ? "布尔" :
    type_of(v) = "Int" ? "整数" :
    type_of(v) = "Float" ? "浮点" :
    type_of(v) = "String" ? "文本" :
    type_of(v) = "List" ? "列表" :
    type_of(v) = "Dict" ? "字典" :
    type_of(v) = "Null" ? "空" :
    "函数"

  (* 自定义运算符求值：查环境得到具名实现函数，以 [l, r] 两参调用
     （对齐宿主 _eval_custom_op：处理器绑定在节点上，无需注册表）。 *)
  func 求值自定义二元(实现: String, left: Dict, right: Dict, env: List) -> Value =
    (实现, left, right, env) =>
    let l = 求值(left, env) in
    let r = 求值(right, env) in
    let f = 查找环境(env, 实现) in
    应用多参数函数(f, [l, r], env)

  (* 一元运算求值 ===== *)
  func 求值一元(op: String, operand: Dict, env: List) -> Value = (op, operand, env) =>
    op = "null" ? null :
    let v = 求值(operand, env) in
    op = "-" ? -v :
    op = "not" or op = "非" ? (if 真值(v) then 假 else 真) :
    (* 30a：一元 sqrt（^9 前缀形——boot 解析器归一为一元运算符 sqrt，
       宿主 _eval_unary 同支对拍；examples/01 实证面。参数直取，同
       应用内建 数学分支口径） *)
    op = "sqrt" ? 运行时引擎.sqrt(v) :
    错误("未知一元运算符: " + op)

  (* if 表达式求值 =====
     33-④：条件经 真值 归一（空容器/""/0/null 均 falsy，对齐宿主/VM
     Python 真值面）；无 else（then_b 节点 null）或 else 分支为 null
     时返 null（对齐宿主 IfExpr branch None → None）。 *)
  func 求值if(cond: Dict, then_b: Dict, else_b: Dict, env: List) -> Value =
    (cond, then_b, else_b, env) =>
    真值(求值(cond, env)) ?
      (then_b = null ? null : 求值(then_b, env)) :
      (else_b = null ? null : 求值(else_b, env))

  (* Lambda 求值 → 闭包 ===== *)
  func 求值lambda(params: List, body: Dict, env: List) -> Value =
    (params, body, env) =>
    ["__closure__", params, body, env]

  (* 函数应用求值 ===== *)
  func 求值应用(func_expr: Dict, arg_expr: Dict, env: List) -> Value =
    (func_expr, arg_expr, env) =>
    let f = 求值(func_expr, env) in
    let a = 求值(arg_expr, env) in
    应用函数(f, a, env)

  (* 列表字面量 [a, b, c]：逐元素求值，纯 Matha 累加器构建（保序）。 *)
  func 求值列表(elems: List, env: List) -> List = (elems, env) =>
    let rec _go(i: Int, acc: List) -> List =
      i >= 标准库.len(elems) ? acc : _go(i + 1, acc + [求值(elems[i], env)])
    in _go(0, [])

  (* 30d：列表推导 [e for t in it if c...]（宿主 _eval_list_comprehension
     ListComp 风格镜像，src/interp.py:1977）——可迭代 List/Tuple/String/Dict
     （字典按 (k, v) 对）；目标名绑定进推导环境（绑定环境 前插派生，
     迭代间不渗漏、外层绑定不受污染），条件全真才收集输出表达式。 *)
  func 求值列表推导(expr: Dict, env: List) -> List = (expr, env) =>
    (* 31b：多生成子句 生成子句们=[{目标,迭代,条件}...]（宿主 gens 分支镜像，
       Python 语义第 k 层条件在绑定第 k 层变量后求值；缺键=null 走单子句） *)
    if expr["生成子句们"] = null then
      let src0 = 求值(expr["迭代"], env) in
      if expr["目标"]["类型"] = "变量" then
        求值推导收集(expr["表达式"], expr["目标"]["名"], _迭代源(src0), expr["条件"], env)
      else 错误("列表推导目标不支持: " + expr["目标"]["类型"])
    else
      _推导多子句(expr, _推导规格们(expr["生成子句们"], env), env)

  func _推导规格们(子句们: List, env: List) -> List =
    let rec _go(i: Int, acc: List) -> List =
      if i >= 标准库.len(子句们) then acc
      else
        let 子句 = 子句们[i] in
        if 子句["目标"]["类型"] = "变量" then
          _go(i + 1, acc + [{"名": 子句["目标"]["名"],
                             "源": _迭代源(求值(子句["迭代"], env)),
                             "条件": 子句["条件"]}])
        else 错误("列表推导目标不支持: " + 子句["目标"]["类型"])
    in _go(0, [])

  func _推导多子句(expr: Dict, specs: List, env: List) -> List =
    _推导层(expr, specs, 0, env, [])

  func _推导层(expr: Dict, specs: List, si: Int, env: List, acc: List) -> List =
    if si >= 标准库.len(specs) then acc + [求值(expr["表达式"], env)]
    else
      let spec = specs[si] in
      let 名 = spec["名"] in
      let 源 = spec["源"] in
      let 条件 = spec["条件"] in
      _推导绑定(expr, specs, si, 名, 源, 条件, env, acc, 0)

  func _推导绑定(expr: Dict, specs: List, si: Int, 名: String, 源: List,
                 条件: List, env: List, acc: List, i: Int) -> List =
    if i >= 标准库.len(源) then acc
    else
      let 新环境 = 绑定环境(env, 名, 源[i]) in
      if _条件全真(条件, 新环境) then
        _推导绑定(expr, specs, si, 名, 源, 条件, env,
                  _推导层(expr, specs, si + 1, 新环境, acc), i + 1)
      else _推导绑定(expr, specs, si, 名, 源, 条件, env, acc, i + 1)

  func _迭代源(src) -> Value =
    type_of(src) = "List" or type_of(src) = "Tuple" ? src :
    type_of(src) = "String" ? 字符串拆字符(src) :
    type_of(src) = "Dict" ? _字典元组对(src) :
    错误("列表推导需迭代列表/元组/字符串/字典/集合，实际 " + _类型名(src))

  (* 31d-②：字典迭代对——host list(items()) 同形（元组对 ('k', v)）。
     标准库.dict_to_list 特意产 [k,v] 列表（函数应用语境注释见其体），
     推导/for 迭代语境须与宿主逐位同形（元组），故单独成对。 *)
  func _字典元组对(src: Dict) -> List =
    _字典元组对进(标准库.dict_to_list(src), 0, [])

  func _字典元组对进(对们: List, i: Int, acc: List) -> List =
    i >= 标准库.len(对们) ? acc :
    _字典元组对进(对们, i + 1, acc + [(对们[i][0], 对们[i][1])])

  (* 31d-②：for 迭代源——List 原样、Tuple 转列表（执行for循环 list_slice
     通道需 List）、String 拆字符、Dict 元组对（host list(items()) 同形）；
     其余诚实报错（宿主 for 面同文案）。此前 Dict/Int/String/Tuple 等落
     type_of!=List 静默空跑（假成功）。 *)
  func _for迭代源(src) -> Value =
    type_of(src) = "List" ? src :
    type_of(src) = "Tuple" ? _元组元素(src) :
    type_of(src) = "String" ? 字符串拆字符(src) :
    type_of(src) = "Dict" ? _字典元组对(src) :
    错误("for 迭代对象需为列表/元组/字符串/字典/集合，实际 " + _类型名(src))

  func _元组元素(src) -> List = _元组元素进(src, 0, [])

  func _元组元素进(src, i: Int, acc: List) -> List =
    i >= 标准库.len(src) ? acc : _元组元素进(src, i + 1, acc + [src[i]])

  func 字符串拆字符(s: String) -> List =
    let rec _go(i: Int, acc: List) -> List =
      i >= 标准库.len(s) ? acc : _go(i + 1, acc + [s[i]])
    in _go(0, [])

  func 求值推导收集(eexpr: Dict, 目标名: String, src, 条件: List, env: List) -> List =
    let rec _go(i: Int, acc: List) -> List =
      if i >= 标准库.len(src) then acc
      else
        let 新环境 = 绑定环境(env, 目标名, src[i]) in
        if _条件全真(条件, 新环境) then _go(i + 1, acc + [求值(eexpr, 新环境)])
        else _go(i + 1, acc)
    in _go(0, [])

  func _条件全真(条件: List, env: List) -> Bool =
    let rec _go(i: Int) -> Bool =
      if i >= 标准库.len(条件) then 真
      else if 求值(条件[i], env) then _go(i + 1)
      else 假
    in _go(0)

  (* 字典字面量 {k1: v1, k2: v2}：键/值为并行列表（对齐宿主 DictLiteral）。
     先逐对求值收集 [[k, v], ...]，再经 标准库.dict_from_pairs 构建真实字典
     （折叠 _dict_put + _empty_dict 原语，宿主/VM 两端均已提供）。
     34-⑤：裸键归一（宿主 interp.py 2947-2951 键面同构）——Variable 键
     节点取 名 字符串（{a: 1} 键 "a"），其余键照常求值。 *)
  func _字典键(k: Dict, env: List) -> Value = (k, env) =>
    k["类型"] = "变量" ? k["名"] : 求值(k, env)

  func 求值字典(keys: List, vals: List, env: List) -> Dict = (keys, vals, env) =>
    let rec _go(i: Int, acc: List) -> List =
      i >= 标准库.len(keys) ? acc
      : _go(i + 1, acc + [[_字典键(keys[i], env), 求值(vals[i], env)]])
    in 标准库.dict_from_pairs(_go(0, []))

  (* 运算分发 ===== *)
  func 应用运算(op: String, l, r) -> Value = (op, l, r) =>
    op = "+" ? l + r :
    op = "-" ? l - r :
    op = "*" ? l * r :
    op = "/" ? (if r = 0 then 错误("除零错误: " + 标准库.str(l) + " / 0") else l / r) :
    op = "**" ? l ** r :
    op = "^" ? l ** r :
    op = "%" ? (if r = 0 then 错误("取模除零错误: " + 标准库.str(l) + " % 0") else l - r * 运行时引擎.floor(l / r)) :
    (* 30c：整除 // 真化（宿主 Python floor 语义镜像：int/int → int、
       含浮点 → float ×1.0 同型；大整数经浮点除法有精度边界） *)
    op = "//" ? (if r = 0 then 错误("整除除零错误: " + 标准库.str(l) + " // 0") else (if type_of(l) = "Int" and type_of(r) = "Int" then 运行时引擎.floor(l / r) else 运行时引擎.floor(l / r) * 1.0)) :
    (* 33-③：比较族返 真/假 Bool（宿主/VM 比较面 Python bool 同判；
       此前 1.0/0.0 浮点与三面分歧） *)
    op = "<" ? (if l < r then 真 else 假) :
    op = ">" ? (if l > r then 真 else 假) :
    op = "<=" ? (if l <= r then 真 else 假) :
    op = ">=" ? (if l >= r then 真 else 假) :
    op = "=" ? (if l = r then 真 else 假) :
    op = "==" ? (if l = r then 真 else 假) :
    op = "!=" ? (if l != r then 真 else 假) :
    (* 33-②：`in` 成员判断（宿主/VM/native 四面同文案守卫；boot 词法/
       编译面早已对齐，仅解释器应用臂缺失） *)
    op = "in" ? _成员判断(l, r) :
    (* 29d：and/or 已上移 求值二元 短路面（值语义），非短路强转分支删除 *)
    错误("未知运算符: " + op)

  (* 33-②：`in` 成员判断——List/Tuple 逐元素 =、String 子串（空串恒命中，
     对齐 Python "" in s）、Dict 键成员。非容器右侧按宿主/VM 文案诚实报错
     （四面同文案）；字符串容器 + 非字符串左侧：宿主/VM 抛 Python 平台
     TypeError（文本随版本），boot 面诚实报错登记分歧。 *)
  func _成员判断(l, r) -> Value =
    type_of(r) = "List" or type_of(r) = "Tuple" ?
      _列表成员(l, r) :
    type_of(r) = "String" ?
      (type_of(l) = "String" ?
        (l = "" ? 真 : 标准库.find(l, r) >= 0) :
        错误("in 左侧需为字符串，实际 " + _类型名(l))) :
    type_of(r) = "Dict" ? 标准库.dict_has(r, l) :
    错误("in 右侧需为序列/集合/字典，实际 " + _类型名(r))

  func _列表成员(l, r) -> Value =
    let rec _go(i: Int) -> Value =
      i >= 标准库.len(r) ? 假 :
      r[i] = l ? 真 : _go(i + 1)
    in _go(0)

  (* 30c：索引错误类型名宿主对齐（host type(c).__name__ 同形小写面）——
     VM type_of 词首大写（Int/Float/Bool/String/List/Tuple/Dict/Function/
     Null），宿主索引错误用 Python __name__（int/float/bool/str/list/
     tuple/dict/function/NoneType）；未知形态透传。 *)
  func _类型名(v) -> String =
    let t = type_of(v) in
    t = "Int" ? "int" :
    t = "Float" ? "float" :
    t = "Bool" ? "bool" :
    t = "String" ? "str" :
    t = "List" ? "list" :
    t = "Tuple" ? "tuple" :
    t = "Dict" ? "dict" :
    t = "Function" ? "function" :
    t = "Null" ? "NoneType" :
    t

  (* 将数值转换为字符串（用于内建函数参数转换）===== *)
  func num_to_str(v) -> String = (v) =>
    type_of(v) = "Int" or type_of(v) = "Float" ? 标准库.str(v) : v

  (* 29d：VM 闭包单参调用（use 导入面）——type_of "Function" 值（VM
     MAKE_CLOSURE 产物 / Partial 偏应用记录）经语言级动态调用；未满元数
     由 VM 记 Partial，多参走嵌套应用逐参累积（与宿主柯里化同语义） *)
  func 调VM单参(f: Value, a: Value) -> Value = (f, a) => f(a)

  (* 函数应用分发 =====
     39a-2：不可调用值渲染经 标准库.元素repr（CPython repr 规则——字符串加引号
     转义、其余同 str）对齐宿主 f"{func!r}"（src/interp.py:3800、
     src/mbc/vm.py:1310）——此前用 str 丢字符串引号，bootstrap_test 三引号
     残留面双端消息不同（'不可调用的值: ' vs "不可调用的值: ''"）。 *)
  func 应用函数(f: Value, arg: Value, call_env: List) -> Value =
    (f, arg, call_env) =>
    if type_of(f) = "Function" then 调VM单参(f, arg)
    else if type_of(f) = "Dict" then
      (if f["类型"] = "__builtin__" then 应用内建(f["名"], [arg], call_env)
       (* 39a：裸 λ-AST 字典应用臂（bootstrap_test 3.6/3.7/3.9 直调链 API 形态）——
          经 求值lambda 折成闭包重入 __closure__ 机制，柯里化/多参语义同臂复用。 *)
       else if f["类型"] = "lambda" then
         应用函数(求值lambda(f["参数"], f["体"], call_env), arg, call_env)
       else 错误("不可调用的值: " + 标准库.元素repr(f)))
    else if type_of(f) = "List" or type_of(f) = "Tuple" then
      (if 标准库.len(f) = 0 then 错误("不可调用的值: " + 标准库.元素repr(f))
       else if f[0] = "__closure__" then
         let params = f[1] in
         let body = f[2] in
         let captured = f[3] in
         (* 参数名：支持字符串或 Variable AST（{"类型":"变量","名":...}）两种形态 *)
         (* 29d：零参闭包（f() 经解析器以 IntLit(0) 占位 arg）——空参数表忽略
            占位直接求值体；此前 params[0] 无守卫 IndexError（golden 零参 func
            块体全族实证，宿主/VM 双面均忽略占位故仅 boot 面崩）。 *)
         let 参数名 = if 标准库.len(params) = 0 then "" else (if type_of(params[0]) = "Dict" then (if params[0]["类型"] = "变量" then params[0]["名"] else params[0]) else params[0]) in
         let new_env = 标准库.len(params) = 0 ? captured : 绑定环境(captured, 参数名, arg) in
         if 标准库.len(params) > 1 then
           ["__closure__", params[1:], body, new_env]
         else
           (* 30a：闭包体位返回信号解包（宿主 _ReturnException 在 lambda 边界
              捕获同构——跳出/继续穿闭包不截，交最近循环执行器） *)
           闭包返回值(求值(body, new_env))
       else if f[0] = "__builtin__" then
         (* 注册内建 绑定的是元组 ("__builtin__", 名)；与 Dict 形态并存，二者皆须分发。 *)
         应用内建(f[1], [arg], call_env)
       else if f[0] = "__struct工厂__" then
         应用结构体工厂(f, [arg])
       else if f[0] = "__struct部分__" then
         应用结构体工厂(f[1], f[2:] + [arg])
       else if f[0] = "__内建部分__" then
         (* 30d：内建偏应用记录补全——["__内建部分__", 名, 已积参数]，
            续参并入重入 应用内建（元数足即实调，不足则再记）
            （宿主 _curry_module builder 同构）。 *)
         应用内建(f[1], f[2] + [arg], call_env)
       else
         错误("不可调用的值: " + 标准库.元素repr(f)))
    else
      (* 30c：类型守卫前置——此前 f[0] 直接探测对 Int/Float 等不可索引值落
         VM 下标错误「索引操作不支持: int[0]」，宿主同形报「不可调用的值: 5」
         （golden 28 双面文案对齐）。 *)
      错误("不可调用的值: " + 标准库.元素repr(f))

  func 调VM多参(f: Value, args: List) -> Value = (f, args) =>
    let rec _go(i: Int, acc: Value) -> Value =
      i >= 标准库.len(args) ? acc : _go(i + 1, 调VM单参(acc, args[i]))
    in _go(0, f)

  (* 多参数函数应用 ===== *)
  func 应用多参数函数(f: Value, args: List, call_env: List) -> Value =
    (f, args, call_env) =>
    if type_of(f) = "Function" then 调VM多参(f, args)
    else if type_of(f) = "Dict" then
      (if f["类型"] = "__builtin__" then 应用内建(f["名"], args, call_env)
       (* 39a：裸 λ-AST 字典多参应用臂（应用函数 同改）。 *)
       else if f["类型"] = "lambda" then
         应用多参数函数(求值lambda(f["参数"], f["体"], call_env), args, call_env)
       else 错误("不可调用的值: " + 标准库.元素repr(f)))
    else if type_of(f) = "List" or type_of(f) = "Tuple" then
      (if 标准库.len(f) = 0 then 错误("不可调用的值: " + 标准库.元素repr(f))
       else if f[0] = "__closure__" then
         let params = f[1] in
         let body = f[2] in
         let captured = f[3] in
         let rec _bind(i: Int, env: List) -> List =
           i >= 标准库.len(args) ? env
           : let 名 = if type_of(params[i]) = "Dict" then
                       (if params[i]["类型"] = "变量" then params[i]["名"] else params[i])
                     else params[i] in
             _bind(i + 1, 绑定环境(env, 名, args[i]))
         in
         let new_env = _bind(0, captured) in
         闭包返回值(求值(body, new_env))
       else if f[0] = "__builtin__" then
         应用内建(f[1], args, call_env)
       else if f[0] = "__struct工厂__" then
         应用结构体工厂(f, args)
       else if f[0] = "__struct部分__" then
         应用结构体工厂(f[1], f[2:] + args)
       else if f[0] = "__内建部分__" then
         应用内建(f[1], f[2] + args, call_env)
       else
         错误("不可调用的值: " + 标准库.元素repr(f)))
    else
      (* 30c：类型守卫前置（应用函数 同改）——不可索引值直接报
         「不可调用的值」，不再落 VM 下标错误。 *)
      错误("不可调用的值: " + 标准库.元素repr(f))

  (* 30d：内建元数表——柯里化 AST（嵌套单参 FuncApp）下多参内建首参调用
     须记偏应用待续参补全，镜像宿主 _curry_module（src/interp.py:71）
     n 元完成面；max/min 变参（单列表 / 两数起）单列表实参直接补全。 *)
  func 内建元数(name: String) -> Int = (name) =>
    name = "get" or name = "append" or name = "concat" or name = "concat_list" or
    name = "range" or name = "split" or name = "repeat" or name = "assert" or
    name = "pow" or name = "gcd" or name = "max" or name = "list_max" or
    name = "min" or name = "list_min" ? 2 :
    (* 42b：终端/装载器载体原语的柯里化二元面（宿主 curry2/lambda 链形状：
       复制文件(a)(b) 改名(a)(b) 执行命令输入(a)(b)——首参调用须记偏应用待续参。 *)
    name = "复制文件" or name = "改名" or name = "执行命令输入" ? 2 :
    name = "slice" or name = "replace" ? 3 : 1

  (* 内建函数应用 ===== *)
  func 应用内建(name: String, args: List, env: List) -> Value = (name, args, env) =>
    内建元数(name) > 标准库.len(args) ?
      标准库.len(args) = 0 ? ["__内建部分__", name, args] :
        (((name = "max" or name = "list_max" or name = "min" or name = "list_min") and
          type_of(args[0]) = "List") or
         ((name = "max" or name = "list_max" or name = "min" or name = "list_min") and
          type_of(args[0]) = "Tuple")) ?
        应用内建实(name, args, env) :
        ["__内建部分__", name, args] :
      应用内建实(name, args, env)

  func 应用内建实(name: String, args: List, env: List) -> Value = (name, args, env) =>
    name = "ord" ? 标准库.ord_matha(args[0]) :
    name = "chr" ? 标准库.chr_matha(标准库.int(num_to_str(args[0]))) :
    name = "len" or name = "list_len" ? 标准库.len(args[0]) :
    name = "get" ? 标准库.list_get(args[0], 标准库.int(num_to_str(args[1]))) :
    name = "slice" ? (type_of(args[0]) = "String" ?
      _切片值(args[0], 标准库.int(num_to_str(args[1])), 标准库.int(num_to_str(args[2])), "String") :
      type_of(args[0]) = "List" ?
        标准库.list_slice(args[0], 标准库.int(num_to_str(args[1])), 标准库.int(num_to_str(args[2]))) :
        错误("slice() 需要字符串或列表")) :
    name = "append" ? 标准库.list_append(args[0], args[1]) :
    name = "concat" or name = "concat_list" ? 标准库.list_concat(args[0], args[1]) :
    name = "reverse" ? 标准库.list_reverse(args[0]) :
    name = "sort" ? 标准库.list_sort(args[0]) :
    name = "max" or name = "list_max" ? (if 标准库.len(args) = 1 then 标准库.list_max(args[0]) else if 标准库.len(args) >= 2 then if args[0] > args[1] then args[0] else args[1] else 错误("max: 需要至少1个参数")) :
    name = "min" or name = "list_min" ? (if 标准库.len(args) = 1 then 标准库.list_min(args[0]) else if 标准库.len(args) >= 2 then if args[0] < args[1] then args[0] else args[1] else 错误("min: 需要至少1个参数")) :
    name = "sum" or name = "list_sum" ? 标准库.list_sum(args[0]) :
    name = "int" ? 标准库.int(num_to_str(args[0])) :
    name = "float" ? 标准库.float(num_to_str(args[0])) :
    name = "str" ? 标准库.str(args[0]) :
    name = "range" ? 标准库.range(标准库.int(num_to_str(args[0])), 标准库.int(num_to_str(args[1]))) :
    name = "enumerate" ? 标准库.enumerate(args[0]) :
    name = "strip" ? 标准库.strip(num_to_str(args[0])) :
    name = "to_lower" ? 标准库.to_lower(num_to_str(args[0])) :
    name = "to_upper" ? 标准库.to_upper(num_to_str(args[0])) :
    name = "replace" ? 标准库.replace(num_to_str(args[0]), num_to_str(args[1]), num_to_str(args[2])) :
    name = "split" ? 标准库.split(num_to_str(args[0]), num_to_str(args[1])) :
    name = "repeat" ? 标准库.repeat(num_to_str(args[0]), 标准库.int(num_to_str(args[1]))) :
    name = "输出" or name = "print" ? (let 忽略 = 输出记录(args[0]) in args[0]) :
    name = "assert" ? (标准库.assert(args[0] != 0.0 and args[0] != 假 and args[0] != "0" and args[0] != "", num_to_str(args[1])), 空()) :
    name = "parse_JSON" ? 标准库.parse_JSON(num_to_str(args[0])) :
    (* 33-⑤：type_of/_to_tuple 面真化——裸名委托宿主 BUILTINS（vm/hi 双面
       同实现 builtin_type_of/builtin_to_tuple；30e carve-out 后用户程序 env
       缺名致未定义变量，此臂补齐应用面。元数 1 走 内建元数 默认臂） *)
    name = "type_of" ? type_of(args[0]) :
    name = "_to_tuple" ? _to_tuple(args[0]) :
    (* 30a：数学函数参数直取（宿主 BUILTINS 直接 math.sin(v) 镜像）——
       此前 标准库.float(num_to_str(v)) 经 str 往返（~7 位有效数字）截断
       非整数值（sin(圆周率/2) 实证 0.9999999999999466 vs 宿主 1.0）。 *)
    name = "sin" ? 运行时引擎.sin(args[0]) :
    name = "cos" ? 运行时引擎.cos(args[0]) :
    name = "tan" ? 运行时引擎.tan(args[0]) :
    name = "sqrt" ? 运行时引擎.sqrt(args[0]) :
    name = "abs" ? 运行时引擎.abs(args[0]) :
    name = "floor" ? 运行时引擎.floor(args[0]) :
    name = "ceil" ? 运行时引擎.ceil(args[0]) :
    name = "round" ? 运行时引擎.round(args[0]) :
    name = "pow" ? 运行时引擎.pow(args[0], args[1]) :
    name = "log" ? 运行时引擎.log(args[0]) :
    name = "log10" ? 运行时引擎.log10(args[0]) :
    name = "log2" ? 运行时引擎.log2(args[0]) :
    name = "factorial" ? 运行时引擎.factorial(标准库.int(num_to_str(args[0]))) :
    name = "gcd" ? 运行时引擎.gcd(标准库.int(num_to_str(args[0])), 标准库.int(num_to_str(args[1]))) :
    name = "is_prime" ? 运行时引擎.is_prime(标准库.int(num_to_str(args[0]))) :
    name = "pi" ? PI :
    name = "e" ? E :
    (* 42b：16 条载体原语逐名臂（阶段 42「让 Matha 自身装载/运行 Matha」）——
       此前链面调这些名字只能靠驱动器把宿主内建表注入 env（Python 代劳）；
       逐名臂使链面自带分派，裸名委托 boot VM 全局：内核终端节
       （src/kernel/terminal_builtin.py 懒物化 LazyKernelFn）、os 域插件符号
       （src/domains/os_module.py，经 VM 惰性解析器）、宿主 执行Matha/调试Matha。
       实参形状按各原语的正典调用（终端执行器 同源写法）：二元柯里化走 (a)(b)，
       零参载体（管道结束/输入行/检查包更新）不带 args——链面 () 即零参调用，
       宿主对应实现无必选参数。 *)
    name = "执行命令" ? 执行命令(args[0]) :
    name = "执行命令输入" ? 执行命令输入(args[0])(args[1]) :
    name = "管道输入" ? 管道输入(args[0]) :
    name = "管道结束" ? 管道结束() :
    name = "输入行" ? 输入行() :
    name = "列目录" ? 列目录(args[0]) :
    name = "建目录" ? 建目录(args[0]) :
    name = "删除路径" ? 删除路径(args[0]) :
    name = "复制文件" ? 复制文件(args[0])(args[1]) :
    name = "改名" ? 改名(args[0])(args[1]) :
    name = "换目录" ? 换目录(args[0]) :
    name = "路径存在" ? 路径存在(args[0]) :
    name = "执行Matha" ? 执行Matha(args[0]) :
    name = "调试Matha" ? 调试Matha(args[0]) :
    name = "升级包" ? 升级包(args[0]) :
    name = "检查包更新" ? 检查包更新() :
    name = "错误" ? 错误(args[0]) :
    错误("未知内建函数: " + name)

  func bool(v) -> Bool = (v) => v != 0.0 and v != 假 and v != "0" and v != ""
  func 空() -> None = () => null

  (* ===== 语句执行 ===== *)

  func 执行语句(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    stmt["类型"] = "绑定" ?
      let v = 求值(stmt["值"], env) in
      (v, 绑定环境(env, stmt["名"], v)) :
    stmt["类型"] = "函数定义" ?
      let env1 = 环境包含(env, stmt["名"]) ?
        (查找环境(env, stmt["名"]) = "__函数占位__" ?
          更新绑定值(env, stmt["名"], "__函数占位__") :
          绑定环境(env, stmt["名"], "__函数占位__")) :
        绑定环境(env, stmt["名"], "__函数占位__") in
      let closure = 求值(语法器.做Lambda(stmt["参数"], stmt["体"]), env1) in
      let env2 = 更新绑定值(env1, stmt["名"], closure) in
      (* 34-③：块值 null（宿主 _exec_stmt FuncDef 隐式 None / 块尾
         _BLOCK_TAIL_STMT_NODES 面）——函数仍入 env，仅值面不回传 *)
      (null, env2) :
    stmt["类型"] = "if" ?
      (* 33-④：真值 归一 + 无 else（假分支节点 null）→ (null, env)，
         对齐宿主 IfStmt branch None 面 *)
      真值(求值(stmt["条件"], env)) ?
        执行语句列表(stmt["真分支"], env) :
        (stmt["假分支"] = null ? (null, env) : 执行语句列表(stmt["假分支"], env)) :
    stmt["类型"] = "while" ?
      执行while循环(stmt["条件"], stmt["体"], env) :
    stmt["类型"] = "for" ?
      执行for循环(stmt["变量"], _for迭代源(求值(stmt["迭代"], env)), stmt["体"], env) :
    stmt["类型"] = "输出" ?
      (let v = 输出取值(stmt["expr"], env) in
       let 忽略 = 输出记录(v) in
       (v, env)) :
    stmt["类型"] = "输出追踪" ?
      (* 语句位 [输出]（宿主 _parse_output_trail 包裹面）：解包执行内层输出；
         29d：登记输出流（宿主 OutputTrail 透传 _exec_stmt(Output) 同构） *)
      (let v = 输出取值(stmt["输出"]["expr"], env) in
       let 忽略 = 输出记录(v) in
       (v, env)) :
    stmt["类型"] = "程序" ?
      执行语句列表(stmt, env) :
    stmt["类型"] = "let绑定" ?
      绑定求值let(stmt, env) :
    stmt["类型"] = "let元组绑定" ?
      (* 35-①：语句位 let 元组绑定（宿主 _exec_stmt 同位——解构绑定，
         块值 null） *)
      绑定求值let元组(stmt, env) :
    stmt["类型"] = "match" ?
      (let v = 求值match(stmt, env) in
       let 忽略 = 输出记录(v) in
       (v, env)) :
    stmt["类型"] = "生成语句" ? 执行生成语句(stmt, env) :
    stmt["类型"] = "机械单元" ? 执行机械单元(stmt, env) :
    (* 29d：编译期 NOOP 语句（宿主 GlobalIdStmt/ForeignDecl 同构——编号/外来
       文本仅解析期收集，执行面无副作用，不进入求值兜底报错） *)
    stmt["类型"] = "全局标识" ? (null, env) :
    stmt["类型"] = "外来声明" ? (null, env) :
    (* 30a：宿主 NOOP/控制流语句路由（读取块=宿主静默调试面，轨迹不入输出流；
       跳出/继续/返回 产列表信号，由执行器通道截获转发——见 信号种类） *)
    stmt["类型"] = "读取块" ? (null, env) :
    stmt["类型"] = "设值" ? 执行设值(stmt, env) :
    stmt["类型"] = "try" ? 执行try(stmt, env) :
    stmt["类型"] = "抛出" ? 执行抛出语句(stmt, env) :
    stmt["类型"] = "跳出语句" ? 跳出哨兵(env) :
    stmt["类型"] = "继续语句" ? 继续哨兵(env) :
    stmt["类型"] = "返回语句" ? 执行返回语句(stmt, env) :
    (* 30a：>> 链式语句（宿主 ChainStmt 镜像）——逐链执行，信号短路转发
       （宿主控制流异常穿链同构），走完返回 null。 *)
    stmt["类型"] = "链式语句" ? 执行链式语句(stmt["语句"], env) :
    stmt["类型"] = "二元运算" ?
      语句位赋值或表达式(stmt, env) :
    (错误("未知语句类型: " + stmt["类型"]), env)

  (* 29c：生成语句执行（宿主 _exec_gen_stmt 同构）——命令文字/空输出/输出追踪/
     输出/go/函数定义 逐支复用既有执行面；含槽 → env "__公式库__" 登记
     （注册内建 预绑定空库，同形归并）；命中模式不求值；其余 求值。
     轨迹面 bootstrap 无载体（登记不修）。
     独立成函数：let-in 体贪婪吞并外层三元链承接位，内联即挂链错位。 *)
  func 执行生成语句(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    let c = stmt["content"] in
    c["类型"] = "命令文字" or c["类型"] = "空输出" ? (null, env) :
    c["类型"] = "输出追踪" or c["类型"] = "函数定义" ? 执行语句(c, env) :
    c["类型"] = "输出" ?
      (let v = 输出取值(c["expr"], env) in
       let 忽略 = 输出记录(v) in
       (v, env)) :
    c["类型"] = "go" ? (求值(c["expr"], env), env) :
    标准库.公式_含槽(c) ?
      let 库 = 查找环境(env, "__公式库__") in
      let 登记态 = 标准库.公式_登记(库, c, stmt["段号"]) in
      (null, 更新绑定值(env, "__公式库__", 登记态[0])) :
    标准库.公式_匹配(查找环境(env, "__公式库__"), c) != [] ? (null, env) :
    (求值(c, env), env)

  (* 29c：机械单元执行——#：{ … } 顶层自测块此前落入 未知语句类型。
     body 三形态：列表 [生成语句, 块]（宿主合并体）／程序 dict／生成语句 dict *)
  func 执行机械单元(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    type_of(stmt["body"]) = "List" ?
      _执行单元列表(stmt["body"], env) :
      执行语句列表(stmt["body"], env)

  (* 语句位裸赋值（宽容消解，对齐宿主 interp.py _exec_stmt 与 VM _emit_block
     is_assign 面）：`名 = 表达式` 在语句位求值右侧并绑定（已有名更新、
     未有名新绑定）；其余二元表达式语句仍按表达式求值。 *)
  func 语句位赋值或表达式(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    (stmt["运算符"] = "=" and stmt["左"]["类型"] = "变量") ?
      let v = 求值(stmt["右"], env) in
      if 环境包含(env, stmt["左"]["名"]) then
        (v, 更新绑定值(env, stmt["左"]["名"], v))
      else
        (v, 绑定环境(env, stmt["左"]["名"], v)) :
    (stmt["运算符"] = "=" and stmt["左"]["类型"] = "下标") ?
      下标赋值(stmt["左"], stmt["右"], env) :
    (求值(stmt, env), env)

  (* 下标赋值（29d 真化，宿主 _exec_stmt IndexExpr 分支 + _assign_subscript
     镜像）：容器/索引/右值求值后写入。列表原位写入（嵌套容器经 求值 取到
     共享内层引用，宿主同语义）；字典 Matha 值不可变——经 dict_put 产新
     字典后回写容器槽（变量容器写回绑定槽、嵌套容器递归回写父槽，同 24d
     「_dict_put 产新 dict + 写回具名变量」口径；别名引用可见性差异登记
     不修）；其余容器形态诚实报错，文案同读面（宿主 Python 类型名 vs
     VM 类型名分歧已登记）。逐支独立成函数：let-in 体贪婪吞并外层三元
     链承接位，内联即挂链错位（29c 先例）。 *)
  func 下标赋值(lhs: Dict, rhs: Dict, env: List) -> (Value, List) = (lhs, rhs, env) =>
    let c = 求值(lhs["容器"], env) in
    let i = 求值(lhs["索引"], env) in
    let v = 求值(rhs, env) in
    _下标写入(lhs["容器"], c, i, v, env)

  func _下标写入(容器e: Dict, c: Value, i: Value, v: Value, env: List) -> (Value, List) =
    (容器e, c, i, v, env) =>
    type_of(c) = "List" ?
      (v, _原地设列表(c, i, v, env)) :
    type_of(c) = "Dict" ?
      _字典槽写回(容器e, 标准库.dict_put(c, i, v), v, env) :
    错误("索引操作不支持: " + _类型名(c) + "[" + 标准库.str(i) + "]")

  func _原地设列表(c: List, i: Int, v: Value, env: List) -> List = (c, i, v, env) =>
    let 忽略 = 标准库.原地设置(c, i, v) in env

  func _字典槽写回(容器e: Dict, nd: Dict, v: Value, env: List) -> (Value, List) =
    (容器e, nd, v, env) =>
    let wr = _槽写回(容器e, nd, env) in
    (v, wr[1])

  func _槽写回(容器e: Dict, nd: Value, env: List) -> (Value, List) = (容器e, nd, env) =>
    容器e["类型"] = "变量" ? (nd, 更新绑定值(env, 容器e["名"], nd)) :
    容器e["类型"] = "下标" ? _父槽写回(容器e, nd, env) :
    错误("索引操作不支持: 字典写回容器形态: " + 容器e["类型"])

  func _父槽写回(容器e: Dict, nd: Value, env: List) -> (Value, List) = (容器e, nd, env) =>
    let pc = 求值(容器e["容器"], env) in
    let pi = 求值(容器e["索引"], env) in
    _父槽写入(容器e["容器"], pc, pi, nd, env)

  func _父槽写入(容器ee: Dict, pc: Value, pi: Value, nd: Value, env: List) -> (Value, List) =
    (容器ee, pc, pi, nd, env) =>
    type_of(pc) = "List" ?
      (nd, _原地设列表(pc, pi, nd, env)) :
    type_of(pc) = "Dict" ?
      _槽写回(容器ee, 标准库.dict_put(pc, pi, nd), env) :
    错误("索引操作不支持: " + _类型名(pc) + "[" + 标准库.str(pi) + "]")

  func 执行语句列表(stmts: Dict, env: List) -> (Value, List) = (stmts, env) =>
    if stmts["类型"] = "程序" then
      (* 32e：let rec 名预绑占位（互相递归前向引用）——占位对经闭包捕获
         共享，绑定求值let 复用同一对 原地填充（30b 提升函数名同构）。 *)
      执行声明列表(stmts["声明"],
        预绑递归let(stmts["声明"], 提升函数名(stmts["声明"], env)))
    else
      执行语句(stmts, env)

  (* 32e：块/程序入口 let rec 名预绑占位（互相递归前向引用）——直接声明位
     语句级 let绑定（有体=假）递归名绑 "__递归占位__" 占位对（已绑跳过，
     同 宿主 _preregister_rec_let setdefault 语义）；先定义闭包的捕获表
     经占位对可见后定义名。只扫直接声明位，不深入嵌套块体（嵌套块体
     在自身入口预绑）。 *)
  func 预绑递归let(声明们: List, env: List) -> List = (声明们, env) =>
    声明们 = [] ? env :
    预绑递归let(声明们[1:],
      (声明们[0]["类型"] = "let绑定" and 声明们[0]["递归"] and
       声明们[0]["有体"] = 假) ?
      (环境包含(env, 声明们[0]["名"]) ? env :
        绑定环境(env, 声明们[0]["名"], "__递归占位__")) :
      env)

  (* 30b：模块级函数名提升（宿主平铺全局 env + 全局回退查找镜像）——顶层/
     模块体 函数定义 名先绑 占位再执行，函数定义 路由对 占位对走 更新绑定值
     （原地改写共享对），互递归闭包经捕获表可见后定义名（宿主全局回退同效，
     _解析行↔_解析行进 形态）。只提升直接声明位的 函数定义，不深入块体；
     占位对每次执行新建，不跨程序共享。 *)
  func 提升函数名(声明们: List, env: List) -> List = (声明们, env) =>
    声明们 = [] ? env :
    提升函数名(声明们[1:],
      声明们[0]["类型"] = "函数定义" ?
        绑定环境(env, 声明们[0]["名"], "__函数占位__") :
        env)

  (* 机械单元列表体 [生成语句, 块]（宿主合并体，29c）：逐条执行。
     30a：跳出/继续/返回 信号截获转发（宿主 _BreakException 等沿块通道
     传播同构——信号即语句结果，最近执行器消费） *)
  func _执行单元列表(items: List, env: List) -> (Value, List) = (items, env) =>
    items = [] ? (null, env) :
    let (v, env2) = 执行语句(items[0], env) in
    if 信号种类(v) != null then (v, env2)
    else if items[1:] = [] then (v, env2)
    else _执行单元列表(items[1:], env2)

  (* 36-② 收尾（37 顺手真修）：块尾值模型——绑定/let绑定/let元组绑定尾
     不回传值（宿主 _BLOCK_TAIL_STMT_NODES 头三族；函数定义 臂 36b 已
     null）。仅表达式位块（求值程序）应用；程序位顶层（run_ast → 执行
     语句）保持「程序值 = 尾表达式值」约定不映射（phase8pre gapfix 锁）。 *)
  func _块尾值(decl: Dict, v: Value) -> Value =
    let t = decl["类型"] in
    ((t = "绑定") or (t = "let绑定") or (t = "let元组绑定")) ? null : v

  func 执行声明列表(decls: List, env: List) -> (Value, List) = (decls, env) =>
    if decls = [] then
      (None, env)
    else
      let (v, env2) = 执行声明(decls[0], env) in
      if 信号种类(v) != null then (v, env2)
      else if decls[1:] = [] then (v, env2)
      else 执行声明列表(decls[1:], env2)

  func 执行声明(decl: Dict, env: List) -> (Value, List) = (decl, env) =>
    if decl["类型"] = "绑定" then
      let v = 求值(decl["值"], env) in
      (v, 绑定环境(env, decl["名"], v))
    else if decl["类型"] = "函数定义" then
      let env1 = 环境包含(env, decl["名"]) ?
        (查找环境(env, decl["名"]) = "__函数占位__" ?
          更新绑定值(env, decl["名"], "__函数占位__") :
          绑定环境(env, decl["名"], "__函数占位__")) :
        绑定环境(env, decl["名"], "__函数占位__") in
      let closure = 求值(语法器.做Lambda(decl["参数"], decl["体"]), env1) in
      let env2 = 更新绑定值(env1, decl["名"], closure) in
      (* 34-③：块值 null（宿主块值模型 FuncDef 尾不回传）——声明列表
         尾值取 null，函数绑定不变 *)
      (null, env2)
    else if decl["类型"] = "程序" then
      (* 32e：嵌套块体（声明位裸块）同入口预绑（执行语句列表 Program 臂
         同构） *)
      执行声明列表(decl["声明"], 预绑递归let(decl["声明"], env))
    else if decl["类型"] = "let绑定" then
      绑定求值let(decl, env)
    else if decl["类型"] = "let元组绑定" then
      (* 35-①：顶层位 let 元组绑定（宿主 _exec_decl → _exec_stmt 同构） *)
      绑定求值let元组(decl, env)
    else if decl["类型"] = "定义运算符" then
      (* 自定义运算符声明：编译期 / 解析期已登记，运行期无副作用（对齐宿主 NOOP） *)
      (None, env)
    else if decl["类型"] = "机械单元" or decl["类型"] = "生成语句" then
      (* 29c：顶层位机械单元/生成语句 → 委托 执行语句 分支（登记/命中/求值） *)
      执行语句(decl, env)
    else if decl["类型"] = "输出" or decl["类型"] = "输出追踪" or decl["类型"] = "while" or decl["类型"] = "for" then
      执行语句(decl, env)
    else if decl["类型"] = "if" then
      if decl["真分支"]["类型"] = "程序" then 执行语句(decl, env) else (求值(decl, env), env)
    else if decl["类型"] = "模块" then
      执行模块体(decl, env)
    else if decl["类型"] = "导入" then
      导入绑定(decl, env)
    else if decl["类型"] = "二元运算" then
      (* 29d：顶层位二元语句委托 执行语句（宿主 _exec_decl 兜底 _exec_stmt
         同构——变量/下标赋值真化 + 裸表达式求值；顶层裸 `名 = 值` 经解析器
         产 绑定 节点不经此支）。 *)
      执行语句(decl, env)
    else if decl["类型"] = "全局标识" or decl["类型"] = "外来声明" then
      (* 29d：编译期 NOOP 声明（宿主 GlobalIdStmt/ForeignDecl 同构）——
         编号/外来文本仅解析期收集，执行面无副作用；顶层位此前落入裸
         表达式兜底报 未知表达式类型（sweep 06_main 16+10 文件根因）。 *)
      (null, env)
    else if decl["类型"] = "读取块" then
      (* 30a：顶层位读取块（宿主静默调试面，轨迹不入输出流） *)
      (null, env)
    else if decl["类型"] = "设值" then
      执行设值(decl, env)
    else if decl["类型"] = "try" then
      执行try(decl, env)
    else if decl["类型"] = "抛出" then
      执行抛出语句(decl, env)
    else if decl["类型"] = "跳出语句" then
      跳出哨兵(env)
    else if decl["类型"] = "继续语句" then
      继续哨兵(env)
    else if decl["类型"] = "返回语句" then
      执行返回语句(decl, env)
    else if decl["类型"] = "链式语句" then
      (* 30a：顶层位 >> 链（宿主 _exec_decl → _exec_stmt ChainStmt 同构） *)
      执行链式语句(decl["语句"], env)
    else if decl["类型"] = "结构体" then
      (* 30a：struct 声明 → 工厂闭包绑定（宿主 _exec_struct 镜像，
         部分应用经 __struct部分__ 累积字段） *)
      执行结构体(decl, env)
    else if decl["类型"] = "枚举" then
      (* 30a：enum 声明 → 命名空间值绑定（宿主 _exec_enum 镜像） *)
      执行枚举(decl, env)
    else
      (* 裸表达式：直接求值并返回结果 *)
      (求值(decl, env), env)

  (* ===== 30a：控制流信号 / 设值 / try / 结构体 / 枚举 / 属性 执行面 =====
     信号协议：纯 Matha 列表哨兵 ["__跳出__"] / ["__继续__"] / ["__返回__", v]
     ——语句路由产出、执行器通道（_执行单元列表/执行声明列表/while/for）截获
     转发、闭包边界（应用函数/应用多参数函数）仅解包 返回（宿主
     _ReturnException 捕获位）；跳出/继续 穿闭包交最近循环。哨兵与用户数据
     撞形同 __struct实例__ 口径（登记不修）。 *)

  func 信号种类(v: Value) -> Value = (v) =>
    type_of(v) = "List" ?
      (标准库.len(v) = 1 and v[0] = "__跳出__" ? "跳出" :
       标准库.len(v) = 1 and v[0] = "__继续__" ? "继续" :
       标准库.len(v) = 2 and v[0] = "__返回__" ? "返回" :
       null) :
    null

  (* 闭包体位返回信号解包：返回 → 裸值；跳出/继续 → 原样穿透（宿主
     控制流异常沿调用栈传播同构）。 *)
  func 闭包返回值(v: Value) -> Value = (v) =>
    信号种类(v) = "返回" ? v[1] : v

  func 跳出哨兵(env: List) -> (Value, List) = (env) => (["__跳出__"], env)
  func 继续哨兵(env: List) -> (Value, List) = (env) => (["__继续__"], env)

  func 返回取值(stmt: Dict, env: List) -> Value = (stmt, env) =>
    stmt["值"] = null ? null : 求值(stmt["值"], env)

  func 执行返回语句(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    (["__返回__", 返回取值(stmt, env)], env)

  (* >> 链式语句：逐链执行（宿主 ChainStmt 逐 _exec_stmt 镜像）——信号
     短路转发（宿主控制流异常穿链传播同构），走完返回 null（语句位无值）。 *)
  func 执行链式语句(links: List, env: List) -> (Value, List) = (links, env) =>
    links = [] ? (null, env) :
    let (v, env2) = 执行语句(links[0], env) in
    信号种类(v) != null ? (v, env2) :
    links[1:] = [] ? (null, env2) : 执行链式语句(links[1:], env2)

  (* raise/throw → 做抛出（boot 解析器同节点）：宿主 RaiseExpr
     raise MathaRuntimeError(str(value)) 无前缀镜像。num_to_str 而非
     标准库.str——后者数字专用（字符串值原样穿越），抛字符串消息必需。 *)
  func 执行抛出语句(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    (错误(num_to_str(求值(stmt["值"], env))), env)

  (* 设值 @：（宿主 _exec_set_up 镜像）——值位有 → env[目标]=值
     （字典赋值语义：有则覆写无则新建）；值位缺 → setdefault(目标, 0)。 *)
  func 执行设值(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    设值项列表(stmt["项"], env)

  func 设值项列表(items: List, env: List) -> (Value, List) = (items, env) =>
    items = [] ? (null, env) : 设值一步(items[0], items[1:], env)

  func 设值一步(item: Dict, rest: List, env: List) -> (Value, List) = (item, rest, env) =>
    let 名 = 设值目标名(item["目标"]) in
    item["值"] = null ? 设值缺省(名, rest, env) : 设值有值(名, item["值"], rest, env)

  func 设值缺省(名: String, rest: List, env: List) -> (Value, List) = (名, rest, env) =>
    环境包含(env, 名) ? 设值项列表(rest, env) : 设值项列表(rest, 绑定环境(env, 名, 0))

  func 设值有值(名: String, 值e: Dict, rest: List, env: List) -> (Value, List) = (名, 值e, rest, env) =>
    let v = 求值(值e, env) in
    设值项列表(rest, 设值绑定(env, 名, v))

  func 设值绑定(env: List, 名: String, v: Value) -> List = (env, 名, v) =>
    环境包含(env, 名) ? 更新绑定值(env, 名, v) : 绑定环境(env, 名, v)

  func 设值目标名(目标: Dict) -> String = (目标) =>
    目标["类型"] = "变量" ? 目标["名"] :
    错误("设值目标不支持: " + 目标["类型"])

  (* try/catch/finally（宿主 _exec_try 镜像）：体经 调用捕获 隔离——
     正常 → finally 后透传 (值, env)；异常 → 无捕获体 → finally 后原样
     重抛；空捕获体 → 吞掉；有捕获变量 → 绑定消息字符串进捕获体。
     捕获体再异常 → finally 后重抛。宿主 break/continue/return 穿 try
     不触发 catch（finally 仍跑）——boot 面 try执行包装 产信号原样透传，
     finally 后由 执行finally后 透传信号，通道执行器继续截获。 *)
  func try执行包装(体: Dict, env: List) -> List = (体, env) =>
    let (v, env2) = 执行语句列表(体, env) in
    [v, env2]

  func 执行try(stmt: Dict, env: List) -> (Value, List) = (stmt, env) =>
    let 结果 = 调用捕获(try执行包装)([stmt["try体"], env]) in
    if 结果[0] = "__正常__" then
      执行finally后(stmt, 结果[1][0], 结果[1][1])
    else if stmt["捕获体"] = null then
      (let 忽略 = 执行finally后(stmt, null, env) in 错误(结果[1]))
    else if stmt["捕获体"]["声明"] = [] then
      执行finally后(stmt, null, env)
    else
      let env3 = stmt["捕获变量"] = "" ? env : 绑定环境(env, stmt["捕获变量"], 结果[1]) in
      let 捕果 = 调用捕获(try执行包装)([stmt["捕获体"], env3]) in
      if 捕果[0] = "__正常__" then 执行finally后(stmt, 捕果[1][0], 捕果[1][1])
      else (let 忽略2 = 执行finally后(stmt, null, env3) in 错误(捕果[1]))

  func 执行finally后(stmt: Dict, v: Value, env: List) -> (Value, List) = (stmt, v, env) =>
    stmt["finally体"]["声明"] = [] ? (v, env) :
    let (忽略, env2) = 执行语句列表(stmt["finally体"], env) in
    (v, env2)

  (* 结构体声明 → 工厂值绑定（宿主 _exec_struct 镜像，stage-1
     执行结构体 同形）：工厂 ["__struct工厂__", 名, 字段名们]，
     逐参调用累积（__struct部分__），齐参成实例 ["__struct实例__", 名, [字段, 值]...]。 *)
  func 执行结构体(decl: Dict, env: List) -> (Value, List) = (decl, env) =>
    let 工厂 = ["__struct工厂__", decl["名"], 结构体字段名(decl["字段"])] in
    (工厂, 绑定环境(env, decl["名"], 工厂))

  func 结构体字段名(fields: List) -> List = (fields) =>
    if fields = [] then [] else [fields[0]["名"]] + 结构体字段名(fields[1:])

  (* 枚举声明 → 命名空间值绑定（宿主 _exec_enum 镜像，stage-1 执行枚举 同形）：
     ["__enum命名__", 名, 构造子...]，成员访问返回构造子名。 *)
  func 执行枚举(decl: Dict, env: List) -> (Value, List) = (decl, env) =>
    let ns = ["__enum命名__", decl["名"]] + decl["构造子"] in
    (ns, 绑定环境(env, decl["名"], ns))

  func 应用结构体工厂(工厂: List, 已收集: List) -> Value = (工厂, 已收集) =>
    let 字段名 = 工厂[2] in
    标准库.len(字段名) = 0 ? ["__struct实例__", 工厂[1]] :
    标准库.len(已收集) = 标准库.len(字段名) ?
      ["__struct实例__", 工厂[1]] + 配对(字段名, 已收集) :
    ["__struct部分__", 工厂] + 已收集

  func 配对(names: List, vals: List) -> List = (names, vals) =>
    if names = [] then [] else [[names[0], vals[0]]] + 配对(names[1:], vals[1:])

  (* 属性访问 a.b（宿主 Attribute 镜像，stage-1 求值属性 同形）：
     变量已绑定 → 对象取字段；未绑定 → 模块平铺回退（链模块内建已平铺
     进 env，宿主 getattr(builtins, 名, None) None 缺位镜像）；其余对象
     表达式先求值再取字段。 *)
  func 求值属性(obje: Dict, 名: String, env: List) -> Value = (obje, 名, env) =>
    obje["类型"] = "变量" ?
      (环境包含(env, obje["名"]) ?
        对象取字段(查找环境(env, obje["名"]), 名, env) :
        (环境包含(env, 名) ? 查找环境(env, 名) : null)) :
    对象取字段(求值(obje, env), 名, env)

  (* 字段访问分发：struct 实例/enum 命名空间（列表形，stage-1 同构）→
     字段/构造子；字典 → 字典取值（缺键走内建回退——宿主 obj.get(field)
     None → getattr(builtins) 同构）；其余形态宿主 getattr 失败抛
     属性访问失败（boot type_of 名与宿主 Python 类型名分歧登记不修）。 *)
  func 对象取字段(obj: Value, 名: String, env: List) -> Value = (obj, 名, env) =>
    type_of(obj) = "List" or type_of(obj) = "Tuple" ?
      属性列表取值(obj, 名, env) :
    type_of(obj) = "Dict" ?
      属性字典取值(obj, 名, env) :
    错误("属性访问失败: " + type_of(obj) + "." + 名)

  func 属性列表取值(obj: List, 名: String, env: List) -> Value = (obj, 名, env) =>
    obj[0] = "__struct实例__" ? 结构体字段值(obj[2:], 名) :
    obj[0] = "__enum命名__" ? 枚举构造子值(obj[2:], 名) :
    错误("属性访问失败: " + type_of(obj) + "." + 名)

  func 属性字典取值(d: Dict, 名: String, env: List) -> Value = (d, 名, env) =>
    let v = 安全索引(d, 名) in
    v = null ? _内建回退(env, 名) : v

  (* 字段缺失 → null（stage-1 对齐宿主 _StructInstance 缺字段返回 None） *)
  func 结构体字段值(pairs: List, 名: String) -> Value = (pairs, 名) =>
    pairs = [] ? null :
    pairs[0][0] = 名 ? pairs[0][1] : 结构体字段值(pairs[1:], 名)

  func 枚举构造子值(ctors: List, 名: String) -> Value = (ctors, 名) =>
    ctors = [] ? null :
    ctors[0] = 名 ? 名 : 枚举构造子值(ctors[1:], 名)

  (* ===== 模块 / use 导入执行（29d，宿主 ModuleDecl/_exec_use 镜像）===== *)

  func _名单含(names: List, nm: String) -> Bool = (names, nm) =>
    names = [] ? 假 :
    names[0] = nm ? 真 : _名单含(names[1:], nm)

  (* 本地命名收集（宿主严格隔离镜像）：只收本模块自定义名（函数定义/绑定/
     let绑定），去重保序；导入名不入本地表。 *)
  func _模块本地名(decls: List, acc: List) -> List = (decls, acc) =>
    decls = [] ? acc :
    let d = decls[0] in
    let 命中 = d["类型"] = "函数定义" or d["类型"] = "绑定" or d["类型"] = "let绑定" or d["类型"] = "结构体" or d["类型"] = "枚举" in
    let acc2 = 命中 and not _名单含(acc, d["名"]) ? acc + [d["名"]] : acc in
    _模块本地名(decls[1:], acc2)

  func _模块名值对(names: List, env: List) -> List = (names, env) =>
    names = [] ? [] :
    环境包含(env, names[0]) ?
      [[names[0], 查找环境(env, names[0])]] + _模块名值对(names[1:], env) :
      _模块名值对(names[1:], env)

  (* 模块执行：内声明顺序执行（导入绑定/函数闭包入 env），module ns = {名: env[名]}
     仅收本地名（严格隔离，不扫全局）；模块名不在本地名表时绑定 env（R1 同名
     冲突规则——平面函数可调用面优先，24a）。 *)
  func 执行模块体(decl: Dict, env: List) -> (Value, List) = (decl, env) =>
    let 本地名 = _模块本地名(decl["声明"], []) in
    let (忽略1, env2) = 执行声明列表(decl["声明"], 提升函数名(decl["声明"], env)) in
    let 命名空间 = 标准库.dict_from_pairs(_模块名值对(本地名, env2)) in
    _名单含(本地名, decl["名"]) ?
      (null, env2) :
      (null, 绑定环境(env2, decl["名"], 命名空间))

  (* use 导入执行：模块命名空间经 注册内建 预绑定（VM globals 装载面），逐名
     绑定 env；缺模块/缺名诚实报错（宿主 _exec_use 同文案）；空导入表 no-op。 *)
  func 导入绑定(decl: Dict, env: List) -> (Value, List) = (decl, env) =>
    环境包含(env, decl["模块名"]) ?
      _导入名列表(decl["名字"], decl["模块名"], 查找环境(env, decl["模块名"]), env) :
      错误("未找到模块 '" + decl["模块名"] + "'")

  func _导入名列表(names: List, 模块名: String, ns: Dict, env: List) -> (Value, List) =
    (names, 模块名, ns, env) =>
    if names = [] then (null, env)
    else
      let nm = names[0] in
      if 标准库.dict_has(ns, nm) then
        _导入名列表(names[1:], 模块名, ns, 绑定环境(env, nm, ns[nm]))
      else
        let 回退 = _内建回退(env, nm) in
        if 回退 = null then
          错误("模块 '" + 模块名 + "' 中未找到 '" + nm + "'")
        else
          _导入名列表(names[1:], 模块名, ns, 绑定环境(env, nm, 回退))

  (* use 导入内建回退（宿主 _exec_use 第三回退镜像）：ns 缺名时仅当 env 中
     同名为内建形态（注册内建物化为 ["__builtin__",名] 列表 / __builtin__
     字典，与 应用函数 分派形状一致）才回退绑定；用户全局/本地绑定不回退。 *)
  func _内建回退(env: List, nm: String) -> Value = (env, nm) =>
    if env = [] then null
    else if env[0][0] = nm then
      let v = env[0][1] in
      let vt = type_of(v) in
      if vt = "Dict" then
        v["类型"] = "__builtin__" ? v : null
      else if vt = "List" or vt = "Tuple" then
        标准库.len(v) > 0 and v[0] = "__builtin__" ? v : null
      else
        null
    else _内建回退(env[1:], nm)

  (* while 循环 =====
     30a：体位信号截获——跳出 即停（返回 (None, env)），返回 上抛转发，
     继续 与裸值 同径继续下一轮（宿主 _BreakException/_ContinueException/
     _ReturnException 捕获面同构）。 *)
  func 执行while循环(cond: Dict, body: Dict, env: List) -> (Value, List) =
    (cond, body, env) =>
    (* 33-④：真值 归一（空容器/""/0/null 均 falsy，对齐宿主/VM） *)
    if not 真值(求值(cond, env)) then (None, env)
    else
      let (v, env2) = 执行语句(body, env) in
      if 信号种类(v) = "跳出" then (None, env2)
      else if 信号种类(v) = "返回" then (v, env2)
      else 执行while循环(cond, body, env2)

  (* for 循环 =====
     入参 items 为已求值列表（执行语句 for 支先行 求值(stmt["迭代"])）：
     递归传值切片而非 AST 节点——旧形 iterable: Dict 在递归位对
     list_slice 产物再走 求值 → list["类型"] 崩溃（29d 真化）。 *)
  func 执行for循环(var_name: Value, items: List, body: Dict, env: List) -> (Value, List) =
    (var_name, items, body, env) =>
    if type_of(items) != "List" or list_len(items) = 0 then (None, env)
    else
      (* 34e：解构目标（"变量"= List）逐位绑定，单变量维持直绑 *)
      let env2 = type_of(var_name) = "List" ?
        _解构绑定(env, var_name, items[0]) :
        绑定环境(env, var_name, items[0]) in
      let (v, env3) = 执行语句(body, env2) in
      if 信号种类(v) = "跳出" then (None, env3)
      else if 信号种类(v) = "返回" then (v, env3)
      else 执行for循环(var_name, list_slice(items, 1, 标准库.len(items)), body, env3)

  (* 34e：for 解构目标绑定（host _exec_for_stmt 镜像）——名单 × 对象元素：
     Tuple/List 且长度匹配逐位绑定；否则诚实报错「解构失败：期望 N 个
     元素，实际 <类型名>」（宿主同文案，_类型名 小写面对齐 type().__name__） *)
  func _解构绑定(env: List, 名单: List, item) -> List =
    let 元素们 = type_of(item) = "Tuple" ? _元组元素(item) :
      type_of(item) = "List" ? item :
      错误("解构失败：期望 " + 标准库.str(标准库.len(名单)) + " 个元素，实际 " + _类型名(item)) in
    标准库.len(元素们) = 标准库.len(名单) ?
      _解构绑定进(env, 名单, 元素们, 0) :
      错误("解构失败：期望 " + 标准库.str(标准库.len(名单)) + " 个元素，实际 " + _类型名(item))

  func _解构绑定进(env: List, 名单: List, 元素们: List, i: Int) -> List =
    i >= 标准库.len(名单) ? env :
    _解构绑定进(绑定环境(env, 名单[i], 元素们[i]), 名单, 元素们, i + 1)

  (* ===== match 模式匹配 =====
     语义对齐宿主 _eval_match / _match_pattern：
     守卫先于模式求值（外层 env，模式绑定对守卫不可见）；
     通配符 _ 为兜底分支（记录首个，后续通配符不可达）；
     变量绑定经 绑定环境 产生新 env，天然不泄漏（宿主为绑定后恢复，意图一致）；
     构造子支持列表 [名, 字段...] 与字典 {名: 字段列表} 两种形态。
     守卫真值对齐宿主 Python truthiness（真值 辅助）：null/假/0/""/空容器皆假。 *)

  (* 宿主 match 守卫按 Python truthiness 判定（interp.py `if not guard_val`）：
     None/False/0/""/[]/{}/() 均假。自举 if 约定（非 0.0 且非 假）会把 ""/[]
     当真，故守卫单独走本辅助。 *)
  func 真值(v) -> Bool = (v) =>
    v = null ? 假 :
    v = 假 ? 假 :
    v = 0.0 ? 假 :
    v = "" ? 假 :
    (type_of(v) = "List" or type_of(v) = "Dict" or type_of(v) = "Tuple") and 标准库.len(v) = 0 ? 假 :
    真

  func 求值match(expr: Dict, env: List) -> Value = (expr, env) =>
    求值match分支(expr["分支"], 求值(expr["scrutinee"], env), null, env)

  func 求值match分支(branches: List, value, 兜底: Dict, env: List) -> Value =
    (branches, value, 兜底, env) =>
    branches = [] ?
      (兜底 = null ? 错误("match 无匹配分支: " + 标准库.str(value)) : 求值(兜底, env)) :
    let b = branches[0] in
    let guard = b[1] in
    let gv = guard = null ? 真 : 求值(guard, env) in
    let guard_ok = guard = null ? 真 : 真值(gv) in
    if not guard_ok then 求值match分支(branches[1:], value, 兜底, env)
    else if b[0]["类型"] = "变量" and b[0]["名"] = "_" then
      求值match分支(branches[1:], value, (兜底 = null ? b[2] : 兜底), env)
    else
      let (matched, env2) = 匹配模式(b[0], value, env) in
      matched ? 求值(b[2], env2) : 求值match分支(branches[1:], value, 兜底, env)

  func 匹配模式(pattern: Dict, value, env: List) -> (Bool, List) = (pattern, value, env) =>
    pattern["类型"] = "整数" or pattern["类型"] = "浮点" or pattern["类型"] = "字符串" or pattern["类型"] = "布尔" ?
      (pattern["值"] = value, env) :
    pattern["类型"] = "构造子模式" ? 匹配构造子(pattern, value, env) :
    pattern["类型"] = "变量" ?
      (pattern["名"] = "_" ? (假, env) : (真, 绑定环境(env, pattern["名"], value))) :
    (假, env)

  func 匹配构造子(pattern: Dict, value, env: List) -> (Bool, List) = (pattern, value, env) =>
    let fields = pattern["字段"] in
    (* 宿主 _match_pattern 对 tuple/list 同等接受（isinstance(value, (tuple, list))） *)
    if (type_of(value) = "List" or type_of(value) = "Tuple") and 标准库.len(value) = 标准库.len(fields) + 1 and type_of(value[0]) = "String" and value[0] = pattern["名"] then
      匹配字段列表(fields, value[1:], env)
    else if type_of(value) = "Dict" then
      (* 安全索引：缺键返回 null → 下方 List 校验拒绝，语义等价成员测试。
         不用 in 成员运算符——自举 parser 无 in 二元层（仅 let 终止符）。
         安全索引宿主/VM/原生三端内建均有。 *)
      let args = 安全索引(value, pattern["名"]) in
      if (type_of(args) = "List" or type_of(args) = "Tuple") and 标准库.len(args) = 标准库.len(fields) then
        匹配字段列表(fields, args, env)
      else (假, env)
    else (假, env)

  func 匹配字段列表(fields: List, values: List, env: List) -> (Bool, List) = (fields, values, env) =>
    fields = [] ? (真, env) :
    let (ok, env2) = 匹配模式(fields[0], values[0], env) in
    ok ? 匹配字段列表(fields[1:], values[1:], env2) : (假, env)

  (* ===== 标准库内建注册 ===== *)
  func 注册内建(env: List) -> List = (env) =>
    (* 空值常量：宿主 BUILTINS 有 None/Null；自举 parser 把 null 解析为变量，
       须显式绑定（守卫真值/缺省判定依赖 null 可求值）。 *)
    let env1 = 绑定环境(env, "null", null) in
    let env1a = 绑定环境(env1, "None", null) in
    let env1b = 绑定环境(env1a, "Null", null) in
    let env2 = 绑定环境(env1b, "ord", ("__builtin__", "ord")) in
    let env3 = 绑定环境(env2, "chr", ("__builtin__", "chr")) in
    let env4 = 绑定环境(env3, "len", ("__builtin__", "len")) in
    let env5 = 绑定环境(env4, "get", ("__builtin__", "get")) in
    let env6 = 绑定环境(env5, "slice", ("__builtin__", "slice")) in
    let env7 = 绑定环境(env6, "append", ("__builtin__", "append")) in
    let env8 = 绑定环境(env7, "list", ("__builtin__", "concat_list")) in
    (* 数学常量 *)
    let env9 = 绑定环境(env8, "pi", PI) in
    let env10 = 绑定环境(env9, "e", E) in
    (* 数学函数 *)
    let env11 = 绑定环境(env10, "sin", ("__builtin__", "sin")) in
    let env12 = 绑定环境(env11, "cos", ("__builtin__", "cos")) in
    let env13 = 绑定环境(env12, "tan", ("__builtin__", "tan")) in
    let env14 = 绑定环境(env13, "sqrt", ("__builtin__", "sqrt")) in
    let env15 = 绑定环境(env14, "abs", ("__builtin__", "abs")) in
    let env16 = 绑定环境(env15, "floor", ("__builtin__", "floor")) in
    let env17 = 绑定环境(env16, "ceil", ("__builtin__", "ceil")) in
    let env18 = 绑定环境(env17, "round", ("__builtin__", "round")) in
    let env19 = 绑定环境(env18, "max", ("__builtin__", "max")) in
    let env20 = 绑定环境(env19, "min", ("__builtin__", "min")) in
    let env21 = 绑定环境(env20, "sum", ("__builtin__", "sum")) in
    let env22 = 绑定环境(env21, "pow", ("__builtin__", "pow")) in
    let env23 = 绑定环境(env22, "log", ("__builtin__", "log")) in
    let env24 = 绑定环境(env23, "factorial", ("__builtin__", "factorial")) in
    let env25 = 绑定环境(env24, "int", ("__builtin__", "int")) in
    let env26 = 绑定环境(env25, "float", ("__builtin__", "float")) in
    let env27 = 绑定环境(env26, "str", ("__builtin__", "str")) in
    let env28 = 绑定环境(env27, "range", ("__builtin__", "range")) in
    let env29 = 绑定环境(env28, "print", ("__builtin__", "print")) in
    let env30 = 绑定环境(env29, "assert", ("__builtin__", "assert")) in
    let env31 = 绑定环境(env30, "parse_JSON", ("__builtin__", "parse_JSON")) in
    let env32 = 绑定环境(env31, "strip", ("__builtin__", "strip")) in
    let env33 = 绑定环境(env32, "to_lower", ("__builtin__", "to_lower")) in
    let env34 = 绑定环境(env33, "to_upper", ("__builtin__", "to_upper")) in
    let env35 = 绑定环境(env34, "replace", ("__builtin__", "replace")) in
    let env36 = 绑定环境(env35, "split", ("__builtin__", "split")) in
    let env36b = 绑定环境(env36, "输出", ("__builtin__", "输出")) in
    (* 29d：链模块命名空间预绑定（宿主 ModuleDecl R1 env 绑定镜像）——
       自举链五模块 ns dict 在 VM globals（bootvm 装载时登记），绑入 env
       供 use 导入查表（宿主面 env 同形状）。 *)
    let env37 = 绑定环境(env36b, "__公式库__", []) in
    (* 33-⑤：type_of/_to_tuple 注册（30e carve-out 后用户程序 env 缺名；
       应用面经 应用内建实 裸名委托宿主 BUILTINS，vm/hi 同实现） *)
    let env38 = 绑定环境(env37, "type_of", ("__builtin__", "type_of")) in
    let env39 = 绑定环境(env38, "_to_tuple", ("__builtin__", "_to_tuple")) in
    (* 42b：16 条载体原语入链面固定面（与 应用内建实 逐名臂同批）——此前只靠
       驱动器注入宿主内建表，链面自身「未定义变量」；注册后名字恒以
       ("__builtin__", 名) 形态分派到臂，宿主面同名符号不再需要注入。 *)
    let env40 = 绑定环境(env39, "执行命令", ("__builtin__", "执行命令")) in
    let env41 = 绑定环境(env40, "执行命令输入", ("__builtin__", "执行命令输入")) in
    let env42 = 绑定环境(env41, "管道输入", ("__builtin__", "管道输入")) in
    let env43 = 绑定环境(env42, "管道结束", ("__builtin__", "管道结束")) in
    let env44 = 绑定环境(env43, "输入行", ("__builtin__", "输入行")) in
    let env45 = 绑定环境(env44, "列目录", ("__builtin__", "列目录")) in
    let env46 = 绑定环境(env45, "建目录", ("__builtin__", "建目录")) in
    let env47 = 绑定环境(env46, "删除路径", ("__builtin__", "删除路径")) in
    let env48 = 绑定环境(env47, "复制文件", ("__builtin__", "复制文件")) in
    let env49 = 绑定环境(env48, "改名", ("__builtin__", "改名")) in
    let env50 = 绑定环境(env49, "换目录", ("__builtin__", "换目录")) in
    let env51 = 绑定环境(env50, "路径存在", ("__builtin__", "路径存在")) in
    let env52 = 绑定环境(env51, "执行Matha", ("__builtin__", "执行Matha")) in
    let env53 = 绑定环境(env52, "调试Matha", ("__builtin__", "调试Matha")) in
    let env54 = 绑定环境(env53, "升级包", ("__builtin__", "升级包")) in
    let env55 = 绑定环境(env54, "检查包更新", ("__builtin__", "检查包更新")) in
    (* 42c：语言级 raise 名入固定面——终端/标准库 level-2 代码的显式拒绝路径
       全走 错误(...)，此前该名只在宿主 BUILTINS/VM _default_builtins 有实现，
       level-2 环境查不到 → 「未定义变量 '错误'」掩盖了真实拒绝文案。臂体委托
       模块自有 错误（raise MathaRuntimeError(msg)），与宿主面异常类/文案同判。 *)
    let env56 = 绑定环境(env55, "错误", ("__builtin__", "错误")) in
    env56

  (* ===== 顶层入口 ===== *)

  func interpret(source: String) -> List = (source) =>
    let toks = 词法器.扫描(source) in
    let ast = 语法器.parse(toks) in
    let env = 注册内建(空环境()) in
    let (result, env2) = 执行语句(ast, env) in
    []  (* 输出通过 print 内建捕获 *)

  func eval(expr: Dict, env: List) -> Value = (expr, env) =>
    求值(expr, env)

  func run(source: String) -> (List, List) = (source) =>
    let toks = 词法器.扫描(source) in
    let ast = 语法器.parse(toks) in
    let env = 注册内建(空环境()) in
    let (result, env2) = 执行语句(ast, env) in
    ([result], [])

}

(* ===== 自测 ===== *)
#：{
  env = 解释器.注册内建(解释器.空环境())

  (* 测试：3 + 5 *)
  expr1 = 语法器.做BinaryOp("+", 语法器.做IntLit(3), 语法器.做IntLit(5))
  result1 = 解释器.求值(expr1, env)
  [result1]

  (* 测试：2 * (3 + 4) *)
  inner = 语法器.做BinaryOp("+", 语法器.做IntLit(3), 语法器.做IntLit(4))
  expr2 = 语法器.做BinaryOp("*", 语法器.做IntLit(2), inner)
  result2 = 解释器.求值(expr2, env)
  [result2]

  (* 测试：三元 1 > 2 ? 100 : 200 *)
  cond = 语法器.做BinaryOp(">", 语法器.做IntLit(1), 语法器.做IntLit(2))
  expr3 = 语法器.做If(cond, 语法器.做IntLit(100), 语法器.做IntLit(200))
  result3 = 解释器.求值(expr3, env)
  [result3]

  (* 测试：变量绑定 + 求值 *)
  env2 = 解释器.绑定环境(env, "x", 10)
  expr4 = 语法器.做Variable("x")
  result4 = 解释器.求值(expr4, env2)
  [result4]

  (* 测试：Lambda + 应用 *)
  lam = 语法器.做Lambda(
    [语法器.做Variable("x")],
    语法器.做BinaryOp("+", 语法器.做Variable("x"), 语法器.做IntLit(1))
  )
  env3 = 解释器.绑定环境(env, "加一", 解释器.求值(lam, env))
  expr5 = 语法器.做FuncApp(语法器.做Variable("加一"), 语法器.做IntLit(5))
  result5 = 解释器.求值(expr5, env3)
  [result5]
}
