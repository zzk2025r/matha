(* Matha 示例 11：桌面应用（线下程序界面）开发 *)
(* 用 软件_构建 / 生成_桌面 编译出可运行的 Python Tkinter 桌面程序 *)
(* 支持 16 种控件、3 种布局（pack/grid/place）、窗口属性、事件处理 *)

(* 方式一：自主构建（从需求描述自动生成规格，经 codegen 编译） *)
？#：{
  【*/自主构建桌面应用：识别需求 >> 生成规格 >> 编译 Tkinter 成品/*】
  #：【推断类型】>>【生成规格】>>【编译桌面】
  报告 = 软件_构建 "记事本桌面应用"
  #：[报告]
}
#：【文件】

(* 方式二：自定义规格 + 生成_桌面（精确控制控件、布局、窗口属性） *)
规格 = 解析_JSON "[\"桌面\", \"控件演示\", [[\"h1\", \"控件演示\", [], []], [\"label\", \"姓名：\", [[\"row\", \"1\"], [\"col\", \"0\"]], []], [\"input\", \"\", [[\"row\", \"1\"], [\"col\", \"1\"], [\"width\", \"20\"]], []], [\"label\", \"性别：\", [[\"row\", \"2\"], [\"col\", \"0\"]], []], [\"radio\", \"男\", [[\"row\", \"2\"], [\"col\", \"1\"], [\"group\", \"sex\"], [\"value\", \"M\"]], []], [\"radio\", \"女\", [[\"row\", \"2\"], [\"col\", \"2\"], [\"group\", \"sex\"], [\"value\", \"F\"]], []], [\"label\", \"爱好：\", [[\"row\", \"3\"], [\"col\", \"0\"]], []], [\"checkbox\", \"阅读\", [[\"row\", \"3\"], [\"col\", \"1\"], [\"checked\", \"true\"]], []], [\"checkbox\", \"运动\", [[\"row\", \"3\"], [\"col\", \"2\"]], []], [\"label\", \"城市：\", [[\"row\", \"4\"], [\"col\", \"0\"]], []], [\"select\", \"\", [[\"row\", \"4\"], [\"col\", \"1\"], [\"options\", \"北京|上海|广州\"]], []], [\"label\", \"年龄：\", [[\"row\", \"5\"], [\"col\", \"0\"]], []], [\"slider\", \"\", [[\"row\", \"5\"], [\"col\", \"1\"], [\"min\", \"0\"], [\"max\", \"120\"]], []], [\"separator\", \"\", [[\"row\", \"6\"], [\"col\", \"0\"], [\"columnspan\", \"3\"]], []], [\"button\", \"提交\", [[\"row\", \"7\"], [\"col\", \"1\"], [\"onclick\", \"submit()\"]], []]], [[\"尺寸\", \"360x320\"], [\"可调整\", \"否\"]]]"

？#：{
  【*/自定义规格构建桌面应用：控件+布局+窗口属性精确控制/*】
  #：【解析规格】>>【编译 Tkinter】>>【输出 main.py】
  @：【输出控制】，类型="桌面"
  结果 = 生成_桌面 规格
  #：[结果]
}
#：【文件】
