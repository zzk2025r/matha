(* ============================================================
   Matha 标准库 — 纯 Matha 实现，零 Python 依赖
   ============================================================
   包含：
     - 字符串操作（ord / chr / len / 截取 / 拼接 / 替换 / 查找）
     - 列表操作（len / get / slice / append / concat / reverse / sort）
     - 字典操作（keys / values / has / size / get / put / set / remove / to_list / update / from_pairs）
     - 类型转换（int / float / str / bool）
     - 文件 I/O（read_file / write_file / append_file）
     - JSON 解析与序列化（简单实现）
     - 数学扩展（abs / floor / ceil / round / max / min / sum / pow / sqrt）
     - 工具函数（print / assert / range）
   ============================================================ *)

module 标准库 {

  (* ===== 字符串操作 ===== *)

  (* 字符串长度 len：基础原语，宿主/VM/原生三端内建均为真实 Unicode 长度。
     不可用 Matha 重定义——函数体内的 len(s) 会自引同名定义造成无限递归。 *)

  (* Unicode 码点 ↔ 字符：110 万码点无法纯 Matha 查表实现，
     委托宿主/VM/原生三端共有的 ord/chr 原语（与 _dict_keys 等 VM 原语同例）。
     命名 ord_matha/chr_matha 保持既有接口（interp.matha / interp_matha.matha 消费）；
     单字符校验与码点越界拒绝由原语承担（三端均真实拒绝）。
     旧 ASCII 查表占位已清除：ord_matha 对非 ASCII 曾静默返回 -1（探针实测）。 *)
  func ord_matha(c: String) -> Int = ord(c)

  func chr_matha(n: Int) -> String = chr(n)

  (* 字符串截取：截取(s, start, end) → 子串
     分块递归：块内 ≤24 字符（浅递归），块间按剩余长度推进（深度 ≈ n/24）。
     纯逐字符递归（_copy(i+1, acc+s[i])）在宿主面每字符耗一层 Python
     栈，~140 字符即撞 RecursionError——阶段 25c 应用中心引擎长请求体
     踩中后真化；语义与旧实现逐字节一致（含 start<0 时 Python 负下标
     回绕的历史行为）。 *)
  func 截取(s: String, start: Int, end: Int) -> String =
    let rec _拷(j: Int, 停: Int, acc: String) -> String =
      if j >= 停 then acc
      else _拷(j + 1, 停, acc + s[j])
    in
    let rec _块(i: Int, 剩: Int, acc: String) -> String =
      if 剩 <= 0 then acc
      else if 剩 < 24 then _块(i + 剩, 0, acc + _拷(i, i + 剩, ""))
      else _块(i + 24, 剩 - 24, acc + _拷(i, i + 24, ""))
    in
    if end <= start then ""
    else _块(start, end - start, "")

  (* 字符串拼接 *)
  func 拼接(a: String, b: String) -> String = a + b

  (* 字符串从 s[j] 起是否与 sub[k..] 匹配（k 为 sub 内偏移）*)
  func _str_eq_at(sub: String, s: String, j: Int, k: Int, sl: Int) -> Bool =
    if k >= sl then 真
    else if j >= len(s) then 假
    else if sub[k] != s[j] then 假
    else _str_eq_at(sub, s, j + 1, k + 1, sl)

  (* 字符串查找：find(sub, in_str) → 起始索引，未找到返回 -1 *)
  func find(sub: String, s: String) -> Int =
    let sl = len(sub) in
    let ll = len(s) in
    if sl = 0 or sl > ll then -1
    else
      let 上界 = ll - sl in
      let rec _段扫(i: Int, 停: Int) -> Int =
        if i > 停 or i > 上界 then -1
        else if _str_eq_at(sub, s, i, 0, sl) then i
        else _段扫(i + 1, 停)
      in
      let rec _大扫(窗起: Int) -> Int =
        if 窗起 > 上界 then -1
        else
          let 命中 = _段扫(窗起, 窗起 + 63) in
          if 命中 != -1 then 命中
          else _大扫(窗起 + 64)
      in _大扫(0)

  (* 字符串替换：replace(s, old, new) → 替换后的字符串 *)
  func replace(s: String, old: String, new_str: String) -> String =
    let ol = len(old) in
    let pos = find(old, s) in
    if pos = -1 then s
    else
      拼接(截取(s, 0, pos), 拼接(new_str, replace(截取(s, pos + ol, len(s)), old, new_str)))

  (* 字符串分割：split(s, sep) → 字符串列表 *)
  func split(s: String, sep: String) -> List =
    let sl = len(sep) in
    let rec _split(i: Int, parts: List) -> List =
      if i >= len(s) then parts + [截取(s, i, len(s))]
      else
        let pos = find(sep, 截取(s, i, len(s))) in
        if pos = -1 then parts + [截取(s, i, len(s))]
        else _split(i + pos + sl, parts + [截取(s, i, i + pos)])
    in _split(0, [])

  (* 字符串转小写 *)
  func to_lower(s: String) -> String =
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" in
    let lower = "abcdefghijklmnopqrstuvwxyz" in
    let rec _map(i: Int, acc: String) -> String =
      if i >= len(s) then acc
      else
        let c = s[i] in
        let idx = find(c, upper) in
        if idx = -1 then _map(i + 1, acc + c)
        else _map(i + 1, acc + lower[idx])
    in _map(0, "")

  (* 字符串转大写 *)
  func to_upper(s: String) -> String =
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" in
    let lower = "abcdefghijklmnopqrstuvwxyz" in
    let rec _map(i: Int, acc: String) -> String =
      if i >= len(s) then acc
      else
        let c = s[i] in
        let idx = find(c, lower) in
        if idx = -1 then _map(i + 1, acc + c)
        else _map(i + 1, acc + upper[idx])
    in _map(0, acc)

  (* 去除空白 *)
  func strip(s: String) -> String =
    let ws = " \t\n\r" in
    let rec _lstrip(i: Int) -> Int =
      if i >= len(s) then i
      else if find(s[i], ws) != -1 then _lstrip(i + 1)
      else i
    in
    let rec _rstrip(i: Int) -> Int =
      if i < 0 then -1
      else if find(s[i], ws) != -1 then _rstrip(i - 1)
      else i
    in
    let start = _lstrip(0) in
    let end_pos = _rstrip(len(s) - 1) in
    if start > end_pos then ""
    else 截取(s, start, end_pos + 1)

  (* 字符串重复 *)
  func repeat(s: String, n: Int) -> String =
    if n <= 0 then ""
    else 拼接(s, repeat(s, n - 1))

  (* ===== 列表操作 ===== *)

  (* 列表长度（通用）*)
  func list_len(lst: List) -> Int =
    let rec _count(i: Int, n: Int) -> Int =
      if i >= len(lst) then n
      else _count(i + 1, n + 1)
    in _count(0, 0)

  (* 列表取元素 *)
  func list_get(lst: List, idx: Int) -> Value =
    if idx < 0 or idx >= len(lst) then 错误("列表索引越界: " + 标准库.str(idx))
    else lst[idx]

  (* 列表切片 *)
  func list_slice(lst: List, start: Int, end: Int) -> List =
    let rec _copy(i: Int, acc: List) -> List =
      if i >= end or i >= len(lst) then acc
      else _copy(i + 1, acc + [lst[i]])
    in _copy(start, [])

  (* 追加元素 *)
  func list_append(lst: List, elem) -> List = lst + [elem]

  (* 列表拼接 *)
  func list_concat(a: List, b: List) -> List = a + b

  (* 列表反转 *)
  func list_reverse(lst: List) -> List =
    let rec _rev(i: Int, acc: List) -> List =
      if i < 0 then acc
      else _rev(i - 1, acc + [lst[i]])
    in _rev(len(lst) - 1, [])

  (* 列表原位设置：返回把 idx 位置替换为 v 的新列表 *)
  func list_set_at(lst: List, idx: Int, v) -> List =
    let rec _set(i: Int, acc: List) -> List =
      if i >= len(lst) then acc
      else if i = idx then _set(i + 1, acc + [v])
      else _set(i + 1, acc + [lst[i]])
    in _set(0, [])

  (* ===== 原地修改（唯一可变原语） =====

     原地设置：直接修改 lst 的第 idx 个元素为 v，返回 lst 本身。
     委托 VM/宿主内建 mut_set_at——递归绑定（let rec / and 互递归）的
     「占位符 + 原地更新」策略依赖此原语：env 为 CONS 共享的
     [[name, value], ...] 结构，对共享 pair 的原地修改对所有捕获该
     env 的闭包同步可见（语义等价宿主 _RecPlaceholder 的可变引用）。 *)
  func 原地设置(lst: List, idx: Int, v) -> List =
    mut_set_at(lst, idx, v)

  (* 列表相邻交换：交换 i 与 i+1 两个位置 *)
  func list_swap(arr: List, i: Int) -> List =
    list_set_at(list_set_at(arr, i, arr[i + 1]), i + 1, arr[i])

  (* 列表排序（冒泡）*)
  func list_sort(lst: List) -> List =
    let n = len(lst) in
    if n <= 1 then lst
    else
      let rec _pass(i: Int, swapped: Bool, arr: List) -> List =
        if i >= n - 1 then
          if swapped then _pass(0, 假, arr)
          else arr
        else if arr[i] > arr[i + 1] then
          _pass(i + 1, 真, list_swap(arr, i))
        else _pass(i + 1, swapped, arr)
      in _pass(0, 假, lst)

  (* 列表包含 *)
  func list_contains(lst: List, elem) -> Bool =
    let rec _search(i: Int) -> Bool =
      if i >= len(lst) then 假
      else if lst[i] = elem then 真
      else _search(i + 1)
    in _search(0)

  (* 列表最大值 *)
  func list_max(lst: List) -> Value =
    if len(lst) = 0 then 错误("list_max: 空列表")
    else
      let rec _max(i: Int, best) -> Value =
        if i >= len(lst) then best
        else if lst[i] > best then _max(i + 1, lst[i])
        else _max(i + 1, best)
      in _max(1, lst[0])

  (* 列表最小值 *)
  func list_min(lst: List) -> Value =
    if len(lst) = 0 then 错误("list_min: 空列表")
    else
      let rec _min(i: Int, best) -> Value =
        if i >= len(lst) then best
        else if lst[i] < best then _min(i + 1, lst[i])
        else _min(i + 1, best)
      in _min(1, lst[0])

  (* 列表求和（33-⑥：累加器 0 起——空表返 Int 0、全整数和返 Int，
     对齐宿主 sum([])=0 / sum([1,2])=3；非 0.0 起避免 0.0+… 浮点化） *)
  func list_sum(lst: List) -> Value =
    let rec _sum(i: Int, acc: Value) -> Value =
      if i >= len(lst) then acc
      else _sum(i + 1, acc + lst[i])
    in _sum(0, 0)

  (* 列表映射：list_map(lst, f) → [f(x0), f(x1), ...]——纯 Matha，
     不委托宿主 映射 内建（自举链可用）。f 为单参函数值；空列表返回 []。 *)
  func list_map(lst: List, f) -> List =
    let rec _map(i: Int, acc: List) -> List =
      if i >= len(lst) then acc
      else _map(i + 1, acc + [f(lst[i])])
    in _map(0, [])

  (* 左折叠：list_fold(lst, init, f) → f(...f(f(init, x0), x1)...)——纯 Matha。
     f 为二元函数值（柯里化 f(acc)(x)）；空列表返回 init。 *)
  func list_fold(lst: List, init, f) -> Value =
    let rec _fold(i: Int, acc: Value) -> Value =
      if i >= len(lst) then acc
      else _fold(i + 1, f(acc, lst[i]))
    in _fold(0, init)

  (* ===== 字典操作 =====

     VM 提供最小原语 _dict_keys / _dict_values / _dict_has / _dict_put /
     _dict_remove（纯 Matha 无法实现——无对应操作码）。以下为公共 API：
     直接委托原语的薄包装 + 用 Matha 实现的高层组合函数。 *)

  (* 字典键列表——委托 VM 原语 *)
  func dict_keys(d: Dict) -> List =
    _dict_keys(d)

  (* keys(d)：M5 计划命名的键列表入口，等价 dict_keys。
     两套名字并存：dict_* 与本模块既有命名（dict_get/dict_put）成组，
     计划书另点名 keys/values，故提供短名别名以对齐对外 API。 *)
  func keys(d: Dict) -> List =
    _dict_keys(d)

  (* 字典值列表——委托 VM 原语 *)
  func dict_values(d: Dict) -> List =
    _dict_values(d)

  func values(d: Dict) -> List =
    _dict_values(d)

  (* 字典是否含键——委托 VM 原语 *)
  func dict_has(d: Dict, k: Value) -> Bool =
    _dict_has(d, k)

  (* 字典大小——纯 Matha：键列表长度 *)
  func dict_size(d: Dict) -> Int =
    len(_dict_keys(d))

  (* 安全取值：有键返回 d[k]，无键返回 fallback——纯 Matha。
     先 _dict_has 再 d[k]：VM 无「带默认值取键」原语，且直接 d[k] 缺键会抛错。 *)
  func dict_get(d: Dict, k: Value, fallback: Value) -> Value =
    if _dict_has(d, k) then d[k] else fallback

  (* 不可变设置：返回含 k→v 的新字典——委托 VM 原语 *)
  func dict_put(d: Dict, k: Value, v: Value) -> Dict =
    _dict_put(d, k, v)

  (* dict_set(d, k, v)：M5 计划命名的不可变设置入口，等价 dict_put。
     语义是「返回新字典」而非原地改——Matha 值不可变，原字典不受影响。 *)
  func dict_set(d: Dict, k: Value, v: Value) -> Dict =
    _dict_put(d, k, v)

  (* 不可变删除：返回不含 k 的新字典——委托 VM 原语 *)
  func dict_remove(d: Dict, k: Value) -> Dict =
    _dict_remove(d, k)

  (* 字典 → [[键, 值], ...] 列表——纯 Matha：拉链合并键值列表。
     注意：用嵌套列表 [[k, v]] 而非元组 [(k, v)]——函数应用语境中
     (a, b) 会被解析器当作多参调用只取首参。 *)
  func dict_to_list(d: Dict) -> List =
    let keys = _dict_keys(d) in
    let vals = _dict_values(d) in
    let rec _zip(i: Int, acc: List) -> List =
      if i >= len(keys) then acc
      else _zip(i + 1, acc + [[keys[i], vals[i]]])
    in _zip(0, [])

  (* 合并字典：overrides 覆盖 base 同键——纯 Matha：折叠 _dict_put *)
  func dict_update(base: Dict, overrides: Dict) -> Dict =
    let keys = _dict_keys(overrides) in
    let rec _merge(i: Int, acc: Dict) -> Dict =
      if i >= len(keys) then acc
      else _merge(i + 1, _dict_put(acc, keys[i], overrides[keys[i]]))
    in _merge(0, base)

  (* 由 [(键, 值), ...] 列表构建字典——纯 Matha：折叠 _dict_put。
     注意：{} 在 Matha 语法中为空集合构造（SetConstruct），非空字典，
     故用 VM 提供的 _empty_dict 常量作为初始值。 *)
  func dict_from_pairs(pairs: List) -> Dict =
    let rec _build(i: Int, acc: Dict) -> Dict =
      if i >= len(pairs) then acc
      else
        let pair = pairs[i] in
        _build(i + 1, _dict_put(acc, pair[0], pair[1]))
    in _build(0, _empty_dict)

  (* ===== 类型转换 ===== *)

  (* 字符串 → 整数 *)
  func int(s: String) -> Int =
    if matha_type_of(s) = "Int" then s
    else if matha_type_of(s) = "Float" then _to_int(s)
    else
    let s = strip(s) in
    if len(s) = 0 then 错误("int(): 空字符串")
    else
      let neg = (s[0] = "-") in
      let digits = if neg then 截取(s, 1, len(s)) else s in
      let rec _parse(i: Int, acc: Int) -> Int =
        if i >= len(digits) then acc
        else
          let c = digits[i] in
          if c >= "0" and c <= "9" then
            _parse(i + 1, acc * 10 + (ord(c) - ord("0")))
          else 错误("int(): 非法字符 '" + c + "'")
      in
      let result = _parse(0, 0) in
      if neg then -result else result

  (* 字符串 → 浮点数（数值入参直接做类型转换；支持科学计数法 e/E）。
     采用大整数缩放实现【正确舍入】：把全部有效数字拼成整数 digits，
     再按十进制指数 k = exp - 小数位 施加。k ≥ 0 时 digits * 10^k 为精确
     大整数，× 1.0 一次舍入；k < 0 时 digits / 10^(-k) 为整数真除法，
     同样一次舍入。故与宿主 float() 逐位一致——不再用 pow(10.0, n)（对
     |n| > 22 不精确）。 *)
  func float(s: String) -> Float =
    if matha_type_of(s) = "Float" then s
    else if matha_type_of(s) = "Int" then s * 1.0
    else
    let s = strip(s) in
    if len(s) = 0 then 错误("float(): 空字符串")
    else
      let neg = (s[0] = "-") in
      let body = if neg then 截取(s, 1, len(s)) else s in
      let epos = _指数位置(body) in
      let mant = if epos >= 0 then 截取(body, 0, epos) else body in
      let exp = if epos >= 0 then _指数值(截取(body, epos + 1, len(body))) else 0 in
      let v = _十进制转浮点(mant, exp) in
      if neg then -v else v

  func _指数位置(s: String) -> Int =
    let rec _go(i: Int) -> Int =
      if i >= len(s) then -1
      else if s[i] = "e" or s[i] = "E" then i
      else _go(i + 1)
    in _go(0)

  func _指数值(s: String) -> Int =
    if len(s) = 0 then 0
    else if s[0] = "+" then int(截取(s, 1, len(s)))
    else int(s)

  func _十进制转浮点(mant: String, exp: Int) -> Float =
    let dot_pos = find(".", mant) in
    let int_part = if dot_pos = -1 then mant else 截取(mant, 0, dot_pos) in
    let frac_part = if dot_pos = -1 then "" else 截取(mant, dot_pos + 1, len(mant)) in
    let frac = len(frac_part) in
    let digits_str = int_part + frac_part in
    let digits = if digits_str = "" then 0 else int(digits_str) in
    let k = exp - frac in
    if k >= 0 then digits * (10 ** k) * 1.0
    else digits / (10 ** (0 - k))

  (* 数值 → 字符串；32d 通用化：容器/布尔/null/函数渲染对齐宿主 str
     （Python str 形态——Bool→True/False、null→None、列表 [a, b]、
     元组 (a, b)（单元素尾逗号 (a,)）、字典 {'k': v}、容器内字符串 repr
     引号转义；vm.matha 函数str 同构镜像）。28-⑨「stdlib str 数字专用」退役。 *)
  func str(n) -> String =
    if matha_type_of(n) = "Int" then
      let rec _digits(x: Int, acc: String) -> String =
        if x = 0 then acc
        else _digits(x // 10, chr(ord("0") + (x % 10)) + acc)
      in
      if n < 0 then "-" + _digits(-n, "")
      else if n = 0 then "0"
      else _digits(n, "")
    else if matha_type_of(n) = "Float" then
      let rec _fmt_float(x: Float, acc: String, precision: Int) -> String =
        if precision = 0 then acc
        else
          let digit = int(x * 10.0) in
          let remainder = x * 10.0 - float(digit) in
          _fmt_float(remainder, acc + chr(ord("0") + digit), precision - 1)
      in
      let rec _trim0(s: String) -> String =
        if s = "" then ""
        else if s[len(s) - 1] = "0" then _trim0(截取(s, 0, len(s) - 1))
        else s
      in
      let i = int(n) in
      let frac = n - float(i) in
      let frac_str = _trim0(_fmt_float(abs(frac), "", 6)) in
      if frac_str = "" then str(i) + ".0"
      else str(i) + "." + frac_str
    else if matha_type_of(n) = "Bool" then
      if n then "True" else "False"
    else if n = null then "None"
    else if matha_type_of(n) = "String" then n
    else if matha_type_of(n) = "List" and len(n) > 0 and n[0] = "__closure__" then
      (* 自举闭包是 Matha 列表 ["__closure__",...]，宿主 type_of 判 "List"，
         且捕获环境自引用（全局 env 原地含自身）——按闭包形态守卫先行，
         与 boot 输出归一（interp_matha 可调用三形态）同哨兵。 *)
      "<function>"
    else if matha_type_of(n) = "List" then 列表转串(n)
    else if matha_type_of(n) = "Tuple" then 元组转串(n)
    else if matha_type_of(n) = "Dict" then 字典转串(n)
    else if matha_type_of(n) = "Function" then "<function>"
    else
      "<?>?"

  (* 容器渲染 helper 族（32d，vm.matha 函数str 镜像）：CPython str 形态，
     容器内字符串按 repr 规则加引号转义，容器递归。 *)
  func 列表转串(xs: List) -> String =
    "[" + 列表元素串(xs, 0) + "]"

  func 列表元素串(xs: List, i: Int) -> String =
    if i >= len(xs) then ""
    else
      let 前置 = if i = 0 then "" else ", " in
      前置 + 元素repr(xs[i]) + 列表元素串(xs, i + 1)

  (* 元组渲染：CPython str(tuple) 形态——() / (a,) 单元素尾逗号 / (a, b)。 *)
  func 元组转串(ts) -> String =
    if len(ts) = 0 then "()"
    else if len(ts) = 1 then "(" + 元素repr(ts[0]) + ",)"
    else "(" + 元组元素串(ts, 0) + ")"

  func 元组元素串(ts, i: Int) -> String =
    if i >= len(ts) then ""
    else
      let 前置 = if i = 0 then "" else ", " in
      前置 + 元素repr(ts[i]) + 元组元素串(ts, i + 1)

  func 字典转串(d) -> String =
    "{" + 字典元素串(d, _dict_keys(d), 0) + "}"

  func 字典元素串(d, 键们: List, i: Int) -> String =
    if i >= len(键们) then ""
    else
      let k = 键们[i] in
      let 前置 = if i = 0 then "" else ", " in
      前置 + 元素repr(k) + ": " + 元素repr(d[k]) + 字典元素串(d, 键们, i + 1)

  (* 容器元素的 CPython repr 形态：字符串引号+转义，其余同 str（容器递归）。 *)
  func 元素repr(x) -> String =
    if matha_type_of(x) = "String" then 串repr(x)
    else str(x)

  (* 智能引号：仅含 ' 而无 " 时用双引号包裹（CPython repr 规则）。 *)
  func 串repr(s: String) -> String =
    if 含字符(s, "'", 0) and not 含字符(s, "\"", 0) then
      "\"" + 转义串(s, 0, 真) + "\""
    else
      "'" + 转义串(s, 0, 假) + "'"

  func 含字符(s: String, c: String, i: Int) -> Bool =
    if i >= len(s) then 假
    else if s[i] = c then 真
    else 含字符(s, c, i + 1)

  func 转义串(s: String, i: Int, 用双: Bool) -> String =
    if i >= len(s) then ""
    else 转义字符(s[i], 用双) + 转义串(s, i + 1, 用双)

  func 转义字符(c: String, 用双: Bool) -> String =
    if c = "\\" then "\\\\"
    else if 用双 and c = "\"" then "\\\""
    else if not 用双 and c = "'" then "\\'"
    else if c = "\n" then "\\n"
    else if c = "\r" then "\\r"
    else if c = "\t" then "\\t"
    else if 是控制码(ord(c)) then 控制转串(ord(c))
    else c

  func 是控制码(o: Int) -> Bool =
    o < 32 or o = 127 or (o >= 128 and o <= 159)

  func 控制转串(o: Int) -> String =
    "\\x" + 十六进制位(o // 16) + 十六进制位(o % 16)

  func 十六进制位(d: Int) -> String =
    "0123456789abcdef"[d]

  (* 判断是否为数字/字符串/列表/字典：matha_type_of 直判（32d——str 通用化
     后 "<?>?" 哨兵启发式失效，改类型直判）。 *)
  func _is_number(v) -> Bool =
    matha_type_of(v) = "Int" or matha_type_of(v) = "Float"

  (* 安全字符串转换：Bool/null 返回 "<?>?"，其余 str 渲染 *)
  func str_safe(n) -> String =
    if n = 真 or n = 假 or n = null then "<?>?"
    else str(n)

  func _is_string(v) -> Bool = matha_type_of(v) = "String"

  func _is_list(v) -> Bool = matha_type_of(v) = "List"

  func _is_dict(v) -> Bool = matha_type_of(v) = "Dict"

  (* 获取值类型名称——委托 VM 内建 type_of（Python 层直接类型判定），
     避免 stdlib 纯 Matha 字符串启发式实现与 str 互相调用死循环。*)
  func matha_type_of(v) -> String = type_of(v)

  (* 由数值取其整数部分（向零取整）。用于 matha_type_of 区分 Int/Float。
     不依赖 str/int 内建，避免引入循环。*)
  func int_of_num(v) -> Int =
    if v >= 0 then _floor_pos(v, 0) else -_floor_pos(-v, 0)

  func _floor_pos(v: Float, acc: Int) -> Int = (v, acc) =>
    (v < 1.0) ? acc :
    (v < 10.0) ? (acc * 10 + _digit(v / 1.0)) :
    _floor_pos(v / 10.0, acc * 10 + _digit(v / 10.0))

  func _digit(v: Float) -> Int = int(v % 10)

  (* ===== 文件 I/O =====

     委托 VM 内建 _read_file / _write_file / _append_file——文件系统访问
     是 OS 级能力，纯 Matha 无法实现。命名加 _ 前缀避免与 stdlib 公共
     API 同名遮蔽（同 mut_set_at / 原地设置 模式）。 *)

  func read_file(path: String) -> String =
    _read_file(path)

  func write_file(path: String, content: String) -> None =
    _write_file(path, content)

  func append_file(path: String, content: String) -> None =
    _append_file(path, content)

  (* ===== JSON 简单解析 ===== *)

  (* 解析 JSON 字符串（支持数字、字符串、布尔、null、数组、对象）。
     互递归辅助函数全部提升为模块顶层 func——自举 parser 不支持 let rec ... and ...，
     且 s 通过参数显式传递。 *)
  func _json_skip_ws(s: String, pos: Int) -> Int =
    if pos < len(s) and (s[pos] = " " or s[pos] = "\t" or s[pos] = "\n" or s[pos] = "\r") then
      _json_skip_ws(s, pos + 1)
    else pos

  func _json_literal(s: String, start: Int, lit: String, val) -> (Value, Int) =
    if 截取(s, start, start + len(lit)) = lit then
      (val, start + len(lit))
    else 错误("JSON 解析错误: 期望 '" + lit + "'")

  func _json_string(s: String, start: Int) -> (Value, Int) =
    if s[start] != "\"" then 错误("JSON 解析错误: 期望字符串")
    else
      let rec _collect(i: Int, acc: String) -> (String, Int) =
        if i >= len(s) then 错误("JSON 解析错误: 未终止字符串")
        else if s[i] = "\"" then (acc, i + 1)
        else _collect(i + 1, acc + s[i])
      in
      let (str_val, end_pos) = _collect(start + 1, "") in
      (str_val, end_pos)

  func _json_number(s: String, start: Int) -> (Value, Int) =
    let rec _scan(i: Int) -> Int =
      if i >= len(s) then i
      else if (s[i] >= "0" and s[i] <= "9") or s[i] = "." or s[i] = "e" or s[i] = "E" or s[i] = "+" or s[i] = "-" then _scan(i + 1)
      else i
    in
    let end_pos = _scan(start) in
    let num_str = 截取(s, start, end_pos) in
    if find(".", num_str) != -1 or find("e", num_str) != -1 or find("E", num_str) != -1 then
      (float(num_str), end_pos)
    else
      (int(num_str), end_pos)

  func _json_array(s: String, start: Int) -> (Value, Int) =
    if s[start] != "[" then 错误("JSON 解析错误: 期望 [")
    else
      let rec _parse_items(pos: Int, items: List) -> (List, Int) =
        let pos = _json_skip_ws(s, pos) in
        if pos >= len(s) or s[pos] = "]" then (items, pos + 1)
        else
          let (val, pos2) = _json_value(s, pos) in
          let pos2 = _json_skip_ws(s, pos2) in
          if pos2 < len(s) and s[pos2] = "," then
            _parse_items(pos2 + 1, items + [val])
          else _parse_items(pos2, items + [val])
      in
      let (items, end_pos) = _parse_items(start + 1, []) in
      (items, end_pos)

  func _json_object(s: String, start: Int) -> (Value, Int) =
    if s[start] != "{" then 错误("JSON 解析错误: 期望 {")
    else
      let rec _parse_entries(pos: Int, entries: List) -> (List, Int) =
        let pos = _json_skip_ws(s, pos) in
        if pos >= len(s) or s[pos] = "}" then (entries, pos + 1)
        else
          let (key, pos2) = _json_string(s, pos) in
          let pos2 = _json_skip_ws(s, pos2) in
          if pos2 >= len(s) or s[pos2] != ":" then 错误("JSON 解析错误: 期望 :")
          else
            let (val, pos3) = _json_value(s, pos2 + 1) in
            let pos3 = _json_skip_ws(s, pos3) in
            if pos3 < len(s) and s[pos3] = "," then
              _parse_entries(pos3 + 1, entries + [[key, val]])
            else _parse_entries(pos3, entries + [[key, val]])
      in
      let (entries, end_pos) = _parse_entries(start + 1, []) in
      (entries, end_pos)

  func _json_value(s: String, start: Int) -> (Value, Int) =
    if start >= len(s) then (错误("JSON 解析错误: 意外结束"), start)
    else
      let c = s[start] in
      if c = "{" then _json_object(s, start)
      else if c = "[" then _json_array(s, start)
      else if c = "\"" then _json_string(s, start)
      else if c = "t" then _json_literal(s, start, "true", 真)
      else if c = "f" then _json_literal(s, start, "false", 假)
      else if c = "n" then _json_literal(s, start, "null", null)
      else if c = "-" or (c >= "0" and c <= "9") then _json_number(s, start)
      else 错误("JSON 解析错误: 意外字符 '" + c + "'")

  (* 解析 JSON 字符串入口 *)
  func parse_JSON(s: String) -> Value =
    let s = strip(s) in
    if len(s) = 0 then 错误("parse_JSON: 空字符串")
    else
      let (result, _end) = _json_value(s, 0) in
      result

  (* ===== 工具函数 ===== *)

  (* 打印到输出 *)
  func print(val: Value) -> None =
    错误("[Matha Print] " + 标准库.str(val))

  (* 范围生成：range(start, end) → 列表 *)
  func range(start: Int, end_pos: Int) -> List =
    let rec _gen(i: Int, acc: List) -> List =
      if i >= end_pos then acc
      else _gen(i + 1, acc + [i])
    in _gen(start, [])

  (* 断言 *)
  func assert(cond: Bool, msg: String) -> None =
    if not cond then 错误("assertion failed: " + msg)

  (* 枚举列表：enumerate(lst) → [[index, value], ...] *)
  func enumerate(lst: List) -> List =
    let rec _enum(i: Int, acc: List) -> List =
      if i >= len(lst) then acc
      else _enum(i + 1, acc + [[i, lst[i]]])
    in _enum(0, [])

  (* ===== 内建函数表 ===== *)
  let 内建 = {
    "ord": ord,
    "chr": chr,
    "len": len,
    "list_len": list_len,
    "list_map": list_map,
    "list_fold": list_fold,
    "get": func_get,
    "slice": func_slice,
    "append": func_append,
    "concat": list_concat,
    "reverse": list_reverse,
    "sort": list_sort,
    "max": list_max,
    "min": list_min,
    "sum": list_sum,
    "int": int,
    "float": float,
    "str": str,
    "type_of": matha_type_of,
    "read_file": read_file,
    "write_file": write_file,
    "append_file": append_file,
    "dict_keys": dict_keys,
    "dict_values": dict_values,
    "keys": keys,
    "values": values,
    "dict_has": dict_has,
    "find": find,
    "dict_size": dict_size,
    "dict_get": dict_get,
    "dict_put": dict_put,
    "dict_set": dict_set,
    "dict_remove": dict_remove,
    "dict_to_list": dict_to_list,
    "dict_update": dict_update,
    "dict_from_pairs": dict_from_pairs,
    "parse_JSON": parse_JSON,
    "print": print,
    "range": range,
    "assert": assert,
    "enumerate": enumerate,
    "strip": strip,
    "to_lower": to_lower,
    "to_upper": to_upper,
    "replace": replace,
    "split": split,
    "repeat": repeat,
    "concat_str": 拼接,
    "concat_list": list_concat,
    "原地设置": 原地设置,
  }

  (* get 和 slice 的柯里化版本 *)
  func func_get(seq) -> Value = (seq) =>
    (idx) => list_get(seq, int(idx))

  func func_slice(seq) -> Value = (seq) =>
    (start) => (end_pos) => list_slice(seq, int(start), int(end_pos))

  func func_append(lst) -> Value = (lst) =>
    (elem) => list_append(lst, elem)

  (* ===== ？公式模式库 helpers（29c，src/formula_schema.py 纯 Matha 镜像）=====
     逐字节同源目标：公式_形状↔shape、公式_渲染↔render、公式_收集槽位↔collect_slots、
     公式_含槽↔has_slot、公式_合一↔unify、公式_实例化↔instantiate、公式_登记↔register、
     公式_匹配↔match。AST 节点为 bootstrap parser dict（"类型"/中文键）。
     浮点串走「最短小数位往返」（k 递增至 17，round(v*10^k)/10^k = v 即取）——
     与 Python repr 在常规量程一致；|v|<1e-4 与 ≥1e16 科学计数区诚实分歧
     （登记不修，测试档 docstring 记边界）。 *)
  func 公式_整串(v) -> String = str(int(v))

  func 公式_十幂(k: Int) -> Float =
    k = 0 ? 1.0 : 10.0 * 公式_十幂(k - 1)

  func 公式_前零(n: Int) -> String =
    n = 0 ? "" : "0" + 公式_前零(n - 1)

  (* 整数 scaled 按 k 位小数落点：负号 + 整部 + "." + 尾部（前导补零） *)
  func 公式_定点串(scaled: Int, k: Int) -> String =
    scaled < 0 ? "-" + 公式_定点串(-scaled, k) :
    let s = str(scaled) in
    k = 0 ? s :
    len(s) > k ?
      截取(s, 0, len(s) - k) + "." + 截取(s, len(s) - k, len(s)) :
      "0." + 公式_前零(k - len(s)) + s

  func 公式_浮点串走(v: Float, k: Int) -> String =
    k > 17 ? str(v) :
    let p = 公式_十幂(k) in
    let scaled = round(v * p) in
    scaled / p = v ? 公式_定点串(scaled, k) : 公式_浮点串走(v, k + 1)

  func 公式_浮点串(v: Float) -> String =
    v = int(v) ? str(int(v)) + ".0" : 公式_浮点串走(v, 0)

  (* Python repr 的引号规则：串含 ' 且不含 " → 双引号包裹，否则单引号。
     转义序列不在同源面（登记不修）。 *)
  func 公式_含字符(s: String, c: String) -> Bool = find(c, s) >= 0

  (* 引号字符经 chr 构造：宿主解析器 func 体首 `( 被括号化 lambda 形态
     （(params) => expr）抢占（parser.py:4184），含引号串字面量随体首括号
     一并不可用——条件先行去括号即避开；chr 构造绕开字面量面（登记不修 29f）。 *)
  func 公式_单引号() -> String = chr(39)
  func 公式_双引号() -> String = chr(34)

  func 公式_引串(s: String) -> String =
    公式_含字符(s, 公式_单引号()) and not 公式_含字符(s, 公式_双引号()) ?
      公式_双引号() + s + 公式_双引号() : 公式_单引号() + s + 公式_单引号()

  (* 左到右孩子序（formula_schema._children 同构；属于单列因宿主 _collect 特判） *)
  func 公式_孩子(e) -> List =
    e["类型"] = "二元运算" ? [e["左"], e["右"]] :
    e["类型"] = "一元运算" ? [e["操作数"]] :
    e["类型"] = "尖括号" ? [e["内"]] :
    e["类型"] = "属于" ? [e["左"], e["右"]] :
    e["类型"] = "列表" or e["类型"] = "元组" ? e["元素"] :
    e["类型"] = "下标" ? [e["容器"], e["索引"]] :
    e["类型"] = "函数应用" ? [e["函数"], e["参数"]] :
    e["类型"] = "if" ? [e["条件"], e["真分支"], e["假分支"]] :
    []

  func 公式_孩子走(items: List, 计数: List, 走) -> String =
    items = [] ? "" :
    items[1:] = [] ? 走(items[0]) :
    走(items[0]) + "," + 公式_孩子走(items[1:], 计数, 走)

  func 公式_逗串(items: List, 计数: List) -> String =
    items = [] ? "" :
    items[1:] = [] ? 公式_形状走(items[0], 计数) :
    公式_形状走(items[0], 计数) + "," + 公式_逗串(items[1:], 计数)

  func 公式_兜底形状(e, 计数: List) -> String =
    let t = e["类型"] in
    t = "函数应用" ?
      "FuncApp(" + 公式_形状走(e["函数"], 计数) + "," + 公式_形状走(e["参数"], 计数) + ")" :
    t = "if" ?
      "IfExpr(" + 公式_形状走(e["条件"], 计数) + "," + 公式_形状走(e["真分支"], 计数) + ","
      + 公式_形状走(e["假分支"], 计数) + ")" :
    (* 其余节点（属性/安全路径/切片/集合构造/typeof…）诚实裸名——
       宿主走 _children 兜底 "TypeName(kids)"，bootstrap 无对应键面，
       语料零命中；分歧登记不修 *)
    t

  func 公式_形状走(e, 计数: List) -> String =
    e["类型"] = "二元运算" ?
      "(" + 公式_形状走(e["左"], 计数) + " " + e["运算符"] + " "
      + 公式_形状走(e["右"], 计数) + ")" :
    e["类型"] = "一元运算" ?
      "(" + e["运算符"] + " " + 公式_形状走(e["操作数"], 计数) + ")" :
    e["类型"] = "变量" ?
      e["是占位"] ?
        (e["名"] = "？" ?
          let n = 计数[0] + 1 in
          let 忽略 = 原地设置(计数, 0, n) in
          "_" + 公式_整串(n) :
          ":" + e["名"]) :
        e["名"] :
    e["类型"] = "整数" ? "i" + 公式_整串(e["值"]) :
    e["类型"] = "浮点" ? "f" + 公式_浮点串(e["值"]) :
    e["类型"] = "字符串" ? "s" + 公式_引串(e["值"]) :
    e["类型"] = "布尔" ? (e["值"] = 真 ? "bTrue" : "bFalse") :
    e["类型"] = "尖括号" ? "angle(" + 公式_形状走(e["内"], 计数) + ")" :
    e["类型"] = "属于" ?
      "in(" + 公式_形状走(e["左"], 计数) + "," + 公式_形状走(e["右"], 计数) + ")" :
    e["类型"] = "列表" ? "ListLiteral[" + 公式_逗串(e["元素"], 计数) + "]" :
    e["类型"] = "元组" ? "TupleExpr[" + 公式_逗串(e["元素"], 计数) + "]" :
    e["类型"] = "下标" ?
      "idx(" + 公式_形状走(e["容器"], 计数) + "," + 公式_形状走(e["索引"], 计数) + ")" :
    公式_兜底形状(e, 计数)

  func 公式_形状(e) -> String = 公式_形状走(e, [0])

  func 公式_收集孩子(items: List, 计数: List, acc: List) -> List =
    items = [] ? acc :
    公式_收集孩子(items[1:], 计数, 公式_收集走(items[0], 计数, acc))

  func 公式_收集走(e, 计数: List, acc: List) -> List =
    e["类型"] = "变量" ?
      e["是占位"] ?
        (e["名"] = "？" ?
          let n = 计数[0] + 1 in
          let 忽略 = 原地设置(计数, 0, n) in
          acc + [[n, "", "？"]] :
          acc + [[0, e["名"], "？" + e["名"]]]) :
      acc :
    e["类型"] = "属于" ?
      let a1 = 公式_收集走(e["左"], 计数, acc) in
      公式_收集走(e["右"], 计数, a1) :
    公式_收集孩子(公式_孩子(e), 计数, acc)

  func 公式_收集槽位(e) -> List = 公式_收集走(e, [0], [])

  func 公式_含槽孩子(items: List) -> Bool =
    items = [] ? 假 : (公式_含槽(items[0]) or 公式_含槽孩子(items[1:]))

  func 公式_含槽(e) -> Bool =
    e["类型"] = "变量" ? e["是占位"] :
    e["类型"] = "属于" ? (公式_含槽(e["左"]) or 公式_含槽(e["右"])) :
    公式_含槽孩子(公式_孩子(e))

  (* —— 合一：槽可绑任意具体子式；具名槽跨出现按 渲染 相等强制一致；
     匿名槽每次出现独立、槽不与槽合一（formula_schema._unify 同构）—— *)
  func 公式_合一走(s, c, 计数: List, b: Dict) -> Value =
    s["类型"] = "变量" ?
      (not s["是占位"]) ?
        ((c["类型"] = "变量" and c["名"] = s["名"]) ? b : null) :
      s["名"] = "？" ?
        (c["类型"] = "变量" and c["是占位"]) ? null :
        let n = 计数[0] + 1 in
        let 忽略 = 原地设置(计数, 0, n) in
        dict_put(b, "?" + 公式_整串(n), c) :
        let k = ":" + s["名"] in
        let prev = dict_get(b, k, null) in
        prev != null ?
          (公式_渲染(prev) = 公式_渲染(c) ? b : null) :
          dict_put(b, k, c) :
    s["类型"] = "二元运算" ?
      (c["类型"] = "二元运算" and c["运算符"] = s["运算符"]) ?
        let b1 = 公式_合一走(s["左"], c["左"], 计数, b) in
        b1 != null ? 公式_合一走(s["右"], c["右"], 计数, b1) : null :
      null :
    s["类型"] = "一元运算" ?
      (c["类型"] = "一元运算" and c["运算符"] = s["运算符"]) ?
        公式_合一走(s["操作数"], c["操作数"], 计数, b) :
      null :
    s["类型"] = "尖括号" ?
      c["类型"] = "尖括号" ? 公式_合一走(s["内"], c["内"], 计数, b) : null :
    s["类型"] = "属于" ?
      c["类型"] = "属于" ?
        let b1 = 公式_合一走(s["左"], c["左"], 计数, b) in
        b1 != null ? 公式_合一走(s["右"], c["右"], 计数, b1) : null :
      null :
    (s["类型"] = "列表" or s["类型"] = "元组") ?
      (c["类型"] = s["类型"] and len(s["元素"]) = len(c["元素"])) ?
        公式_合一元素(s["元素"], c["元素"], 计数, b) :
      null :
    s["类型"] = "下标" ?
      c["类型"] = "下标" ?
        let b1 = 公式_合一走(s["容器"], c["容器"], 计数, b) in
        b1 != null ? 公式_合一走(s["索引"], c["索引"], 计数, b1) : null :
      null :
    s["类型"] = "函数应用" ?
      c["类型"] = "函数应用" ?
        let b1 = 公式_合一走(s["函数"], c["函数"], 计数, b) in
        b1 != null ? 公式_合一走(s["参数"], c["参数"], 计数, b1) : null :
      null :
    (s["类型"] = "整数" or s["类型"] = "浮点" or s["类型"] = "字符串" or s["类型"] = "布尔") ?
      (c["类型"] = s["类型"] and c["值"] = s["值"]) ? b : null :
    null

  func 公式_合一元素(ss: List, cs: List, 计数: List, b: Dict) -> Value =
    ss = [] ? b :
    let b1 = 公式_合一走(ss[0], cs[0], 计数, b) in
    b1 != null ? 公式_合一元素(ss[1:], cs[1:], 计数, b1) : null

  func 公式_合一(模式, 具体) -> Value =
    公式_合一走(模式, 具体, [0], dict_from_pairs([]))

  func 公式_渲染逗(items: List, 分隔: String) -> String =
    items = [] ? "" :
    items[1:] = [] ? 公式_渲染(items[0]) :
    公式_渲染(items[0]) + 分隔 + 公式_渲染逗(items[1:], 分隔)

  func 公式_渲染(e) -> String =
    e["类型"] = "变量" ?
      e["是占位"] ? (e["名"] = "？" ? "？" : "？" + e["名"]) : e["名"] :
    e["类型"] = "整数" ? 公式_整串(e["值"]) :
    e["类型"] = "浮点" ? 公式_浮点串(e["值"]) :
    e["类型"] = "字符串" ? 公式_双引号() + e["值"] + 公式_双引号() :
    e["类型"] = "布尔" ? (e["值"] = 真 ? "真" : "假") :
    e["类型"] = "二元运算" ?
      公式_渲染(e["左"]) + " " + e["运算符"] + " " + 公式_渲染(e["右"]) :
    e["类型"] = "一元运算" ? e["运算符"] + 公式_渲染(e["操作数"]) :
    e["类型"] = "尖括号" ? "<<" + 公式_渲染(e["内"]) + ">>" :
    e["类型"] = "属于" ? 公式_渲染(e["左"]) + " >> " + 公式_渲染(e["右"]) :
    e["类型"] = "列表" ? "[" + 公式_渲染逗(e["元素"], ", ") + "]" :
    e["类型"] = "元组" ? "(" + 公式_渲染逗(e["元素"], ", ") + ")" :
    e["类型"] = "下标" ?
      公式_渲染(e["容器"]) + "[" + 公式_渲染(e["索引"]) + "]" :
    公式_形状(e)

  func 公式_实例列表(items: List, 计数: List, b: Dict) -> List =
    items = [] ? [] :
    [公式_实例走(items[0], 计数, b)] + 公式_实例列表(items[1:], 计数, b)

  func 公式_实例走(s, 计数: List, b: Dict) -> Value =
    s["类型"] = "变量" ?
      (not s["是占位"]) ? s :
      s["名"] = "？" ?
        let n = 计数[0] + 1 in
        let 忽略 = 原地设置(计数, 0, n) in
        let v = dict_get(b, "?" + 公式_整串(n), null) in
        v != null ? v : s :
      let v2 = dict_get(b, ":" + s["名"], null) in
      v2 != null ? v2 : s :
    s["类型"] = "二元运算" ?
      {"类型": "二元运算", "运算符": s["运算符"],
       "左": 公式_实例走(s["左"], 计数, b), "右": 公式_实例走(s["右"], 计数, b)} :
    s["类型"] = "一元运算" ?
      {"类型": "一元运算", "运算符": s["运算符"], "操作数": 公式_实例走(s["操作数"], 计数, b)} :
    s["类型"] = "尖括号" ? {"类型": "尖括号", "内": 公式_实例走(s["内"], 计数, b)} :
    s["类型"] = "属于" ?
      {"类型": "属于", "左": 公式_实例走(s["左"], 计数, b), "右": 公式_实例走(s["右"], 计数, b)} :
    (s["类型"] = "列表" or s["类型"] = "元组") ?
      {"类型": s["类型"], "元素": 公式_实例列表(s["元素"], 计数, b)} :
    s["类型"] = "下标" ?
      {"类型": "下标", "容器": 公式_实例走(s["容器"], 计数, b),
       "索引": 公式_实例走(s["索引"], 计数, b)} :
    s["类型"] = "函数应用" ?
      {"类型": "函数应用", "函数": 公式_实例走(s["函数"], 计数, b),
       "参数": 公式_实例走(s["参数"], 计数, b)} :
    s

  func 公式_实例化(模式, b: Dict) -> Value = 公式_实例走(模式, [0], b)

  (* —— 公式库（解释器/编译器双面共用；库 = 记录列表，记录 = dict）——
     登记：形状即身份，同形归并复用原条目（FormulaLibrary.register 同构）。
     匹配：逐条合一，返回全部成功绑定（多公式一用途）。 *)
  func 公式_查形状(库: List, 形: String) -> Int =
    库 = [] ? -1 :
    (库[0]["形状"] = 形) ? 0 : 公式_查形状余(库[1:], 形, 1)

  func 公式_查形状余(库: List, 形: String, i: Int) -> Int =
    库 = [] ? -1 :
    (库[0]["形状"] = 形) ? i : 公式_查形状余(库[1:], 形, i + 1)

  func 公式_登记(库: List, expr, seg) -> (List, Dict) =
    let sh = 公式_形状(expr) in
    let hit = 公式_查形状(库, sh) in
    hit >= 0 ? (库, list_get(库, hit)) :
    let 新条 = {"式": expr, "段号": seg, "形状": sh, "文本": 公式_渲染(expr),
                "槽位": 公式_收集槽位(expr)} in
    (库 + [新条], 新条)

  func 公式_匹配(库: List, expr) -> List =
    库 = [] ? [] :
    let b = 公式_合一(库[0]["式"], expr) in
    (b != null ? [b] : []) + 公式_匹配(库[1:], expr)

}

(* ===== 异常类型 ===== *)
(* MathaIOError, MathaPrintError 由 VM 层定义 *)
