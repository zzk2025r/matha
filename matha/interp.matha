(* ============================================================
   Matha 自举解释器（完整版）
   ------------------------------------------------------------
   完整解释器，支持：
     - 字面量、变量、算术运算
     - 三元条件表达式
     - Lambda 闭包与柯里化
     - 函数调用
     - if/while/for/match 控制流
     - 标准库内建函数
   
   调用入口：eval(expr, env) → Value
   ============================================================ *)

module 解释器 {

  use 词法器 { Token | 类型 | 扫描 | 做Token | tokenize }
  use 语法器 { parse | 做BinaryOp | 做IntLit | 做If | 做Variable | 做Lambda | 做FuncApp }
  use 标准库 { len | str | int | ord_matha | chr_matha | list_get | list_slice | list_append | list_max | list_min | list_sum | matha_type_of | 原地设置 | dict_from_pairs }

  (* ===== 环境：列表 [[name, value], ...] ===== *)

  func 空环境() -> List = []

  func 绑定环境(env: List, name: String, value) -> List =
    let pair = [name, value] in
    [pair] + env

  func 查找环境(env: List, name: String) -> Value =
    env = [] ? 错误("未定义变量 '" + name + "'") :
    env[0][0] = name ? env[0][1] : 查找环境(env[1:], name)

  (* ===== 递归绑定支持：占位符 + 原地更新 =====

     递归绑定（let rec / and 互递归 / 函数自递归）的关键：
     lambda 闭包捕获的 env 必须能看到绑定自身。策略：
       1. 先把绑定名绑定为占位符字符串（pair 是 CONS 共享的可变列表）；
       2. 在含占位符的 env 中求值（闭包捕获该 env）；
       3. 用 原地设置 把共享 pair 中的占位符替换为真实闭包——
          所有捕获该 env 的闭包同步可见。
     语义等价宿主解释器 _RecPlaceholder 的 [None] 可变引用。 *)

  (* env 中是否已含名为 name 的绑定 *)
  func 环境包含(env: List, name: String) -> Bool =
    env = [] ? 假 :
    env[0][0] = name ? 真 : 环境包含(env[1:], name)

  (* 原地更新 env 中名为 name 的绑定为 value；找不到时结构不变。
     pair 为 CONS 共享对象，原地修改对所有持有该 pair 的 env 派生可见，
     故必须返回原 env——不可返回尾切片（会丢弃链上更靠前的绑定，
     破坏互递归：闭包捕获的原 env 仍持占位 pair）。 *)
  func 更新绑定值(env: List, name: String, value) -> List =
    env = [] ? env :
    env[0][0] = name ?
      let 更新结果 = 原地设置(env[0], 1, value) in
      env :
    let 更新结果2 = 更新绑定值(env[1:], name, value) in
    env

  (* 预绑定：扫描声明列表，把所有函数定义名先绑定为占位符。
     之后逐条执行声明时，每个函数闭包捕获的 env 已含全部函数名
     （含互递归伙伴），求值后经 更新绑定值 原地补上真实闭包。 *)
  func 预绑定函数(decls: List, env: List) -> List =
    decls = [] ? env :
    decls[0].类型 = "函数定义" ?
      预绑定函数(decls[1:], 绑定环境(env, decls[0].名, "__函数占位__")) :
      预绑定函数(decls[1:], env)

  (* ===== 错误 ===== *)
  func 错误(msg: String) -> Value =
    raise msg

  (* ===== 表达式求值 ===== *)

  func 求值(expr: Dict, env: List) -> Value =
    expr.类型 = "整数" ? expr.值 :
    expr.类型 = "浮点" ? expr.值 :
    expr.类型 = "字符串" ? expr.值 :
    expr.类型 = "布尔" ? expr.值 :
    expr.类型 = "变量" ? 查找环境(env, expr.名) :
    expr.类型 = "二元运算" ? 求值二元(expr.运算符, expr.左, expr.右, env) :
    expr.类型 = "自定义二元" ? 求值自定义二元(expr.实现, expr.左, expr.右, env) :
    expr.类型 = "一元运算" ? 求值一元(expr.运算符, expr.操作数, env) :
    expr.类型 = "if" ? 求值if(expr.条件, expr.真分支, expr.假分支, env) :
    expr.类型 = "lambda" ? 求值lambda(expr.参数, expr.体, env) :
    expr.类型 = "函数应用" ? 求值应用(expr.函数, expr.参数, env) :
    expr.类型 = "列表" ? 求值列表(expr.元素, env) :
    expr.类型 = "元组" ? _to_tuple(求值列表(expr.元素, env)) :
    expr.类型 = "字典" ? 求值字典(expr.键, expr.值, env) :
    expr.类型 = "属性" ? 求值属性(expr.对象, expr.名, env) :
    expr.类型 = "输出" ? 求值(expr.expr, env) :
    expr.类型 = "抛出" ? 抛出求值(expr.值, env) :
    expr.类型 = "let绑定" ?
      let (r, new_env_after) = 绑定求值let(expr, env) in
      r :
    expr.类型 = "match" ? 求值match(expr, env) :
    错误("未知表达式类型: " + expr.类型)

  (* let [rec] 名 = 值 [in 体] —— 返回 (结果值, 新环境)
     递归：占位符绑定 → 求值 → 原地更新（闭包捕获的 env 同步看到真实值）
     非递归：先求值后绑定（标准词法作用域，值中不可引用绑定名） *)
  func 绑定求值let(expr: Dict, env: List) -> (Value, List) =
    if expr.递归 then
      let env1 = 绑定环境(env, expr.名, "__递归占位__") in
      let v = 求值(expr.值, env1) in
      let env2 = 更新绑定值(env1, expr.名, v) in
      if expr.有体 then (求值(expr.体, env2), env2) else (v, env2)
    else
      let v = 求值(expr.值, env) in
      let env1 = 绑定环境(env, expr.名, v) in
      if expr.有体 then (求值(expr.体, env1), env1) else (v, env1)

  (* 属性求值 =====
     1. 对象变量已绑定且为 struct 实例 / enum 命名空间 → 字段/构造子访问；
     2. 对象变量未绑定 → 模块平铺回退（内建已平铺注册到 env，
        标准库.str 等价 查找环境(env, "str")）；
     3. 其余对象表达式（如 包(4).值）先求值对象再取字段。 *)
  func 求值属性(obj_expr: Dict, name: String, env: List) -> Value =
    obj_expr.类型 = "变量" ?
      (环境包含(env, obj_expr.名) ?
        对象取字段(查找环境(env, obj_expr.名), name) :
        查找环境(env, name)) :
    对象取字段(求值(obj_expr, env), name)

  (* struct 实例 / enum 命名空间的字段访问；其它值返回 null（对齐宿主缺属性返回 None） *)
  func 对象取字段(obj: Value, name: String) -> Value =
    obj[0] = "__struct实例__" ?
      结构体字段值(obj[2:], name) :
    obj[0] = "__enum命名__" ?
      枚举构造子值(obj[2:], name) :
    null

  func 结构体字段值(pairs: List, name: String) -> Value =
    pairs = [] ? null :
    pairs[0][0] = name ? pairs[0][1] : 结构体字段值(pairs[1:], name)

  func 枚举构造子值(ctors: List, name: String) -> Value =
    ctors = [] ? null :
    ctors[0] = name ? name : 枚举构造子值(ctors[1:], name)

  (* 二元运算求值 =====
     and/or 短路：左值已可定结果时不求值右操作数；
     返回值语义与宿主一致（and 取假左值或右值，or 取真左值或右值）。 *)
  func 求值二元(op: String, left: Dict, right: Dict, env: List) -> Value =
    if op = "and" then
      let l = 求值(left, env) in
      if l then 求值(right, env) else l
    else if op = "or" then
      let l = 求值(left, env) in
      if l then l else 求值(right, env)
    else
      let l = 求值(left, env) in
      let r = 求值(right, env) in
      应用运算(op, l, r)

  (* 自定义运算符求值：查环境得到具名实现函数，按柯里化两次应用 f(l)(r)
     （对齐宿主 _eval_custom_op：处理器绑定在节点「实现」字段，无需注册表）。 *)
  func 求值自定义二元(实现: String, left: Dict, right: Dict, env: List) -> Value =
    let l = 求值(left, env) in
    let r = 求值(right, env) in
    let f = 查找环境(env, 实现) in
    应用函数(应用函数(f, l, env), r, env)

  (* 一元运算求值 ===== *)
  func 求值一元(op: String, operand: Dict, env: List) -> Value =
    (* null 字面量（parser 产 UnaryOp("null", null)）：不取操作数直接得 null *)
    op = "null" ? null :
    let v = 求值(operand, env) in
    op = "-" ? -v :
    op = "^" ? v ** 0.5 :
    错误("未知一元运算符: " + op)

  (* if 表达式求值 ===== *)
  func 求值if(cond: Dict, then_b: Dict, else_b: Dict, env: List) -> Value =
    if 求值(cond, env) then 求值(then_b, env) else 求值(else_b, env)

  (* Lambda 求值 → 闭包 ===== *)
  func 求值lambda(params: List, body: Dict, env: List) -> Value =
    ["__closure__", params, body, env]

  (* 函数应用求值 ===== *)
  func 求值应用(func_expr: Dict, arg_expr: Dict, env: List) -> Value =
    let f = 求值(func_expr, env) in
    let a = 求值(arg_expr, env) in
    应用函数(f, a, env)

  (* 列表字面量 [a, b, c]：逐元素求值，纯 Matha 累加器构建（保序）。 *)
  func 求值列表(elems: List, env: List) -> List =
    let rec _go(i: Int, acc: List) -> List =
      if i >= len(elems) then acc else _go(i + 1, acc + [求值(elems[i], env)])
    in _go(0, [])

  (* 字典字面量 {k1: v1, k2: v2}：键/值为并行列表（对齐宿主 DictLiteral）。
     先逐对求值收集 [[k, v], ...]，再经 dict_from_pairs 构建真实字典
     （折叠 _dict_put + _empty_dict 原语，宿主/VM 两端均已提供）。 *)
  func 求值字典(keys: List, vals: List, env: List) -> Dict =
    let rec _go(i: Int, acc: List) -> List =
      if i >= len(keys) then acc
      else _go(i + 1, acc + [[求值(keys[i], env), 求值(vals[i], env)]])
    in dict_from_pairs(_go(0, []))

  (* 运算分发 ===== *)
  func 应用运算(op: String, l, r) -> Value =
    op = "+" ? l + r :
    op = "-" ? l - r :
    op = "*" ? l * r :
    op = "/" ? l / r :
    op = "**" ? l ** r :
    op = "^" ? l ** r :
    op = "%" ? l % r :
    op = "<" ? l < r :
    op = ">" ? l > r :
    op = "<=" ? l <= r :
    op = ">=" ? l >= r :
    op = "=" ? l = r :
    op = "==" ? l = r :
    op = "!=" ? l != r :
    错误("未知运算符: " + op)

  (* 函数应用分发 =====
     31d-①：类型守卫前置（30c 同款 List/Tuple 探测→不可调用）——此前 f[0]
     直接探测对 Int/Float 落下标错误「索引操作不支持: int[0]」、空列表落
     原生 IndexError，宿主同形报「不可调用的值: 5」（8a 双链对拍同口径）。 *)
  func 应用函数(f: Value, arg: Value, call_env: List) -> Value =
    if matha_type_of(f) = "List" or matha_type_of(f) = "Tuple" then
      (if len(f) = 0 then 错误("不可调用的值: " + str(f))
       else if f[0] = "__closure__" then
      let params = f[1] in
      let body = f[2] in
      let captured = f[3] in
      let p0 = params[0] in
      (* 参数名双形态：func 定义经 解析参数列表 产字符串，lambda 经表达式
         解析产 Variable 节点（与 interp_matha.matha 同口径）。 *)
      let pname = if matha_type_of(p0) = "Dict" then (if p0.类型 = "变量" then p0.名 else p0) else p0 in
      let new_env = 绑定环境(captured, pname, arg) in
      (* 柯里化：若还有多余参数，返回部分应用闭包。
         注意不可在此提前求值 body——多参函数在首个参数处后续参数尚未绑定，
         提前求值会报「未定义变量」；应留到最后一个参数绑定后再求值。 *)
      if len(params) > 1 then
        let remaining_params = params[1:] in
        ["__closure__", remaining_params, body, new_env]
      else 求值(body, new_env)
    else if f[0] = "builtin" then
      f[1](arg)
    else if f[0] = "__struct工厂__" then
      应用结构体工厂(f, [arg])
    else if f[0] = "__struct部分__" then
      应用结构体工厂(f[1], f[2:] + [arg])
    else
      错误("不可调用的值: " + str(f)))
    else 错误("不可调用的值: " + str(f))

  (* struct 工厂应用：按字段数收集参数，齐了即构造实例（柯里化，
     对齐宿主 _struct_factory 的逐参数应用）。零字段 struct 无参即构造。 *)
  func 应用结构体工厂(工厂: List, 已收集: List) -> Value =
    let 字段名 = 工厂[2] in
    len(字段名) = 0 ?
      ["__struct实例__", 工厂[1]] :
    len(已收集) = len(字段名) ?
      ["__struct实例__", 工厂[1]] + 配对(字段名, 已收集) :
    ["__struct部分__", 工厂] + 已收集

  func 配对(names: List, vals: List) -> List = (names, vals) =>
    (* 注意：[[a,b]] 不可跟在三元冒号后——宿主 parser 会把 : 后的
       [ 误判为输出块；if/then/else 的 else 后才是列表字面量语境 *)
    if names = [] then [] else [[names[0], vals[0]]] + 配对(names[1:], vals[1:])

  (* ===== 语句执行 ===== *)

  func 执行语句(stmt: Dict, env: List) -> (Value, List) =
    stmt.类型 = "绑定" ?
      let v = 求值(stmt.值, env) in
      (v, 绑定环境(env, stmt.名, v)) :
    stmt.类型 = "if" ?
      if 求值(stmt.条件, env) then
        执行语句列表(stmt.真分支, env)
      else
        执行语句列表(stmt.假分支, env) :
    stmt.类型 = "while" ?
      执行while循环(stmt.条件, stmt.体, env) :
    stmt.类型 = "for" ?
      执行for循环(stmt.变量, stmt.迭代, stmt.体, env) :
    stmt.类型 = "函数定义" ?
      执行函数定义(stmt, env) :
    stmt.类型 = "let绑定" ?
      绑定求值let(stmt, env) :
    stmt.类型 = "程序" ?
      执行语句列表(stmt, env) :
    stmt.类型 = "try" ?
      执行try(stmt, env) :
    stmt.类型 = "定义运算符" ?
      (* 自定义运算符声明：解析期已登记，运行期无副作用（对齐宿主 NOOP） *)
      (None, env) :
    stmt.类型 = "输出追踪" ?
      (* 语句位 [输出]（宿主 _parse_output_trail 包裹面）：解包执行内层输出；
         空输出（expr=null）不发射（对齐宿主 Output(expr=None)） *)
      (stmt.输出.expr != null ? 求值(stmt.输出.expr, env) : null, env) :
    stmt.类型 = "二元运算" ?
      语句位赋值或表达式(stmt, env) :
    (* 其余节点视为表达式语句（顶层裸表达式，如 是偶数(10)） *)
    let v = 求值(stmt, env) in
    (v, env)

  (* 语句位裸赋值（宽容消解，对齐宿主 interp.py _exec_stmt 与 VM _emit_block
     is_assign 面）：`名 = 表达式` 在语句位求值右侧并绑定（已有名更新、
     未有名新绑定）；其余二元表达式语句仍按表达式求值。 *)
  func 语句位赋值或表达式(stmt: Dict, env: List) -> (Value, List) =
    if stmt.运算符 = "=" and stmt.左.类型 = "变量" then
      let v = 求值(stmt.右, env) in
      if 环境包含(env, stmt.左.名) then
        (v, 更新绑定值(env, stmt.左.名, v))
      else
        (v, 绑定环境(env, stmt.左.名, v))
    else
      let v = 求值(stmt, env) in (v, env)

  (* 函数定义执行：求值 lambda 闭包并绑定（支持自递归与互递归）。
     参数存于 decl.参数（Variable 节点列表），decl.体 为裸函数体，
     需包装为 lambda 节点再求值。 *)
  func 执行函数定义(decl: Dict, env: List) -> (Value, List) =
    let lam = 做Lambda(decl.参数, decl.体) in
    if 环境包含(env, decl.名) then
      (* 预绑定路径：env 已含占位符，求值后原地更新为真实闭包 *)
      let closure = 求值(lam, env) in
      let env2 = 更新绑定值(env, decl.名, closure) in
      (closure, env2)
    else
      (* 未预绑定路径：先绑占位符再求值再更新，闭包经共享 pair 看到自身 *)
      let env1 = 绑定环境(env, decl.名, "__函数占位__") in
      let closure = 求值(lam, env1) in
      let env2 = 更新绑定值(env1, decl.名, closure) in
      (closure, env2)

  func 执行语句列表(stmts: Dict, env: List) -> (Value, List) =
    if stmts.类型 = "程序" then
      执行声明列表(stmts.声明, env)
    else
      执行语句(stmts, env)

  (* 声明列表执行：先预绑定全部函数占位符（互递归可见），再逐条执行 *)
  func 执行声明列表(decls: List, env: List) -> (Value, List) =
    let env0 = 预绑定函数(decls, env) in
    执行声明列表已预绑(decls, env0)

  (* 返回最后一条声明的结果（程序值 = 尾表达式值） *)
  func 执行声明列表已预绑(decls: List, env: List) -> (Value, List) =
    decls = [] ? (None, env) :
    let (v, env2) = 执行声明(decls[0], env) in
    decls[1:] = [] ? (v, env2) :
    执行声明列表已预绑(decls[1:], env2)

  (* 声明执行：结构体/枚举注册；其余全部委托 执行语句 *)
  func 执行声明(decl: Dict, env: List) -> (Value, List) =
    decl.类型 = "结构体" ? 执行结构体(decl, env) :
    decl.类型 = "枚举" ? 执行枚举(decl, env) :
    执行语句(decl, env)

  (* struct 注册：名 → 工厂值（应用时按字段数柯里化收集参数构造实例）。
     实例表示：["__struct实例__", 名, [字段1, 值1], [字段2, 值2], ...]
     —— 纯 List 表示，列表相等即结构相等（对齐宿主 _StructInstance）。 *)
  func 执行结构体(decl: Dict, env: List) -> (Value, List) =
    let 工厂 = ["__struct工厂__", decl.名, 结构体字段名(decl.字段)] in
    (工厂, 绑定环境(env, decl.名, 工厂))

  func 结构体字段名(fields: List) -> List = (fields) =>
    (* else 后为列表字面量语境；: 后的 [x] 会被宿主 parser 误判为输出块 *)
    if fields = [] then [] else [fields[0].名] + 结构体字段名(fields[1:])

  (* enum 注册：名 → 命名空间值；名.构造子 返回构造子名字符串（对齐宿主 _EnumNamespace） *)
  func 执行枚举(decl: Dict, env: List) -> (Value, List) =
    let ns = ["__enum命名__", decl.名] + decl.构造子 in
    (ns, 绑定环境(env, decl.名, ns))

  (* while 循环 ===== *)
  func 执行while循环(cond: Dict, body: Dict, env: List) -> (Value, List) =
    if not 求值(cond, env) then (None, env)
    else
      let (result2, env2) = 执行语句(body, env) in
      执行while循环(cond, body, env2)

  (* for 循环 ===== *)
  func 执行for循环(var_name: String, iterable: Dict, body: Dict, env: List) -> (Value, List) =
    let items = 求值(iterable, env) in
    if items = [] then (None, env)
    else
      let (result3, env2) = 执行语句(body, 绑定环境(env, var_name, items[0])) in
      let (result4, env3) = 执行for循环(var_name, items[1:], body, env2) in
      (None, env3)

  (* ===== try/catch/raise ===== *)

  (* raise 求值：调用 VM「错误」内建，抛出宿主异常穿越解释器帧，
     由 调用捕获 在 try 边界拦截 *)
  func 抛出求值(值expr: Dict, env: List) -> Value =
    let v = 求值(值expr, env) in
    错误(v)

  (* try 体包装：由 调用捕获 在受保护上下文中经 VM 调用，
     返回 [值, env2] 使块内绑定可传播（异常时整块放弃） *)
  func try执行包装(体: Dict, env: List) -> List =
    let (v, env2) = 执行语句列表(体, env) in
    [v, env2]

  (* try/catch/finally 执行：
     try 体经 调用捕获 受保护运行 → 正常 ["__正常__", [值, env2]] /
     异常 ["__异常__", 消息]；异常路径均「先 finally 后重抛」（阶段 20 全链同构，
     对齐宿主 _exec_try / VM 发射面）：无 catch 时异常继续传播，finally 仍先执行；
     catch 体亦经 调用捕获 受保护，catch 再抛 → 先 finally 后重抛。
     finally 无论结果如何都执行（只取副作用，保留原值） *)
  func 执行try(stmt: Dict, env: List) -> (Value, List) =
    let 结果 = 调用捕获(try执行包装)([stmt.try体, env]) in
    if 结果[0] = "__正常__" then
      执行finally后(stmt, 结果[1][0], 结果[1][1])
    else if stmt.捕获体 = null then
      (* 无 catch（哨兵 null）：finally 先执行，错误重抛——
         对齐宿主 _exec_try 无 catch 路径（阶段 20e） *)
      let 忽略 = 执行finally后(stmt, null, env) in
      错误(结果[1])
    else if stmt.捕获体.声明 = [] then
      (* 显式空 catch：吞错继续——对齐宿主 catch 空体语义 *)
      执行finally后(stmt, null, env)
    else
      let env3 = stmt.捕获变量 = "" ? env : 绑定环境(env, stmt.捕获变量, 结果[1]) in
      let 捕果 = 调用捕获(try执行包装)([stmt.捕获体, env3]) in
      if 捕果[0] = "__正常__" then
        执行finally后(stmt, 捕果[1][0], 捕果[1][1])
      else
        let 忽略2 = 执行finally后(stmt, null, env3) in
        错误(捕果[1])

  func 执行finally后(stmt: Dict, v: Value, env: List) -> (Value, List) =
    stmt.finally体.声明 = [] ?
      (v, env) :
      let (忽略, env2) = 执行语句列表(stmt.finally体, env) in
      (v, env2)

  (* ===== match 模式匹配 =====
     语义与 interp_matha.matha 同节一致（对齐宿主 _eval_match / _match_pattern）：
     守卫先于模式求值；通配符 _ 兜底；变量绑定经新 env 不泄漏；
     构造子支持列表/元组/字典形态；守卫真值对齐宿主 Python truthiness。 *)

  (* 宿主 match 守卫按 Python truthiness 判定（interp.py `if not guard_val`）：
     None/False/0/""/[]/{}/() 均假。自举 if 约定（非 0.0 且非 假）会把 ""/[]
     当真，故守卫单独走本辅助。 *)
  func 真值(v) -> Bool =
    v = null ? 假 :
    v = 假 ? 假 :
    v = 0.0 ? 假 :
    v = "" ? 假 :
    (matha_type_of(v) = "List" or matha_type_of(v) = "Dict" or matha_type_of(v) = "Tuple") and len(v) = 0 ? 假 :
    真

  func 求值match(expr: Dict, env: List) -> Value =
    求值match分支(expr.分支, 求值(expr.scrutinee, env), null, env)

  func 求值match分支(branches: List, value, 兜底: Dict, env: List) -> Value =
    branches = [] ?
      (兜底 = null ? 错误("match 无匹配分支: " + str(value)) : 求值(兜底, env)) :
    let b = branches[0] in
    let guard = b[1] in
    let gv = guard = null ? 真 : 求值(guard, env) in
    let guard_ok = guard = null ? 真 : 真值(gv) in
    if not guard_ok then 求值match分支(branches[1:], value, 兜底, env)
    else if b[0].类型 = "变量" and b[0].名 = "_" then
      求值match分支(branches[1:], value, (兜底 = null ? b[2] : 兜底), env)
    else
      let (matched, env2) = 匹配模式(b[0], value, env) in
      matched ? 求值(b[2], env2) : 求值match分支(branches[1:], value, 兜底, env)

  func 匹配模式(pattern: Dict, value, env: List) -> (Bool, List) =
    pattern.类型 = "整数" or pattern.类型 = "浮点" or pattern.类型 = "字符串" or pattern.类型 = "布尔" ?
      (pattern.值 = value, env) :
    pattern.类型 = "构造子模式" ? 匹配构造子(pattern, value, env) :
    pattern.类型 = "变量" ?
      (pattern.名 = "_" ? (假, env) : (真, 绑定环境(env, pattern.名, value))) :
    (假, env)

  func 匹配构造子(pattern: Dict, value, env: List) -> (Bool, List) =
    let fields = pattern.字段 in
    (* 宿主 _match_pattern 对 tuple/list 同等接受（isinstance(value, (tuple, list))） *)
    if (matha_type_of(value) = "List" or matha_type_of(value) = "Tuple") and len(value) = len(fields) + 1 and matha_type_of(value[0]) = "String" and value[0] = pattern.名 then
      匹配字段列表(fields, value[1:], env)
    else if matha_type_of(value) = "Dict" then
      (* 安全索引：缺键返回 null → 下方 List 校验拒绝，语义等价成员测试。
         不用 in 成员运算符——自举 parser 无 in 二元层（仅 let 终止符），
         用了会破坏 test_m7 自编译（期望 then）。安全索引三端内建均有。 *)
      let args = 安全索引(value, pattern.名) in
      if (matha_type_of(args) = "List" or matha_type_of(args) = "Tuple") and len(args) = len(fields) then
        匹配字段列表(fields, args, env)
      else (假, env)
    else (假, env)

  func 匹配字段列表(fields: List, values: List, env: List) -> (Bool, List) =
    fields = [] ? (真, env) :
    let (ok, env2) = 匹配模式(fields[0], values[0], env) in
    ok ? 匹配字段列表(fields[1:], values[1:], env2) : (假, env)

  (* ===== 解释器插口（28d）=====
     模块级持久注册表（单槽容器 + 原地设置改内容，跨调用可见）：
     解释器插口[0] = [名, 值] 对列表。值通常为 lambda (ps) => ...
     （收完整参数表 List）。注册表在 注册内建 尾部经 并插口 并入环境：
     绑定环境 前插序使注册项先于静态内建被查到——重注册同名 = 覆盖
     （升级语义）；注销后回落静态内建，「未定义变量」诚实报错不变。
     帮助函数命名带 解释器 前缀，避免与 vm.matha 的 查插口 平面撞名。 *)
  解释器插口 = [[]]

  func 解释器查插口(表: List, 名: String) -> Int =
    表 = [] ? -1 : (表[0][0] = 名 ? 0 : 解释器查插口(表[1:], 名))

  func 是解释器保留名(名: String) -> Bool =
    名 = "输出" or 名 = "print" or 名 = "打印文本" or 名 = "调用捕获" or 名 = "错误" or 名 = "MathaIOError"

  func 注册解释器插口(名: String, 值) -> Bool =
    是解释器保留名(名) ? 错误("保留内建 '" + 名 + "' 不可注册插口") : 注册解释器插口基(名, 值)

  func 注册解释器插口基(名: String, 值) -> Bool =
    let 表 = 解释器插口[0] in
    let hit = 解释器查插口(表, 名) in
    let 新表 = hit >= 0 ? 原地设置(表, hit, [名, 值]) : 表 + [[名, 值]] in
    let 忽略 = 原地设置(解释器插口, 0, 新表) in
    真

  func 注销解释器插口(名: String) -> Bool =
    是解释器保留名(名) ? 错误("保留内建 '" + 名 + "' 不可注销") : 注销解释器插口基(名)

  func 注销解释器插口基(名: String) -> Bool =
    let 表 = 解释器插口[0] in
    let hit = 解释器查插口(表, 名) in
    hit >= 0 ?
      (let 忽略 = 原地设置(解释器插口, 0,
         list_slice(表, 0, hit) + list_slice(表, hit + 1, len(表))) in
       真) :
      假

  func 收解释器插口名(表: List, acc: List) -> List =
    表 = [] ? acc : 收解释器插口名(表[1:], acc + [表[0][0]])

  func 解释器插口名表() -> List = 收解释器插口名(解释器插口[0], [])

  func 并插口基(表: List, i: Int, env: List) -> List =
    i >= len(表) ? env : 并插口基(表, i + 1, 绑定环境(env, 表[i][0], 表[i][1]))

  func 并插口(env: List, 表: List) -> List = 并插口基(表, 0, env)

  (* ===== 标准库内建 ===== *)
  func 注册内建(env: List) -> List =
    (* 空值常量：宿主 parser 把 null 作关键字字面量，自举 parser 解析为变量，
       须显式绑定（守卫真值/缺省判定依赖 null 可求值）。 *)
    let env1 = 绑定环境(env, "null", null) in
    let env1a = 绑定环境(env1, "None", null) in
    let env1b = 绑定环境(env1a, "Null", null) in
    let env2 = 绑定环境(env1b, "ord", ["builtin", func_ord]) in
    let env3 = 绑定环境(env2, "chr", ["builtin", func_chr]) in
    let env4 = 绑定环境(env3, "len", ["builtin", func_len]) in
    let env5 = 绑定环境(env4, "get", ["builtin", func_get]) in
    let env6 = 绑定环境(env5, "slice", ["builtin", func_slice]) in
    let env7 = 绑定环境(env6, "append", ["builtin", func_append]) in
    let env8 = 绑定环境(env7, "list", ["builtin", func_list]) in
    let env9 = 绑定环境(env8, "pi", 3.141592653589793) in
    let env10 = 绑定环境(env9, "e", 2.718281828459045) in
    let env11 = 绑定环境(env10, "sin", ["builtin", func_sin]) in
    let env12 = 绑定环境(env11, "cos", ["builtin", func_cos]) in
    let env13 = 绑定环境(env12, "tan", ["builtin", func_tan]) in
    let env14 = 绑定环境(env13, "sqrt", ["builtin", func_sqrt]) in
    let env15 = 绑定环境(env14, "abs", ["builtin", func_abs]) in
    let env16 = 绑定环境(env15, "floor", ["builtin", func_floor]) in
    let env17 = 绑定环境(env16, "ceil", ["builtin", func_ceil]) in
    let env18 = 绑定环境(env17, "round", ["builtin", func_round]) in
    let env19 = 绑定环境(env18, "max", ["builtin", func_max]) in
    let env20 = 绑定环境(env19, "min", ["builtin", func_min]) in
    let env21 = 绑定环境(env20, "sum", ["builtin", func_sum]) in
    let env22 = 绑定环境(env21, "原地设置", ["builtin", func_原地设置]) in
    并插口(env22, 解释器插口[0])

  (* 内建函数实现 ===== *)
  func func_ord(c) -> Int = ord_matha(c)
  func func_chr(n) -> String = chr_matha(n)
  func func_len(seq) -> Int = len(seq)
  (* 原地设置三参柯里化：原地设置(lst)(idx)(v) —— 递归绑定的占位更新依赖 *)
  func func_原地设置(lst) -> Value = (lst) =>
    (idx) => (v) => 原地设置(lst, idx, v)
  func func_get(seq) -> Value = (seq) =>
    (idx) => list_get(seq, int(idx))
  func func_slice(seq) -> Value = (seq) =>
    (start) => (end) => list_slice(seq, int(start), int(end))
  func func_append(lst) -> Value = (lst) =>
    (elem) => list_append(lst, elem)
  func func_list(args) -> List = args
  func func_sin(x) -> Float = 运行时引擎.sin(x)
  func func_cos(x) -> Float = 运行时引擎.cos(x)
  func func_tan(x) -> Float = 运行时引擎.tan(x)
  func func_sqrt(x) -> Float = 运行时引擎.sqrt(x)
  func func_abs(x) -> Float = 运行时引擎.abs(x)
  func func_floor(x) -> Int = 运行时引擎.floor(x)
  func func_ceil(x) -> Int = 运行时引擎.ceil(x)
  func func_round(x) -> Int = 运行时引擎.round(x)
  func func_max(lst) -> Value = list_max(lst)
  func func_min(lst) -> Value = list_min(lst)
  func func_sum(lst) -> Float = list_sum(lst)

  (* ===== 顶层入口 ===== *)

  func interpret(source: String) -> List =
    let toks = 扫描(source) in
    let ast = parse(toks) in
    let env = 注册内建(空环境()) in
    let (result5, env2) = 执行语句(ast, env) in
    []  (* 输出暂存 env 中 *)

  func eval(expr: Dict, env: List) -> Value =
    求值(expr, env)

}

(* ===== 自测 ===== *)
#：{
  env = 注册内建(空环境())

  (* 测试：3 + 5 *)
  expr1 = 做BinaryOp("+", 做IntLit(3), 做IntLit(5))
  result1 = 求值(expr1, env)
  [result1]

  (* 测试：2 * (3 + 4) *)
  inner = 做BinaryOp("+", 做IntLit(3), 做IntLit(4))
  expr2 = 做BinaryOp("*", 做IntLit(2), inner)
  result2 = 求值(expr2, env)
  [result2]

  (* 测试：三元 1 > 2 ? 100 : 200 *)
  cond = 做BinaryOp(">", 做IntLit(1), 做IntLit(2))
  expr3 = 做If(cond, 做IntLit(100), 做IntLit(200))
  result3 = 求值(expr3, env)
  [result3]

  (* 测试：变量绑定 + 求值 *)
  env2 = 绑定环境(env, "x", 10)
  expr4 = 做Variable("x")
  result4 = 求值(expr4, env2)
  [result4]

  (* 测试：Lambda + 应用 *)
  lam = 做Lambda(
    [做Variable("x")],
    做BinaryOp("+", 做Variable("x"), 做IntLit(1))
  )
  closure = 求值(lam, env)
  env3 = 绑定环境(env, "加一", closure)
  expr5 = 做FuncApp(做Variable("加一"), 做IntLit(5))
  result5 = 求值(expr5, env3)
  [result5]
}
