(* 学科知识：语言学 — 语法基础
   覆盖：词性标注、分词、句法
   ============================================================ *)

module 语法 {

  func 词性标记(word: String) -> String =
    (word) =>
    match word {
      | "的" => "助词"
      | "是" => "动词"
      | "和" => "连词"
      | "在" => "介词"
      | _ => "名词"
    }

  func 分词(text: String) -> List =
    (text) => text.split(" ")

  func 音节组合(声母: String, 韵母: String) -> String =
    (声母, 韵母) => 声母 + 韵母
}
