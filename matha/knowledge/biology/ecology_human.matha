(* 学科知识：生物学 — 生态与人体
   覆盖：种群增长、BMI、生命体征
   ============================================================ *)

module 生态人体 {

  func 逻辑斯蒂增长(N0: Float, K: Float, r: Float, t: Float) -> Float =
    (N0, K, r, t) =>
    K / (1 + (K/N0 - 1) * exp(-r * t))

  func BMI(体重: Float, 身高: Float) -> Float =
    (体重, 身高) => 体重 / (身高 * 身高)

  func 卡路里(体重: Float, 活动系数: Float) -> Float =
    (体重, 活动系数) => 体重 * 22 * 活动系数

  func 心输出量(每搏量: Float, 心率: Int) -> Float =
    (每搏量, 心率) => 每搏量 * 心率

  func 血容量(体重: Float) -> Float =
    (体重) => 体重 * 0.07
}
