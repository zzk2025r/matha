module 应用中心 {
  use 标准库 { len | str | split | strip | find | 截取 | dict_from_pairs | dict_keys | dict_get | dict_has | dict_size | dict_put | list_sort | read_file | write_file | matha_type_of }

  (* ============================================================
     应用中心 —— Matha 自举应用商店引擎（阶段 25c，纯 Matha 实现）
     ============================================================
     HTTP/1.1 文本面解析 + 路由 + 索引持久化。外部凭据自由的商店
     自生面（阶段 25 拍板）：商店服务器本体由 Matha 自身写成，
     Python 侧只保留 socket 收发驱动（25a 网络_服务/接受/收/发）。

     路由表：
       GET  /health          → {"状态", "应用数"}
       GET  /apps            → {"应用数", "应用"(字典序)}
       GET  /apps/<名>       → 应用记录 / 404
       GET  /search?q=词     → {"数量", "命中", "词"}（名字或说明子串匹配）
       POST /token           → {"令牌"}（体 {主体, 过期秒?}；签发开放）
       POST /publish         → 201 {"已发布", "版本"}（体 {应用, 版本,
                                说明?, 入口?, 内容, 令牌}；需有效令牌）
       POST /revoke          → {"已吊销"}（体 {令牌}）
     错误面：400 请求行/JSON/缺字段、401 令牌无效、404 未知路由、
     405 方法不允许、500 索引损坏/写入失败（全部诚实消息）。

     设计约束（经语料陷阱逐项核实）：
       ① 响应以 Connection: close 定界（RFC 7230 §3.3.3 规则 7），
          不写 Content-Length——纯 Matha 逐字符字节计数会触发深递归
          （Python 递归深度上限），驱动端按连接关闭读尽主体。
       ② 查询参数原样匹配，不做 URL 百分号解码（登记边界）。
       ③ 索引落盘 .matha/store/index.json（cwd 相对——驱动端以商店
          根目录为 cwd）；令牌能力来自 25b 商店域（商店_签发令牌/
          商店_校验令牌/商店_吊销令牌）。
       ④ 块尾裸列表=输出语句面：本模块全部函数为表达式体（= 形），
          if-else 链一律多行不括号化（(if ...) 括号形态会被解析器
          劫持——「期望 )」），let 链一律扁平级联不嵌套；try/catch
          仅以块尾形式出现在 lambda 块体内（表达式位 try 不被
          _parse_expr 接受），块尾 try 依 _eval_block_value 规则
          产出 try/catch 块值。
       ⑤ 令牌签发开放、发布需令牌、安装开放（拍板语义）。
       ⑥ 已过期令牌不可吊销（吊销先走校验，过期令牌本已失效，
          返回 400「令牌已过期」而非假装吊销成功）。

     文件 I/O 走 stdlib read_file/write_file（两端同名可用）；JSON
     编解码走内建 解析_JSON/JSON编码（kernel/io 双面单源）。 *)

  (* ---- ① HTTP 请求解析 ---- *)

  func _切头体(原始: String) -> Dict =
    if find("\r\n\r\n", 原始) < 0 then dict_from_pairs([["头", 原始], ["体", ""]])
    else _切在(原始, find("\r\n\r\n", 原始))

  func _切在(原始: String, k: Int) -> Dict =
    dict_from_pairs([["头", 截取(原始, 0, k)], ["体", 截取(原始, k + 4, len(原始))]])

  func _解析查询(段们: List, i: Int) -> Dict =
    if i >= len(段们) then dict_from_pairs([])
    else _解析查询对(段们, i, find("=", 段们[i]))

  func _解析查询对(段们: List, i: Int, k: Int) -> Dict =
    if k <= 0 then _解析查询(段们, i + 1)
    else dict_put(_解析查询(段们, i + 1), 截取(段们[i], 0, k), 截取(段们[i], k + 1, len(段们[i])))

  func _解析行(行们: List, 体: String, i: Int) -> Dict =
    if i >= len(行们) then dict_from_pairs([["错误", "请求行缺失"]])
    else _解析行进(行们, 体, i, strip(行们[i]))

  func _解析行进(行们: List, 体: String, i: Int, 行: String) -> Dict =
    if 行 = "" then _解析行(行们, 体, i + 1)
    else _解析行段(行们, 体, i, split(行, " "))

  func _解析行段(行们: List, 体: String, i: Int, 段: List) -> Dict =
    if len(段) != 3 then dict_from_pairs([["错误", "请求行须为 方法 路径 协议 三段"]])
    else _解析行目标(体, 段, split(段[1], "?"))

  func _解析行目标(体: String, 段: List, 目标段: List) -> Dict =
    if len(目标段) > 1 then dict_from_pairs([["方法", 段[0]], ["路径", 目标段[0]], ["参数", _解析查询(split(目标段[1], "&"), 0)], ["体", 体]])
    else dict_from_pairs([["方法", 段[0]], ["路径", 目标段[0]], ["参数", dict_from_pairs([])], ["体", 体]])

  func 解析请求(原始: String) -> Dict =
    let 切分 = _切头体(strip(原始)) in
    _解析行(split(切分["头"], "\r\n"), 切分["体"], 0)

  (* ---- ② 响应构造 ---- *)

  func _原因(码: Int) -> String =
    if 码 = 200 then "OK"
    else if 码 = 201 then "Created"
    else if 码 = 400 then "Bad Request"
    else if 码 = 401 then "Unauthorized"
    else if 码 = 404 then "Not Found"
    else if 码 = 405 then "Method Not Allowed"
    else "Error"

  func _响应文本(码: Int, 主体值) -> String = "HTTP/1.1 " + str(码) + " " + _原因(码) + "\r\nContent-Type: application/json; charset=utf-8\r\nConnection: close\r\n\r\n" + JSON编码(主体值)

  func _响应帧(码: Int, 主体值) -> Dict =
    dict_from_pairs([["响应", _响应文本(码, 主体值)], ["码", 码]])

  func _错误响应(码: Int, 消息: String) -> Dict =
    _响应帧(码, dict_from_pairs([["错误", 消息]]))

  func _处理帧回执(帧: Dict, 结果: Dict) -> Dict =
    dict_from_pairs([["响应", 结果["响应"]], ["方法", 帧["方法"]], ["路径", 帧["路径"]], ["码", 结果["码"]]])

  (* ---- ③ 索引面（.matha/store/index.json） ---- *)

  func _索引路径() -> String = ".matha/store/index.json"

  func _空索引() -> Dict =
    dict_from_pairs([["protocol_version", 1], ["apps", dict_from_pairs([])]])

  func _载入现存(路径: String) -> Dict = (路径) => {
    try { dict_from_pairs([["索引", 解析_JSON(read_file(路径))]]) } catch (e) { dict_from_pairs([["错误", "索引损坏，无法读取: " + e]]) }
  }

  func 载入索引() -> Dict =
    if 文件存在(_索引路径()) then _载入现存(_索引路径())
    else dict_from_pairs([["索引", _空索引()]])

  func _试存(索引: Dict) -> Dict = (索引) => {
    try { dict_from_pairs([["完成", write_file(_索引路径(), JSON编码(索引))]]) } catch (e) { dict_from_pairs([["错误", "索引写入失败: " + e]]) }
  }

  (* ---- ④ 令牌面（25b 商店域 try 包装，错误转帧不穿透） ---- *)

  func 签发(主体: String, 过期秒) -> Dict = (主体, 过期秒) => {
    try { dict_from_pairs([["令牌", 商店_签发令牌(主体)(过期秒)]]) } catch (e) { dict_from_pairs([["错误", e]]) }
  }

  func 校验(令牌: String) -> Dict = (令牌) => {
    try { dict_from_pairs([["载荷", 商店_校验令牌(令牌)]]) } catch (e) { dict_from_pairs([["错误", e]]) }
  }

  func 吊销(令牌: String) -> Dict = (令牌) => {
    try { dict_from_pairs([["完成", 商店_吊销令牌(令牌)]]) } catch (e) { dict_from_pairs([["错误", e]]) }
  }

  (* ---- ⑤ 请求体校验 ---- *)

  func _试解析体(体: String) -> Dict = (体) => {
    try { dict_from_pairs([["体", 解析_JSON(体)]]) } catch (e) { dict_from_pairs([["错误", "请求体不是合法 JSON"]]) }
  }

  func _缺字段(体: Dict, 名单: List, i: Int) -> List =
    if i >= len(名单) then []
    else if dict_has(体, 名单[i]) then _缺字段(体, 名单, i + 1)
    else [名单[i]] + _缺字段(体, 名单, i + 1)

  func _坏字段(体: Dict, 名单: List, i: Int) -> List =
    if i >= len(名单) then []
    else _坏字段判定(体, 名单, i, dict_get(体, 名单[i], null))

  func _坏字段判定(体: Dict, 名单: List, i: Int, 值) -> List =
    if matha_type_of(值) != "String" or 值 = "" then [名单[i]] + _坏字段(体, 名单, i + 1)
    else _坏字段(体, 名单, i + 1)

  func _顿号(名单: List, i: Int, acc: String) -> String =
    if i >= len(名单) then acc
    else if acc = "" then _顿号(名单, i + 1, 名单[i])
    else _顿号(名单, i + 1, acc + "、" + 名单[i])

  (* ---- ⑥ POST 处理器 ---- *)

  func _签发响应(体: Dict) -> Dict =
    let 结果 = 签发(dict_get(体, "主体", ""), dict_get(体, "过期秒", 3600)) in
    if dict_has(结果, "错误") then _错误响应(400, 结果["错误"])
    else _响应帧(200, dict_from_pairs([["令牌", 结果["令牌"]]]))

  func _签发主体链(体: Dict) -> Dict =
    if dict_has(体, "主体") then _签发响应(体)
    else _错误响应(400, "签发缺字段: 主体")

  func _处理签发(体: String) -> Dict =
    let 解析 = _试解析体(体) in
    if dict_has(解析, "错误") then _错误响应(400, 解析["错误"])
    else _签发主体链(解析["体"])

  func _发布落盘(体: Dict, 索引: Dict, 应用: String) -> Dict =
    let 记录 = dict_from_pairs([["版本", dict_get(体, "版本", "")], ["说明", dict_get(体, "说明", "")], ["入口", dict_get(体, "入口", "main.matha")], ["主体", dict_get(体, "主体名", "")], ["时间", 当前时间()], ["内容", dict_get(体, "内容", "")]]) in
    let 新索引 = dict_put(索引, "apps", dict_put(dict_get(索引, "apps", dict_from_pairs([])), 应用, 记录)) in
    let 保存 = _试存(新索引) in
    if dict_has(保存, "错误") then _错误响应(500, 保存["错误"])
    else _响应帧(201, dict_from_pairs([["已发布", 应用], ["版本", dict_get(体, "版本", "")]]))

  func _发布校验链(体: Dict, 索引: Dict) -> Dict =
    let 缺 = _缺字段(体, ["应用", "版本", "内容", "令牌"], 0) in
    if len(缺) > 0 then _错误响应(400, "发布缺字段: " + _顿号(缺, 0, ""))
    else _发布字段链(体, 索引)

  func _发布字段链(体: Dict, 索引: Dict) -> Dict =
    let 坏 = _坏字段(体, ["应用", "版本", "内容"], 0) in
    if len(坏) > 0 then _错误响应(400, "发布字段须为非空字符串: " + _顿号(坏, 0, ""))
    else _发布令牌链(体, 索引)

  func _发布令牌链(体: Dict, 索引: Dict) -> Dict =
    let 校验帧 = 校验(dict_get(体, "令牌", "")) in
    if dict_has(校验帧, "错误") then _错误响应(401, 校验帧["错误"])
    else _发布落盘(dict_put(体, "主体名", 校验帧["载荷"]["sub"]), 索引, dict_get(体, "应用", ""))

  func _处理发布(体: String, 索引: Dict) -> Dict =
    let 解析 = _试解析体(体) in
    if dict_has(解析, "错误") then _错误响应(400, 解析["错误"])
    else _发布校验链(解析["体"], 索引)

  func _吊销执行(体: Dict) -> Dict =
    let 结果 = 吊销(dict_get(体, "令牌", "")) in
    if dict_has(结果, "错误") then _错误响应(400, 结果["错误"])
    else _响应帧(200, dict_from_pairs([["已吊销", true]]))

  func _吊销令牌链(体: Dict) -> Dict =
    if dict_has(体, "令牌") then _吊销执行(体)
    else _错误响应(400, "吊销缺字段: 令牌")

  func _处理吊销(体: String) -> Dict =
    let 解析 = _试解析体(体) in
    if dict_has(解析, "错误") then _错误响应(400, 解析["错误"])
    else _吊销令牌链(解析["体"])

  (* ---- ⑦ GET 处理器 ---- *)

  func _处理详情(应用表: Dict, 名: String) -> Dict =
    if dict_has(应用表, 名) then _响应帧(200, dict_get(应用表, 名, dict_from_pairs([])))
    else _错误响应(404, "应用不存在: " + 名)

  func _过滤命中(应用表: Dict, 名单: List, 词: String, i: Int) -> List =
    if i >= len(名单) then []
    else if 词 = "" then [名单[i]] + _过滤命中(应用表, 名单, 词, i + 1)
    else if find(词, 名单[i]) >= 0 then [名单[i]] + _过滤命中(应用表, 名单, 词, i + 1)
    else _过滤判定(应用表, 名单, 词, i)

  func _过滤判定(应用表: Dict, 名单: List, 词: String, i: Int) -> List =
    if find(词, dict_get(dict_get(应用表, 名单[i], dict_from_pairs([])), "说明", "")) >= 0 then [名单[i]] + _过滤命中(应用表, 名单, 词, i + 1)
    else _过滤命中(应用表, 名单, 词, i + 1)

  func _处理搜索(应用表: Dict, 词: String) -> Dict =
    let 命中 = _过滤命中(应用表, list_sort(dict_keys(应用表)), 词, 0) in
    _响应帧(200, dict_from_pairs([["数量", len(命中)], ["命中", 命中], ["词", 词]]))

  (* ---- ⑧ 分发 ---- *)

  func _前缀(前: String, s: String) -> Bool = len(s) >= len(前) and 截取(s, 0, len(前)) = 前
  func _去前缀(前: String, s: String) -> String = 截取(s, len(前), len(s))

  func _已知GET路径(路径: String) -> Bool = 路径 = "/health" or 路径 = "/apps" or 路径 = "/search" or _前缀("/apps/", 路径)
  func _已知POST路径(路径: String) -> Bool = 路径 = "/token" or 路径 = "/publish" or 路径 = "/revoke"

  func _分发GET(路径: String, 参数: Dict, 应用表: Dict) -> Dict =
    if 路径 = "/health" then _响应帧(200, dict_from_pairs([["状态", "ok"], ["应用数", dict_size(应用表)]]))
    else if 路径 = "/apps" then _响应帧(200, dict_from_pairs([["应用数", dict_size(应用表)], ["应用", list_sort(dict_keys(应用表))]]))
    else if 路径 = "/search" then _处理搜索(应用表, dict_get(参数, "q", ""))
    else if _前缀("/apps/", 路径) then _处理详情(应用表, _去前缀("/apps/", 路径))
    else if _已知POST路径(路径) then _错误响应(405, "方法不允许: GET " + 路径)
    else _错误响应(404, "未知路由: " + 路径)

  func _分发POST(路径: String, 体: String, 索引: Dict) -> Dict =
    if 路径 = "/token" then _处理签发(体)
    else if 路径 = "/publish" then _处理发布(体, 索引)
    else if 路径 = "/revoke" then _处理吊销(体)
    else if _已知GET路径(路径) then _错误响应(405, "方法不允许: POST " + 路径)
    else _错误响应(404, "未知路由: " + 路径)

  func _分派方法(帧: Dict, 索引: Dict, 应用表: Dict) -> Dict =
    if 帧["方法"] = "GET" then _分发GET(帧["路径"], 帧["参数"], 应用表)
    else if 帧["方法"] = "POST" then _分发POST(帧["路径"], 帧["体"], 索引)
    else _错误响应(405, "方法不支持: " + 帧["方法"])

  func _分发索引(帧: Dict, 索引: Dict) -> Dict =
    if matha_type_of(索引) != "Dict" then _错误响应(500, "索引损坏：顶层须为字典")
    else _分发应用表(帧, 索引, dict_get(索引, "apps", dict_from_pairs([])))

  func _分发应用表(帧: Dict, 索引: Dict, 应用表: Dict) -> Dict =
    if matha_type_of(应用表) != "Dict" then _错误响应(500, "索引损坏：apps 须为字典")
    else _分派方法(帧, 索引, 应用表)

  func 分发(帧: Dict) -> Dict =
    let 载入 = 载入索引() in
    if dict_has(载入, "错误") then _错误响应(500, 载入["错误"])
    else _分发索引(帧, 载入["索引"])

  (* ---- ⑨ 顶层入口：原始请求文本 → {"响应","方法","路径","码"} ---- *)

  func 处理请求(原始: String) -> Dict =
    let 帧 = 解析请求(原始) in
    if dict_has(帧, "错误") then dict_from_pairs([["响应", _响应文本(400, dict_from_pairs([["错误", 帧["错误"]]]))], ["方法", ""], ["路径", ""], ["码", 400]])
    else _处理帧回执(帧, 分发(帧))
}

？#：{
  帧1 = 解析请求("GET /health HTTP/1.1\r\nHost: local\r\n\r\n")
  输出("方法=" + 帧1["方法"] + " 路径=" + 帧1["路径"])
  帧2 = 解析请求("GET /search?q=体积 HTTP/1.1\r\n\r\n")
  输出("q=" + 帧2["参数"]["q"])
  帧3 = 解析请求("坏请求")
  输出("拒绝面=" + 帧3["错误"])
  回 = 处理请求("GET /未知路由 HTTP/1.1\r\n\r\n")
  输出("未知路由码=" + str(回["码"]))
  输出("应用中心自测完成")
}
