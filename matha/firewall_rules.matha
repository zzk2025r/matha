# ============================================================
# Matha 防火墙规则 — 用 Matha 自身语言定义
#
# 语法说明：
#   @：变量 = 值        # 绑定变量
#   func 名(参:类型)->类型 = (参) => 表达式  # 函数定义
#   #1：[表达式]        # 输出语句
#
# 防火墙规则文件格式：
#   @：防火墙_级别 = "沙箱"    # 级别：沙箱 / 受限 / 全功能
#   @：拦截列表 = [规则列表]   # 每条规则是 {"builtin": 名, "action": "deny/allow", "reason": "..."}
#
# 本文件由防火墙引擎自动加载，用户也可手动编辑以自定义规则。
# ============================================================

# ── 防火墙级别 ───────────────────────────────────────────────
@：防火墙_级别 = "沙箱"

# ── 级别说明 ─────────────────────────────────────────────────
# 沙箱：只允许纯计算（加减乘除、数学函数、素数、统计）
#       禁止：文件I/O、外部求值、自升级、代码生成、自省操作
#
# 受限：允许基础数学 + 字符串操作
#       禁止：文件I/O、外部求值、自升级、代码生成
#
# 全功能：允许所有操作（包括文件读写、外部求值、自升级）

# ── 沙箱模式：被拦截的内建函数 ───────────────────────────────
# 文件 I/O 类
@：io_builtins = ["读文件", "写文件", "追加文件", "读JSON文件", "写JSON文件"]

# 外部求值类
@：net_builtins = ["外部求值", "对比实现", "对比升级"]

# 自升级类
@：upgrade_builtins = ["升级", "试运行"]

# 代码生成类
@：codegen_builtins = ["生成_网页", "生成_桌面", "生成_服务", "生成_系统", "生成_游戏", "生成_建模", "软件_构建"]

# 自省类
@：introspect_builtins = ["探针_状态", "探针_函数列表", "探针_已定义", "导出_AST", "导出_Token", "转译_Python", "转译_JS", "导出_符号表", "自主_调试", "自主_优化", "自主_成长"]

# 资源库类
@：resource_builtins = ["资源_列表", "资源_读取", "资源_加载", "资源_成长"]

# ── 合并所有被拦截的 builtin ───────────────────────────────
@：沙箱拦截列表 = io_builtins + net_builtins + upgrade_builtins + codegen_builtins + introspect_builtins + resource_builtins

# ── 允许在沙箱中使用的内建（白名单）──────────────────────────
@：沙箱允许 = ["ord", "chr", "len", "get", "slice", "append", "list", "token",
               "解析_JSON", "float", "int", "str", "bool",
               "截取", "替换", "查找", "分割", "拼接", "去空白", "小写", "大写",
               "映射", "过滤", "反转", "排序", "展平", "求和", "去重",
               "阶乘", "素数筛", "素数判定", "IntFactors",
               "平均值", "max", "min",
               "sin", "cos", "tan", "sqrt", "abs", "log", "log10",
               "运动_自由落体位移", "运动_匀速位移", "运动_斜抛射程",
               "换算_千米_米", "换算_米_千米", "换算_摄氏度_华氏度"]

# ── 受限模式：额外允许 ──────────────────────────────────────
# 受限模式在沙箱基础上额外允许：字符串操作、基础自省
@：受限额外允许 = ["探针_状态", "探针_函数列表", "探针_已定义"]

# ── 防火墙检查函数（供 Matha 代码调用）──────────────────────
#
# 用法示例（在 Matha 代码中）：
#   func 检查_防火墙(名)->Bool = (名) => 检查_是否拦截(名)
#
# 这些函数由防火墙引擎注入，此处仅为文档说明。

# ── 自验证：确保规则一致 ─────────────────────────────────────
# 检查：沙箱拦截列表不应包含沙箱允许列表中的项
# （由 firewall.py 中的 assert 验证）
