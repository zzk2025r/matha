module 终端词法器 {
  use 标准库 { len | 截取 }

  (* ============================================================
     终端词法器 —— 纯 Matha 实现（阶段 12a）
     ============================================================
     CMD 模板命令行 → token 列表：
       ["词", 文本] | ["管道", "|"] | ["重定向", ">"] | ["追加重定向", ">>"]
     规则：
       - 空行/全空白 → []（终端无操作，不报错）
       - 引号段（CMD 兼容）：引号内空白/管道/重定向符不具分隔功能，
         引号段与前后裸字符合并为同一词 token（如 a"b c"d → 一个词 "ab cd"）
       - 引号未闭合 → 显式拒绝（错误）
       - > 与 >> 相邻字符区分（dir>f 与 dir>>f 均可，无需空格）
     字符级扫描递归（与 matha/lexer.matha 扫描 同风格）：
       递归深度随行长线性增长，调用方须随行长抬高递归上限。 *)

  (* 主入口：命令行文本 → token 列表 *)
  func 终端词法分析(行: String) -> List =
    扫描(行, 0, "", 假, [])

  (* 字符扫描状态机：i 位置 / 当前词累积 / 是否在引号内 / 已产出 tokens *)
  func 扫描(行: String, i: Int, 当前: String, 在引号内: Bool, tokens: List) -> List =
    if i >= len(行) then
      if 在引号内 then
        错误("引号未闭合")
      else
        结束当前词(当前, tokens)
    else
      let c = 行[i] in
      if 在引号内 then
        if c = "\"" then
          扫描(行, i + 1, 当前, 假, tokens)
        else
          扫描(行, i + 1, 当前 + c, 真, tokens)
      else if c = "\"" then
        扫描(行, i + 1, 当前, 真, tokens)
      else if c = "|" then
        扫描(行, i + 1, "", 假, 结束当前词(当前, tokens) + [["管道", "|"]])
      else if c = ">" then
        if i + 1 < len(行) then
          if 行[i + 1] = ">" then
            扫描(行, i + 2, "", 假, 结束当前词(当前, tokens) + [["追加重定向", ">>"]])
          else
            扫描(行, i + 1, "", 假, 结束当前词(当前, tokens) + [["重定向", ">"]])
        else
          扫描(行, i + 1, "", 假, 结束当前词(当前, tokens) + [["重定向", ">"]])
      else if c = " " or c = "\t" or c = "\r" or c = "\n" then
        扫描(行, i + 1, "", 假, 结束当前词(当前, tokens))
      else
        扫描(行, i + 1, 当前 + c, 假, tokens)

  (* 非空当前词 → 追加 token；空 → 原样返回 *)
  func 结束当前词(当前: String, tokens: List) -> List =
    if 当前 = "" then tokens
    else tokens + [["词", 当前]]
}
