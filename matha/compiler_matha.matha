(* ============================================================
   Matha 自举编译器 — 纯 Matha 实现，零 Python 依赖
   ============================================================
   架构：.matha 源码 → Lexer → Parser → AST → M3V 字节码 → VM
   对标 src/compiler_matha.py 的完整功能。

   支持：
     - 两阶段编译：函数定义独立编译，主程序联合编译
     - M3V 字节码生成（PUSH_NUM, PUSH_STR, ADD, CALL 等）
     - 常量池管理
     - 函数注册与调用
   ============================================================ *)

module 编译器 {

  use 词法器 { Token | 类型 | 扫描 | 做Token }
  use 语法器
  use 标准库

  (* ===== M3V 操作码 ===== *)
  let OP_PUSH_NUM  = 0x01
  let OP_PUSH_STR  = 0x02
  let OP_PUSH_TR   = 0x03
  let OP_PUSH_LOCAL = 0x10
  let OP_PUSH_GLOBAL = 0x11
  let OP_STORE_LOCAL = 0x20
  let OP_STORE_GLOBAL = 0x21
  let OP_ADD      = 0x30
  let OP_SUB      = 0x31
  let OP_MUL      = 0x32
  let OP_DIV      = 0x33
  let OP_MOD      = 0x34
  let OP_POW      = 0x35
  let OP_NEG      = 0x36
  let OP_EQ       = 0x40
  let OP_NEQ      = 0x41
  let OP_LT       = 0x42
  let OP_GT       = 0x43
  let OP_LEQ      = 0x44
  let OP_GEQ      = 0x45
  let OP_AND      = 0x50
  let OP_OR       = 0x51
  let OP_NOT      = 0x52
  let OP_JMP      = 0x80
  let OP_JZ       = 0x81
  let OP_JNZ      = 0x82
  let OP_CALL     = 0x83
  let OP_RET      = 0x84
  let OP_RETURN   = 0x85
  let OP_FUNC_REG = 0x90
  let OP_FUNC_CALL = 0x91
  let OP_LIST_NEW = 0x92
  let OP_LIST_PUSH = 0x93
  let OP_LIST_GET = 0x94
  let OP_PRINT    = 0xA0
  let OP_INPUT    = 0xA1
  let OP_ERROR    = 0xA2
  let OP_HALT     = 0xFF

  (* ===== 字节码容器 ===== *)
  func 新字节码() -> Dict = () =>
    {"指令": [], "常量": [], "函数": {}, "全局": {}}

  func 发射(bc: Dict, opcode: Int, ?operands: List) -> Int = (bc, opcode, operands) =>
    let pos = 标准库.len(bc["指令"]) in
    let insns = if operands != None then bc["指令"] + [(opcode, operands)]
                else bc["指令"] + [(opcode, [])] in
    {"指令": insns, "常量": bc["常量"], "函数": bc["函数"], "全局": bc["全局"]}

  func 发射常量(bc: Dict, value) -> Int = (bc, value) =>
    let idx = 标准库.len(bc["常量"]) in
    let ctype = if 标准库.type_of(value) = "Int" or 标准库.type_of(value) = "Float" then "number"
                elif 标准库.type_of(value) = "String" then "string"
                else "number" in
    let constants = bc["常量"] + [(ctype, value)] in
    {"指令": bc["指令"], "常量": constants, "函数": bc["函数"], "全局": bc["全局"]}

  func 注册函数(bc: Dict, name: String, params: List, body_insns: List) -> Dict =
    (bc, name, params, body_insns) =>
    let body_len = _instr_byte_len(body_insns) in
    let funcs = bc["函数"] + [(name, (params, body_insns, body_len))] in
    {"指令": bc["指令"], "常量": bc["常量"], "函数": funcs, "全局": bc["全局"]}

  func _instr_byte_len(insns: List) -> Int = (insns) =>
    let rec _sum(i: Int, total: Int) -> Int =
      if i >= 标准库.len(insns) then total
      else
        let instr = insns[i] in
        let op = instr[0] in
        let ops = instr[1] in
        let op_len = if 标准库.len(ops) > 0 then 1 + 标准库.len(ops) * 4
                     else 1 in
        _sum(i + 1, total + op_len)
    in _sum(0, 0)

  (* ===== 序列化字节码 ===== *)
  func 字节码到字节(bc: Dict) -> List = (bc) =>
    let buf = ["M", "3", "V", 1] in  (* 魔数 + 版本 *)
    let buf2 = _写整数(buf, 标准库.len(bc["函数"])) in
    let buf3 = _写函数表(buf2, bc["函数"]) in
    let buf4 = _写常量池(buf3, bc["常量"]) in
    let buf5 = _写指令(buf4, bc["指令"]) in
    buf5

  and _写整数(buf: List, n: Int) -> List = (buf, n) =>
    let bytes_list = _int_to_bytes(n) in
    buf + bytes_list

  and _int_to_bytes(n: Int) -> List = (n) =>
    [
      n % 256,
      (n / 256) % 256,
      (n / 65536) % 256,
      (n / 16777216) % 256
    ]

  and _写函数表(buf: List, funcs: List) -> List = (buf, funcs) =>
    let rec _write(i: Int, acc: List) -> List =
      if i >= 标准库.len(funcs) then acc
      else
        let (name, (params, body, body_len)) = funcs[i] in
        let name_bytes = _str_to_bytes(name) in
        let acc2 = acc + [标准库.len(name_bytes) % 256, (标准库.len(name_bytes) / 256) % 256] + name_bytes + [0] in
        let acc3 = acc2 + _int_to_bytes(标准库.len(params)) in
        let acc4 = _write_params(acc3, params) in
        let acc5 = acc4 + _int_to_bytes(body_len) in
        let acc6 = _write_instrs(acc5, body) in
        _write(i + 1, acc6)
    in _write(0, buf)

  and _写_params(buf: List, params: List) -> List = (buf, params) =>
    let rec _write(i: Int, acc: List) -> List =
      if i >= 标准库.len(params) then acc
      else
        let p_bytes = _str_to_bytes(params[i]) in
        _write(i + 1, acc + [标准库.len(p_bytes) % 256, (标准库.len(p_bytes) / 256) % 256] + p_bytes + [0])
    in _write(0, buf)

  and _写常量池(buf: List, constants: List) -> List = (buf, constants) =>
    let buf = buf + _int_to_bytes(标准库.len(constants)) in
    let rec _write(i: Int, acc: List) -> List =
      if i >= 标准库.len(constants) then acc
      else
        let (ctype, cval) = constants[i] in
        if ctype = "number" then
          let n = 标准库.int(cval) in
          acc + [OP_PUSH_NUM] + _int_to_bytes(i)
        else if ctype = "string" then
          let s_bytes = _str_to_bytes(cval) in
          acc + [OP_PUSH_STR, 标准库.len(s_bytes) % 256, (标准库.len(s_bytes) / 256) % 256] + s_bytes
        else acc
      in _write(i + 1, buf)
    in _write(0, buf)

  and _写指令(buf: List, instructions: List) -> List = (buf, instructions) =>
    let buf = buf + _int_to_bytes(标准库.len(instructions)) in
    let rec _write(i: Int, acc: List) -> List =
      if i >= 标准库.len(instructions) then acc
      else
        let instr = instructions[i] in
        let opcode = instr[0] in
        let ops = instr[1] in
        let acc2 = acc + [opcode] in
        let acc3 = if 标准库.len(ops) > 0 then _write_ops(acc2, ops) else acc2 in
        _write(i + 1, acc3)
    in _write(0, buf)

  and _write_ops(buf: List, ops: List) -> List = (buf, ops) =>
    let rec _write(i: Int, acc: List) -> List =
      if i >= 标准库.len(ops) then acc
      else
        let op = ops[i] in
        if type_of(op) = "Int" or type_of(op) = "Float" then
          _write(i + 1, acc + _int_to_bytes(标准库.int(op)))
        else if type_of(op) = "String" then
          let op_bytes = _str_to_bytes(op) in
          _write(i + 1, acc + [标准库.len(op_bytes) % 256, (标准库.len(op_bytes) / 256) % 256] + op_bytes)
        else _write(i + 1, acc)
    in _write(0, buf)

  and _str_to_bytes(s: String) -> List = (s) =>
    let rec _encode(i: Int, acc: List) -> List =
      if i >= 标准库.len(s) then acc
      else _encode(i + 1, acc + [标准库.ord_matha(s[i])])
    in _encode(0, [])

  (* ===== AST → 字节码编译 ===== *)

  func 编译(source: String) -> List = (source) =>
    let toks = 词法器.扫描(source) in
    let ast = 语法器.parse(toks) in
    let bc = 新字节码() in
    let bc2 = _compile_program(ast, bc) in
    字节码到字节(bc2)

  func _compile_program(ast: Dict, bc: Dict) -> Dict = (ast, bc) =>
    let decls = ast["声明"] in
    let func_defs = _filter_funcs(decls) in
    let main_body = _filter_non_funcs(decls) in

    (* Phase 1: 编译函数定义 *)
    let bc1 = _compile_funcs(func_defs, bc) in

    (* Phase 2: 编译主程序 *)
    _compile_main(main_body, bc1)

  and _filter_funcs(decls: List) -> List = (decls) =>
    let rec _filter(i: Int, acc: List) -> List =
      if i >= 标准库.len(decls) then acc
      else if decls[i]["类型"] = "函数定义" then _filter(i + 1, acc + [decls[i]])
      else _filter(i + 1, acc)
    in _filter(0, [])

  and _filter_non_funcs(decls: List) -> List = (decls) =>
    let rec _filter(i: Int, acc: List) -> List =
      if i >= 标准库.len(decls) then acc
      else if decls[i]["类型"] != "函数定义" then _filter(i + 1, acc + [decls[i]])
      else _filter(i + 1, acc)
    in _filter(0, [])

  and _compile_funcs(func_defs: List, bc: Dict) -> Dict = (func_defs, bc) =>
    let rec _compile(i: Int, acc: Dict) -> Dict =
      if i >= 标准库.len(func_defs) then acc
      else
        let func = func_defs[i] in
        let body_insns = _compile_func_body(func, acc) in
        let acc2 = 注册函数(acc, func["名"], func["参数"], body_insns) in
        _compile(i + 1, acc2)
    in _compile(0, bc)

  and _compile_func_body(func: Dict, parent_bc: Dict) -> List = (func, parent_bc) =>
    let body_expr = func["体"]["体"] if func["体"]["类型"] = "lambda" else func["体"] in
    _emit_expr(body_expr, parent_bc, [])

  and _compile_main(decls: List, bc: Dict) -> Dict = (decls, bc) =>
    let rec _compile(i: Int, acc: Dict) -> Dict =
      if i >= 标准库.len(decls) then
        let acc2 = 发射(acc, OP_HALT) in
        acc2
      else
        let decl = decls[i] in
        let acc2 = _emit_stmt(decl, acc) in
        _compile(i + 1, acc2)
    in _compile(0, bc)

  and _emit_stmt(stmt: Dict, bc: Dict) -> Dict = (stmt, bc) =>
    if stmt["类型"] = "绑定" then
      let bc2 = _emit_expr(stmt["值"], bc, []) in
      发射(bc2, OP_STORE_GLOBAL, [stmt["名"]])
    else if stmt["类型"] = "输出" then
      let bc2 = _emit_expr(stmt["expr"], bc, []) in
      发射(bc2, OP_PRINT)
    else
      let bc2 = _emit_expr(stmt, bc, []) in
      发射(bc2, OP_PRINT)

  and _emit_expr(expr: Dict, bc: Dict, locals: List) -> List = (expr, bc, locals) =>
    let insns = bc["指令"] in
    if expr["类型"] = "整数" then
      let bc2 = 发射常量(bc, expr["值"]) in
      bc2["指令"] + [(OP_PUSH_STR, [标准库.len(bc2["常量"]) - 1])]
    else if expr["类型"] = "浮点" then
      let bc2 = 发射常量(bc, expr["值"]) in
      bc2["指令"] + [(OP_PUSH_NUM, [标准库.len(bc2["常量"]) - 1])]
    else if expr["类型"] = "字符串" then
      let bc2 = 发射常量(bc, expr["值"]) in
      bc2["指令"] + [(OP_PUSH_STR, [标准库.len(bc2["常量"]) - 1])]
    else if expr["类型"] = "布尔" then
      let val = if expr["值"] then 1.0 else 0.0 in
      let bc2 = 发射常量(bc, val) in
      bc2["指令"] + [(OP_PUSH_NUM, [标准库.len(bc2["常量"]) - 1])]
    else if expr["类型"] = "变量" then
      insns + [(OP_PUSH_GLOBAL, [expr["名"]])]
    else if expr["类型"] = "二元运算" then
      let left_insns = _emit_expr(expr["左"], bc, locals) in
      let right_insns = _emit_expr(expr["右"], bc, locals) in
      let op_map = {
        "+": OP_ADD, "-": OP_SUB, "*": OP_MUL, "/": OP_DIV,
        "%": OP_MOD, "^": OP_POW,
        "==": OP_EQ, "!=": OP_NEQ, "<": OP_LT, ">": OP_GT,
        "<=": OP_LEQ, ">=": OP_GEQ,
        "and": OP_AND, "or": OP_OR,
      } in
      let opcode = op_map[expr["运算符"]] in
      right_insns + [opcode]
    else if expr["类型"] = "一元运算" then
      let op_insns = _emit_expr(expr["操作数"], bc, locals) in
      if expr["运算符"] = "-" then op_insns + [OP_NEG]
      else if expr["运算符"] = "not" or expr["运算符"] = "非" then op_insns + [OP_NOT]
      else op_insns
    else if expr["类型"] = "函数应用" then
      let func_insns = _emit_expr(expr["函数"], bc, locals) in
      let arg_insns = _emit_expr(expr["参数"], bc, locals) in
      arg_insns + [(OP_FUNC_CALL, [1])]
    else if expr["类型"] = "if" then
      let cond_insns = _emit_expr(expr["条件"], bc, locals) in
      let else_pos = 标准库.len(cond_insns) + 1 in
      let then_insns = _emit_expr(expr["真分支"], bc, locals) in
      let jump_pos = 标准库.len(cond_insns) + 标准库.len(then_insns) + 2 in
      let else_insns = if expr["假分支"] != None then
                         _emit_expr(expr["假分支"], bc, locals)
                       else [] in
      let patched_cond = _patch_jz(cond_insns, else_pos) in
      let patched_then = _patch_jmp(then_insns, jump_pos) in
      patched_cond + patched_then + else_insns
    else
      insns

  and _patch_jz(insns: List, target: Int) -> List = (insns, target) =>
    let last = 标准库.len(insns) - 1 in
    insns[:last] + [(OP_JZ, [target])]

  and _patch_jmp(insns: List, target: Int) -> List = (insns, target) =>
    let last = 标准库.len(insns) - 1 in
    insns[:last] + [(OP_JMP, [target])]

  (* ===== 便捷入口 ===== *)
  func compile(source: String) -> List = (source) =>
    编译(source)

}

(* ===== 自测 ===== *)
#：{
  (* 测试：编译简单表达式 *)
  source = "3 + 5"
  bc = 编译器.编译(source)
  [标准库.len(bc)]
}
