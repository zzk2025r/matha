(* ============================================================
   Matha 基础示例
   运行：matha run examples/basic_examples.matha
   四端一致：解释器 / 字节码 VM / 自举编译器 / x86-64 原生
   ============================================================ *)

(* ---------- 1. 基础计算 ---------- *)
结果 = 1 + 2 * 3
输出(结果)                  (* 7 *)

a = 2
b = 3
c = 4
输出(a + b * c)             (* 14 *)
输出(a ^ 10)                (* 1024，中缀次方 *)
输出(^9)                    (* 3，前缀开方 *)

(* ---------- 2. 三角函数 ---------- *)
圆周率 = 3.141592653589793
输出(sin(圆周率 / 2))        (* 1.0 *)
输出(cos(0))                (* 1.0 *)

(* ---------- 3. 函数与递归 ---------- *)
func 阶乘(n) -> Int = (n) => n <= 1 ? 1 : n * 阶乘(n - 1)
输出(阶乘(6))               (* 720 *)

func 斐波那契(n) -> Int = (n) => n < 2 ? n : 斐波那契(n - 1) + 斐波那契(n - 2)
输出(斐波那契(10))           (* 55 *)

(* ---------- 4. 条件表达式 ---------- *)
func 符号(n) -> Int = (n) => if n < 0 then -1 else 1
输出(符号(-5))              (* -1 *)
输出(符号(5))               (* 1 *)

(* ---------- 5. 列表 ---------- *)
数字列表 = [1, 2, 3, 4, 5]
输出(len(数字列表))          (* 5 *)
输出(数字列表[0] + 数字列表[4])  (* 6 *)
输出(sum(数字列表))          (* 15 *)

(* ---------- 6. 字符串 ---------- *)
问候 = "hello, world"
输出(len(问候))             (* 12 *)
输出(问候[0])               (* h *)

(* ---------- 7. 高阶函数与闭包 ---------- *)
加 = (y) => (x) => x + y
输出(加(3)(4))              (* 7 *)

组合 = (f) => (g) => (x) => f(g(x))
inc = (x) => x + 1
双重 = (x) => x * 2
h = 组合(inc)(双重)
输出(h(5))                  (* 11 *)

输出("所有示例运行完毕")
