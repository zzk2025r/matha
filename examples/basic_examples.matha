# -*- coding: utf-8 -*-
"""Matha 示例集合。"""

# ============================================================
# 示例 1：基础计算
# ============================================================

# Matha 支持中文函数名
结果 = 1 + 2 * 3
print(结果)  # 7

# 三角函数
圆周率 = 3.141592653589793
正弦值 = sin(圆周率 / 2)
print(正弦值)  # 1.0

# ============================================================
# 示例 2：函数定义
# ============================================================

def 阶乘(n):
    """计算阶乘。"""
    if n <= 1:
        return 1
    return n * 阶乘(n - 1)

print(阶乘(10))  # 3628800

# ============================================================
# 示例 3：列表操作
# ============================================================

数字列表 = [1, 2, 3, 4, 5]
平方列表 = map(lambda x: x * x, 数字列表)
print(平方列表)  # [1, 4, 9, 16, 25]

过滤列表 = filter(lambda x: x > 2, 数字列表)
print(过滤列表)  # [3, 4, 5]

# ============================================================
# 示例 4：字符串操作
# ============================================================

问候 = "hello, world"
print(upper(问候))     # "HELLO, WORLD"
print(split(",", "a,b,c"))  # ["a", "b", "c"]

# ============================================================
# 示例 5：JSON 处理
# ============================================================

数据 = json_dumps({"name": "Matha", "version": 4.5})
print(数据)  # {"name": "Matha", "version": 4.5}

解析 = json_loads('{"a": 1, "b": 2}')
print(解析)  # {"a": 1, "b": 2}

# ============================================================
# 示例 6：随机数
# ============================================================

随机整数 = random_int(1, 100)
随机浮点 = random_float()
print(f"随机整数: {随机整数}")
print(f"随机浮点: {随机浮点}")

# ============================================================
# 示例 7：领域模块 - 神经网络
# ============================================================

# 创建神经网络
nn = create_neural_network(input_size=784, hidden_size=128, output_size=10)
print(nn)

# ============================================================
# 示例 8：领域模块 - 区块链
# ============================================================

区块链 = create_blockchain()
交易 = create_transaction(from_addr="Alice", to_addr="Bob", amount=100)
print(区块链)

# ============================================================
# 示例 9：并发编程
# ============================================================

# 使用 Future/Promise
f = Future()
f.set_result(42)
print(f.result)  # 42

# 使用并行计算
结果 = Parallel.map(lambda x: x * 2, [1, 2, 3])
print(结果)  # [2, 4, 6]

# ============================================================
# 示例 10：图形渲染
# ============================================================

画布 = Canvas(800, 600)
画布.fill_rect(0, 0, 800, 600, Color.black)
画布.fill_circle(400, 300, 100, Color.red)
画布.save("output.json")

print("所有示例运行完毕！")
