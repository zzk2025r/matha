(* 资源库：通用工具数学
   覆盖：日期时间、单位换算、图像处理、数据压缩
   ============================================================ *)

module 工具数学 {

  (* ===== 日期时间 ===== *)
  func 闰年判断(年: Int) -> Bool =
    (年) => (年 % 4 = 0) and ((年 % 100 != 0) or (年 % 400 = 0))

  func 月份天数(月: Int, 年: Int) -> Int =
    (月, 年) =>
    case 月 of
      2 -> if 闰年判断(年) then 29 else 28
      4, 6, 9, 11 -> 30
      _ -> 31

  func 年内天数(年: Int) -> Int =
    (年) => if 闰年判断(年) then 366 else 365

  func 日期差(年1: Int, 月1: Int, 日1: Int, 年2: Int, 月2: Int, 日2: Int) -> Int =
    (* 简化：返回天数差 *)
    (年1, 月1, 日1, 年2, 月2, 日2) =>
    (年2 - 年1) * 365 + (月2 - 月1) * 30 + (日2 - 日1)

  func 时间戳转日期(时间戳: Int) -> Int =
    (* 简化：返回年 *)
    (时间戳) => 1970 + 时间戳 / (365 * 24 * 3600)

  func 周几计算(年: Int, 月: Int, 日: Int) -> Int =
    (* Zeller公式简化 *)
    (年, 月, 日) =>
    let y = if 月 <= 2 then 年 - 1 else 年 in
    let m = if 月 <= 2 then 月 + 12 else 月 in
    (日 + int(2.6 * m - 0.2) + y + int(y/4) - int(y/100) + int(y/400)) % 7

  (* ===== 单位换算 ===== *)
  func 长度换算(值: Float, 从: String, 到: String) -> Float =
    (* 简化：米到厘米 *)
    (值, 从, 到) =>
    case (从, 到) of
      ("米", "厘米") -> 值 * 100
      ("米", "毫米") -> 值 * 1000
      ("千米", "米") -> 值 * 1000
      ("英寸", "厘米") -> 值 * 2.54
      ("英尺", "米") -> 值 * 0.3048
      _ -> 值

  func 重量换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    case (从, 到) of
      ("千克", "克") -> 值 * 1000
      ("磅", "千克") -> 值 * 0.453592
      ("吨", "千克") -> 值 * 1000
      _ -> 值

  func 温度换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    case (从, 到) of
      ("摄氏", "开尔文") -> 值 + 273.15
      ("开尔文", "摄氏") -> 值 - 273.15
      ("摄氏", "华氏") -> 值 * 9/5 + 32
      ("华氏", "摄氏") -> (值 - 32) * 5/9
      _ -> 值

  func 面积换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    case (从, 到) of
      ("平方米", "平方英尺") -> 值 * 10.7639
      ("公顷", "平方米") -> 值 * 10000
      ("亩", "平方米") -> 值 * 666.67
      _ -> 值

  func 体积换算(值: Float, 从: String, 到: String) -> Float =
    (值, 从, 到) =>
    case (从, 到) of
      ("升", "毫升") -> 值 * 1000
      ("加仑", "升") -> 值 * 3.78541
      ("立方米", "升") -> 值 * 1000
      _ -> 值

  (* ===== 数据处理 ===== *)
  func 数据压缩比(原始: Int, 压缩: Int) -> Float =
    (原始, 压缩) =>
    (压缩 = 0) ? 0 : 原始 / 压缩

  func 数据压缩率(原始: Int, 压缩: Int) -> Float =
    (原始, 压缩) =>
    (原始 = 0) ? 0 : 1.0 - 压缩 / 原始

  func 信噪比(信号功率: Float, 噪声功率: Float) -> Float =
    (信号功率, 噪声功率) =>
    (噪声功率 = 0) ? 999.0 : 10.0 * log10(信号功率 / 噪声功率)

  func 数据熵(符号列表: List, 概率列表: List) -> Float =
    (* Shannon熵: -Σ p * log2(p) *)
    (符号列表, 概率列表) =>
    let n = min(len(符号列表), len(概率列表)) in
    let rec calc(i: Int, acc: Float) -> Float =
      (i, acc) =>
        if i >= n: acc
        elif 概率列表[i] <= 0: calc(i+1, acc)
        else: calc(i+1, acc - 概率列表[i] * log2(概率列表[i]))
    calc(0, 0)

  func 香农编码长度(概率: Float) -> Float =
    (* -log2(p) *)
    (概率) =>
    if 概率 <= 0 then 999.0
    else -log2(概率)

  (* ===== 图像处理工具 ===== *)
  func 图像分辨率(宽: Int, 高: Int) -> Int =
    (宽, 高) => 宽 * 高

  func 图像宽高比(宽: Int, 高: Int) -> Float =
    (宽, 高) =>
    (高 = 0) ? 0 : 宽 / 高

  func 图像像素密度(ppi: Int, 尺寸英寸: Float) -> Int =
    (ppi, 尺寸英寸) => ppi

  func 色彩深度位数(颜色数: Int) -> Int =
    (* log2(颜色数) *)
    (颜色数) =>
    let rec log2(n: Int, acc: Int) -> Int =
      (n, acc) => if n <= 1: acc else log2(n/2, acc+1)
    log2(颜色数, 0)

  (* ===== 文件格式 ===== *)
  func JPEG压缩率(原始大小: Int, 压缩大小: Int) -> Float =
    (原始大小, 压缩大小) =>
    (原始大小 = 0) ? 0 : 原始大小 / 压缩大小

  func PNG无损压缩率(原始: Int, 压缩: Int) -> Float =
    (原始, 压缩) =>
    (压缩 = 0) ? 0 : 原始 / 压缩

  func MP4码率(文件大小: Float, 时长: Float) -> Float =
    (文件大小, 时长) =>
    (时长 = 0) ? 0 : 文件大小 * 8 / 时长  (* kbps *)
}
