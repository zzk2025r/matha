(* ============================================================
   Matha 自举测试套件
   ------------------------------------------------------------
   验证所有 Matha 核心模块（lexer / parser / interpreter）
   在纯 Matha 环境下的正确性。
   
   测试覆盖：
     1. 词法器：Token 生成正确性
     2. 语法器：表达式解析正确性
     3. 解释器：求值正确性
     4. 端到端：Matha 源码 → Token → AST → Value
   ============================================================ *)

module 自举测试 {

  use 词法器 { Token | 类型 | 扫描 | 做Token }
  use 语法器
  use 解释器

  (* ===== 测试框架 ===== *)
  var 通过数 = 0
  var 失败数 = 0

  func 断言(名称: String, 实际, 期望) -> Bool = (名称, 实际, 期望) =>
    if 实际 = 期望 then
      通过数 = 通过数 + 1
      [名称 + ": ✓ " + str(实际)]
    else
      失败数 = 失败数 + 1
      [名称 + ": ✗ 期望 " + str(期望) + " 实际 " + str(实际)]
      假

  func 断言真(名称: String, 实际: Bool) -> Bool = (名称, 实际) =>
    断言(名称, 实际, 真)

  func 断言近似(名称: String, 实际: Float, 期望: Float) -> Bool = (名称, 实际, 期望) =>
    let diff = abs(实际 - 期望) in
    断言(名称, diff < 0.0001, 真)

  (* ===== 测试 1：词法器 ===== *)
  #1：【词法器测试】
  {
    (* 1.1 整数 *)
    toks1 = 词法器.扫描("42")
    断言("整数Token", toks1[0].类型, 类型.整数)
    断言("整数值", toks1[0].文本, "42")

    (* 1.2 标识符 *)
    toks2 = 词法器.扫描("x")
    断言("标识符Token", toks2[0].类型, 类型.标识符)
    断言("标识符值", toks2[0].文本, "x")

    (* 1.3 运算符 *)
    toks3 = 词法器.扫描("+ - * /")
    断言("加号", toks3[0].类型, 类型.加)
    断言("减号", toks3[1].类型, 类型.减)
    断言("乘号", toks3[2].类型, 类型.乘)
    断言("除号", toks3[3].类型, 类型.除)

    (* 1.4 括号 *)
    toks4 = 词法器.扫描("( ) [ ] { }")
    断言("左括号", toks4[0].类型, 类型.左括号)
    断言("右括号", toks4[1].类型, 类型.右括号)
    断言("左方括号", toks4[2].类型, 类型.左括号方)
    断言("右方括号", toks4[3].类型, 类型.右括号方)
    断言("左花括号", toks4[4].类型, 类型.左括号花)
    断言("右花括号", toks4[5].类型, 类型.右括号花)

    (* 1.5 关键字 *)
    toks5 = 词法器.扫描("func if while for match")
    断言("func关键字", toks5[0].类型, 类型.关键字)
    断言("if关键字", toks5[1].类型, 类型.关键字)
    断言("while关键字", toks5[2].类型, 类型.关键字)
    断言("for关键字", toks5[3].类型, 类型.关键字)
    断言("match关键字", toks5[4].类型, 类型.关键字)

    (* 1.6 多字符操作符 *)
    toks6 = 词法器.扫描("=> -> != <= >= << >>")
    断言("胖箭头", toks6[0].类型, 类型.胖箭头)
    断言("箭头", toks6[1].类型, 类型.箭头)
    断言("不等于", toks6[2].类型, 类型.不等于)
    断言("小于等于", toks6[3].类型, 类型.小于等于)
    断言("大于等于", toks6[4].类型, 类型.大于等于)
    断言("左移/角度", toks6[5].类型, 类型.左括号)
    断言("右移/链式", toks6[6].类型, 类型.管道)

    (* 1.7 字符串 *)
    toks7 = 词法器.扫描('"hello"')
    断言("字符串", toks7[0].类型, 类型.字符串)
    断言("字符串值", toks7[0].文本, "hello")

    (* 1.8 布尔 *)
    toks8 = 词法器.扫描("真 假 true false")
    断言("真", toks8[0].类型, 类型.布尔)
    断言("假", toks8[1].类型, 类型.布尔)
    断言("true", toks8[2].类型, 类型.布尔)
    断言("false", toks8[3].类型, 类型.布尔)

    (* 1.9 结束 *)
    toks9 = 词法器.扫描("")
    断言("结束Token", toks9[0].类型, 类型.结束)
  }

  (* ===== 测试 2：语法器 ===== *)
  #2：【语法器测试】
  {
    (* 2.1 整数字面量 *)
    toks = 词法器.扫描("42")
    ast = 语法器.parse(toks)
    断言("整数AST", ast.类型, "程序")

    (* 2.2 变量引用 *)
    toks = 词法器.扫描("x")
    ast = 语法器.parse(toks)
    断言("变量AST", ast.声明[0].类型, "变量")

    (* 2.3 二元运算 *)
    toks = 词法器.扫描("a + b")
    ast = 语法器.parse(toks)
    断言("二元运算AST", ast.声明[0].类型, "二元运算")
    断言("二元运算符", ast.声明[0].运算符, "+")

    (* 2.4 函数定义 *)
    toks = 词法器.扫描("func 加一(x: Int) -> Int = (x) => x + 1")
    ast = 语法器.parse(toks)
    断言("函数定义AST", ast.声明[0].类型, "函数定义")
    断言("函数名", ast.声明[0].名, "加一")

    (* 2.5 Lambda *)
    toks = 词法器.扫描("(x) => x + 1")
    ast = 语法器.parse(toks)
    断言("LambdaAST", ast.类型, "lambda")
  }

  (* ===== 测试 3：解释器 ===== *)
  #3：【解释器测试】
  {
    env = 解释器.注册内建(解释器.空环境())

    (* 3.1 整数运算 *)
    expr1 = 语法器.做BinaryOp("+", 语法器.做IntLit(3), 语法器.做IntLit(5))
    断言近似("加法", 解释器.求值(expr1, env), 8.0)

    expr2 = 语法器.做BinaryOp("*", 语法器.做IntLit(4), 语法器.做IntLit(5))
    断言近似("乘法", 解释器.求值(expr2, env), 20.0)

    expr3 = 语法器.做BinaryOp("-", 语法器.做IntLit(10), 语法器.做IntLit(3))
    断言近似("减法", 解释器.求值(expr3, env), 7.0)

    expr4 = 语法器.做BinaryOp("/", 语法器.做IntLit(10), 语法器.做IntLit(2))
    断言近似("除法", 解释器.求值(expr4, env), 5.0)

    (* 3.2 幂运算 *)
    expr5 = 语法器.做BinaryOp("^", 语法器.做IntLit(2), 语法器.做IntLit(10))
    断言近似("幂", 解释器.求值(expr5, env), 1024.0)

    (* 3.3 比较运算 *)
    expr6 = 语法器.做BinaryOp(">", 语法器.做IntLit(5), 语法器.做IntLit(3))
    断言真("大于", 解释器.求值(expr6, env) = 真)

    expr7 = 语法器.做BinaryOp("<", 语法器.做IntLit(5), 语法器.做IntLit(3))
    断言真("小于", 解释器.求值(expr7, env) = 假)

    expr8 = 语法器.做BinaryOp("=", 语法器.做IntLit(5), 语法器.做IntLit(5))
    断言真("等于", 解释器.求值(expr8, env) = 真)

    (* 3.4 三元条件 *)
    cond = 语法器.做BinaryOp(">", 语法器.做IntLit(1), 语法器.做IntLit(2))
    expr9 = 语法器.做If(cond, 语法器.做IntLit(100), 语法器.做IntLit(200))
    断言近似("三元假", 解释器.求值(expr9, env), 200.0)

    cond2 = 语法器.做BinaryOp(">", 语法器.做IntLit(2), 语法器.做IntLit(1))
    expr10 = 语法器.做If(cond2, 语法器.做IntLit(100), 语法器.做IntLit(200))
    断言近似("三元真", 解释器.求值(expr10, env), 100.0)

    (* 3.5 变量绑定 + 求值 *)
    env2 = 解释器.绑定环境(env, "x", 10)
    expr11 = 语法器.做Variable("x")
    断言近似("变量", 解释器.求值(expr11, env2), 10.0)

    (* 3.6 Lambda + 函数应用 *)
    lam = 语法器.做Lambda(
      [语法器.做Variable("x")],
      语法器.做BinaryOp("+", 语法器.做Variable("x"), 语法器.做IntLit(1))
    )
    env3 = 解释器.绑定环境(env, "加一", lam)
    expr12 = 语法器.做FuncApp(语法器.做Variable("加一"), 语法器.做IntLit(5))
    断言近似("Lambda应用", 解释器.求值(expr12, env3), 6.0)

    (* 3.7 柯里化 *)
    curry_lam = 语法器.做Lambda(
      [语法器.做Variable("a"), 语法器.做Variable("b")],
      语法器.做BinaryOp("+", 语法器.做Variable("a"), 语法器.做Variable("b"))
    )
    env4 = 解释器.绑定环境(env, "加", curry_lam)
    applied1 = 语法器.做FuncApp(语法器.做Variable("加"), 语法器.做IntLit(3))
    applied2 = 语法器.做FuncApp(applied1, 语法器.做IntLit(5))
    断言近似("柯里化", 解释器.求值(applied2, env4), 8.0)

    (* 3.8 内建函数 *)
    expr13 = 语法器.做BinaryOp("*", 语法器.做IntLit(2), 语法器.做IntLit(3))
    env5 = 解释器.绑定环境(env, "result", 解释器.求值(expr13, env))
    expr14 = 语法器.做Variable("result")
    断言近似("内建环境", 解释器.求值(expr14, env5), 6.0)

    (* 3.9 嵌套 Lambda (compose) *)
    compose = 语法器.做Lambda(
      [语法器.做Variable("f"), 语法器.做Variable("g")],
      语法器.做Lambda(
        [语法器.做Variable("x")],
        语法器.做FuncApp(
          语法器.做Variable("f"),
          语法器.做FuncApp(语法器.做Variable("g"), 语法器.做Variable("x"))
        )
      )
    )
    add_one = 语法器.做Lambda([语法器.做Variable("x")],
      语法器.做BinaryOp("+", 语法器.做Variable("x"), 语法器.做IntLit(1)))
    double = 语法器.做Lambda([语法器.做Variable("x")],
      语法器.做BinaryOp("*", 语法器.做Variable("x"), 语法器.做IntLit(2)))
    env6 = 解释器.绑定环境(
      解释器.绑定环境(env, "compose", compose),
      "加一", add_one
    )
    env7 = 解释器.绑定环境(env6, "加倍", double)
    h = 语法器.做FuncApp(
      语法器.做FuncApp(语法器.做Variable("compose"), 语法器.做Variable("加一")),
      语法器.做Variable("加倍")
    )
    result = 语法器.做FuncApp(h, 语法器.做IntLit(5))
    断言近似("Compose", 解释器.求值(result, env7), 11.0)
  }

  (* ===== 测试 4：端到端 Matha 源码执行 ===== *)
  #4：【端到端测试】
  {
    (* 4.1 阶乘 *)
    src1 = """
      func 阶乘(n: Int) -> Int = (n) =>
        n <= 1 ? 1 : n * 阶乘(n - 1)
      #：{
        [阶乘(6)]
      }
    """
    toks1 = 词法器.扫描(src1)
    ast1 = 语法器.parse(toks1)
    env1 = 解释器.注册内建(解释器.空环境())
    (_, env1b) = 解释器.执行声明列表(ast1.声明, env1)
    result1 = 解释器.查找环境(env1b, "阶乘")
    断言近似("阶乘(6)", result1, 720.0)

    (* 4.2 斐波那契 *)
    src2 = """
      func 斐波那契(n: Int) -> Int = (n) =>
        n <= 1 ? n : 斐波那契(n - 1) + 斐波那契(n - 2)
      #：{
        [斐波那契(10)]
      }
    """
    toks2 = 词法器.扫描(src2)
    ast2 = 语法器.parse(toks2)
    env2 = 解释器.注册内建(解释器.空环境())
    (_, env2b) = 解释器.执行声明列表(ast2.声明, env2)
    result2 = 解释器.查找环境(env2b, "斐波那契")
    断言近似("斐波那契(10)", result2, 55.0)
  }

  (* ===== 测试结果汇总 ===== *)
  #5：【汇总】
  {
    [通过数]
    [失败数]
    [通过数 + 失败数]
  }
}

(* ===== 运行测试 ===== *)
#100：【运行所有测试】 >> #1 >> #2 >> #3 >> #4 >> #5
