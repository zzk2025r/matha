(* 学科知识：工程 — 电气工程基础
   覆盖：电路分析、交流电路
   ============================================================ *)

module 电气 {

  func 欧姆定律(V: Float, R: Float) -> Float = (V, R) => V / R
  func 电功率(V: Float, I: Float) -> Float = (V, I) => V * I
  func 串联电阻(R1: Float, R2: Float) -> Float = (R1, R2) => R1 + R2
  func 并联电阻(R1: Float, R2: Float) -> Float =
    (R1, R2) => R1 * R2 / (R1 + R2)

  func 感抗(ω: Float, L: Float) -> Float = (ω, L) => ω * L
  func 容抗(ω: Float, C: Float) -> Float = (ω, C) => 1 / (ω * C)
  func 阻抗(R: Float, XL: Float, XC: Float) -> Float =
    (R, XL, XC) => 开方(R*R + (XL - XC)*(XL - XC))

  func 谐振频率(L: Float, C: Float) -> Float =
    (L, C) => 1 / (2 * 3.14159 * 开方(L * C))
}
