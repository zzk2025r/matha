(* 学科知识：生物学 — 细胞
   覆盖：细胞类型、DNA碱基配对、分裂计算
   ============================================================ *)

module 细胞 {

  func 分裂后数量(初始数: Int, 次数: Int) -> Int =
    (初始数, 次数) => 初始数 * 2 ^ 次数

  func DNA长度纳米(碱基数: Int) -> Float =
    (碱基数) => 碱基数 * 0.34

  func 蛋白质质量道尔顿(氨基酸数: Int) -> Float =
    (氨基酸数) => 氨基酸数 * 110.0
}
