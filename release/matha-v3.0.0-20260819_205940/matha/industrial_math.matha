(* 资源库：工业与嵌入式系统数学
   覆盖：自动控制、传感器、电机控制、通信协议、PLC逻辑
   ============================================================ *)

module 工业嵌入式 {

  (* ===== 自动控制 ===== *)
  func 传递函数极点(分子系数: List, 分母系数: List) -> List =
    (* 简化：返回分母系数 *)
    (分子系数, 分母系数) => 分母系数

  func PID输出(Kp: Float, Ki: Float, Kd: Float, 误差: Float, 积分: Float, 微分: Float) -> Float =
    (Kp, Ki, Kd, 误差, 积分, 微分) =>
    Kp * 误差 + Ki * 积分 + Kd * 微分

  func 阶跃响应上升时间(带宽: Float) -> Float =
    (* tr ≈ 0.35 / BW *)
    (带宽) =>
    (带宽 = 0) ? 0 : 0.35 / 带宽

  func 稳态误差(开环增益: Float, 系统类型: Int) -> Float =
    (* 简化：1型系统对阶跃输入稳态误差为0 *)
    (开环增益, 系统类型) =>
    if 系统类型 >= 1 then 0
    else 1 / (1 + 开环增益)

  func 相位裕度(增益穿越频率: Float, 相位: Float) -> Float =
    (增益穿越频率, 相位) => 180 + 相位

  func 增益裕度(相位穿越频率: Float, 增益: Float) -> Float =
    (相位穿越频率, 增益) =>
    (增益 = 0) ? 0 : 1 / 增益

  (* ===== 传感器 ===== *)
  func 热电偶温度(电动势: Float, 灵敏度: Float) -> Float =
    (电动势, 灵敏度) =>
    (灵敏度 = 0) ? 0 : 电动势 / 灵敏度

  func 应变片应变量(电阻变化: Float, 原始电阻: Float, 灵敏系数: Float) -> Float =
    (电阻变化, 原始电阻, 灵敏系数) =>
    (原始电阻 * 灵敏系数 = 0) ? 0 : 电阻变化 / (原始电阻 * 灵敏系数)

  func 加速度计角度(ax: Float, ay: Float, az: Float) -> (Float, Float, Float) =
    (ax, ay, az) =>
    (atan2(ay, az), atan2(-ax, 开方(ay*ay + az*az)), 0)

  func 陀螺仪角度(角速度: Float, 采样时间: Float) -> Float =
    (角速度, 采样时间) => 角速度 * 采样时间

  func 传感器融合(加速度角度: Float, 陀螺仪角度: Float, α: Float) -> Float =
    (* 互补滤波器 *)
    (加速度角度, 陀螺仪角度, α) =>
    α * 加速度角度 + (1 - α) * 陀螺仪角度

  (* ===== 电机控制 ===== *)
  func 步进电机步数(角度: Float, 步距角: Float) -> Int =
    (角度, 步距角) =>
    (步距角 = 0) ? 0 : int(角度 / 步距角)

  func 直流电机转速(电压: Float, 电机常数: Float) -> Float =
    (电压, 电机常数) =>
    (电机常数 = 0) ? 0 : 电压 / 电机常数

  func 电机扭矩(电流: Float, 扭矩常数: Float) -> Float =
    (电流, 扭矩常数) => 电流 * 扭矩常数

  func 编码器脉冲(圈数: Float, 分辨率: Int) -> Int =
    (圈数, 分辨率) => int(圈数 * 分辨率)

  (* ===== 通信协议 ===== *)
  func CRC8校验(数据: List, 多项式: Int) -> Int =
    (* 简化：返回数据异或 *)
    (数据, 多项式) =>
    let rec crc(i: Int, acc: Int) -> Int =
      (i, acc) =>
        if i >= len(数据): acc
        else: crc(i+1, acc XOR 数据[i])
    crc(0, 0)

  func UART波特率(时钟频率: Int, 分频系数: Int) -> Int =
    (时钟频率, 分频系数) =>
    (分频系数 = 0) ? 0 : 时钟频率 / 分频系数

  func I2C总线速度(时钟频率: Int) -> Int =
    (* 标准模式100kHz, 快速模式400kHz *)
    (时钟频率) => 100000

  func SPI时钟频率(分频: Int, 主时钟: Int) -> Int =
    (分频, 主时钟) =>
    (分频 = 0) ? 0 : 主时钟 / 分频

  (* ===== PLC逻辑 ===== *)
  func 梯形图与门(a: Bool, b: Bool) -> Bool =
    (a, b) => a and b

  func 梯形图或门(a: Bool, b: Bool) -> Bool =
    (a, b) => a or b

  func 梯形图非门(a: Bool) -> Bool =
    (a) => not a

  func 定时器TON(输入: Bool, 预设时间: Float, 当前时间: Float) -> Bool =
    (输入, 预设时间, 当前时间) =>
    输入 and 当前时间 >= 预设时间

  func 计数器CTU(脉冲: Bool, 预设值: Int, 当前计数: Int) -> (Int, Bool) =
    (脉冲, 预设值, 当前计数) =>
    if 脉冲 then
      (if 当前计数 + 1 >= 预设值 then 预设值 else 当前计数 + 1,
       当前计数 + 1 >= 预设值)
    else
      (当前计数, 假)

  (* ===== 嵌入式系统 ===== *)
  func 内存对齐(大小: Int, 对齐值: Int) -> Int =
    (* 向上对齐到对齐值的倍数 *)
    (大小, 对齐值) =>
    ((大小 + 对齐值 - 1) / 对齐值) * 对齐值

  func 堆栈使用率(已使用: Int, 总大小: Int) -> Float =
    (已使用, 总大小) =>
    (总大小 = 0) ? 0 : 已使用 / 总大小

  func 中断延迟(指令周期: Int, 中断向量数: Int) -> Int =
    (指令周期, 中断向量数) =>
    指令周期 * 中断向量数
}
