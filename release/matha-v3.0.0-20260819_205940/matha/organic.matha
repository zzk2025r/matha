(* 学科知识：化学 — 有机化学基础
   覆盖：烃类分子式、官能团
   ============================================================ *)

module 有机 {

  func 烷烃分子式(n: Int) -> String = (n) =>
    "C" + str(n) + "H" + str(2*n + 2)

  func 烯烃分子式(n: Int) -> String = (n) =>
    "C" + str(n) + "H" + str(2*n)

  func 炔烃分子式(n: Int) -> String = (n) =>
    "C" + str(n) + "H" + str(2*n - 2)
}
