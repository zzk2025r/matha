？#：{
  【*/多参数函数边界测试/*】
  #：【类型标注要求】>>【调用方式】>>【递归】>>【特殊数值】
  @：【测试参数】，x=5，a=3，b=4
  #：【单参有类型】
  func 单参(x: Int) -> Int = (x) => x + 1
  #：[单参(x)]
  #：【两参柯里化】
  func 加(a: Int, b: Int) -> Int = (a, b) => a + b
  #：[加(a)(b)]
  #：【两参逗号】
  #：[加(3, 4)]
  #：【三参】
  func 热机(Th: Float, Tc: Float) -> Float = (Th, Tc) => 1 - Tc / Th
  #：[热机(500.0, 300.0)]
  #：【单参递归】
  func 阶乘(n: Int) -> Int = (n) => (n <= 1) ? 1 : n * 阶乘(n - 1)
  #：[阶乘(5)]
}
#：【文件】
