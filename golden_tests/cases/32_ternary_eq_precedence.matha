# A3 回归锁：语句位比较运算符 == / != 与三元的优先级
# （修复前 3 == 3 ? 100 : 200 误析为 3 == (3 ? 100 : 200)，运行得 false）
r = 3 == 3 ? 100 : 200
[r]
s = 3 == 5 ? 100 : 200
[s]
t = 4 != 3 ? 7 : 9
[t]
# or 语境：右侧 (2 == 2) ? 5 : 6 应取 5
o = 0 or (2 == 2 ? 5 : 6)
[o]
# 赋值右值整体纳入三元（不得被改坏）
m = 3 > 2 ? 100 : 200
[m]
# lambda 体内比较（既有正确路径，防回归）
func 分类(n: Int) -> String = (n) => n == 0 ? "零" : (n == 1 ? "一" : "多")
[分类(0)]
[分类(1)]
[分类(9)]
