# 标准库 collections_core：map / filter / reduce 基本形态与边界
# 库源码由 manifest preload 前置拼接（matha/library/collections_core.matha）
inc = (x) => x + 1
isEven = (x) => x % 2 == 0
add2 = (a, b) => a + b
sq = (x) => x * x
[map(inc, [1, 2, 3, 4])]
[map(inc, [])]
[filter(isEven, [1, 2, 3, 4, 5])]
[filter(isEven, [1, 3, 5])]
[reduce(add2, [1, 2, 3, 4], 0)]
[reduce(add2, [], 7)]
[reduce(add2, [42], 0)]
# 嵌套闭包：内联 lambda 直接实参 + map∘reduce 组合
[reduce(add2, map(sq, [1, 2, 3, 4]), 0)]
[map((x) => x % 3, [10, 11, 12, 13])]
